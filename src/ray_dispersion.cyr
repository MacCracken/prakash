# ray_dispersion.cyr -- dispersion models (Cauchy/Sellmeier/Herzberger/Schott/
# Conrady), prisms, Abbe number, chromatic aberration.
# Usage: include "lib/ray_dispersion.cyr"  (requires error.cyr)
#
# Ported from the Rust `ray/dispersion.rs`. Glass coefficients are encoded as
# exact ratios (num/den, both < 2^53) which reproduce Rust's decimal literals
# bit-for-bit. Wavelengths are in micrometers.

fn _disp_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _disp_eps15() { return 0x3CD203AF9EE75616; }

# Fraunhofer reference wavelengths (micrometers).
#must_use
fn fraunhofer_d() { return _disp_r(58756, 100000); }   # 0.58756 (He yellow)
# Fraunhofer F line (hydrogen H-beta, blue): 0.48613 um.
#must_use
fn fraunhofer_f() { return _disp_r(48613, 100000); }   # 0.48613 (H blue)
# Fraunhofer C line (hydrogen H-alpha, red): 0.65627 um.
#must_use
fn fraunhofer_c() { return _disp_r(65627, 100000); }   # 0.65627 (H red)

# ── Cauchy dispersion: n(l) = b + c/l^2 ────────

#derive(accessors)
struct CauchyCoefficients { b; c; }

fn _cauchy_mk(b, c) {
    var x = alloc(sizeof(CauchyCoefficients));
    if (x == 0) { return 0; }
    CauchyCoefficients_set_b(x, b);
    CauchyCoefficients_set_c(x, c);
    return x;
}

# Cauchy coefficients for BK7: b = 1.5046, c = 0.00420 um^2.
#must_use
fn cauchy_bk7() { return _cauchy_mk(_disp_r(15046, 10000), _disp_r(420, 100000)); }
# Cauchy coefficients for fused silica: b = 1.4483, c = 0.00351 um^2.
# ⛔ Through 2.4.3 this read b = 1.4580, which is fused silica's n_d — NOT its Cauchy
# constant. `b` is the asymptotic index, always below n_d: BK7 above has b = 1.5046
# against an n_d of 1.5168, and that contrast is what gives the slip away. Adding
# c/l^2 on top of n_d double-counts the dispersion, so this returned n_d = 1.46825
# against a true 1.45846 — an 0.0098 error the suite's `TOL_02` assertion was twice
# too wide to see. Inherited from the Rust archive, which labelled it "approximate".
# The pair here is a least-squares refit to this file's own (verified) Malitson
# Sellmeier fused-silica set over 400-700 nm: worst |dn| 1.7e-4 across the band,
# n_d within 1e-5, comparable to what the BK7 pair achieves (1.0e-4).
#must_use
fn cauchy_fused_silica() { return _cauchy_mk(_disp_r(14483, 10000), _disp_r(351, 100000)); }

# Refractive index at wavelength_um: b + c/l^2.
#must_use
fn cauchy_n_at(coef, wavelength_um) {
    if (coef == 0) { return f64_from(0); }
    var l2 = f64_mul(wavelength_um, wavelength_um);
    return f64_add(CauchyCoefficients_b(coef), f64_div(CauchyCoefficients_c(coef), l2));
}

# ── Sellmeier dispersion (3-term) ────────

#derive(accessors)
struct SellmeierCoefficients { b1; c1; b2; c2; b3; c3; }

fn _sellmeier_mk(b1, c1, b2, c2, b3, c3) {
    var s = alloc(sizeof(SellmeierCoefficients));
    if (s == 0) { return 0; }
    SellmeierCoefficients_set_b1(s, b1);
    SellmeierCoefficients_set_c1(s, c1);
    SellmeierCoefficients_set_b2(s, b2);
    SellmeierCoefficients_set_c2(s, c2);
    SellmeierCoefficients_set_b3(s, b3);
    SellmeierCoefficients_set_c3(s, c3);
    return s;
}

# Sellmeier coefficients (b1,c1,b2,c2,b3,c3; c in um^2) for Schott N-BK7.
#must_use
fn sellmeier_bk7() {
    return _sellmeier_mk(
      _disp_r(103961212, 100000000), _disp_r(600069867, 100000000000),
      _disp_r(231792344, 1000000000), _disp_r(200179144, 10000000000),
      _disp_r(101046945, 100000000), _disp_r(103560653, 1000000));
}
# Sellmeier coefficients for Schott N-SF11 dense flint.
# ⚠ N-SF11, the lead-free glass, not the older SF11 — both are catalogued at
# n_d = 1.78472, but their Abbe numbers differ (N-SF11 25.68, SF11 25.76) and this
# set answers 25.68. The Rust archive labelled it N-SF11; prakash's own doc line said
# "SF11" from 2.4.1 until 2.4.4, and the suite pinned SF11's 25.76 at a tolerance of
# 1.0, wide enough that neither reading failed. The function name is unchanged: it is
# public API, and renaming it to move one prefix is not worth a breaking change.
# b1 was `1.73759626` through 2.4.3, a transcription slip for the catalogued
# `1.73759695`; worth 2e-7 in n, corrected for fidelity rather than for accuracy.
#must_use
fn sellmeier_sf11() {
    return _sellmeier_mk(
      _disp_r(173759695, 100000000), _disp_r(131887070, 10000000000),
      _disp_r(313747346, 1000000000), _disp_r(623068142, 10000000000),
      _disp_r(189878101, 100000000), _disp_r(15523629, 100000));
}
# Sellmeier coefficients for fused silica (Malitson 1965).
#must_use
fn sellmeier_fused_silica() {
    return _sellmeier_mk(
      _disp_r(6961663, 10000000), _disp_r(46791482, 10000000000),
      _disp_r(4079426, 10000000), _disp_r(13512063, 1000000000),
      _disp_r(8974794, 10000000), _disp_r(979340025, 10000000));
}
# Sellmeier coefficients for sapphire (Al2O3), ordinary ray — Malitson & Dodge.
# c1/c2/c3 are resonance wavelengths SQUARED: 0.0726631^2, 0.1193242^2, 18.028251^2.
# ⚠ Through 2.4.3 three of the six were slipped in transcription — c2 read 0.01421826
# for 0.01423826 and b3 read 5.3414822 for 5.3414021 (both digit transpositions), and
# c1 was rounded to 0.00527925 for 0.005279925. Net effect was only 3.3e-5 in n, so
# unlike the diamond and water repairs this is fidelity to the cited source rather
# than a correctness fix; it is made because the source IS cited and b1/b2 already
# matched it exactly, which is what identified the other four as slips.
#must_use
fn sellmeier_sapphire() {
    return _sellmeier_mk(
      _disp_r(14313493, 10000000), _disp_r(5279925, 1000000000),
      _disp_r(65054713, 100000000), _disp_r(1423826, 100000000),
      _disp_r(53414021, 10000000), _disp_r(325017834, 1000000));
}
# Sellmeier coefficients for water at 20 C, derived from Daimon & Masumura (2007).
# Fit validity 0.182-1.129 um, which contains the whole visible band. ⚠ Outside it
# the third term's resonance at 3.27 um takes over and the output is meaningless
# (n crosses 1 there and the n^2 < 1 clamp in sellmeier_n_at fires) — this preset
# is for visible and near-IR light, as every consumer of prakash is.
#
# ⚠ TERMS 1 AND 3 ARE D&M VERBATIM; TERM 2 IS PRAKASH'S OWN, AND THAT IS
# DELIBERATE — do not "restore" it from the paper. D&M is a FOUR-term fit and
# `SellmeierCoefficients` holds three, so D&M's two adjacent UV resonances (135 nm
# and 162 nm) are carried here by ONE least-squares merged term at 138.3 nm.
# Measured: the merged set tracks the published four-term fit to **3.5e-6 in n**
# across 380-780 nm, and reproduces published n at all three Fraunhofer lines to
# 1e-5. The alternative was widening the struct to four terms, which moves public
# API for every preset; 2.4.3 is a patch, and the merge costs nothing measurable.
#
# ⛔ Through 2.4.2 this preset was D&M's first three terms with the IR term simply
# DROPPED. That is the one term the visible band cannot do without: it contributes
# about -0.0014 to n across the whole band, so n_d read 1.33418 against a published
# 1.33304 and V_d read 65.1 against ~55.7 — a 17% dispersion error, printed by
# examples/rainbow.cyr for six releases. See the [2.4.3] CHANGELOG entry.
#must_use
fn sellmeier_water() {
    return _sellmeier_mk(
      _disp_r(5674277366, 10000000000), _disp_r(5101829712, 1000000000000),
      _disp_r(19345245, 100000000), _disp_r(1914, 100000),
      _disp_r(1130748688, 10000000000), _disp_r(1069792721, 100000000));
}
# Sellmeier coefficients for diamond (Peter 1923), two-term fit (b3 = 0, c3 = 1).
# Fit validity 0.225-0.665 um, so all three Fraunhofer lines sit inside it.
# ⚠ c1 AND c2 ARE RESONANCE WAVELENGTHS **SQUARED** — 0.1060^2 = 0.011236 and
# 0.1750^2 = 0.030625 um^2 — which is this file's convention everywhere else
# (fused silica stores 0.0684043^2 as 0.0046791482, sapphire 0.0726631^2). Through
# 2.4.1 this entry stored `0.0106` and `0.0175`: the wavelengths themselves, neither
# squared nor even scaled consistently, with b2 = 0.3060 for a published 0.3306.
# Measured cost of that: n_d = 2.4074 against a published 2.4175, n_F 2.4228 vs
# 2.4355, n_C 2.4009 vs 2.4099, and an Abbe number of 64.2 for a material whose
# published value is 55.3 — the dispersion was off by 16%, not the index alone.
# ⛔ The error was inherited character-for-character from the Rust archive
# (`git show 524a7aa^:rust-old/src/ray/dispersion.rs`), a seventh member of the
# 2.2.6 class, AND so was the 0.02 test tolerance that let it pass — wide enough
# to swallow a 0.0096 miss. The pins below are tight and at three wavelengths.
#must_use
fn sellmeier_diamond() {
    return _sellmeier_mk(
      _disp_r(43356, 10000), _disp_r(11236, 1000000),
      _disp_r(3306, 10000), _disp_r(30625, 1000000),
      f64_from(0), F64_ONE);
}

# One Sellmeier term with a resonance-pole guard: b*l2/(l2-c), or 0 near the pole.
fn _sellmeier_term(b, l2, c) {
    var d = f64_sub(l2, c);
    if (f64_gt(f64_abs(d), _disp_eps15()) == 1) {
        return f64_div(f64_mul(b, l2), d);
    }
    return f64_from(0);
}

# Refractive index at wavelength_um. Clamps to 1.0 in the unphysical n^2 < 1 region.
#must_use
fn sellmeier_n_at(coef, wavelength_um) {
    if (coef == 0) { return f64_from(0); }
    var l2 = f64_mul(wavelength_um, wavelength_um);
    var t1 = _sellmeier_term(SellmeierCoefficients_b1(coef), l2, SellmeierCoefficients_c1(coef));
    var t2 = _sellmeier_term(SellmeierCoefficients_b2(coef), l2, SellmeierCoefficients_c2(coef));
    var t3 = _sellmeier_term(SellmeierCoefficients_b3(coef), l2, SellmeierCoefficients_c3(coef));
    var n2 = f64_add(f64_add(f64_add(F64_ONE, t1), t2), t3);
    if (f64_lt(n2, F64_ONE) == 1) {
        return F64_ONE;
    }
    return f64_sqrt(n2);
}

# One term's contribution to chi = n^2 - 1, f' and f'' (accumulated into
# acc[0..2]); 0 inside the pole guard. A b = 0 term contributes nothing and has
# no pole — diamond's unused third term is (0, 1), which would otherwise refuse
# lambda = 1 um. The derivatives are formed as (2BC/d)(l/d) and
# (2BC/d)((3l^2 + C)/d)/d, never through d^3 — which overflowed past l = 2.4e51 um
# and turned f'' into 0 and D's sign around (round 1 of the review).
fn _sellmeier_f012_term(b, c, wl, acc) {
    if ((b & 0x7FFFFFFFFFFFFFFF) == 0) { return 1; }
    var l2 = f64_mul(wl, wl);
    # l^2 underflowing to 0 (l < 1.6e-162 um) makes every term exactly 0 and chi a
    # true +0 that passes the chi < 0 test (round 2 of the review).
    if (l2 == 0) { return 0; }
    var d = f64_sub(l2, c);
    if (f64_gt(f64_abs(d), _disp_eps15()) == 0) { return 0; }
    var g = f64_div(f64_mul(F64_TWO, f64_mul(b, c)), d);
    store64(acc, f64_add(load64(acc), f64_div(f64_mul(b, l2), d)));
    store64(acc + 8, f64_sub(load64(acc + 8), f64_mul(g, f64_div(wl, d))));
    store64(acc + 16, f64_add(load64(acc + 16),
        f64_div(f64_mul(g, f64_div(f64_add(f64_mul(f64_from(3), l2), c), d)), d)));
    return 1;
}

# n^2 and its first two wavelength derivatives, f = n^2, f', f'' (um^-1, um^-2),
# into out[0..2]:  f  = 1 + chi, chi = sum B l^2/(l^2 - C),
#                  f' = sum -2 B C l/(l^2 - C)^2,
#                  f''= sum 2 B C (3 l^2 + C)/(l^2 - C)^3.
# Returns 1, or 0 for a null set, a wavelength that is not finite and positive
# or whose square underflows, a term within sellmeier_n_at's pole guard, chi < 0 — the n^2 < 1 region
# sellmeier_n_at clamps to 1, where its derivatives would describe a curve it
# does not return — or any of f, f', f'' not finite. chi is summed on its own and
# tested before 1 is added: below l = 6e-10 um silica's first term is under half
# an ulp of 1, and a test on 1 + chi let that (all-negative) region through.
fn _sellmeier_f012(coef, wavelength_um, out) {
    if (coef == 0) { return 0; }
    if (f64_gt(wavelength_um, 0) == 0) { return 0; }
    if ((wavelength_um & 0x7FFFFFFFFFFFFFFF) >= 0x7FF0000000000000) { return 0; }
    store64(out, 0);
    store64(out + 8, 0);
    store64(out + 16, 0);
    var ok = _sellmeier_f012_term(SellmeierCoefficients_b1(coef), SellmeierCoefficients_c1(coef),
      wavelength_um, out);
    ok = ok & _sellmeier_f012_term(SellmeierCoefficients_b2(coef), SellmeierCoefficients_c2(coef),
      wavelength_um, out);
    ok = ok & _sellmeier_f012_term(SellmeierCoefficients_b3(coef), SellmeierCoefficients_c3(coef),
      wavelength_um, out);
    if (ok == 0) { return 0; }
    if (f64_ge(load64(out), 0) == 0) { return 0; }
    store64(out, f64_add(F64_ONE, load64(out)));
    var i = 0;
    while (i < 3) {
        if ((load64(out + i * 8) & 0x7FFFFFFFFFFFFFFF) >= 0x7FF0000000000000) { return 0; }
        i = i + 1;
    }
    return 1;
}

# dn/dlambda (um^-1) of a Sellmeier material at wavelength_um: f'/(2n) with
# f = n^2. Analytic, not a finite difference. NaN where _sellmeier_f012 refuses
# (null set, bad wavelength, a pole, the n^2 < 1 region sellmeier_n_at clamps, or
# an overflow).
#must_use
fn sellmeier_dn_dlambda(coef, wavelength_um) {
    var f[24];
    if (_sellmeier_f012(coef, wavelength_um, &f) == 0) { return 0x7FF8000000000000; }
    return f64_div(load64(&f + 8), f64_mul(F64_TWO, f64_sqrt(load64(&f))));
}

# d^2n/dlambda^2 (um^-2) at wavelength_um: (f'' - 2 n'^2)/(2n), from f = n^2.
# NaN on the same inputs as sellmeier_dn_dlambda.
#must_use
fn sellmeier_d2n_dlambda2(coef, wavelength_um) {
    var f[24];
    if (_sellmeier_f012(coef, wavelength_um, &f) == 0) { return 0x7FF8000000000000; }
    var n = f64_sqrt(load64(&f));
    var n1 = f64_div(load64(&f + 8), f64_mul(F64_TWO, n));
    return f64_div(f64_sub(load64(&f + 16), f64_mul(F64_TWO, f64_mul(n1, n1))), f64_mul(F64_TWO, n));
}

# Group index N_g = n - lambda dn/dlambda at wavelength_um: c over the group
# velocity of a pulse in the bulk material. NaN on the same inputs as above.
#must_use
fn sellmeier_group_index(coef, wavelength_um) {
    var f[24];
    if (_sellmeier_f012(coef, wavelength_um, &f) == 0) { return 0x7FF8000000000000; }
    var n = f64_sqrt(load64(&f));
    var n1 = f64_div(load64(&f + 8), f64_mul(F64_TWO, n));
    return f64_sub(n, f64_mul(wavelength_um, n1));
}

# Abbe number V = (n_d - 1) / (n_F - n_C).
#must_use
fn abbe_number(sellmeier) {
    if (sellmeier == 0) { return f64_from(0); }
    var n_d = sellmeier_n_at(sellmeier, fraunhofer_d());
    var n_f = sellmeier_n_at(sellmeier, fraunhofer_f());
    var n_c = sellmeier_n_at(sellmeier, fraunhofer_c());
    return f64_div(f64_sub(n_d, F64_ONE), f64_sub(n_f, n_c));
}

# ── Prism ────────

# Minimum deviation angle: d_min = 2*asin(n*sin(A/2)) - A. Writes PK_ERR_TIR
# (returns 0) if n*sin(A/2) exceeds 1.
#must_use
fn prism_deviation(apex_angle, n, err_out) {
    store64(err_out, PK_ERR_NONE);
    var sin_half_a = _prk_sin(f64_div(apex_angle, F64_TWO));
    var arg = f64_mul(n, sin_half_a);
    if (f64_gt(f64_abs(arg), F64_ONE) == 1) {
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    return f64_sub(f64_mul(F64_TWO, ganita_f64_asin(arg)), apex_angle);
}

# Prism deviation using the Sellmeier index at wavelength_um.
#must_use
fn prism_dispersion(apex_angle, sellmeier, wavelength_um, err_out) {
    if (sellmeier == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var n = sellmeier_n_at(sellmeier, wavelength_um);
    return prism_deviation(apex_angle, n, err_out);
}

# (dev_short, dev_long, angular_spread) for prism_angular_spread.
#derive(accessors)
struct PrismSpread { dev_short; dev_long; spread; }

# Angular spread across a wavelength range. Returns a PrismSpread (0 on error).
#must_use
fn prism_angular_spread(apex_angle, sellmeier, wavelength_short_um, wavelength_long_um, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (sellmeier == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var e1 = 0;
    var dev_short = prism_dispersion(apex_angle, sellmeier, wavelength_short_um, &e1);
    if (prakash_is_err(e1) == 1) {
        store64(err_out, e1);
        return 0;
    }
    var e2 = 0;
    var dev_long = prism_dispersion(apex_angle, sellmeier, wavelength_long_um, &e2);
    if (prakash_is_err(e2) == 1) {
        store64(err_out, e2);
        return 0;
    }
    var ps = alloc(sizeof(PrismSpread));
    if (ps == 0) { return 0; }
    PrismSpread_set_dev_short(ps, dev_short);
    PrismSpread_set_dev_long(ps, dev_long);
    PrismSpread_set_spread(ps, f64_abs(f64_sub(dev_short, dev_long)));
    return ps;
}

# ── Additional dispersion models ────────

# Herzberger (5-term): n = a + b*L + c*L^2 + d*l2 + e*l2^2, L = 1/(l2 - 0.028).
#derive(accessors)
struct HerzbergerCoefficients { a; b; c; d; e; }

fn _herzberger_mk(a, b, c, d, e) {
    var h = alloc(sizeof(HerzbergerCoefficients));
    if (h == 0) { return 0; }
    HerzbergerCoefficients_set_a(h, a);
    HerzbergerCoefficients_set_b(h, b);
    HerzbergerCoefficients_set_c(h, c);
    HerzbergerCoefficients_set_d(h, d);
    HerzbergerCoefficients_set_e(h, e);
    return h;
}

# Herzberger index at wavelength_um: a + b*L + c*L^2 + d*l^2 + e*l^4, L = 1/(l^2 - 0.028).
#must_use
fn herzberger_n_at(coef, wavelength_um) {
    if (coef == 0) { return f64_from(0); }
    var l2 = f64_mul(wavelength_um, wavelength_um);
    var l = f64_div(F64_ONE, f64_sub(l2, _disp_r(28, 1000)));   # 0.028
    # Match Rust's left-associative coefficient-first order: c*l*l = (c*l)*l.
    var term_a = HerzbergerCoefficients_a(coef);
    var term_b = f64_mul(HerzbergerCoefficients_b(coef), l);
    var term_c = f64_mul(f64_mul(HerzbergerCoefficients_c(coef), l), l);
    var term_d = f64_mul(HerzbergerCoefficients_d(coef), l2);
    var term_e = f64_mul(f64_mul(HerzbergerCoefficients_e(coef), l2), l2);
    return f64_add(f64_add(f64_add(f64_add(term_a, term_b), term_c), term_d), term_e);
}

# Schott (6-term legacy): n^2 = a0 + a1*l2 + a2/l2 + a3/l2^2 + a4/l2^3 + a5/l2^4.
#derive(accessors)
struct SchottCoefficients { a0; a1; a2; a3; a4; a5; }

fn _schott_mk(a0, a1, a2, a3, a4, a5) {
    var s = alloc(sizeof(SchottCoefficients));
    if (s == 0) { return 0; }
    SchottCoefficients_set_a0(s, a0);
    SchottCoefficients_set_a1(s, a1);
    SchottCoefficients_set_a2(s, a2);
    SchottCoefficients_set_a3(s, a3);
    SchottCoefficients_set_a4(s, a4);
    SchottCoefficients_set_a5(s, a5);
    return s;
}

# Schott power-series coefficients a0..a5 for N-BK7 (wavelength in um).
# ⛔ a3 read `0.000200816` through 2.4.3, for a catalogued `0.00020816` — a zero
# inserted after the leading 2. It put this series 2.1e-5 off the Sellmeier fit of
# the SAME GLASS at the d-line (9.5e-5 at 400 nm) and its Abbe number at 64.41
# against a catalogued 64.17. Corrected, the two models agree to **1.7e-6** across
# 400-700 nm and n_d lands on 1.51680 exactly.
# ⚠ The cross-check that finds this already existed — `Schott BK7 ~ Sellmeier BK7` —
# and was inherited from the Rust archive at a tolerance of **0.002**, a hundred times
# the defect. Two independent models of one glass is the right instrument; 0.002 is
# the wrong setting for it. Now pinned at 1e-5, at five wavelengths.
#must_use
fn schott_bk7() {
    return _schott_mk(
      _disp_r(22718929, 10000000), f64_neg(_disp_r(10108077, 1000000000)),
      _disp_r(10592509, 1000000000), _disp_r(20816, 100000000),
      f64_neg(_disp_r(76472538, 10000000000000)), _disp_r(49240991, 100000000000000));
}

# Schott power-series index: sqrt(a0 + a1*l^2 + a2/l^2 + a3/l^4 + a4/l^6 + a5/l^8); 1 if n^2 <= 0.
#must_use
fn schott_n_at(coef, wavelength_um) {
    if (coef == 0) { return f64_from(0); }
    var l2 = f64_mul(wavelength_um, wavelength_um);
    var li = f64_div(F64_ONE, l2);
    # Match Rust's left-associative coefficient-first folds: a3*x*x = (a3*x)*x.
    var t3 = f64_mul(f64_mul(SchottCoefficients_a3(coef), li), li);
    var t4 = f64_mul(f64_mul(f64_mul(SchottCoefficients_a4(coef), li), li), li);
    var t5 = f64_mul(f64_mul(f64_mul(f64_mul(SchottCoefficients_a5(coef), li), li), li), li);
    var n2 = f64_add(f64_add(f64_add(f64_add(f64_add(
              SchottCoefficients_a0(coef),
              f64_mul(SchottCoefficients_a1(coef), l2)),
            f64_mul(SchottCoefficients_a2(coef), li)),
          t3), t4), t5);
    if (f64_gt(n2, f64_from(0)) == 1) {
        return f64_sqrt(n2);
    }
    return F64_ONE;
}

# Conrady (3-term): n = n0 + a/l + b/l^3.5.
#derive(accessors)
struct ConradyCoefficients { n0; a; b; }

fn _conrady_mk(n0, a, b) {
    var c = alloc(sizeof(ConradyCoefficients));
    if (c == 0) { return 0; }
    ConradyCoefficients_set_n0(c, n0);
    ConradyCoefficients_set_a(c, a);
    ConradyCoefficients_set_b(c, b);
    return c;
}

# Conrady index at wavelength_um: n0 + a/l + b/l^3.5.
#must_use
fn conrady_n_at(coef, wavelength_um) {
    if (coef == 0) { return f64_from(0); }
    var term_a = f64_div(ConradyCoefficients_a(coef), wavelength_um);
    var term_b = f64_div(ConradyCoefficients_b(coef), _prk_pow(wavelength_um, _disp_r(7, 2)));
    return f64_add(f64_add(ConradyCoefficients_n0(coef), term_a), term_b);
}

# ── Partial dispersion & chromatic aberration ────────

# Partial dispersion P_g,F = (n_g - n_F) / (n_F - n_C). 0 if n_F ~ n_C.
#must_use
fn partial_dispersion(sellmeier) {
    if (sellmeier == 0) { return f64_from(0); }
    var n_g = sellmeier_n_at(sellmeier, _disp_r(43584, 100000));   # g-line 0.43584
    var n_f = sellmeier_n_at(sellmeier, fraunhofer_f());
    var n_c = sellmeier_n_at(sellmeier, fraunhofer_c());
    var dn_fc = f64_sub(n_f, n_c);
    if (f64_lt(f64_abs(dn_fc), _disp_eps15()) == 1) {
        return f64_from(0);
    }
    return f64_div(f64_sub(n_g, n_f), dn_fc);
}

# Longitudinal chromatic aberration (axial color): df = f / V.
#must_use
fn longitudinal_chromatic_aberration(focal_length, abbe_num) {
    return f64_div(focal_length, abbe_num);
}

# Lateral (transverse) chromatic aberration: TCA = h / V.
#must_use
fn lateral_chromatic_aberration(image_height, abbe_num) {
    return f64_div(image_height, abbe_num);
}

# Secondary spectrum (residual after achromatic correction): f * dP / V.
#must_use
fn secondary_spectrum(focal_length, delta_p, abbe_num) {
    return f64_div(f64_mul(focal_length, delta_p), abbe_num);
}
