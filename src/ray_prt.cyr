# ray_prt.cyr -- three-dimensional polarization ray tracing
# Usage: include "lib/ray_prt.cyr"  (requires error.cyr, ray_core.cyr, ray_fresnel.cyr,
# ray_trace.cyr)
#
# New in 2.12.0, and NOT a port: the Rust 1.x crate tracked scalar s/p transmittance, and so
# does trace_sequential_polarized. Here the polarization state of a ray is a 3D electric
# field in global coordinates, carried by a 3x3 complex matrix per surface: Chipman's
# polarization ray-tracing matrix (Yun, Crabtree & Chipman, Appl. Opt. 50, 2855 (2011);
# Yun, McClain & Chipman, Appl. Opt. 50, 2866 (2011)).
#
# THE MATRIX. For a ray of direction k meeting a surface of normal eta and leaving along k',
#   s = k x eta / |k x eta|,  p = k x s,  p' = k' x s,
#   P = O_out diag(a_s, a_p, 1) O_in^-1 = a_s s s^T + a_p p' p^T + k' k^T,
# with O_in = (s, p, k), O_out = (s, p', k'), and (a_s, a_p) = (t_s, t_p) on refraction,
# (r_s, r_p) on reflection, from fresnel_amplitudes. E' = P E in global coordinates, P k = k',
# and a path multiplies along itself: P_total = P_N ... P_2 P_1.
#
# GEOMETRY IS NOT RETARDANCE. A fold mirror turns a polarization state with no physical
# phase shift, and P cannot tell the two apart: two paths can share a P and differ in
# retardance. Q is the same chain for a nonpolarizing system, which holds only the geometry:
#   Q = O_out diag(1, +-1, 1) O_in^T,  + on refraction, - on reflection.
# The - is Chipman's: Lam's dissertation (Univ. Arizona, 2015) Eqs. 4.5-4.6, "a right-handed
# orthonormal basis becomes left-handed after reflection". With it, an ideal mirror is no
# retarder at normal incidence, and a reflection's Q is the mirror matrix I - 2 eta eta^T.
# (Her diag has 0 in the last place, so her Q annihilates k. The 1 here keeps Q orthogonal
# and changes nothing in the transverse plane, which is all retardance reads.)
#   Q^T P, restricted to the plane transverse to the first k, is then a 2x2 Jones matrix J in
# the input frame, and diattenuation and retardance are J's.
#
# ⚠ WHAT "RETARDANCE" MEANS ON A REFLECTION. It is measured from that ideal mirror. So an
# odd number of reflections reads pi away from a bare arg(r_p/r_s): total internal
# reflection at the critical angle has r_s = r_p = 1 and reads pi, a half wave, which is
# Lam's "polarization inversion". An even number agrees: a Fresnel rhomb reads 2 delta.
#
# ⚠ TIME CONVENTION. e^(-i w t), as in ray_fresnel, multilayer_rta, wave_focus and wave_doe, so
# a published matrix in the e^(+i w t) convention is the complex conjugate of this one. Lam's
# is, and so is wave_beam (Siegman's convention). Retardance and diattenuation are the same
# either way. (2.15.1: this said "as everywhere else in prakash", which wave_beam is not.)
#
# Unit vectors are checked, not assumed: a k or eta off unit length by more than ~1e-12 is
# refused, because the frames above would silently stop being orthonormal.
#
# ⚠ THE ABSOLUTE NOISE FLOOR. P keeps k' k^T at unit size next to the transverse terms, so an
# amplitude under ~1e-12 of the input is not readable from it: diattenuation and retardance
# answer NaN there rather than a number made of rounding.

# A P or Q matrix is a 144-byte buffer of 18 f64: element (i, j) has its real part at byte
# offset (i*3 + j)*8 and its imaginary part 72 bytes on.
var PRT_MATRIX_BYTES = 144;

# 2^-80. P's elements carry k' k^T at unit size, so their rounding is ABSOLUTE, ~1e-16 in
# every element whatever the path passes. A transverse amplitude under 2^-40 ~ 1e-12 of the
# input cannot be read back from them to better than a part in 1e4, so as a power this is the
# floor for "the path passes something" (|J|^2) and for a usable second singular value.
var _PRT_NOTHING = 0x3AF0000000000000;

# A complex electric field in global coordinates.
#derive(accessors)
struct PrtField { x_re; x_im; y_re; y_im; z_re; z_im; }

# One surface's result. p and q are PRT_MATRIX_BYTES buffers inside the step; (kx, ky, kz)
# is the exiting direction; flux turns |P E|^2 into the power crossing the surface;
# reflectance is (R_s + R_p)/2, or NaN from prt_surface on a refraction, which is not told.
#derive(accessors)
struct PrtStep { p; q; kx; ky; kz; flux; reflectance; }

# A surface of a trace_sequential_prt path. hit is the TraceHit; surface_p the surface's P;
# total_p and total_q the chains so far; flux their cumulative flux factor. All
# PRT_MATRIX_BYTES buffers are inside this hit, so it owns them.
#derive(accessors)
struct PrtTraceHit { hit; surface_p; total_p; total_q; flux; }

# The identity, written to a PRT_MATRIX_BYTES buffer. Returns m.
fn prt_identity(m) {
    if (m == 0) { return 0; }
    for (var i = 0; i < 18; i = i + 1) { store64(m + i * 8, 0); }
    store64(m, F64_ONE);
    store64(m + 32, F64_ONE);
    store64(m + 64, F64_ONE);
    return m;
}

# A new identity matrix; 0 on allocation failure.
#must_use
fn prt_new() {
    return prt_identity(alloc(PRT_MATRIX_BYTES));
}

# Re P(i, j), or NaN for a null matrix or an index outside 0..2.
#must_use
fn prt_re(m, i, j) {
    if ((m == 0) | (i < 0) | (i > 2) | (j < 0) | (j > 2)) { return _PRK_NAN; }
    return load64(m + (i * 3 + j) * 8);
}

# Im P(i, j), or NaN for a null matrix or an index outside 0..2.
#must_use
fn prt_im(m, i, j) {
    if ((m == 0) | (i < 0) | (i > 2) | (j < 0) | (j > 2)) { return _PRK_NAN; }
    return load64(m + 72 + (i * 3 + j) * 8);
}

# out = a b, the path a after b. out may be a or b. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER for a null handle.
fn prt_multiply(a, b, out) {
    if ((a == 0) | (b == 0) | (out == 0)) { return PK_ERR_INVALID_PARAMETER; }
    var t[144];
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var re = 0;
            var im = 0;
            for (var k = 0; k < 3; k = k + 1) {
                var ar = load64(a + (i * 3 + k) * 8);
                var ai = load64(a + 72 + (i * 3 + k) * 8);
                var br = load64(b + (k * 3 + j) * 8);
                var bi = load64(b + 72 + (k * 3 + j) * 8);
                re = f64_add(re, f64_sub(f64_mul(ar, br), f64_mul(ai, bi)));
                im = f64_add(im, f64_add(f64_mul(ar, bi), f64_mul(ai, br)));
            }
            store64(&t + (i * 3 + j) * 8, re);
            store64(&t + 72 + (i * 3 + j) * 8, im);
        }
    }
    for (var n = 0; n < 18; n = n + 1) { store64(out + n * 8, load64(&t + n * 8)); }
    return PK_ERR_NONE;
}

# A new field; 0 on allocation failure.
#must_use
fn prt_field_new(x_re, x_im, y_re, y_im, z_re, z_im) {
    var e = alloc(sizeof(PrtField));
    if (e == 0) { return 0; }
    PrtField_set_x_re(e, x_re);
    PrtField_set_x_im(e, x_im);
    PrtField_set_y_re(e, y_re);
    PrtField_set_y_im(e, y_im);
    PrtField_set_z_re(e, z_re);
    PrtField_set_z_im(e, z_im);
    return e;
}

# out = m e, for PrtFields e and out. out may be e. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER for a null handle.
fn prt_apply(m, e, out) {
    if ((m == 0) | (e == 0) | (out == 0)) { return PK_ERR_INVALID_PARAMETER; }
    var t[48];
    for (var i = 0; i < 3; i = i + 1) {
        var re = 0;
        var im = 0;
        for (var j = 0; j < 3; j = j + 1) {
            var mr = load64(m + (i * 3 + j) * 8);
            var mi = load64(m + 72 + (i * 3 + j) * 8);
            var er = load64(e + j * 16);
            var ei = load64(e + j * 16 + 8);
            re = f64_add(re, f64_sub(f64_mul(mr, er), f64_mul(mi, ei)));
            im = f64_add(im, f64_add(f64_mul(mr, ei), f64_mul(mi, er)));
        }
        store64(&t + i * 16, re);
        store64(&t + i * 16 + 8, im);
    }
    for (var n = 0; n < 6; n = n + 1) { store64(out + n * 8, load64(&t + n * 8)); }
    return PK_ERR_NONE;
}

# A step with its two matrices; 0 on allocation failure. One block, reusable across a sweep.
#must_use
fn prt_step_new() {
    var s = alloc(sizeof(PrtStep) + 2 * PRT_MATRIX_BYTES);
    if (s == 0) { return 0; }
    PrtStep_set_p(s, prt_identity(s + sizeof(PrtStep)));
    PrtStep_set_q(s, prt_identity(s + sizeof(PrtStep) + PRT_MATRIX_BYTES));
    PrtStep_set_kx(s, 0);
    PrtStep_set_ky(s, 0);
    PrtStep_set_kz(s, 0);
    PrtStep_set_flux(s, F64_ONE);
    PrtStep_set_reflectance(s, 0);
    return s;
}

# 1 if v is a non-null RayVec3 of unit length to within 2^-40 of |v|^2 = 1. NaN fails it.
fn _prt_unit_ok(v) {
    if (v == 0) { return 0; }
    var x = RayVec3_x(v);
    var y = RayVec3_y(v);
    var z = RayVec3_z(v);
    var l2 = f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(z, z));
    return f64_lt(f64_abs(f64_sub(l2, F64_ONE)), 0x3D70000000000000);
}

# a x b for three-slot buffers; out may not be a or b.
fn _prt_cross(a, b, out) {
    store64(out, f64_sub(f64_mul(load64(a + 8), load64(b + 16)), f64_mul(load64(a + 16), load64(b + 8))));
    store64(out + 8, f64_sub(f64_mul(load64(a + 16), load64(b)), f64_mul(load64(a), load64(b + 16))));
    store64(out + 16, f64_sub(f64_mul(load64(a), load64(b + 8)), f64_mul(load64(a + 8), load64(b))));
    return 0;
}

# Scale a three-slot buffer to unit length.
fn _prt_unit(v) {
    var x = load64(v);
    var y = load64(v + 8);
    var z = load64(v + 16);
    var l = f64_sqrt(f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(z, z)));
    store64(v, f64_div(x, l));
    store64(v + 8, f64_div(y, l));
    store64(v + 16, f64_div(z, l));
    return 0;
}

# A unit vector transverse to the unit vector k: the axis k leans on least, crossed with k.
fn _prt_transverse(k, out) {
    var ax = f64_abs(load64(k));
    var ay = f64_abs(load64(k + 8));
    var az = f64_abs(load64(k + 16));
    var e[24];
    store64(&e, 0);
    store64(&e + 8, 0);
    store64(&e + 16, 0);
    if ((f64_le(ax, ay) & f64_le(ax, az)) == 1) {
        store64(&e, F64_ONE);
    } else {
        if (f64_le(ay, az) == 1) { store64(&e + 8, F64_ONE); } else { store64(&e + 16, F64_ONE); }
    }
    var _c = _prt_cross(&e, k, out);
    return _prt_unit(out);
}

# Fill a step's P and Q from the two directions, s and the two amplitudes. qp is Q's sign
# on p: +1 for refraction, -1 for reflection. Assumes k, o, s are unit and s is
# perpendicular to both.
fn _prt_compose(step, k, o, s, asr, asi, apr, api, qp) {
    var pi[24];
    var po[24];
    var _c = _prt_cross(k, s, &pi);
    _c = _prt_cross(o, s, &po);
    var pm = PrtStep_p(step);
    var qm = PrtStep_q(step);
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var ss = f64_mul(load64(s + i * 8), load64(s + j * 8));
            var pp = f64_mul(load64(&po + i * 8), load64(&pi + j * 8));
            var kk = f64_mul(load64(o + i * 8), load64(k + j * 8));
            var at = (i * 3 + j) * 8;
            store64(pm + at, f64_add(f64_add(f64_mul(asr, ss), f64_mul(apr, pp)), kk));
            store64(pm + 72 + at, f64_add(f64_mul(asi, ss), f64_mul(api, pp)));
            store64(qm + at, f64_add(f64_add(ss, f64_mul(qp, pp)), kk));
            store64(qm + 72 + at, 0);
        }
    }
    return 0;
}

# The unit s of a ray k at normal eta, into a three-slot buffer. At normal incidence k x eta
# is nothing, and any transverse s serves: a_s = a_p on refraction and a_s = -a_p on
# reflection make P independent of it, and P stays continuous there because the difference
# is second order in the angle.
#
# ⚠ Near normal k x eta is part rounding, which leaves s off perpendicular to k by ~1e-16
# over the angle: every element of P was wrong at 2e-16 rad, and five digits were gone at
# 1e-6 rad. Which way s points hardly matters there, for the reason above; that it is
# transverse does. So it is always made transverse by hand. The result is perpendicular to
# k' too, to within the angle times the noise, which is an ulp.
fn _prt_s(k, eta, out) {
    var c[24];
    var _c = _prt_cross(k, eta, &c);
    var cx = load64(&c);
    var cy = load64(&c + 8);
    var cz = load64(&c + 16);
    var l2 = f64_add(f64_add(f64_mul(cx, cx), f64_mul(cy, cy)), f64_mul(cz, cz));
    if (f64_lt(l2, 0x3930000000000000) == 1) { return _prt_transverse(k, out); }     # 2^-108
    store64(out, cx);
    store64(out + 8, cy);
    store64(out + 16, cz);
    _c = _prt_unit(out);
    var d = f64_add(f64_add(f64_mul(load64(out), load64(k)), f64_mul(load64(out + 8), load64(k + 8))),
      f64_mul(load64(out + 16), load64(k + 16)));
    for (var i = 0; i < 3; i = i + 1) {
        store64(out + i * 8, f64_sub(load64(out + i * 8), f64_mul(d, load64(k + i * 8))));
    }
    return _prt_unit(out);
}

# 1 if k_out is a ray a surface of this normal can send: same tangential direction as k_in,
# and across the surface on refraction, or mirrored about it on reflection, to ~1e-12. The
# directions are compared as directions, so the test keeps its meaning however small they
# are, plus 2^-50 of absolute noise on each, which is all a legal ray near normal can carry.
fn _prt_geometry_ok(k_in, normal, k_out, reflect) {
    var dk = f64_add(f64_add(f64_mul(RayVec3_x(k_in), RayVec3_x(normal)), f64_mul(RayVec3_y(k_in), RayVec3_y(normal))),
      f64_mul(RayVec3_z(k_in), RayVec3_z(normal)));
    if (reflect == 1) {
        var e = 0;
        for (var i = 0; i < 3; i = i + 1) {
            var d = f64_sub(f64_sub(load64(k_in + i * 8), f64_mul(f64_mul(F64_TWO, dk), load64(normal + i * 8))),
              load64(k_out + i * 8));
            e = f64_add(e, f64_mul(d, d));
        }
        return f64_le(e, _PRT_NOTHING);
    }
    var dov = f64_add(f64_add(f64_mul(RayVec3_x(k_out), RayVec3_x(normal)), f64_mul(RayVec3_y(k_out),
          RayVec3_y(normal))),
      f64_mul(RayVec3_z(k_out), RayVec3_z(normal)));
    if (f64_gt(f64_mul(dk, dov), 0) == 0) { return 0; }
    var tin[24];
    var tou[24];
    var par[24];
    var _c = _prt_cross(k_in, normal, &tin);
    _c = _prt_cross(k_out, normal, &tou);
    _c = _prt_cross(&tin, &tou, &par);
    var e2 = f64_add(f64_add(f64_mul(load64(&par), load64(&par)), f64_mul(load64(&par + 8), load64(&par + 8))),
      f64_mul(load64(&par + 16), load64(&par + 16)));
    var two = f64_add(f64_add(f64_mul(load64(&tin), load64(&tou)), f64_mul(load64(&tin + 8), load64(&tou + 8))),
      f64_mul(load64(&tin + 16), load64(&tou + 16)));
    var li = f64_add(f64_add(f64_mul(load64(&tin), load64(&tin)), f64_mul(load64(&tin + 8), load64(&tin + 8))),
      f64_mul(load64(&tin + 16), load64(&tin + 16)));
    var lo = f64_add(f64_add(f64_mul(load64(&tou), load64(&tou)), f64_mul(load64(&tou + 8), load64(&tou + 8))),
      f64_mul(load64(&tou + 16), load64(&tou + 16)));
    # Straight down the normal, k_out must leave along it too.
    if ((f64_lt(li, 0x3930000000000000) == 1) & (f64_gt(lo, _PRT_NOTHING) == 1)) { return 0; }
    var lim = f64_add(f64_mul(_PRT_NOTHING, f64_mul(li, lo)), f64_mul(0x39B0000000000000, f64_add(li, lo)));
    return f64_le(e2, lim) & f64_ge(two, f64_neg(_PRT_NOTHING));
}

# P and Q of a surface given its amplitudes directly, for a coating or any other source of
# a_s and a_p: k_in at normal to k_out, reflect = 1 on reflection, 0 on refraction. All three
# are unit RayVec3s and the normal's sign does not matter. a_s and a_p are taken on trust;
# the geometry is not. step's flux is left at 1 and its k is set to k_out. Returns
# PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER for a null handle, a non-unit vector, an unknown
# reflect, or a k_out no such surface can send (out of the plane of incidence, on the wrong
# side, or off the law of reflection). A P built on any of those is not a P at all: its
# frames are not orthonormal, so nothing read from it would mean anything.
fn prt_surface(k_in, normal, k_out, as_re, as_im, ap_re, ap_im, reflect, step) {
    if (step == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((_prt_unit_ok(k_in) & _prt_unit_ok(normal) & _prt_unit_ok(k_out)) == 0) {
        return PK_ERR_INVALID_PARAMETER;
    }
    if ((reflect != 0) & (reflect != 1)) { return PK_ERR_INVALID_PARAMETER; }
    if (_prt_geometry_ok(k_in, normal, k_out, reflect) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var s[24];
    var _c = _prt_s(k_in, normal, &s);
    var qp = F64_ONE;
    if (reflect == 1) { qp = f64_neg(F64_ONE); }
    _c = _prt_compose(step, k_in, k_out, &s, as_re, as_im, ap_re, ap_im, qp);
    PrtStep_set_kx(step, RayVec3_x(k_out));
    PrtStep_set_ky(step, RayVec3_y(k_out));
    PrtStep_set_kz(step, RayVec3_z(k_out));
    PrtStep_set_flux(step, F64_ONE);
    var rf = _PRK_NAN;
    if (reflect == 1) {
        rf = f64_mul(F64_HALF, f64_add(f64_add(f64_mul(as_re, as_re), f64_mul(as_im, as_im)),
            f64_add(f64_mul(ap_re, ap_re), f64_mul(ap_im, ap_im))));
    }
    PrtStep_set_reflectance(step, rf);
    return PK_ERR_NONE;
}

# cos(theta_i) of a unit k at a unit normal, and the normal turned to face the ray.
fn _prt_face(k, normal, facing, cos_out) {
    var nx = RayVec3_x(normal);
    var ny = RayVec3_y(normal);
    var nz = RayVec3_z(normal);
    var dot = f64_add(f64_add(f64_mul(RayVec3_x(k), nx), f64_mul(RayVec3_y(k), ny)), f64_mul(RayVec3_z(k), nz));
    if (f64_gt(dot, 0) == 1) {
        nx = f64_neg(nx);
        ny = f64_neg(ny);
        nz = f64_neg(nz);
    }
    store64(facing, nx);
    store64(facing + 8, ny);
    store64(facing + 16, nz);
    # Unit to rounding is not unit: a k along a normal has k.k just above 1 about one time in
    # six, and fresnel_amplitudes rightly refuses a cosine above 1.
    var c = f64_abs(dot);
    if (f64_gt(c, F64_ONE) == 1) { c = F64_ONE; }
    store64(cos_out, c);
    return 0;
}

# (R_s + R_p)/2 of an amplitude record.
fn _prt_r_avg(fa) {
    var rs = f64_add(f64_mul(FresnelAmplitudes_rs_re(fa), FresnelAmplitudes_rs_re(fa)),
      f64_mul(FresnelAmplitudes_rs_im(fa), FresnelAmplitudes_rs_im(fa)));
    var rp = f64_add(f64_mul(FresnelAmplitudes_rp_re(fa), FresnelAmplitudes_rp_re(fa)),
      f64_mul(FresnelAmplitudes_rp_im(fa), FresnelAmplitudes_rp_im(fa)));
    return f64_mul(F64_HALF, f64_add(rs, rp));
}

# Refraction of a ray along unit k_in at a surface of unit normal (either sign), from real
# n1 into real n2: fills step with P, Q, the refracted direction and the flux factor
# n2 cos(theta_t)/(n1 cos(theta_i)). Returns PK_ERR_NONE, PK_ERR_TIR (there is no refracted
# ray), or PK_ERR_INVALID_PARAMETER / PK_ERR_INVALID_ANGLE as fresnel_amplitudes, and for a
# null step or a non-unit vector. step is untouched on any refusal.
fn prt_refract(k_in, normal, n1, n2, step) {
    if (step == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((_prt_unit_ok(k_in) & _prt_unit_ok(normal)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var f[24];
    var c = 0;
    var _c = _prt_face(k_in, normal, &f, &c);
    var fa[80];
    var e = fresnel_amplitudes(n1, n2, 0, c, &fa);
    if (e != PK_ERR_NONE) { return e; }
    var flux = FresnelAmplitudes_flux_s(&fa);
    if (f64_gt(flux, 0) == 0) { return PK_ERR_TIR; }
    # k' = ratio t - cos_t f from the tangential part t = k + c f, whose length is sin(theta_i)
    # to full precision: a cosine near 1 cannot resolve a small angle, so going back through c
    # broke n sin(theta) by 1e-12 at n1/n2 = 100. x = ratio |t| is sin(theta_t), and the
    # refusal above and this one agree but for the last ulp before the critical angle.
    var ratio = f64_div(n1, n2);
    var t[24];
    var t2 = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var ti = f64_add(load64(k_in + i * 8), f64_mul(c, load64(&f + i * 8)));
        store64(&t + i * 8, ti);
        t2 = f64_add(t2, f64_mul(ti, ti));
    }
    var x = f64_mul(ratio, f64_sqrt(t2));
    if (f64_ge(x, F64_ONE) == 1) { return PK_ERR_TIR; }
    var ct = f64_sqrt(f64_mul(f64_sub(F64_ONE, x), f64_add(F64_ONE, x)));
    var o[24];
    for (var j = 0; j < 3; j = j + 1) {
        store64(&o + j * 8, f64_sub(f64_mul(ratio, load64(&t + j * 8)), f64_mul(ct, load64(&f + j * 8))));
    }
    _c = _prt_unit(&o);
    var s[24];
    _c = _prt_s(k_in, normal, &s);
    _c = _prt_compose(step, k_in, &o, &s, FresnelAmplitudes_ts_re(&fa), FresnelAmplitudes_ts_im(&fa),
      FresnelAmplitudes_tp_re(&fa), FresnelAmplitudes_tp_im(&fa), F64_ONE);
    PrtStep_set_kx(step, load64(&o));
    PrtStep_set_ky(step, load64(&o + 8));
    PrtStep_set_kz(step, load64(&o + 16));
    PrtStep_set_flux(step, flux);
    PrtStep_set_reflectance(step, _prt_r_avg(&fa));
    return PK_ERR_NONE;
}

# Reflection of a ray along unit k_in, in real n1, from a surface of unit normal (either
# sign) backed by n2 + i k2: a metal, a dielectric, or total internal reflection. Fills step
# with P, Q and the mirrored direction; flux = 1, since |r|^2 is already the power. Returns
# PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER / PK_ERR_INVALID_ANGLE as fresnel_amplitudes, and
# for a null step or a non-unit vector. step is untouched on any refusal.
fn prt_reflect(k_in, normal, n1, n2, k2, step) {
    if (step == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((_prt_unit_ok(k_in) & _prt_unit_ok(normal)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var f[24];
    var c = 0;
    var _c = _prt_face(k_in, normal, &f, &c);
    var fa[80];
    var e = fresnel_amplitudes(n1, n2, k2, c, &fa);
    if (e != PK_ERR_NONE) { return e; }
    var o[24];
    var two_c = f64_mul(F64_TWO, c);
    for (var i = 0; i < 3; i = i + 1) {
        store64(&o + i * 8, f64_add(load64(k_in + i * 8), f64_mul(two_c, load64(&f + i * 8))));
    }
    # Unit, so that a long path can feed k' back: a light guide left to drift was refused
    # by its own unit test after 1691 bounces.
    _c = _prt_unit(&o);
    var s[24];
    _c = _prt_s(k_in, normal, &s);
    _c = _prt_compose(step, k_in, &o, &s, FresnelAmplitudes_rs_re(&fa), FresnelAmplitudes_rs_im(&fa),
      FresnelAmplitudes_rp_re(&fa), FresnelAmplitudes_rp_im(&fa), f64_neg(F64_ONE));
    PrtStep_set_kx(step, load64(&o));
    PrtStep_set_ky(step, load64(&o + 8));
    PrtStep_set_kz(step, load64(&o + 16));
    PrtStep_set_flux(step, F64_ONE);
    PrtStep_set_reflectance(step, _prt_r_avg(&fa));
    return PK_ERR_NONE;
}

# A new hit, one block holding its three matrices; 0 on allocation failure.
fn _prt_hit_new(hit) {
    var h = alloc(sizeof(PrtTraceHit) + 3 * PRT_MATRIX_BYTES);
    if (h == 0) { return 0; }
    var at = h + sizeof(PrtTraceHit);
    PrtTraceHit_set_hit(h, hit);
    PrtTraceHit_set_surface_p(h, at);
    PrtTraceHit_set_total_p(h, at + PRT_MATRIX_BYTES);
    PrtTraceHit_set_total_q(h, at + 2 * PRT_MATRIX_BYTES);
    return h;
}

# Trace a ray through a `vec` of OpticalSurface as trace_sequential does, carrying Chipman's
# P and Q. Returns a `vec` of PrtTraceHit, or 0 with err_out set.
#
# mirrors is 0, or a `vec` as long as surfaces: an entry of 0 refracts at that surface, and a
# ComplexMedium reflects from it, so complex_gold_550nm() makes a gold mirror of that surface
# and complex_dielectric(n, name) a surface that reflects with its true Fresnel coefficient,
# total internal reflection included. A mirror keeps the ray in its medium, so the surface's
# n_after is not read. The surface's shape and aperture are, as ever.
#
# PK_ERR_TIR ends a path at a surface that refracts, as in trace_sequential: name it in
# mirrors to follow the reflected ray.
#must_use
fn trace_sequential_prt(initial_ray, surfaces, mirrors, err_out) {
    _prk_trace("trace_sequential_prt");
    store64(err_out, PK_ERR_NONE);
    if ((initial_ray == 0) | (surfaces == 0)) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var count = vec_len(surfaces);
    if (mirrors != 0) {
        if (vec_len(mirrors) != count) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
    }
    var step = prt_step_new();
    var acc_p = prt_new();
    var acc_q = prt_new();
    var results = vec_new();
    if ((step == 0) | (acc_p == 0) | (acc_q == 0) | (results == 0)) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    var current = initial_ray;
    var flux = F64_ONE;
    var i = 0;
    while (i < count) {
        var surface = vec_get(surfaces, i);
        var mirror = 0;
        if (mirrors != 0) { mirror = vec_get(mirrors, i); }
        var he = 0;
        var hit = 0;
        if (mirror == 0) {
            hit = trace_surface(current, surface, &he);
        } else {
            if (surface == 0) {
                store64(err_out, PK_ERR_INVALID_PARAMETER);
                return 0;
            }
            # The geometry of this surface without its refraction: a copy whose n_after is the
            # ray's own passes the ray straight through, and the hit keeps nothing of it.
            var plain[40];
            for (var w = 0; w < 5; w = w + 1) { store64(&plain + w * 8, load64(surface + w * 8)); }
            OpticalSurface_set_n_after(&plain, TraceRay_n(current));
            hit = trace_surface(current, &plain, &he);
        }
        if (prakash_is_err(he) == 1) {
            store64(err_out, he);
            return 0;
        }
        var kd = TraceRay_dir(current);
        var nrm = TraceHit_normal(hit);
        var e = 0;
        if (mirror == 0) {
            e = prt_refract(kd, nrm, TraceRay_n(current), OpticalSurface_n_after(surface), step);
        } else {
            e = prt_reflect(kd, nrm, TraceRay_n(current), ComplexMedium_n(mirror), ComplexMedium_k(mirror), step);
        }
        if (e != PK_ERR_NONE) {
            store64(err_out, e);
            return 0;
        }
        # The path carries the step's own k', so that P k = k' runs unbroken along it.
        var after = TraceHit_ray_after(hit);
        var ad = TraceRay_dir(after);
        RayVec3_set_x(ad, PrtStep_kx(step));
        RayVec3_set_y(ad, PrtStep_ky(step));
        RayVec3_set_z(ad, PrtStep_kz(step));
        if (mirror != 0) { TraceHit_set_reflectance(hit, PrtStep_reflectance(step)); }
        var ph = _prt_hit_new(hit);
        if (ph == 0) {
            store64(err_out, PK_ERR_ALLOCATION);
            return 0;
        }
        for (var m = 0; m < 18; m = m + 1) {
            store64(PrtTraceHit_surface_p(ph) + m * 8, load64(PrtStep_p(step) + m * 8));
        }
        var _p = prt_multiply(PrtStep_p(step), acc_p, acc_p);
        _p = prt_multiply(PrtStep_q(step), acc_q, acc_q);
        for (var c = 0; c < 18; c = c + 1) {
            store64(PrtTraceHit_total_p(ph) + c * 8, load64(acc_p + c * 8));
            store64(PrtTraceHit_total_q(ph) + c * 8, load64(acc_q + c * 8));
        }
        flux = f64_mul(flux, PrtStep_flux(step));
        PrtTraceHit_set_flux(ph, flux);
        vec_push(results, ph);
        current = after;
        i = i + 1;
    }
    return results;
}

# Fraction of the power of a field e, transverse to the path's first direction k_in, that
# reaches this hit: flux |P e|^2/|e|^2. NaN for a null handle, a zero or non-finite field, or
# a field with a component along k_in, which no plane wave has.
#must_use
fn prt_transmittance(hit, k_in, e) {
    if ((hit == 0) | (e == 0)) { return _PRK_NAN; }
    if (_prt_unit_ok(k_in) == 0) { return _PRK_NAN; }
    var e2 = 0;
    var dr = 0;
    var di = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var r = load64(e + i * 16);
        var m = load64(e + i * 16 + 8);
        e2 = f64_add(e2, f64_add(f64_mul(r, r), f64_mul(m, m)));
        dr = f64_add(dr, f64_mul(r, load64(k_in + i * 8)));
        di = f64_add(di, f64_mul(m, load64(k_in + i * 8)));
    }
    if ((f64_gt(e2, 0) & f64_lt(e2, _PRK_INF)) == 0) { return _PRK_NAN; }
    var along = f64_add(f64_mul(dr, dr), f64_mul(di, di));
    if (f64_gt(along, f64_mul(e2, 0x3BB0000000000000)) == 1) { return _PRK_NAN; }    # 2^-68
    var o[48];
    var _a = prt_apply(PrtTraceHit_total_p(hit), e, &o);
    var o2 = 0;
    for (var n = 0; n < 6; n = n + 1) {
        o2 = f64_add(o2, f64_mul(load64(&o + n * 8), load64(&o + n * 8)));
    }
    return f64_mul(PrtTraceHit_flux(hit), f64_div(o2, e2));
}

# The 2x2 Jones matrix of a path, in the input frame: J = [u v]^T Q^T P [u v], for the right-
# handed transverse pair (u, v) that _prt_transverse builds on k_in. Geometry is gone: for a
# nonpolarizing path J is a phase times the identity (-1 for one ideal mirror). Writes j00,
# j01, j10, j11 as (re, im) pairs, 64 bytes, to out, which may be p or q. Returns PK_ERR_NONE,
# or PK_ERR_INVALID_PARAMETER for a null handle or non-unit k_in.
fn prt_jones(p, q, k_in, out) {
    if ((p == 0) | (q == 0) | (out == 0)) { return PK_ERR_INVALID_PARAMETER; }
    if (_prt_unit_ok(k_in) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var u[24];
    var v[24];
    var t[64];
    var _c = _prt_transverse(k_in, &u);
    _c = _prt_cross(k_in, &u, &v);
    for (var col = 0; col < 2; col = col + 1) {
        var a = &u;
        if (col == 1) { a = &v; }
        # P a, then Q^T of it: Q is real.
        var pa[48];
        for (var i = 0; i < 3; i = i + 1) {
            var re = 0;
            var im = 0;
            for (var j = 0; j < 3; j = j + 1) {
                var av = load64(a + j * 8);
                re = f64_add(re, f64_mul(load64(p + (i * 3 + j) * 8), av));
                im = f64_add(im, f64_mul(load64(p + 72 + (i * 3 + j) * 8), av));
            }
            store64(&pa + i * 16, re);
            store64(&pa + i * 16 + 8, im);
        }
        for (var row = 0; row < 2; row = row + 1) {
            var b = &u;
            if (row == 1) { b = &v; }
            var jr = 0;
            var ji = 0;
            for (var x = 0; x < 3; x = x + 1) {
                # (Q b)_x: b^T Q^T (P a) = (Q b).(P a).
                var w = 0;
                for (var y = 0; y < 3; y = y + 1) {
                    w = f64_add(w, f64_mul(load64(b + y * 8), load64(q + (x * 3 + y) * 8)));
                }
                jr = f64_add(jr, f64_mul(w, load64(&pa + x * 16)));
                ji = f64_add(ji, f64_mul(w, load64(&pa + x * 16 + 8)));
            }
            store64(&t + (row * 2 + col) * 16, jr);
            store64(&t + (row * 2 + col) * 16 + 8, ji);
        }
    }
    for (var n = 0; n < 8; n = n + 1) { store64(out + n * 8, load64(&t + n * 8)); }
    return PK_ERR_NONE;
}

# prt_jones, divided by its largest component m, written to m_out. S below is fourth order in
# the amplitudes, which overflow or vanish long before P does, and neither D nor retardance
# depends on scale: at 1e80 an overflow read 1.5708 rad on a path with no retardance at all.
# Returns PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER for a bad handle, or a J that is all zero
# or not finite.
fn _prt_jones_scaled(p, q, k_in, j, m_out) {
    var e = prt_jones(p, q, k_in, j);
    if (e != PK_ERR_NONE) { return e; }
    var m = 0;
    for (var i = 0; i < 8; i = i + 1) {
        var a = load64(j + i * 8) & _PRK_ABS;
        if (a >= _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
        if (f64_gt(a, m) == 1) { m = a; }
    }
    if (f64_gt(m, 0) == 0) { return PK_ERR_INVALID_PARAMETER; }
    for (var n = 0; n < 8; n = n + 1) { store64(j + n * 8, f64_div(load64(j + n * 8), m)); }
    store64(m_out, m);
    return PK_ERR_NONE;
}

# S = J^H J for a prt_jones matrix: s[0] = S00, s[1] = S11, (s[2], s[3]) = S01.
fn _prt_jhj(j, s) {
    var a2 = f64_add(f64_mul(load64(j), load64(j)), f64_mul(load64(j + 8), load64(j + 8)));
    var b2 = f64_add(f64_mul(load64(j + 16), load64(j + 16)), f64_mul(load64(j + 24), load64(j + 24)));
    var c2 = f64_add(f64_mul(load64(j + 32), load64(j + 32)), f64_mul(load64(j + 40), load64(j + 40)));
    var d2 = f64_add(f64_mul(load64(j + 48), load64(j + 48)), f64_mul(load64(j + 56), load64(j + 56)));
    store64(s, f64_add(a2, c2));
    store64(s + 8, f64_add(b2, d2));
    store64(s + 16, f64_add(
        f64_add(f64_mul(load64(j), load64(j + 16)), f64_mul(load64(j + 8), load64(j + 24))),
        f64_add(f64_mul(load64(j + 32), load64(j + 48)), f64_mul(load64(j + 40), load64(j + 56)))));
    store64(s + 24, f64_add(
        f64_sub(f64_mul(load64(j), load64(j + 24)), f64_mul(load64(j + 8), load64(j + 16))),
        f64_sub(f64_mul(load64(j + 32), load64(j + 56)), f64_mul(load64(j + 40), load64(j + 48)))));
    return 0;
}

# Diattenuation of a path: (L1^2 - L2^2)/(L1^2 + L2^2), L1 >= L2 the singular values of its
# Jones matrix, so 0 for no polarization dependence and 1 for a perfect polarizer. It is
# (T_max - T_min)/(T_max + T_min) over all input states. NaN for a null handle, a non-unit
# k_in, a J that is not finite, or a path that passes nothing: |J|^2 under 2^-80, where only
# rounding is left.
#must_use
fn prt_diattenuation(p, q, k_in) {
    var j[64];
    var m = 0;
    if (_prt_jones_scaled(p, q, k_in, &j, &m) != PK_ERR_NONE) { return _PRK_NAN; }
    var s[32];
    var _c = _prt_jhj(&j, &s);
    var tr = f64_add(load64(&s), load64(&s + 8));
    if (f64_gt(f64_mul(f64_mul(tr, m), m), _PRT_NOTHING) == 0) { return _PRK_NAN; }
    # The eigenvalues of S differ by sqrt((S00 - S11)^2 + 4|S01|^2), read off directly so that
    # a D near 0 is not the square root of a rounding error.
    var ds = f64_sub(load64(&s), load64(&s + 8));
    var o2 = f64_add(f64_mul(load64(&s + 16), load64(&s + 16)), f64_mul(load64(&s + 24), load64(&s + 24)));
    var d = f64_div(f64_sqrt(f64_add(f64_mul(ds, ds), f64_mul(f64_from(4), o2))), tr);
    if (f64_gt(d, F64_ONE) == 1) { return F64_ONE; }
    return d;
}

# Retardance of a path, in radians in [0, pi]: the phase between the eigenstates of the unitary
# part U of J = U H, H = sqrt(J^H J). 0 for a nonpolarizing path. See the module header for
# what it means on a reflection. NaN for a null handle, a non-unit k_in, a J that is not
# finite, or one whose smaller singular value is under about 2^-40: U is not defined at 0,
# and below that it is rounding. A long lossy path can get there: 200 bounces in a gold guide
# reach 1.3e-13, and NaN is right, the true value being unreadable a few dozen bounces on.
#must_use
fn prt_retardance(p, q, k_in) {
    var j[64];
    var m = 0;
    if (_prt_jones_scaled(p, q, k_in, &j, &m) != PK_ERR_NONE) { return _PRK_NAN; }
    var s[32];
    var _c = _prt_jhj(&j, &s);
    var j00r = load64(&j);
    var j00i = load64(&j + 8);
    var j01r = load64(&j + 16);
    var j01i = load64(&j + 24);
    var j10r = load64(&j + 32);
    var j10i = load64(&j + 40);
    var j11r = load64(&j + 48);
    var j11i = load64(&j + 56);
    var dr = f64_sub(f64_sub(f64_mul(j00r, j11r), f64_mul(j00i, j11i)), f64_sub(f64_mul(j01r, j10r),
        f64_mul(j01i, j10i)));
    var di = f64_sub(f64_add(f64_mul(j00r, j11i), f64_mul(j00i, j11r)), f64_add(f64_mul(j01r, j10i),
        f64_mul(j01i, j10r)));
    var d = ganita_f64_hypot(dr, di);
    # d = L1 L2 and tr = L1^2 + L2^2, so d^2/tr is L2^2 to first order. The noise here is
    # absolute (see _PRT_NOTHING): a test relative to L1 let a zero L2 through at L1 = 1e-5,
    # as a retardance of 2.14 rad made from rounding.
    var tr = f64_add(load64(&s), load64(&s + 8));
    if (f64_gt(f64_mul(f64_mul(tr, m), m), _PRT_NOTHING) == 0) { return _PRK_NAN; }
    if (f64_gt(f64_mul(f64_mul(f64_div(f64_mul(d, d), tr), m), m), _PRT_NOTHING) == 0) { return _PRK_NAN; }
    # sqrt(S) = (S + d I)/tau by Cayley-Hamilton, so U = J adj(S + d I)/(d tau), and the
    # common scale drops out of the angle below. V = U (d tau).
    var a00 = f64_add(load64(&s), d);
    var a11 = f64_add(load64(&s + 8), d);
    var or = load64(&s + 16);
    var oi = load64(&s + 24);
    # V00 = J00 a11 - J01 conj(S01),  V01 = J01 a00 - J00 S01
    var v00r = f64_sub(f64_mul(j00r, a11), f64_add(f64_mul(j01r, or), f64_mul(j01i, oi)));
    var v00i = f64_sub(f64_mul(j00i, a11), f64_sub(f64_mul(j01i, or), f64_mul(j01r, oi)));
    var v01r = f64_sub(f64_mul(j01r, a00), f64_sub(f64_mul(j00r, or), f64_mul(j00i, oi)));
    var v01i = f64_sub(f64_mul(j01i, a00), f64_add(f64_mul(j00r, oi), f64_mul(j00i, or)));
    # V10 = J10 a11 - J11 conj(S01),  V11 = J11 a00 - J10 S01
    var v10r = f64_sub(f64_mul(j10r, a11), f64_add(f64_mul(j11r, or), f64_mul(j11i, oi)));
    var v10i = f64_sub(f64_mul(j10i, a11), f64_sub(f64_mul(j11i, or), f64_mul(j11r, oi)));
    var v11r = f64_sub(f64_mul(j11r, a00), f64_sub(f64_mul(j10r, or), f64_mul(j10i, oi)));
    var v11i = f64_sub(f64_mul(j11i, a00), f64_add(f64_mul(j10r, oi), f64_mul(j10i, or)));
    # U = e^(i phi)(cos(d/2) I + i sin(d/2) n.sigma): |tr U|^2/4 = cos^2(d/2), and the
    # traceless part has |.|_F^2/2 = sin^2(d/2). atan2 keeps both ends of [0, pi] accurate,
    # where an acos of the trace would lose half the digits near 0.
    var tr_r = f64_add(v00r, v11r);
    var tr_i = f64_add(v00i, v11i);
    var cos2 = f64_mul(0x3FD0000000000000, f64_add(f64_mul(tr_r, tr_r), f64_mul(tr_i, tr_i)));
    var hr = f64_sub(v00r, v11r);
    var hi = f64_sub(v00i, v11i);
    var sin2 = f64_mul(F64_HALF, f64_add(
        f64_mul(F64_HALF, f64_add(f64_mul(hr, hr), f64_mul(hi, hi))),
        f64_add(f64_add(f64_mul(v01r, v01r), f64_mul(v01i, v01i)), f64_add(f64_mul(v10r, v10r), f64_mul(v10i, v10i)))));
    return f64_mul(F64_TWO, ganita_f64_atan2(f64_sqrt(sin2), f64_sqrt(cos2)));
}
