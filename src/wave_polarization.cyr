# wave_polarization.cyr -- Stokes constructors, Mueller matrices, birefringence
# Usage: include "lib/wave_polarization.cyr"  (requires error.cyr, wave_core.cyr)
#
# Ported from the Rust `wave/polarization.rs`. StokesVector (struct + new +
# degree_of_polarization) lives in wave_core.cyr; this module adds its
# constructors and angle helpers, plus MuellerMatrix and BirefringentMaterial.
# A Mueller matrix is a 128-byte buffer of 16 f64 in row-major order: element
# (i, j) at byte offset (i*4 + j)*8.

fn _wp_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _wp_eps15() { return f64_div(F64_ONE, f64_from(1000000000000000)); }

# ── Stokes vector constructors & angles ────────

#must_use
fn stokes_unpolarized(intensity) { return stokes_new(intensity, f64_from(0), f64_from(0), f64_from(0)); }
#must_use
fn stokes_horizontal(intensity) { return stokes_new(intensity, intensity, f64_from(0), f64_from(0)); }
#must_use
fn stokes_vertical(intensity) { return stokes_new(intensity, f64_neg(intensity), f64_from(0), f64_from(0)); }
#must_use
fn stokes_diagonal_plus(intensity) { return stokes_new(intensity, f64_from(0), intensity, f64_from(0)); }
#must_use
fn stokes_diagonal_minus(intensity) { return stokes_new(intensity, f64_from(0), f64_neg(intensity), f64_from(0)); }
#must_use
fn stokes_circular_right(intensity) { return stokes_new(intensity, f64_from(0), f64_from(0), intensity); }
#must_use
fn stokes_circular_left(intensity) { return stokes_new(intensity, f64_from(0), f64_from(0), f64_neg(intensity)); }

# Total intensity (S0).
#must_use
fn stokes_intensity(s) { return StokesVector_s0(s); }

# Ellipticity angle chi: 0.5 * atan2(S3, sqrt(S1^2 + S2^2)); 0 for zero vector.
#must_use
fn stokes_ellipticity_angle(s) {
    var s1 = StokesVector_s1(s);
    var s2 = StokesVector_s2(s);
    var s3 = StokesVector_s3(s);
    var linear_part = f64_sqrt(f64_add(f64_mul(s1, s1), f64_mul(s2, s2)));
    if (f64_lt(linear_part, _wp_eps15()) == 1) {
        if (f64_lt(f64_abs(s3), _wp_eps15()) == 1) {
            return f64_from(0);
        }
    }
    return f64_mul(F64_HALF, ganita_f64_atan2(s3, linear_part));
}

# Orientation angle psi: 0.5 * atan2(S2, S1).
#must_use
fn stokes_orientation_angle(s) {
    return f64_mul(F64_HALF, ganita_f64_atan2(StokesVector_s2(s), StokesVector_s1(s)));
}

# ── Mueller matrices (4x4, row-major flat 16-f64 buffer) ────────

# Element accessors: (i, j) at offset (i*4 + j)*8.
fn mueller_get(m, i, j) { return load64(m + (i * 4 + j) * 8); }
fn mueller_set(m, i, j, v) { store64(m + (i * 4 + j) * 8, v); return 0; }

# Build a Mueller matrix from 16 row-major elements.
fn _mm(m00, m01, m02, m03, m10, m11, m12, m13, m20, m21, m22, m23, m30, m31, m32, m33) {
    var m = alloc(128);
    store64(m + 0, m00);
    store64(m + 8, m01);
    store64(m + 16, m02);
    store64(m + 24, m03);
    store64(m + 32, m10);
    store64(m + 40, m11);
    store64(m + 48, m12);
    store64(m + 56, m13);
    store64(m + 64, m20);
    store64(m + 72, m21);
    store64(m + 80, m22);
    store64(m + 88, m23);
    store64(m + 96, m30);
    store64(m + 104, m31);
    store64(m + 112, m32);
    store64(m + 120, m33);
    return m;
}

#must_use
fn mueller_identity() {
    return _mm(
    F64_ONE, f64_from(0), f64_from(0), f64_from(0),
    f64_from(0), F64_ONE, f64_from(0), f64_from(0),
    f64_from(0), f64_from(0), F64_ONE, f64_from(0),
    f64_from(0), f64_from(0), f64_from(0), F64_ONE);
}

#must_use
fn mueller_polarizer_horizontal() {
    return _mm(
    F64_HALF, F64_HALF, f64_from(0), f64_from(0),
    F64_HALF, F64_HALF, f64_from(0), f64_from(0),
    f64_from(0), f64_from(0), f64_from(0), f64_from(0),
    f64_from(0), f64_from(0), f64_from(0), f64_from(0));
}

#must_use
fn mueller_polarizer_vertical() {
    return _mm(
    F64_HALF, f64_neg(F64_HALF), f64_from(0), f64_from(0),
    f64_neg(F64_HALF), F64_HALF, f64_from(0), f64_from(0),
    f64_from(0), f64_from(0), f64_from(0), f64_from(0),
    f64_from(0), f64_from(0), f64_from(0), f64_from(0));
}

# Linear polarizer at angle theta.
#must_use
fn mueller_polarizer(angle) {
    var two_a = f64_mul(F64_TWO, angle);
    var s2 = f64_sin(two_a);
    var c2 = f64_cos(two_a);
    var cs = f64_mul(c2, s2);
    return _mm(
    F64_HALF, f64_mul(F64_HALF, c2), f64_mul(F64_HALF, s2), f64_from(0),
    f64_mul(F64_HALF, c2), f64_mul(f64_mul(F64_HALF, c2), c2), f64_mul(F64_HALF, cs), f64_from(0),
    f64_mul(F64_HALF, s2), f64_mul(F64_HALF, cs), f64_mul(f64_mul(F64_HALF, s2), s2), f64_from(0),
    f64_from(0), f64_from(0), f64_from(0), f64_from(0));
}

#must_use
fn mueller_quarter_wave_horizontal() {
    return _mm(
    F64_ONE, f64_from(0), f64_from(0), f64_from(0),
    f64_from(0), F64_ONE, f64_from(0), f64_from(0),
    f64_from(0), f64_from(0), f64_from(0), F64_ONE,
    f64_from(0), f64_from(0), f64_neg(F64_ONE), f64_from(0));
}

#must_use
fn mueller_half_wave_horizontal() {
    return _mm(
    F64_ONE, f64_from(0), f64_from(0), f64_from(0),
    f64_from(0), F64_ONE, f64_from(0), f64_from(0),
    f64_from(0), f64_from(0), f64_neg(F64_ONE), f64_from(0),
    f64_from(0), f64_from(0), f64_from(0), f64_neg(F64_ONE));
}

# General linear retarder, fast axis horizontal, retardance delta.
#must_use
fn mueller_retarder(retardance) {
    var c = f64_cos(retardance);
    var s = f64_sin(retardance);
    return _mm(
    F64_ONE, f64_from(0), f64_from(0), f64_from(0),
    f64_from(0), F64_ONE, f64_from(0), f64_from(0),
    f64_from(0), f64_from(0), c, s,
    f64_from(0), f64_from(0), f64_neg(s), c);
}

# Reference-frame rotation by angle.
#must_use
fn mueller_rotation(angle) {
    var two_a = f64_mul(F64_TWO, angle);
    var s2 = f64_sin(two_a);
    var c2 = f64_cos(two_a);
    return _mm(
    F64_ONE, f64_from(0), f64_from(0), f64_from(0),
    f64_from(0), c2, s2, f64_from(0),
    f64_from(0), f64_neg(s2), c2, f64_from(0),
    f64_from(0), f64_from(0), f64_from(0), F64_ONE);
}

# Row i of m dotted with the 4-vector [v0,v1,v2,v3].
fn _mm_row_dot(m, i, v0, v1, v2, v3) {
    return f64_add(f64_add(f64_add(
    f64_mul(mueller_get(m, i, 0), v0),
    f64_mul(mueller_get(m, i, 1), v1)),
    f64_mul(mueller_get(m, i, 2), v2)),
    f64_mul(mueller_get(m, i, 3), v3));
}

# Apply a Mueller matrix to a Stokes vector.
#must_use
fn mueller_apply(m, s) {
    var s0 = StokesVector_s0(s);
    var s1 = StokesVector_s1(s);
    var s2 = StokesVector_s2(s);
    var s3 = StokesVector_s3(s);
    return stokes_new(
    _mm_row_dot(m, 0, s0, s1, s2, s3),
    _mm_row_dot(m, 1, s0, s1, s2, s3),
    _mm_row_dot(m, 2, s0, s1, s2, s3),
    _mm_row_dot(m, 3, s0, s1, s2, s3));
}

# Multiply two Mueller matrices: a * b (apply b first, then a).
#must_use
fn mueller_multiply(a, b) {
    var r = alloc(128);
    var i = 0;
    while (i < 4) {
        var j = 0;
        while (j < 4) {
            var sum = f64_add(f64_add(f64_add(
            f64_mul(mueller_get(a, i, 0), mueller_get(b, 0, j)),
            f64_mul(mueller_get(a, i, 1), mueller_get(b, 1, j))),
            f64_mul(mueller_get(a, i, 2), mueller_get(b, 2, j))),
            f64_mul(mueller_get(a, i, 3), mueller_get(b, 3, j)));
            mueller_set(r, i, j, sum);
            j = j + 1;
        }
        i = i + 1;
    }
    return r;
}

# Apply a `vec` of Mueller matrices to a Stokes vector, first to last.
#must_use
fn mueller_chain(stokes, elements) {
    var s = stokes;
    var i = 0;
    while (i < vec_len(elements)) {
        s = mueller_apply(vec_get(elements, i), s);
        i = i + 1;
    }
    return s;
}

# ── Birefringence ────────

# { n_o (ordinary), n_e (extraordinary), name }.
#derive(accessors)
struct BirefringentMaterial { n_o; n_e; name; }

fn _biref_mk(n_o, n_e, name) {
    var b = alloc(sizeof(BirefringentMaterial));
    BirefringentMaterial_set_n_o(b, n_o);
    BirefringentMaterial_set_n_e(b, n_e);
    BirefringentMaterial_set_name(b, name);
    return b;
}

#must_use
fn biref_calcite() { return _biref_mk(_wp_r(16584, 10000), _wp_r(14864, 10000), "calcite"); }
#must_use
fn biref_quartz() { return _biref_mk(_wp_r(15443, 10000), _wp_r(15534, 10000), "quartz"); }
#must_use
fn biref_rutile() { return _biref_mk(_wp_r(2616, 1000), _wp_r(2903, 1000), "rutile"); }
#must_use
fn biref_mica() { return _biref_mk(_wp_r(15601, 10000), _wp_r(15936, 10000), "mica"); }

# Birefringence: delta_n = n_e - n_o.
#must_use
fn biref_birefringence(mat) {
    return f64_sub(BirefringentMaterial_n_e(mat), BirefringentMaterial_n_o(mat));
}

# Phase retardation: 2*pi * d * |delta_n| / lambda.
#must_use
fn biref_retardation(mat, thickness, wavelength) {
    return f64_div(f64_mul(f64_mul(F64_TAU, thickness), f64_abs(biref_birefringence(mat))), wavelength);
}

# Quarter-wave-plate thickness: lambda / (4*|delta_n|).
#must_use
fn biref_quarter_wave_thickness(mat, wavelength) {
    return f64_div(wavelength, f64_mul(f64_from(4), f64_abs(biref_birefringence(mat))));
}

# Half-wave-plate thickness: lambda / (2*|delta_n|).
#must_use
fn biref_half_wave_thickness(mat, wavelength) {
    return f64_div(wavelength, f64_mul(F64_TWO, f64_abs(biref_birefringence(mat))));
}

# Mueller matrix for this material at a thickness and wavelength (fast axis horizontal).
#must_use
fn biref_to_mueller(mat, thickness, wavelength) {
    return mueller_retarder(biref_retardation(mat, thickness, wavelength));
}
