# wave_airy.cyr -- circular-aperture diffraction: Bessel J1, Airy, Rayleigh
# Usage: include "lib/wave_airy.cyr"
#
# Ported from the Rust `wave/airy.rs`. bessel_j1 uses the Abramowitz & Stegun
# rational approximation (|x| < 8) and the asymptotic expansion (|x| >= 8);
# all coefficients are exact ratios of the Rust literals. FRAC_2_PI (2/pi) is the
# exact IEEE-754 hex bit pattern.

fn _ar(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# First-order Bessel function J1(x), accurate to ~1e-7.
#must_use
fn bessel_j1(x) {
    var ax = f64_abs(x);
    if (f64_lt(ax, f64_from(8)) == 1) {
        var y = f64_mul(x, x);
        # num = x * (N0 + y*(N1 + y*(N2 + y*(N3 + y*(N4 + y*N5)))))
        var t = f64_neg(_ar(3016036606, 100000000));                # -30.16036606
        t = f64_add(_ar(1570448260, 100000), f64_mul(y, t));        # 15704.48260
        t = f64_add(f64_neg(_ar(2972611439, 1000)), f64_mul(y, t)); # -2972611.439
        t = f64_add(_ar(2423968531, 10), f64_mul(y, t));            # 242396853.1
        t = f64_add(f64_neg(f64_from(7895059235)), f64_mul(y, t));  # -7895059235
        t = f64_add(f64_from(72362614232), f64_mul(y, t));          # 72362614232
        var num = f64_mul(x, t);
        # den = D0 + y*(D1 + y*(D2 + y*(D3 + y*(D4 + y))))
        var u = f64_add(_ar(3769991397, 10000000), y);              # 376.9991397 + y
        u = f64_add(_ar(9944743394, 100000), f64_mul(y, u));        # 99447.43394
        u = f64_add(_ar(1858330474, 100), f64_mul(y, u));           # 18583304.74
        u = f64_add(f64_from(2300535178), f64_mul(y, u));           # 2300535178
        var den = f64_add(f64_from(144725228442), f64_mul(y, u));   # 144725228442
        return f64_div(num, den);
    }
    var z = f64_div(f64_from(8), ax);
    var z2 = f64_mul(z, z);
    var theta = f64_sub(ax, _ar(23561944902, 10000000000));         # ax - 3*pi/4
    # p1 = 1 + z2*(P0 + z2*(P1 + z2*(P2 + z2*P3)))
    var p = f64_neg(_ar(240337019, 1000000000000000));              # -0.240337019e-6
    p = f64_add(_ar(2457520174, 1000000000000000), f64_mul(z2, p)); # 0.2457520174e-5
    p = f64_add(f64_neg(_ar(3516396496, 100000000000000)), f64_mul(z2, p)); # -0.3516396496e-4
    p = f64_add(_ar(183105, 100000000), f64_mul(z2, p));            # 0.183105e-2
    var p1 = f64_add(F64_ONE, f64_mul(z2, p));
    # q1 = Q0 + z2*(Q1 + z2*(Q2 + z2*(Q3 + z2*Q4)))
    var q = _ar(105787412, 1000000000000000);                       # 0.105787412e-6
    q = f64_add(f64_neg(_ar(88228987, 100000000000000)), f64_mul(z2, q)); # -0.88228987e-6
    q = f64_add(_ar(8449199096, 1000000000000000), f64_mul(z2, q)); # 0.8449199096e-5
    q = f64_add(f64_neg(_ar(2002690873, 10000000000000)), f64_mul(z2, q)); # -0.2002690873e-3
    var q1 = f64_add(_ar(4687499995, 100000000000), f64_mul(z2, q)); # 0.04687499995
    var term1 = f64_mul(f64_cos(theta), p1);
    var term2 = f64_mul(f64_mul(z, f64_sin(theta)), q1);
    var result = f64_mul(f64_sqrt(f64_div(0x3FE45F306DC9C883, ax)), f64_sub(term1, term2));
    if (f64_lt(x, f64_from(0)) == 1) {
        return f64_neg(result);
    }
    return result;
}

# Airy diffraction intensity: I0 * (2*J1(x)/x)^2, x = pi*D*sin(theta)/lambda.
#must_use
fn airy_pattern(wavelength, aperture_diameter, angle, i0) {
    var x = f64_div(f64_mul(f64_mul(F64_PI, aperture_diameter), f64_sin(angle)), wavelength);
    if (f64_lt(f64_abs(x), _ar(1, 10000000000)) == 1) {
        return i0;
    }
    var jinc = f64_div(f64_mul(F64_TWO, bessel_j1(x)), x);
    return f64_mul(f64_mul(i0, jinc), jinc);
}

# Angular radius of the first Airy dark ring: 1.2196705 * lambda / D.
#must_use
fn airy_first_zero(wavelength, aperture_diameter) {
    return f64_div(f64_mul(_ar(12196705, 10000000), wavelength), aperture_diameter);
}

# Rayleigh resolution criterion: 1.22 * lambda / D.
#must_use
fn rayleigh_criterion(wavelength, aperture_diameter) {
    return f64_div(f64_mul(_ar(122, 100), wavelength), aperture_diameter);
}
