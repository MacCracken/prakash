# error.cyr -- prakash error codes
# Usage: include "lib/error.cyr"
#
# Replaces Rust's PrakashError enum with integer error codes. Functions return
# PK_ERR_NONE (0) on success or a negative PK_ERR_* code on failure. Where a
# function also returns an f64 result, it takes an `err_out` pointer and writes
# the code there. Detailed failure context (angles, indices) is logged via
# sakshi at the failure site rather than carried in the return value.
#
# Pairs with tagged.cyr for Result-like patterns when an Option is needed.

var PK_ERR_NONE                  = 0;

# Total internal reflection — incident angle exceeds the critical angle.
var PK_ERR_TIR               = (0 - 1);
# Refractive index is below the physical minimum of 1.0.
var PK_ERR_INVALID_INDEX     = (0 - 2);
# Wavelength is outside the visible range (380-780 nm).
var PK_ERR_WAVELENGTH_RANGE  = (0 - 3);
# Angle is outside the valid range (0-90 deg) for a surface interaction.
var PK_ERR_INVALID_ANGLE     = (0 - 4);
# Negative focal length where a positive one is required.
var PK_ERR_INVALID_FOCAL     = (0 - 5);
# Division by zero in an optical calculation.
var PK_ERR_DIVISION_BY_ZERO  = (0 - 6);
# A parameter is outside the valid range for the operation. Also covers an
# out-of-range buffer index and a null handle passed to an accessor.
var PK_ERR_INVALID_PARAMETER = (0 - 7);
# An allocation was refused — the request exceeds ALLOC_MAX (2 GiB), the size
# computation overflowed, or the heap is exhausted. Distinct from
# PK_ERR_INVALID_PARAMETER: the arguments were sane, the memory was not there.
var PK_ERR_ALLOCATION        = (0 - 8);
# The input bytes are not well-formed JSON, or the document is not of the type
# the decoder expected (e.g. an array where an object was required). Distinct
# from PK_ERR_INVALID_PARAMETER, which means the document parsed but a required
# field was absent or of the wrong type — bad bytes vs. wrong schema.
var PK_ERR_PARSE             = (0 - 9);

# 1 if `code` is an error (negative), else 0.
#must_use
fn prakash_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# 1 if `code` is success (PK_ERR_NONE), else 0.
#must_use
fn prakash_is_ok(code) {
    if (code == 0) { return 1; }
    return 0;
}

# ── Rust-semantics math shims ────────
# The Cyrius math builtins diverge from Rust's f64 methods at the infinite and
# zero boundaries. Every ported call site that can reach those boundaries goes
# through these shims so the port keeps matching the Rust original (retrievable
# at tag 2.2.2 / 1.2.0 — see CONTRIBUTING.md).
#
# ⚠ RE-MEASURED FOR cyrius 6.5.33 / ganita 1.1.4 (2.2.4). The previous table
# here was stamped "Measured on cyrius 6.5.20" and ONE OF ITS ROWS HAD GONE
# FALSE: ganita 1.1.4 gained an explicit domain prologue, so a zero base no
# longer falls into exp(n*ln(base)) and no longer returns NaN. No test caught
# it — all 5485 assertions passed either side of the bump — because the shim
# masks the builtin at exactly the point the table describes.
#
# Measured on cyrius 6.5.33, x86_64 (raw f64 bits, this host):
#
#   expression              Cyrius builtin      Rust    shim
#   ganita_f64_pow(0.0, 2)  0.0  (was NaN)      0.0     0.0
#   ganita_f64_pow(0.0, 0)  1.0  (was NaN)      1.0     1.0
#   ganita_f64_pow(0.0,-1)  +inf (was NaN)      +inf    +inf
#   f64_exp(-inf)           NaN                 0.0     0.0
#   f64_exp(+inf)           NaN                 +inf    +inf
#
# So the three pow rows now agree with Rust WITHOUT the shim; the two f64_exp
# rows are the ones still doing work (f64_exp is a compiler intrinsic and was
# untouched by the ganita change — verified, not assumed).
#
# Finite arguments are delegated unchanged, so no in-range result moves.

# Rust `f64::exp` semantics. Only the infinite arguments are special-cased;
# NaN in still gives NaN out, matching Rust.
#must_use
fn _prk_exp(x) {
    if (x == 0x7FF0000000000000) { return 0x7FF0000000000000; }
    if (x == 0xFFF0000000000000) { return 0; }
    return f64_exp(x);
}

# Sine/cosine with an explicit domain guard. The x86 `fsin`/`fcos` instructions
# are undefined for |x| >= 2^63 and return the ARGUMENT UNCHANGED there, so
# `f64_sin(1e300)` yields 1e300 — an "intensity" far outside [-1, 1] that then
# propagates silently through an interference or slit calculation. Measured on
# cyrius 6.5.33 (re-measured for 2.2.4, unchanged from 6.5.20): correct through
# 2^62, broken at 1e300 — where f64_sin returns the ARGUMENT, 0x7E37E43C8800759C
# in and 0x7E37E43C8800759C out — and NaN at the infinities.
#
# Beyond 2^63 a double's spacing exceeds 2048 while a period is 2*pi, so the
# argument no longer identifies a phase at all and the result is unrecoverable
# without Payne-Hanek reduction. prakash reports the loss instead of inventing a
# value: these return NaN, which propagates visibly. (Rust's libm would perform
# the full reduction and return a value; this is a deliberate, documented
# divergence in favour of not fabricating.) Below the limit both delegate
# unchanged, so no in-range result moves.
var _PRK_TRIG_LIMIT = 0x43E0000000000000;   # 2^63
var _PRK_NAN        = 0x7FF8000000000000;

#must_use
fn _prk_sin(x) {
    if (f64_lt(f64_abs(x), _PRK_TRIG_LIMIT) == 0) { return _PRK_NAN; }
    return f64_sin(x);
}

#must_use
fn _prk_cos(x) {
    if (f64_lt(f64_abs(x), _PRK_TRIG_LIMIT) == 0) { return _PRK_NAN; }
    return f64_cos(x);
}

# Rust `f64::powf` semantics for a non-negative base.
#
# ⚠ THE REASON THIS SHIM EXISTS WAS RETIRED UPSTREAM IN 2.2.4, AND IT IS KEPT
# ANYWAY. It was written because `ganita_f64_pow` was literally
# `exp(exp * ln(base))`, so a zero base gave exp(-inf) = NaN where Rust gives
# 0.0 / 1.0 / +inf. ganita 1.1.4 (cyrius 6.5.33) added an explicit domain
# prologue and now returns those three values itself — measured, this host:
# pow(0,2) = 0x0, pow(0,0) = 0x3FF0000000000000, pow(0,-1) = 0x7FF0000000000000,
# bit-for-bit what the branch below produces. The branch is therefore redundant
# for every non-NaN exponent, and is retained deliberately as a pin: a silent
# revert upstream would otherwise move published optics values with nothing
# watching for it.
#
# ⚠ A NEGATIVE BASE NO LONGER FAILS LOUDLY. Until 6.5.33 it was NaN for every
# exponent. ganita 1.1.4 special-cases an INTEGRAL exponent, taking the
# magnitude from exp(n*ln|base|) and applying the sign — so it inherits the
# transcendental round-off and is NOT exact where Rust is:
#   ganita_f64_pow(-2, 3) = 0xC01FFFFFFFFFFFFE  (-7.99999999999999982)
#   Rust      (-2f64).powf(3.0) = 0xC020000000000000  (exactly -8)
# A non-integral exponent is still NaN on both sides (verified control:
# pow(-2, 0.5) = NaN before and after). No prakash call site passes a negative
# base today, so nothing moves — but a future one would now silently break
# bit-fidelity instead of producing a NaN somebody would notice.
#
# ⚠ KNOWN LATENT DIVERGENCE, pre-existing and NOT introduced by 2.2.4:
# `_prk_pow(0.0, NaN)` returns 1.0 (a NaN exponent is neither > 0 nor < 0, so it
# falls through to the F64_ONE branch). The raw builtin returns 0.0. IEEE-754 /
# C99 pow — which Rust follows — says NaN for a base other than 1. All three
# disagree. It is unreachable from prakash today: every call site passes an
# exponent it computed itself. Fixing it is a behaviour change and belongs in
# its own release, not in a toolchain bump.
#must_use
fn _prk_pow(base, exp) {
    if (f64_abs(base) == 0) {
        if (f64_gt(exp, 0) == 1) { return 0; }
        if (f64_lt(exp, 0) == 1) { return 0x7FF0000000000000; }
        return F64_ONE;
    }
    return ganita_f64_pow(base, exp);
}

# ── Logging (sakshi) ────────
# Ports the Rust `tracing::trace!` diagnostics. Consumers set the level with
# prakash_set_log_level(SK_TRACE) to see operation-entry traces; the default
# (SK_INFO) leaves them off. `_prk_trace` is a thin wrapper the optics modules
# call at operation entry — sakshi_trace is compile-elidable (#if SAKSHI_LEVEL)
# and runtime-guarded, so it is near-free when trace is disabled.

# Set the global log level (SK_OFF/ERROR/WARN/INFO/DEBUG/TRACE from sakshi).
fn prakash_set_log_level(level) {
    return sakshi_set_level(level);
}

# Emit a TRACE-level operation marker (the Rust trace!("op") equivalent).
fn _prk_trace(name) {
    sakshi_trace(name, strlen(name));
    return 0;
}
