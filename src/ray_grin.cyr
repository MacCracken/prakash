# ray_grin.cyr -- gradient-index (GRIN) optics: ray tracing through a continuously
# varying refractive index
# Usage: include "lib/ray_grin.cyr"  (requires error.cyr, ray_core.cyr, ray_trace.cyr)
#
# New in 2.8.0, and NOT a port: the Rust 1.x crate had no GRIN support, so every
# formula here is checked against the literature and closed-form trajectories,
# never against itself.
#
# THE RAY EQUATION. d/ds(n dr/ds) = grad n, written with Sharma, Kumar & Ghatak
# (Appl. Opt. 21, 984 (1982)) in the parameter t, dt = ds/n, and the optical
# direction vector T = n dr/ds:
#   d^2 R/dt^2 = D(R),   D = n grad n = grad(n^2)/2,   T = dR/dt,   |T| = n.
# It is integrated by their Runge-Kutta-Nystrom scheme (fourth order, three D
# evaluations per step — the one at the step's end is reused as the next step's
# first):
#   A = dt D(R),  B = dt D(R + (dt/2) T + (dt/8) A),  C = dt D(R + dt T + (dt/2) B)
#   R' = R + dt (T + (A + 2B)/6),   T' = T + (A + 4B + C)/6
# The optical path OPL = integral n ds = integral n^2 dt rides along with a
# two-point Hermite rule, dt/2 (f0 + f1) + dt^2/12 (f0' - f1') with f = n^2 and
# f' = 2 D.T — fourth order like the rays, and free: n^2 and D at both ends are
# already known.
#
# CONVENTIONS. Lengths in any ONE unit. Radial profiles are symmetric about the
# z axis; spherical ones about (0, 0, cz). The index is the index at ONE
# wavelength (a GRIN material's dispersion is the caller's).
#
# THE STEP is an arc length: each step covers at most `step` of the ray,
# dt = min(step/n(start), step/n(here)) — the cap keeps dt from growing where n
# falls towards 0 (2.8.0 review: a dt fixed at step/n(start) let a ray starting in
# low index run steps n_max/n_start times too long, and returned a NEGATIVE optical
# path as success). The global error is O(step^4) (tests/ray_grin.tcyr pins the
# order); a usable step is small against the profile's scale (step*g << 1 for a
# rod, step << R for a sphere). A step is re-taken at half the length, up to 40
# times, when a stage point has no index or the step is not a step of a ray — T
# turns by more than 0.5 rad, n^2 changes by more than 2x, or the optical path
# does not grow — a trace whose |T| has drifted 10% from n on the way stops at
# once, and one whose |T|^2/n^2 is more than 2e-3 from 1 at the end is refused
# rather than returned. That last check is RELATIVE TO THE INDEX AT THE END: drift
# made where n is large reads (n_max/n_end)^2 larger where the ray lands, so a
# trace landing in much lower index than it crossed needs a proportionally smaller
# step — and may be refused although its result would have been accurate (a
# refusal, never a wrong answer: rescaling the check by n_max let 0.29 rad
# direction errors through, 2.8.0 round 2). None of this is error control: within
# those bounds the error is the method's. Size max_steps to the path: for a ray
# that never arrives, the budget, not the ray, decides when it is refused.

fn _grin_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# 1 if x is finite (not NaN, not +-inf).
fn _grin_finite(x) {
    if ((x & _PRK_ABS) >= _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite and strictly positive. f64_gt is false for NaN.
fn _grin_pos(x) {
    if (f64_gt(x, 0) == 0) { return 0; }
    if (x == _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite and positive with x^2 a finite NORMAL number — a scale the
# profile formulas can square (n0, g, R). Past about 1.3e154 or below 1.5e-154
# the index is NaN everywhere (2.8.0 review), so such a profile is refused.
fn _grin_sq_ok(x) {
    if (_grin_pos(x) == 0) { return 0; }
    var q = f64_mul(x, x);
    if (q == _PRK_INF) { return 0; }
    if ((q & 0x7FF0000000000000) == 0) { return 0; }
    return 1;
}

# ── Profiles ────────

# Profile tags. The GrinProfile's a1..a6 and cz mean, per kind:
#   GRIN_SELFOC   n^2 = n0^2 [1 - (g r)^2 + h4 (g r)^4 + h6 (g r)^6]   a1 = g, a2 = h4, a3 = h6
#   GRIN_SECH     n = n0 sech(g r)                                     a1 = g
#   GRIN_POLY     n = n0 + nr2 r^2 + nr4 r^4 + nr6 r^6 + nz1 z + nz2 z^2 + nz3 z^3
#                                                  a1..a3 = nr2, nr4, nr6; a4..a6 = nz1, nz2, nz3
#   GRIN_LUNEBURG n^2 = n0^2 (2 - (rho/R)^2)                           a1 = R, cz
#   GRIN_FISHEYE  n = n0 / (1 + (rho/R)^2)                             a1 = R, cz
# with r = sqrt(x^2 + y^2) and rho the distance from (0, 0, cz).
var GRIN_SELFOC = 0;
var GRIN_SECH = 1;
var GRIN_POLY = 2;
var GRIN_LUNEBURG = 3;
var GRIN_FISHEYE = 4;

# A gradient-index profile; see the tags above for what a1..a6 and cz hold.
#derive(accessors)
struct GrinProfile { kind; n0; a1; a2; a3; a4; a5; a6; cz; }

fn _grin_mk(kind, n0, a1, a2, a3, a4, a5, a6, cz, err_out) {
    var p = alloc(sizeof(GrinProfile));
    if (p == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    GrinProfile_set_kind(p, kind);
    GrinProfile_set_n0(p, n0);
    GrinProfile_set_a1(p, a1);
    GrinProfile_set_a2(p, a2);
    GrinProfile_set_a3(p, a3);
    GrinProfile_set_a4(p, a4);
    GrinProfile_set_a5(p, a5);
    GrinProfile_set_a6(p, a6);
    GrinProfile_set_cz(p, cz);
    store64(err_out, PK_ERR_NONE);
    return p;
}

fn _grin_bad(err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return 0;
}

# A radial SELFOC-type rod, in the manufacturer's form
#   n^2(r) = n0^2 [1 - (g r)^2 + h4 (g r)^4 + h6 (g r)^6]
# (g the gradient constant, h4/h6 the higher-order coefficients; h4 = h6 = 0 is the
# parabolic-n^2 profile, whose rays are exactly harmonic in t, and h4 = 2/3,
# h6 = -17/45 matches n0 sech(g r) through sixth order). Paraxial pitch 2*pi/g.
# n0 and g finite and positive with finite normal squares, h4 and h6 finite; else
# PK_ERR_INVALID_PARAMETER and 0. PK_ERR_ALLOCATION and 0 if the struct cannot be allocated.
#must_use
fn grin_selfoc(n0, g, h4, h6, err_out) {
    if (_grin_sq_ok(n0) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(g) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(h4) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(h6) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(f64_mul(n0, g)) == 0) { return _grin_bad(err_out); }
    return _grin_mk(GRIN_SELFOC, n0, g, h4, h6, 0, 0, 0, 0, err_out);
}

# The hyperbolic-secant rod n(r) = n0 sech(g r): every MERIDIONAL ray is periodic
# with period 2*pi/g at any amplitude, sinh(g y) = C sin(g z + phi) — so a
# collimated meridional fan focuses exactly on axis at a quarter pitch. (Skew rays
# do not.) n0 and g finite and positive with finite normal squares; else
# PK_ERR_INVALID_PARAMETER and 0.
#must_use
fn grin_sech(n0, g, err_out) {
    if (_grin_sq_ok(n0) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(g) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(f64_mul(n0, g)) == 0) { return _grin_bad(err_out); }
    return _grin_mk(GRIN_SECH, n0, g, 0, 0, 0, 0, 0, 0, err_out);
}

# A radial-plus-axial polynomial profile (the form lens-design codes call
# "gradient 3"):
#   n = n0 + nr2 r^2 + nr4 r^4 + nr6 r^6 + nz1 z + nz2 z^2 + nz3 z^3
# with z the GLOBAL z (put the rod's front face at z = 0 to measure the axial
# terms from it). Axial GRIN is nr2 = nr4 = nr6 = 0. n0 finite and positive with a
# finite normal square, every coefficient finite; else PK_ERR_INVALID_PARAMETER and 0. Where n <= 0 there is no
# index: grin_index is NaN there. (A ray only approaches a zero of n: an oblique
# one turns back as a mirage, PK_ERR_TIR; one running head-on is refused,
# PK_ERR_INVALID_PARAMETER — see grin_trace_to_plane.)
#must_use
fn grin_polynomial(n0, nr2, nr4, nr6, nz1, nz2, nz3, err_out) {
    if (_grin_sq_ok(n0) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nr2) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nr4) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nr6) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nz1) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nz2) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nz3) == 0) { return _grin_bad(err_out); }
    return _grin_mk(GRIN_POLY, n0, nr2, nr4, nr6, nz1, nz2, nz3, 0, err_out);
}

# The Luneburg lens: a sphere of radius R about (0, 0, cz) with
#   n = n_surface * sqrt(2 - (rho/R)^2),
# n_surface at its rim, so in a medium of that index a collimated beam is focused
# perfectly on the far side of the sphere — every ray, at every height (Luneburg
# 1944). The LAW holds for rho < sqrt(2) R; the lens is the ball rho <= R, which
# is what grin_ball_trace traces. n_surface and R finite and positive with finite
# normal squares, cz finite; else PK_ERR_INVALID_PARAMETER and 0.
#must_use
fn grin_luneburg(n_surface, radius, cz, err_out) {
    if (_grin_sq_ok(n_surface) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(radius) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(cz) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(f64_div(n_surface, radius)) == 0) { return _grin_bad(err_out); }
    return _grin_mk(GRIN_LUNEBURG, n_surface, radius, 0, 0, 0, 0, 0, cz, err_out);
}

# Maxwell's fish-eye about (0, 0, cz): n = n0 / (1 + (rho/R)^2). Every ray is a
# circle, and every ray from a point P meets again at its inversion
# -R^2 P/|P|^2 (relative to the centre) — a point on the sphere rho = R images to
# its antipode, with optical path n0*pi*R/2 on every ray (Maxwell 1854). n0 and R
# finite and positive with finite normal squares, cz finite; else
# PK_ERR_INVALID_PARAMETER and 0.
#must_use
fn grin_maxwell_fisheye(n0, radius, cz, err_out) {
    if (_grin_sq_ok(n0) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(radius) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(cz) == 0) { return _grin_bad(err_out); }
    var nr = f64_div(n0, radius);
    if (_grin_sq_ok(nr) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(f64_mul(F64_TWO, f64_mul(nr, nr))) == 0) { return _grin_bad(err_out); }
    return _grin_mk(GRIN_FISHEYE, n0, radius, 0, 0, 0, 0, 0, cz, err_out);
}

# expm1(y) accurate for small |y| (Kahan: (e^y - 1) * y / ln(e^y) cancels the
# rounding of e^y). Only the sech profile needs it: 1 - e^(-2u) near the axis.
fn _grin_expm1(y) {
    var w = f64_exp(y);
    if (w == F64_ONE) { return y; }
    var wm = f64_sub(w, F64_ONE);
    if (f64_gt(f64_abs(y), F64_HALF) == 1) { return wm; }
    return f64_div(f64_mul(wm, y), f64_ln(w));
}

# D = grad(n^2)/2 and n^2 at (x, y, z) into out[0..3]. Returns 1, or 0 where the
# profile has no physical index: n^2 not finite and positive (SELFOC past its
# zero, a polynomial with n <= 0) or a non-finite gradient.
fn _grin_eval(p, x, y, z, out) {
    var kind = GrinProfile_kind(p);
    var n0 = GrinProfile_n0(p);
    var n02 = f64_mul(n0, n0);
    var n2 = 0;
    var dx = 0;
    var dy = 0;
    var dz = 0;
    if (kind == GRIN_SELFOC) {
        var g = GrinProfile_a1(p);
        var g2 = f64_mul(g, g);
        var h4 = GrinProfile_a2(p);
        var h6 = GrinProfile_a3(p);
        var u = f64_mul(g2, f64_add(f64_mul(x, x), f64_mul(y, y)));
        var poly = f64_add(f64_neg(F64_ONE), f64_mul(u, f64_add(h4, f64_mul(u, h6))));
        n2 = f64_mul(n02, f64_add(F64_ONE, f64_mul(u, poly)));
        var s = f64_mul(f64_mul(n02, g2),
          f64_add(f64_neg(F64_ONE), f64_mul(u, f64_add(f64_mul(F64_TWO, h4), f64_mul(f64_from(3), f64_mul(h6, u))))));
        dx = f64_mul(s, x);
        dy = f64_mul(s, y);
    }
    if (kind == GRIN_SECH) {
        var gs = GrinProfile_a1(p);
        var u2 = f64_mul(gs, f64_sqrt(f64_add(f64_mul(x, x), f64_mul(y, y))));
        var e = f64_exp(f64_mul(f64_from(0 - 2), u2));
        var op = f64_add(F64_ONE, e);
        n2 = f64_div(f64_mul(n02, f64_mul(f64_from(4), e)), f64_mul(op, op));
        # tanh(u)/u = (1 - e^(-2u)) / ((1 + e^(-2u)) u), 1 at u = 0.
        var tu = F64_ONE;
        if (f64_gt(u2, 0x3E50000000000000) == 1) {
            tu = f64_div(f64_neg(_grin_expm1(f64_mul(f64_from(0 - 2), u2))), f64_mul(op, u2));
        }
        var ss = f64_neg(f64_mul(f64_mul(n2, f64_mul(gs, gs)), tu));
        dx = f64_mul(ss, x);
        dy = f64_mul(ss, y);
    }
    if (kind == GRIN_POLY) {
        var r2 = f64_add(f64_mul(x, x), f64_mul(y, y));
        var a1 = GrinProfile_a1(p);
        var a2 = GrinProfile_a2(p);
        var a3 = GrinProfile_a3(p);
        var a4 = GrinProfile_a4(p);
        var a5 = GrinProfile_a5(p);
        var a6 = GrinProfile_a6(p);
        var nn = f64_add(f64_add(n0, f64_mul(r2, f64_add(a1, f64_mul(r2, f64_add(a2, f64_mul(r2, a3)))))),
          f64_mul(z, f64_add(a4, f64_mul(z, f64_add(a5, f64_mul(z, a6))))));
        if (f64_gt(nn, 0) == 0) { return 0; }
        n2 = f64_mul(nn, nn);
        var gr = f64_add(f64_mul(F64_TWO, a1),
          f64_mul(r2, f64_add(f64_mul(f64_from(4), a2), f64_mul(f64_from(6), f64_mul(a3, r2)))));
        var gz = f64_add(a4, f64_mul(z, f64_add(f64_mul(F64_TWO, a5), f64_mul(f64_from(3), f64_mul(a6, z)))));
        dx = f64_mul(f64_mul(nn, gr), x);
        dy = f64_mul(f64_mul(nn, gr), y);
        dz = f64_mul(nn, gz);
    }
    if (kind >= GRIN_LUNEBURG) {
        var rr = GrinProfile_a1(p);
        var rr2 = f64_mul(rr, rr);
        var zc = f64_sub(z, GrinProfile_cz(p));
        var rho2 = f64_div(f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(zc, zc)), rr2);
        var sl = 0;
        if (kind == GRIN_LUNEBURG) {
            n2 = f64_mul(n02, f64_sub(F64_TWO, rho2));
            sl = f64_neg(f64_div(n02, rr2));
        } else {
            # An unknown tag is not a fish-eye: no index (grin_* refuse it first).
            if (kind != GRIN_FISHEYE) { return 0; }
            var q = f64_add(F64_ONE, rho2);
            n2 = f64_div(n02, f64_mul(q, q));
            sl = f64_neg(f64_div(f64_mul(F64_TWO, n2), f64_mul(rr2, q)));
        }
        dx = f64_mul(sl, x);
        dy = f64_mul(sl, y);
        dz = f64_mul(sl, zc);
    }
    if (_grin_pos(n2) == 0) { return 0; }
    if (_grin_finite(f64_add(f64_add(dx, dy), dz)) == 0) { return 0; }
    store64(out, dx);
    store64(out + 8, dy);
    store64(out + 16, dz);
    store64(out + 24, n2);
    return 1;
}

# 1 if p is a profile handle with a known tag.
fn _grin_kind_ok(p) {
    if (p == 0) { return 0; }
    var k = GrinProfile_kind(p);
    if ((k < GRIN_SELFOC) | (k > GRIN_FISHEYE)) { return 0; }
    return 1;
}

# The index at (x, y, z), or NaN for a null profile, a non-finite coordinate, or a
# point where the profile has no physical index (see _grin_eval).
#must_use
fn grin_index(profile, x, y, z) {
    if (_grin_kind_ok(profile) == 0) { return _PRK_NAN; }
    if (_grin_finite(f64_add(f64_add(x, y), z)) == 0) { return _PRK_NAN; }
    var w[32];
    if (_grin_eval(profile, x, y, z, &w) == 0) { return _PRK_NAN; }
    return f64_sqrt(load64(&w + 24));
}

# grad n at (x, y, z) into out[0..2] (three f64). Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER for a null profile/out or a non-finite coordinate, or
# PK_ERR_INVALID_INDEX where the profile has no physical index; out is untouched on
# an error.
fn grin_gradient(profile, x, y, z, out) {
    if (_grin_kind_ok(profile) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_finite(f64_add(f64_add(x, y), z)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var w[32];
    if (_grin_eval(profile, x, y, z, &w) == 0) { return PK_ERR_INVALID_INDEX; }
    var n = f64_sqrt(load64(&w + 24));
    store64(out, f64_div(load64(&w), n));
    store64(out + 8, f64_div(load64(&w + 8), n));
    store64(out + 16, f64_div(load64(&w + 16), n));
    return PK_ERR_NONE;
}

# ── The integrator ────────
# A state is 10 f64: R (0..2), T (3..5), D(R) (6..8), n^2(R) (9).

# One Runge-Kutta-Nystrom step of dt from state s into state o. Returns 1, or 0 if
# any stage point has no physical index.
fn _grin_step(p, s, dt, o) {
    var w[32];
    var x = load64(s);
    var y = load64(s + 8);
    var z = load64(s + 16);
    var tx = load64(s + 24);
    var ty = load64(s + 32);
    var tz = load64(s + 40);
    var ax = load64(s + 48);
    var ay = load64(s + 56);
    var az = load64(s + 64);
    var hdt = f64_mul(F64_HALF, dt);
    var dt2 = f64_mul(dt, dt);
    var q8 = f64_mul(dt2, _grin_r(1, 8));
    # B point: R + (dt/2) T + (dt^2/8) D(R).
    var px = f64_add(f64_add(x, f64_mul(hdt, tx)), f64_mul(q8, ax));
    var py = f64_add(f64_add(y, f64_mul(hdt, ty)), f64_mul(q8, ay));
    var pz = f64_add(f64_add(z, f64_mul(hdt, tz)), f64_mul(q8, az));
    if (_grin_eval(p, px, py, pz, &w) == 0) { return 0; }
    var bx = load64(&w);
    var by = load64(&w + 8);
    var bz = load64(&w + 16);
    # C point: R + dt T + (dt^2/2) D(B).
    var q2 = f64_mul(F64_HALF, dt2);
    px = f64_add(f64_add(x, f64_mul(dt, tx)), f64_mul(q2, bx));
    py = f64_add(f64_add(y, f64_mul(dt, ty)), f64_mul(q2, by));
    pz = f64_add(f64_add(z, f64_mul(dt, tz)), f64_mul(q2, bz));
    if (_grin_eval(p, px, py, pz, &w) == 0) { return 0; }
    var cx = load64(&w);
    var cy = load64(&w + 8);
    var cz = load64(&w + 16);
    var q6 = f64_div(dt2, f64_from(6));
    var d6 = f64_div(dt, f64_from(6));
    var nx = f64_add(f64_add(x, f64_mul(dt, tx)), f64_mul(q6, f64_add(ax, f64_mul(F64_TWO, bx))));
    var ny = f64_add(f64_add(y, f64_mul(dt, ty)), f64_mul(q6, f64_add(ay, f64_mul(F64_TWO, by))));
    var nz = f64_add(f64_add(z, f64_mul(dt, tz)), f64_mul(q6, f64_add(az, f64_mul(F64_TWO, bz))));
    var f4 = f64_from(4);
    store64(o, nx);
    store64(o + 8, ny);
    store64(o + 16, nz);
    store64(o + 24, f64_add(tx, f64_mul(d6, f64_add(f64_add(ax, f64_mul(f4, bx)), cx))));
    store64(o + 32, f64_add(ty, f64_mul(d6, f64_add(f64_add(ay, f64_mul(f4, by)), cy))));
    store64(o + 40, f64_add(tz, f64_mul(d6, f64_add(f64_add(az, f64_mul(f4, bz)), cz))));
    return _grin_eval(p, nx, ny, nz, o + 48);
}

# D.T of a state.
fn _grin_dt(s) {
    return f64_add(f64_add(f64_mul(load64(s + 48), load64(s + 24)), f64_mul(load64(s + 56), load64(s + 32))),
      f64_mul(load64(s + 64), load64(s + 40)));
}

# |T|^2 of a state.
fn _grin_t2(s) {
    return f64_add(f64_add(f64_mul(load64(s + 24), load64(s + 24)), f64_mul(load64(s + 32), load64(s + 32))),
      f64_mul(load64(s + 40), load64(s + 40)));
}

# The optical path over a step of dt from state a to state b (Hermite, n^2 and
# d(n^2)/dt = 2 D.T at both ends).
fn _grin_opl(a, b, dt) {
    var tr = f64_mul(f64_mul(F64_HALF, dt), f64_add(load64(a + 72), load64(b + 72)));
    return f64_add(tr, f64_mul(f64_div(f64_mul(dt, dt), f64_from(6)), f64_sub(_grin_dt(a), _grin_dt(b))));
}

# 1 if the step a -> b of dt is a step of a RAY: T turns by at most 0.5 rad, n^2
# changes by at most 2x, and the optical path grows. Deliberately loose — it
# catches a step that has left the method's regime (the 2.8.0 review's coarse
# steps returned n = 6.7e20 and a negative optical path as success), not ordinary
# truncation error. A failing step is re-taken shorter. Writes the step's optical
# path to dopl.
fn _grin_sane(a, b, dt, dopl) {
    var dot = f64_add(f64_add(f64_mul(load64(a + 24), load64(b + 24)), f64_mul(load64(a + 32), load64(b + 32))),
      f64_mul(load64(a + 40), load64(b + 40)));
    if (f64_gt(dot, 0) == 0) { return 0; }
    # dot^2 >= cos^2(0.5) |Ta|^2 |Tb|^2
    if (f64_lt(f64_mul(dot, dot), f64_mul(0x3FE8A51407DA8346, f64_mul(_grin_t2(a), _grin_t2(b)))) == 1) { return 0; }
    var na = load64(a + 72);
    var nb = load64(b + 72);
    if (f64_gt(nb, f64_mul(F64_TWO, na)) == 1) { return 0; }
    if (f64_gt(na, f64_mul(F64_TWO, nb)) == 1) { return 0; }
    var d = _grin_opl(a, b, dt);
    store64(dopl, d);
    if (f64_gt(d, 0) == 0) { return 0; }
    return 1;
}

# 1 if a state still carries the ray's one exact invariant, |T| = n, to 1e-3
# (|T|^2/n^2 within 2e-3 of 1). NaN fails.
fn _grin_held(s) {
    var r = f64_div(_grin_t2(s), load64(s + 72));
    if (f64_le(f64_abs(f64_sub(r, F64_ONE)), 0x3F60624DD2F1A9FC) == 1) { return 1; }
    return 0;
}

# The peak over u in (0, 1) of the cubic Hermite interpolant of f on a step of dt,
# from f0, f1 and their t-derivatives d0, d1 — O(dt^4) like the step itself — when
# f rises then falls inside the step (d0 > 0 > d1); else the larger end. Writes the
# peak's fraction of the step to uout (0 when it is an end).
fn _grin_cpeak(f0, f1, d0, d1, dt, uout) {
    store64(uout, 0);
    var m = f0;
    if (f64_gt(f1, m) == 1) { m = f1; }
    if (f64_gt(d0, 0) == 0) { return m; }
    if (f64_lt(d1, 0) == 0) { return m; }
    # f(u) = f0 + c1 u + c2 u^2 + c3 u^3 on u in [0, 1]; f'(0) > 0 > f'(1).
    var c1 = f64_mul(dt, d0);
    var c2 = f64_sub(f64_sub(f64_mul(f64_from(3), f64_sub(f1, f0)), f64_mul(F64_TWO, c1)), f64_mul(dt, d1));
    var c3 = f64_add(f64_add(f64_mul(F64_TWO, f64_sub(f0, f1)), c1), f64_mul(dt, d1));
    # f'(u) = c1 + 2 c2 u + 3 c3 u^2 = 0: its two roots in cancellation-free form are
    # c1/qq and qq/(3 c3), qq = -(c2 + sign(c2) sqrt(c2^2 - 3 c1 c3)). (2.8.0 round 2:
    # the first cut took c1/(-qq), so a peak inside a step was never found.)
    var qa = f64_mul(f64_from(3), c3);
    var disc = f64_sub(f64_mul(c2, c2), f64_mul(qa, c1));
    if (f64_lt(disc, 0) == 1) { disc = 0; }
    var sq = f64_sqrt(disc);
    var qq = f64_neg(f64_add(c2, sq));
    if (f64_lt(c2, 0) == 1) { qq = f64_neg(f64_sub(c2, sq)); }
    var k = 0;
    while (k < 2) {
        var u = f64_div(c1, qq);
        if (k == 1) { u = f64_div(qq, qa); }
        if ((f64_gt(u, 0) & f64_lt(u, F64_ONE)) == 1) {
            var f = f64_add(f64_add(f0, f64_mul(c1, u)), f64_mul(f64_mul(u, u), f64_add(c2, f64_mul(c3, u))));
            if (f64_gt(f, m) == 1) {
                m = f;
                store64(uout, u);
            }
        }
        k = k + 1;
    }
    return m;
}

# The largest r^2 = x^2 + y^2 over the step a -> b of dt (d r^2/dt = 2 (x T_x +
# y T_y)): a rod's wall is met between step ends too.
fn _grin_r2max(a, b, dt) {
    var fa = f64_add(f64_mul(load64(a), load64(a)), f64_mul(load64(a + 8), load64(a + 8)));
    var fb = f64_add(f64_mul(load64(b), load64(b)), f64_mul(load64(b + 8), load64(b + 8)));
    var da = f64_mul(F64_TWO, f64_add(f64_mul(load64(a), load64(a + 24)), f64_mul(load64(a + 8), load64(a + 32))));
    var db = f64_mul(F64_TWO, f64_add(f64_mul(load64(b), load64(b + 24)), f64_mul(load64(b + 8), load64(b + 32))));
    var u = 0;
    return _grin_cpeak(fa, fb, da, db, dt, &u);
}

# The stop function: < 0 before the boundary, >= 0 at or past it. stop 0 is the
# plane z = c1 approached from the side sig (+1: from below); stop 1 is the
# sphere of radius c2 about (0, 0, c1), left from inside.
fn _grin_g(s, stop, c1, c2, sig) {
    if (stop == 0) { return f64_mul(sig, f64_sub(load64(s + 16), c1)); }
    var zc = f64_sub(load64(s + 16), c1);
    var r2 = f64_add(f64_add(f64_mul(load64(s), load64(s)), f64_mul(load64(s + 8), load64(s + 8))), f64_mul(zc, zc));
    return f64_sub(r2, f64_mul(c2, c2));
}

# dg/dt of a state.
fn _grin_gd(s, stop, c1, sig) {
    if (stop == 0) { return f64_mul(sig, load64(s + 40)); }
    var zc = f64_sub(load64(s + 16), c1);
    return f64_mul(F64_TWO, f64_add(f64_add(f64_mul(load64(s), load64(s + 24)), f64_mul(load64(s + 8), load64(s + 32))),
        f64_mul(zc, load64(s + 40))));
}

# The straight-line estimate of the t to the boundary from state s — the plane's
# -g/(dg/dt), the sphere chord's far root — or 0 when the line never reaches it.
fn _grin_tau(s, stop, c1, c2, sig) {
    var g = _grin_g(s, stop, c1, c2, sig);
    var gd = _grin_gd(s, stop, c1, sig);
    if (stop == 0) {
        if (f64_gt(gd, 0) == 0) { return 0; }
        return f64_div(f64_neg(g), gd);
    }
    # |R + tau T - c|^2 - rho^2 = g + gd tau + |T|^2 tau^2.
    var qa = _grin_t2(s);
    var disc = f64_sub(f64_mul(gd, gd), f64_mul(f64_from(4), f64_mul(qa, g)));
    if (f64_lt(disc, 0) == 1) { return 0; }
    var sq = f64_sqrt(disc);
    if (f64_gt(gd, 0) == 1) {
        var den = f64_add(gd, sq);
        if (f64_gt(den, 0) == 0) { return 0; }
        return f64_div(f64_mul(F64_TWO, f64_neg(g)), den);
    }
    return f64_div(f64_add(f64_neg(gd), sq), f64_mul(F64_TWO, qa));
}

# The first t > 0 at which the step's own quadratic, g + g' t + g'' t^2/2 with the
# curvature D, predicts the boundary; 0 when it predicts none. (The straight chord
# alone is tiny for a ray skimming inside a sphere while the curved ray stays in:
# 2.8.0 round 2 measured 1000x the steps for a Luneburg ray 1e-12 R from the rim.)
fn _grin_tau2(s, stop, c1, c2, sig, dt) {
    var g = _grin_g(s, stop, c1, c2, sig);
    var b = _grin_gd(s, stop, c1, sig);
    var a = f64_mul(F64_HALF, f64_mul(sig, load64(s + 64)));
    if (stop == 1) {
        # g'' / 2 = |T|^2 + (R - c).D
        var zc = f64_sub(load64(s + 16), c1);
        var rd = f64_add(f64_mul(load64(s), load64(s + 48)), f64_mul(load64(s + 8), load64(s + 56)));
        a = f64_add(_grin_t2(s), f64_add(rd, f64_mul(zc, load64(s + 64))));
    }
    # a t^2 + b t + g = 0 with g < 0: the smallest positive root — unless the
    # quadratic cannot climb to 0 within dt at all (the usual case, far from it).
    if (f64_gt(g, 0) == 1) { return 0; }
    if (f64_lt(f64_add(g, f64_mul(dt, f64_add(f64_abs(b), f64_mul(dt, f64_abs(a))))), 0) == 1) { return 0; }
    var disc = f64_sub(f64_mul(b, b), f64_mul(f64_from(4), f64_mul(a, g)));
    if (f64_lt(disc, 0) == 1) { return 0; }
    var q = f64_neg(f64_mul(F64_HALF, f64_add(b, f64_sqrt(disc))));
    if (f64_lt(b, 0) == 1) { q = f64_neg(f64_mul(F64_HALF, f64_sub(b, f64_sqrt(disc)))); }
    var best = 0;
    if (f64_gt(f64_abs(q), 0) == 1) {
        var r1 = f64_div(g, q);
        if (f64_gt(r1, 0) == 1) { best = r1; }
    }
    if (f64_gt(f64_abs(a), 0) == 1) {
        var r2 = f64_div(q, a);
        if (f64_gt(r2, 0) == 1) {
            if ((best == 0) | (f64_lt(r2, best) == 1)) { best = r2; }
        }
    }
    return best;
}

# 1 if the profile has no axial gradient (T_z is then conserved exactly: a ray
# not heading for a plane never reaches it).
fn _grin_zinv(p) {
    var k = GrinProfile_kind(p);
    if ((k == GRIN_SELFOC) | (k == GRIN_SECH)) { return 1; }
    if (k != GRIN_POLY) { return 0; }
    var az = (GrinProfile_a4(p) | GrinProfile_a5(p) | GrinProfile_a6(p)) & _PRK_ABS;
    if (az == 0) { return 1; }
    return 0;
}

fn _grin_copy(dst, src) {
    for (var i = 0; i < 80; i = i + 8) { store64(dst + i, load64(src + i)); }
    return 0;
}

# Accept the step a -> b of tau as the one that ends on the boundary: check it
# (a step of a ray, the invariant held, inside the cylinder), snap the end onto the
# boundary (the plane's z set to it, the sphere's radius rescaled to it — both
# rounding-level corrections), and write the end state and the optical path.
fn _grin_finish(a, b, tau, stop, c1, c2, cyl2, opl, sout, opl_out) {
    var dop = 0;
    if (_grin_sane(a, b, tau, &dop) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_held(b) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (cyl2 != _PRK_INF) {
        if (f64_gt(_grin_r2max(a, b, tau), cyl2) == 1) { return PK_ERR_INVALID_PARAMETER; }
    }
    var total = f64_add(opl, dop);
    _grin_copy(sout, b);
    if (stop == 0) {
        store64(sout + 16, c1);
    } else {
        var ex = load64(b);
        var ey = load64(b + 8);
        var ez = f64_sub(load64(b + 16), c1);
        var sc = f64_div(c2, f64_sqrt(f64_add(f64_add(f64_mul(ex, ex), f64_mul(ey, ey)), f64_mul(ez, ez))));
        store64(sout, f64_mul(ex, sc));
        store64(sout + 8, f64_mul(ey, sc));
        store64(sout + 16, f64_add(c1, f64_mul(ez, sc)));
    }
    store64(opl_out, total);
    return PK_ERR_NONE;
}

# Trace state s0 to the boundary — stop 0: the plane z = c1; stop 1: the sphere of
# radius c2 about (0, 0, c1), left from inside — in steps of arc length at most
# `step` (see the header), then one partial step whose length Newton finds, so the
# ray ends ON the boundary. cyl2 is the square of the radius of a cylinder about
# the z axis the ray must stay inside (a rod's wall; +inf for none). Writes the end
# state to sout and the optical path to opl_out. Returns PK_ERR_NONE, or:
# - PK_ERR_INVALID_INDEX if a step meets a point with no index even at 2^-40 of
#   its length;
# - PK_ERR_TIR if the budget runs out on a plane trace whose ray, once heading for
#   the plane, turned away (a gradient-index mirage: an oblique ray turns back where
#   n falls to its transverse invariant);
# - PK_ERR_INVALID_PARAMETER if the budget runs out otherwise, a plane trace's ray
#   heads away in a profile with no axial gradient (it can never arrive), a sphere
#   trace starts outside, the ray meets the cylinder, a step cannot move the ray,
#   a step is not a step of a ray even at 2^-40 of its length (a ray running
#   HEAD-ON into n -> 0, whose T reverses in every step, ends here), or the
#   landing fails its checks.
fn _grin_run(p, s0, stop, c1, c2, step, max_steps, cyl2, sout, opl_out) {
    var ba[80];
    var bb[80];
    var bt[80];
    var cur = &ba;
    var nxt = &bb;
    var opl = 0;
    store64(opl_out, 0);
    _grin_copy(cur, s0);
    var dt0 = f64_div(step, f64_sqrt(load64(s0 + 72)));
    var sig = F64_ONE;
    var gscale = 0;
    var toward = 0;
    var turned = 0;
    if (stop == 0) {
        # On the plane already (either signed zero).
        if ((f64_sub(load64(s0 + 16), c1) & _PRK_ABS) == 0) {
            _grin_copy(sout, cur);
            return PK_ERR_NONE;
        }
        if (f64_gt(load64(s0 + 16), c1) == 1) { sig = f64_neg(F64_ONE); }
        if (f64_gt(f64_mul(sig, load64(s0 + 40)), 0) == 1) { toward = 1; }
        if (toward == 0) {
            if (_grin_zinv(p) == 1) { return PK_ERR_INVALID_PARAMETER; }
        }
    } else {
        # g carries ~2 rho ulp(|c| + rho) of rounding (2.8.0 review: a scale of
        # rho^2 alone refused every trace of a ball 2000 radii from the origin).
        gscale = f64_mul(c2, f64_add(c2, f64_abs(c1)));
        var gstart = f64_add(f64_mul(f64_mul(c2, c2), _grin_r(1, 1000000000)), f64_mul(gscale, 0x3CF0000000000000));
        var g0 = _grin_g(cur, 1, c1, c2, sig);
        if (f64_gt(g0, gstart) == 1) { return PK_ERR_INVALID_PARAMETER; }
        # On the sphere (to rounding) it must head in: a tangent start follows the
        # rim or leaves at once depending on the first step's rounding (round 2).
        if (f64_gt(g0, f64_neg(gstart)) == 1) {
            if (f64_ge(_grin_gd(cur, 1, c1, sig), 0) == 1) { return PK_ERR_INVALID_PARAMETER; }
        }
    }
    var r20 = f64_add(f64_mul(load64(s0), load64(s0)), f64_mul(load64(s0 + 8), load64(s0 + 8)));
    if (f64_gt(r20, cyl2) == 1) { return PK_ERR_INVALID_PARAMETER; }
    # Every fish-eye ray is a closed circle of optical length pi n0 R, so a real
    # arrival comes within one loop; past two the integrator's drift, not the ray,
    # would decide (2.8.0 round 2: a never-arriving orbit precessed into the plane
    # and "arrived" once max_steps allowed it).
    var oplcap = _PRK_INF;
    if (GrinProfile_kind(p) == GRIN_FISHEYE) {
        oplcap = f64_mul(F64_TAU, f64_mul(GrinProfile_n0(p), GrinProfile_a1(p)));
    }
    var i = 0;
    while (i < max_steps) {
        var dt = dt0;
        var dn = f64_div(step, f64_sqrt(load64(cur + 72)));
        if (f64_lt(dn, dt) == 1) { dt = dn; }
        # Shorten a step that would overshoot the boundary — as the step's own
        # quadratic predicts it — by more than 1/8, so stage points stay near the
        # medium (floored at 1/1024 of the step, so the ray always moves).
        var te = _grin_tau2(cur, stop, c1, c2, sig, dt);
        if (f64_gt(te, 0) == 1) {
            var tc = f64_mul(te, _grin_r(9, 8));
            var tf = f64_mul(dt, _grin_r(1, 1024));
            if (f64_lt(tc, tf) == 1) { tc = tf; }
            if (f64_lt(tc, dt) == 1) { dt = tc; }
        }
        var nh = 0;
        var ok = 0;
        var why = PK_ERR_INVALID_INDEX;
        var dop = 0;
        while (nh <= 40) {
            if (_grin_step(p, cur, dt, nxt) == 1) {
                if (_grin_sane(cur, nxt, dt, &dop) == 1) {
                    ok = 1;
                    break;
                }
                why = PK_ERR_INVALID_PARAMETER;
            } else {
                why = PK_ERR_INVALID_INDEX;
            }
            dt = f64_mul(F64_HALF, dt);
            nh = nh + 1;
        }
        if (ok == 0) { return why; }
        # A step below the coordinates' resolution: no budget can finish the trace.
        var same = 0;
        if (load64(nxt) == load64(cur)) {
            if (load64(nxt + 8) == load64(cur + 8)) {
                if (load64(nxt + 16) == load64(cur + 16)) { same = 1; }
            }
        }
        if (same == 1) { return PK_ERR_INVALID_PARAMETER; }
        # A ray whose |T| has lost 10% against n cannot reach where the true ray
        # does: stop now. An early exit — the landing check or the budget would
        # refuse it later — so its cost, not its verdict, is what it saves (round 2
        # measured 2 s for a 50-step trace at max_steps 1e6 before the fish-eye
        # loop cap below took that case too).
        if (f64_le(f64_abs(f64_sub(f64_div(_grin_t2(nxt), load64(nxt + 72)), F64_ONE)), _grin_r(1, 10)) == 0) {
            return PK_ERR_INVALID_PARAMETER;
        }
        var gn = _grin_g(nxt, stop, c1, c2, sig);
        var land = 0;
        var hi = dt;
        if (f64_ge(gn, 0) == 1) {
            if ((gn & _PRK_ABS) == 0) { return _grin_finish(cur, nxt, dt, stop, c1, c2, cyl2, opl, sout, opl_out); }
            land = 1;
        } else {
            # A crossing and a return INSIDE the step — a ray grazing out of a
            # sphere through a thin cap, a plane just past a mirage's turning point
            # — shows as a peak of g between two negative ends. (2.8.0 round 2: only
            # the ends were tested, so such a ray was traced on as if it never
            # left.) The step's cubic finds the peak; one RKN step confirms it.
            var up = 0;
            var gpk = gn;
            var d1n = _grin_gd(nxt, stop, c1, sig);
            if (f64_lt(d1n, 0) == 1) {
                var g0c = _grin_g(cur, stop, c1, c2, sig);
                gpk = _grin_cpeak(g0c, gn, _grin_gd(cur, stop, c1, sig), d1n, dt, &up);
            }
            if (f64_gt(gpk, 0) == 1) {
                if (f64_gt(up, 0) == 1) {
                    var tpk = f64_mul(up, dt);
                    if (_grin_step(p, cur, tpk, &bt) == 1) {
                        if (f64_ge(_grin_g(&bt, stop, c1, c2, sig), 0) == 1) {
                            hi = tpk;
                            land = 1;
                        }
                    }
                }
            }
        }
        if (land == 1) {
            # The crossing is in (0, hi]: find tau with safeguarded Newton on
            # g(step(tau)) = 0.
            var gs = gscale;
            if (stop == 0) { gs = f64_add(f64_abs(c1), f64_mul(dt, f64_sqrt(load64(cur + 72)))); }
            var lo = 0;
            var tau = _grin_tau(cur, stop, c1, c2, sig);
            if (f64_gt(tau, 0) == 0) { tau = f64_mul(F64_HALF, hi); }
            if (f64_gt(tau, hi) == 1) { tau = hi; }
            var done = 0;
            var it = 0;
            while (it < 60) {
                if (_grin_step(p, cur, tau, &bt) == 0) { return PK_ERR_INVALID_INDEX; }
                var h = _grin_g(&bt, stop, c1, c2, sig);
                if (f64_le(f64_abs(h), f64_mul(gs, 0x3CB0000000000000)) == 1) {
                    done = 1;
                    break;
                }
                if (f64_gt(h, 0) == 1) { hi = tau; } else { lo = tau; }
                var tn = f64_sub(tau, f64_div(h, _grin_gd(&bt, stop, c1, sig)));
                # Newton unless it leaves the bracket (or dg/dt is 0/NaN): then bisect.
                if (f64_gt(tn, lo) == 0) { tn = f64_mul(F64_HALF, f64_add(lo, hi)); }
                if (f64_lt(tn, hi) == 0) { tn = f64_mul(F64_HALF, f64_add(lo, hi)); }
                # A correction at the ulp scale of dt: h is rounding noise, and &bt
                # (the state at tau) is the answer. Waiting for tn == tau instead
                # can cycle on that noise.
                if (f64_le(f64_abs(f64_sub(tn, tau)), f64_mul(dt, 0x3CD0000000000000)) == 1) {
                    done = 1;
                    break;
                }
                tau = tn;
                it = it + 1;
            }
            if (done == 0) { return PK_ERR_INVALID_PARAMETER; }
            if (f64_gt(f64_abs(_grin_g(&bt, stop, c1, c2, sig)), f64_mul(gs, _grin_r(1, 1000000000000))) == 1) {
                return PK_ERR_INVALID_PARAMETER;
            }
            return _grin_finish(cur, &bt, tau, stop, c1, c2, cyl2, opl, sout, opl_out);
        }
        if (cyl2 != _PRK_INF) {
            if (f64_gt(_grin_r2max(cur, nxt, dt), cyl2) == 1) { return PK_ERR_INVALID_PARAMETER; }
        }
        opl = f64_add(opl, dop);
        if (f64_gt(opl, oplcap) == 1) { break; }
        if (stop == 0) {
            var tw = 0;
            if (f64_gt(f64_mul(sig, load64(nxt + 40)), 0) == 1) { tw = 1; }
            if ((toward == 1) & (tw == 0)) { turned = 1; }
            toward = tw;
        }
        var tmp = cur;
        cur = nxt;
        nxt = tmp;
        i = i + 1;
    }
    if (turned == 1) { return PK_ERR_TIR; }
    return PK_ERR_INVALID_PARAMETER;
}

# (dx, dy, dz) scaled to unit length into out[0..2] — by the largest component
# first, so no square over- or underflows (2.8.0 review: a finite direction of
# 1e154 was refused and one of 1e-162 lost bits). Returns 1, or 0 for a zero or
# non-finite vector.
fn _grin_unit(dx, dy, dz, out) {
    var m = f64_abs(dx);
    if (f64_gt(f64_abs(dy), m) == 1) { m = f64_abs(dy); }
    if (f64_gt(f64_abs(dz), m) == 1) { m = f64_abs(dz); }
    if (_grin_pos(m) == 0) { return 0; }
    if ((_grin_finite(dx) & _grin_finite(dy) & _grin_finite(dz)) == 0) { return 0; }
    var sx = f64_div(dx, m);
    var sy = f64_div(dy, m);
    var sz = f64_div(dz, m);
    var l = f64_sqrt(f64_add(f64_add(f64_mul(sx, sx), f64_mul(sy, sy)), f64_mul(sz, sz)));
    store64(out, f64_div(sx, l));
    store64(out + 8, f64_div(sy, l));
    store64(out + 16, f64_div(sz, l));
    return 1;
}

# Validate a trace's common arguments; on success fill state s from the ray (at its
# position, direction normalised, T = n(pos) * dir) and return PK_ERR_NONE.
# PK_ERR_INVALID_INDEX (s only partly filled) where the profile has no index at the
# ray's position — the rod and ball traces, whose rays start outside, ignore it.
fn _grin_start(p, ray, step, max_steps, s) {
    if (_grin_kind_ok(p) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (ray == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_pos(step) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (max_steps < 1) { return PK_ERR_INVALID_PARAMETER; }
    var pos = TraceRay_pos(ray);
    var dir = TraceRay_dir(ray);
    if ((pos == 0) | (dir == 0)) { return PK_ERR_INVALID_PARAMETER; }
    var x = RayVec3_x(pos);
    var y = RayVec3_y(pos);
    var z = RayVec3_z(pos);
    if (_grin_finite(f64_add(f64_add(x, y), z)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var u[24];
    if (_grin_unit(RayVec3_x(dir), RayVec3_y(dir), RayVec3_z(dir), &u) == 0) { return PK_ERR_INVALID_PARAMETER; }
    store64(s, x);
    store64(s + 8, y);
    store64(s + 16, z);
    store64(s + 24, load64(&u));
    store64(s + 32, load64(&u + 8));
    store64(s + 40, load64(&u + 16));
    if (_grin_eval(p, x, y, z, s + 48) == 0) { return PK_ERR_INVALID_INDEX; }
    var n = f64_sqrt(load64(s + 72));
    store64(s + 24, f64_mul(n, load64(&u)));
    store64(s + 32, f64_mul(n, load64(&u + 8)));
    store64(s + 40, f64_mul(n, load64(&u + 16)));
    return PK_ERR_NONE;
}

fn _grin_fail(e, opl_out, err_out) {
    if (opl_out != 0) { store64(opl_out, 0); }
    store64(err_out, e);
    return 0;
}

# The result: a TraceRay at state s's position, heading along its T, in index n.
# Its three RayVec3/TraceRay blocks are the only allocations a trace makes.
fn _grin_done(s, n, opl, opl_out, err_out) {
    var u[24];
    if (_grin_unit(load64(s + 24), load64(s + 32), load64(s + 40), &u) == 0) {
        return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out);
    }
    var pos = ray_vec3(load64(s), load64(s + 8), load64(s + 16));
    var dir = ray_vec3(load64(&u), load64(&u + 8), load64(&u + 16));
    if ((pos == 0) | (dir == 0)) { return _grin_fail(PK_ERR_ALLOCATION, opl_out, err_out); }
    var r = trace_ray_new(pos, dir, n);
    if (r == 0) { return _grin_fail(PK_ERR_ALLOCATION, opl_out, err_out); }
    if (opl_out != 0) { store64(opl_out, opl); }
    store64(err_out, PK_ERR_NONE);
    return r;
}

# Trace a ray INSIDE the medium to the plane z = z_end (either side of it). The
# ray's position is its start, its direction is normalised here, and its index
# field is ignored — the profile gives n there. `step` is the arc length of a step
# (finite, > 0; see the header — the error is O(step^4)); `max_steps` bounds the
# steps. Returns a new TraceRay at the plane (direction of the ray there, n the
# profile's index there; its z is exactly z_end) and the optical path through
# opl_out (may be 0). Errors (0 returned, opl 0):
# - PK_ERR_INVALID_PARAMETER for a null or non-finite argument, a zero direction,
#   step <= 0, max_steps < 1; a ray heading away from the plane in a profile with
#   no axial gradient (SELFOC, sech, a polynomial with no z terms: it can never
#   arrive); the budget running out; a step too small to move the ray, or one the
#   header's checks refuse even at 2^-40 of its length (a step far too coarse, or
#   a ray running head-on into n -> 0);
# - PK_ERR_TIR if the budget runs out after the ray, once heading for the plane,
#   turned away (a gradient-index mirage);
# - PK_ERR_INVALID_INDEX if the ray starts, or a step at 2^-40 of its length
#   still reaches, where the profile has no index.
#must_use
fn grin_trace_to_plane(profile, ray, z_end, step, max_steps, opl_out, err_out) {
    _prk_trace("grin_trace_to_plane");
    if (_grin_finite(z_end) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var s0[80];
    var e = _grin_start(profile, ray, step, max_steps, &s0);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var se[80];
    var opl = 0;
    e = _grin_run(profile, &s0, 0, z_end, 0, step, max_steps, _PRK_INF, &se, &opl);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    return _grin_done(&se, f64_sqrt(load64(&se + 72)), opl, opl_out, err_out);
}

# Trace a ray INSIDE the medium (or on the sphere, heading in) until it leaves the
# sphere of radius `radius` about (0, 0, cz); the result lies exactly on it. Same
# arguments and result as grin_trace_to_plane. Errors: PK_ERR_INVALID_PARAMETER for
# a null or non-finite argument, radius not finite and positive with a finite
# normal square, a ray starting outside the sphere or on it not heading in, the
# budget running out, or a step refused as for grin_trace_to_plane;
# PK_ERR_INVALID_INDEX as for it. Never PK_ERR_TIR.
#must_use
fn grin_trace_to_sphere(profile, ray, cz, radius, step, max_steps, opl_out, err_out) {
    _prk_trace("grin_trace_to_sphere");
    if (_grin_finite(cz) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (_grin_sq_ok(radius) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var s0[80];
    var e = _grin_start(profile, ray, step, max_steps, &s0);
    if (e == PK_ERR_INVALID_INDEX) {
        # Outside the sphere is the documented refusal even where the law has no
        # index there (a Luneburg past sqrt(2) R).
        var sz = f64_sub(load64(&s0 + 16), cz);
        var sr2 = f64_add(f64_add(f64_mul(load64(&s0), load64(&s0)), f64_mul(load64(&s0 + 8), load64(&s0 + 8))),
          f64_mul(sz, sz));
        if (f64_gt(sr2, f64_mul(radius, radius)) == 1) { e = PK_ERR_INVALID_PARAMETER; }
    }
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var se[80];
    var opl = 0;
    e = _grin_run(profile, &s0, 1, cz, radius, step, max_steps, _PRK_INF, &se, &opl);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    return _grin_done(&se, f64_sqrt(load64(&se + 72)), opl, opl_out, err_out);
}

# Vector Snell, on stack scalars (2.8.0 review: going through ray_refract_3d cost
# six discarded RayVec3 allocations per rod or ball trace, and reported an
# allocation failure as a bad argument): unit incident (dx, dy, dz) in index n1,
# unit normal (nx, ny, nz) facing it, into index n2 —
#   t = r d + (r cos_i - cos_t) n,   r = n1/n2,   cos_i = -d.n.
# Writes the refracted unit direction to out[0..2]; PK_ERR_NONE or PK_ERR_TIR.
fn _grin_refract(dx, dy, dz, nx, ny, nz, n1, n2, out) {
    var ratio = f64_div(n1, n2);
    var ci = f64_neg(f64_add(f64_add(f64_mul(dx, nx), f64_mul(dy, ny)), f64_mul(dz, nz)));
    var s2 = f64_mul(f64_mul(ratio, ratio), f64_sub(F64_ONE, f64_mul(ci, ci)));
    if (f64_gt(s2, F64_ONE) == 1) { return PK_ERR_TIR; }
    var fac = f64_sub(f64_mul(ratio, ci), f64_sqrt(f64_sub(F64_ONE, s2)));
    store64(out, f64_add(f64_mul(ratio, dx), f64_mul(fac, nx)));
    store64(out + 8, f64_add(f64_mul(ratio, dy), f64_mul(fac, ny)));
    store64(out + 16, f64_add(f64_mul(ratio, dz), f64_mul(fac, nz)));
    return PK_ERR_NONE;
}

# Refract the incoming unit direction (dx, dy, dz) in index n_in into the GRIN at
# boundary point (x, y, z) with unit normal (nx, ny, nz) facing the incoming ray,
# and fill state s there. Returns PK_ERR_NONE, PK_ERR_TIR or PK_ERR_INVALID_INDEX.
fn _grin_enter(p, x, y, z, dx, dy, dz, nx, ny, nz, n_in, s) {
    if (_grin_eval(p, x, y, z, s + 48) == 0) { return PK_ERR_INVALID_INDEX; }
    var n = f64_sqrt(load64(s + 72));
    var d[24];
    var e = _grin_refract(dx, dy, dz, nx, ny, nz, n_in, n, &d);
    if (e != PK_ERR_NONE) { return e; }
    store64(s, x);
    store64(s + 8, y);
    store64(s + 16, z);
    store64(s + 24, f64_mul(n, load64(&d)));
    store64(s + 32, f64_mul(n, load64(&d + 8)));
    store64(s + 40, f64_mul(n, load64(&d + 16)));
    return PK_ERR_NONE;
}

# Refract state s (on a boundary, heading along T) out of the GRIN into n_after
# through a surface whose unit normal (nx, ny, nz) points back into the GRIN.
# Rewrites s's T as the refracted UNIT direction. PK_ERR_NONE or PK_ERR_TIR.
fn _grin_exit(s, nx, ny, nz, n_after) {
    var u[24];
    if (_grin_unit(load64(s + 24), load64(s + 32), load64(s + 40), &u) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var d[24];
    var n1 = f64_sqrt(load64(s + 72));
    var e = _grin_refract(load64(&u), load64(&u + 8), load64(&u + 16), nx, ny, nz, n1, n_after, &d);
    if (e != PK_ERR_NONE) { return e; }
    store64(s + 24, load64(&d));
    store64(s + 32, load64(&d + 8));
    store64(s + 40, load64(&d + 16));
    return PK_ERR_NONE;
}

# A GRIN ROD of radius `radius` about the z axis between the planes z = z_front and
# z = z_front + length: the ray, in a homogeneous medium of its own index
# (TraceRay_n), travels straight to the front face, refracts in, is traced
# through, and refracts out into n_after. Returns the ray just past the back face
# (index n_after) and, through opl_out (may be 0), the optical path from the ray's
# start to the back face. The ray must start at or before the front face heading
# +z. `radius` is the rod's wall (+inf for a laterally unbounded rod): a ray that
# meets the front face outside it, or reaches it anywhere inside the rod, is
# vignetted — PK_ERR_INVALID_PARAMETER, like an aperture miss in trace_surface.
# Errors otherwise as grin_trace_to_plane, plus PK_ERR_INVALID_PARAMETER for a ray
# that starts past the front face or does not head +z, a non-finite z_front,
# length not finite and positive, radius neither +inf nor finite and positive with a
# finite normal square, n_after or the ray's index not
# finite and positive with a finite normal square; PK_ERR_TIR at either face.
#must_use
fn grin_rod_trace(profile, ray, z_front, length, radius, n_after, step, max_steps, opl_out, err_out) {
    _prk_trace("grin_rod_trace");
    if (_grin_finite(z_front) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (_grin_pos(length) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (radius != _PRK_INF) {
        if (_grin_sq_ok(radius) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    }
    if (_grin_sq_ok(n_after) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var s0[80];
    var e = _grin_start(profile, ray, step, max_steps, &s0);
    if (e == PK_ERR_INVALID_INDEX) { e = PK_ERR_NONE; }
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var n_in = TraceRay_n(ray);
    if (_grin_sq_ok(n_in) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var u[24];
    var rd = TraceRay_dir(ray);
    _grin_unit(RayVec3_x(rd), RayVec3_y(rd), RayVec3_z(rd), &u);
    var dx = load64(&u);
    var dy = load64(&u + 8);
    var dz = load64(&u + 16);
    var gap = f64_sub(z_front, load64(&s0 + 16));
    if (f64_gt(dz, 0) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (f64_lt(gap, 0) == 1) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var t = f64_div(gap, dz);
    var x = f64_add(load64(&s0), f64_mul(t, dx));
    var y = f64_add(load64(&s0 + 8), f64_mul(t, dy));
    var cyl2 = f64_mul(radius, radius);
    if (f64_gt(f64_add(f64_mul(x, x), f64_mul(y, y)), cyl2) == 1) {
        return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out);
    }
    var s[80];
    e = _grin_enter(profile, x, y, z_front, dx, dy, dz, 0, 0, f64_neg(F64_ONE), n_in, &s);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var se[80];
    var opl = 0;
    e = _grin_run(profile, &s, 0, f64_add(z_front, length), 0, step, max_steps, cyl2, &se, &opl);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    e = _grin_exit(&se, 0, 0, f64_neg(F64_ONE), n_after);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    return _grin_done(&se, n_after, f64_add(f64_mul(n_in, t), opl), opl_out, err_out);
}

# A GRIN BALL of radius `radius` about (0, 0, cz) — the Luneburg lens, or any
# profile cut to a sphere: the ray, in a homogeneous medium of its own index, travels
# straight to the sphere, refracts in, is traced through, and refracts out into
# n_after. Returns the ray just outside the exit point and, through opl_out (may
# be 0), the optical path from the ray's start to the exit point. The ray must start
# outside the sphere or on it (to rounding), heading in. A ray that misses the
# sphere, only touches it (tangent), heads away from it, or starts inside, is
# PK_ERR_INVALID_PARAMETER;
# otherwise errors as grin_trace_to_sphere, plus PK_ERR_INVALID_PARAMETER for
# n_after or the ray's index not finite and positive with a finite normal square,
# and PK_ERR_TIR at either face.
#must_use
fn grin_ball_trace(profile, ray, cz, radius, n_after, step, max_steps, opl_out, err_out) {
    _prk_trace("grin_ball_trace");
    if (_grin_finite(cz) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (_grin_sq_ok(radius) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (_grin_sq_ok(n_after) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var s0[80];
    var e = _grin_start(profile, ray, step, max_steps, &s0);
    if (e == PK_ERR_INVALID_INDEX) { e = PK_ERR_NONE; }
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var n_in = TraceRay_n(ray);
    if (_grin_sq_ok(n_in) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var u[24];
    var rd = TraceRay_dir(ray);
    _grin_unit(RayVec3_x(rd), RayVec3_y(rd), RayVec3_z(rd), &u);
    var dx = load64(&u);
    var dy = load64(&u + 8);
    var dz = load64(&u + 16);
    var lx = load64(&s0);
    var ly = load64(&s0 + 8);
    var lz = f64_sub(load64(&s0 + 16), cz);
    var b = f64_add(f64_add(f64_mul(lx, dx), f64_mul(ly, dy)), f64_mul(lz, dz));
    # From outside or on the sphere, b >= 0 moves away from the centre: a miss.
    if (f64_lt(b, 0) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var c0 = f64_sub(f64_add(f64_add(f64_mul(lx, lx), f64_mul(ly, ly)), f64_mul(lz, lz)), f64_mul(radius, radius));
    if (f64_lt(c0, 0) == 1) {
        # On the sphere to rounding is a start there; clearly inside is refused.
        # The same tolerance _grin_run's start check uses (round 2: 1e-9 R(R + |cz|)
        # took a start 4e-4 R inside a ball at cz = 1e6 R as on the sphere).
        var ctol = f64_add(f64_mul(f64_mul(radius, radius), _grin_r(1, 1000000000)),
          f64_mul(f64_mul(radius, f64_add(radius, f64_abs(cz))), 0x3CF0000000000000));
        if (f64_lt(c0, f64_neg(ctol)) == 1) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
        c0 = 0;
    }
    # The discriminant from the perpendicular distance, R^2 - |L - (L.d) d|^2, not
    # b^2 - c0, which cancels for a far start (Haines, Guenther & Akenine-Moller,
    # "Precision Improvements for Ray/Sphere Intersection", Ray Tracing Gems 2019).
    var fx = f64_sub(lx, f64_mul(b, dx));
    var fy = f64_sub(ly, f64_mul(b, dy));
    var fz = f64_sub(lz, f64_mul(b, dz));
    var fq = f64_sqrt(f64_add(f64_add(f64_mul(fx, fx), f64_mul(fy, fy)), f64_mul(fz, fz)));
    var disc = f64_mul(f64_sub(radius, fq), f64_add(radius, fq));
    # disc <= 0 touches at most: a tangent ray is a miss (round 2: traced, it followed
    # the rim or left at once depending on the first step's rounding). NaN too.
    if (f64_gt(disc, 0) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    # The near root, in the cancellation-free form c0 / (-b + sqrt(disc)).
    var t = f64_div(c0, f64_add(f64_neg(b), f64_sqrt(disc)));
    var x = f64_add(load64(&s0), f64_mul(t, dx));
    var y = f64_add(load64(&s0 + 8), f64_mul(t, dy));
    var zr = f64_add(lz, f64_mul(t, dz));
    # Onto the sphere: from a far start the entry carries ~distance * eps of
    # rounding, which _grin_run's start check would read as "outside" (round 2:
    # half the rays from 1e7 R were refused).
    var snp = f64_div(radius, f64_sqrt(f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(zr, zr))));
    x = f64_mul(x, snp);
    y = f64_mul(y, snp);
    zr = f64_mul(zr, snp);
    var s[80];
    var nrm = f64_div(F64_ONE, radius);
    var ez0 = f64_add(cz, zr);
    e = _grin_enter(profile, x, y, ez0, dx, dy, dz, f64_mul(x, nrm), f64_mul(y, nrm), f64_mul(zr, nrm), n_in, &s);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var se[80];
    var opl = 0;
    e = _grin_run(profile, &s, 1, cz, radius, step, max_steps, _PRK_INF, &se, &opl);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var ex = f64_neg(f64_mul(load64(&se), nrm));
    var ey = f64_neg(f64_mul(load64(&se + 8), nrm));
    var ez = f64_neg(f64_mul(f64_sub(load64(&se + 16), cz), nrm));
    e = _grin_exit(&se, ex, ey, ez, n_after);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    return _grin_done(&se, n_after, f64_add(f64_mul(n_in, t), opl), opl_out, err_out);
}

# ── SELFOC paraxial optics ────────

# The paraxial pitch 2*pi/g of a SELFOC rod (the length of one full sinusoidal
# ray period); NaN unless g is finite and positive and 2*pi/g is finite.
#must_use
fn grin_selfoc_pitch(g) {
    if (_grin_pos(g) == 0) { return _PRK_NAN; }
    var p = f64_div(F64_TAU, g);
    if (_grin_finite(p) == 0) { return _PRK_NAN; }
    return p;
}

# The paraxial ABCD matrix of a SELFOC rod of length L between flat faces, in a
# medium of index n_ext on both sides, on (height, real slope) — the convention
# wave_beam's beam_abcd takes:
#   [ cos gL                sin gL * n_ext/(n0 g) ]
#   [ -sin gL * n0 g/n_ext  cos gL                ]
# (inside, y'' = -g^2 y; the faces scale the slope by n_ext/n0 in and back out).
# Writes A, B, C, D to out[0..3]. Returns PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER
# (out untouched) for a null out, n0, g or n_ext not finite and positive, a
# non-finite length, |g L| >= 2^53 (ulp(g L) >= 2 rad there: the double carries no
# phase), n0 g subnormal, or an entry that is not finite.
fn grin_selfoc_abcd(n0, g, length, n_ext, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_pos(n0) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_pos(g) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_pos(n_ext) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_finite(length) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var gl = f64_mul(g, length);
    # From 2^53 up ulp(gL) >= 2 rad: the product carries no phase to take a cosine of.
    if (f64_lt(f64_abs(gl), 0x4340000000000000) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var c = _prk_cos(gl);
    var s = _prk_sin(gl);
    var ng = f64_mul(n0, g);
    if ((ng & 0x7FF0000000000000) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var bb = f64_div(f64_mul(s, n_ext), ng);
    var cc = f64_neg(f64_div(f64_mul(s, ng), n_ext));
    if (_grin_finite(f64_add(f64_add(c, s), f64_add(bb, cc))) == 0) { return PK_ERR_INVALID_PARAMETER; }
    store64(out, c);
    store64(out + 8, bb);
    store64(out + 16, cc);
    store64(out + 24, c);
    return PK_ERR_NONE;
}
