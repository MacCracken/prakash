# ray_trace.cyr -- sequential ray tracing through optical surfaces
# Size of the single block trace_surface carves a hit out of:
# [TraceHit][hit_point RayVec3][normal RayVec3][after dir RayVec3][after TraceRay].
#must_use
fn _trace_hit_block() { return sizeof(TraceHit) + 3 * sizeof(RayVec3) + sizeof(TraceRay); }

# The TIR variant. A totally-internally-reflecting hit has no transmitted ray, so
# the after-direction and after-ray are never carved and the block is shorter.
#must_use
fn _trace_hit_block_tir() { return sizeof(TraceHit) + 2 * sizeof(RayVec3); }

# Usage: include "lib/ray_trace.cyr"  (requires error.cyr, ray_core.cyr, ray_fresnel.cyr)
#
# Ported from the Rust `ray/trace.rs`. The Rust `SurfaceShape` enum
# (Sphere{radius} | Plane) is flattened into OpticalSurface as a shape_tag +
# radius (radius unused for Plane). Vectors of hits use the stdlib `vec`.

# Surface shape tags (was the SurfaceShape enum).
var SURF_SPHERE = 0;
var SURF_PLANE = 1;

# Small geometry thresholds (Rust literals 1e-15 / 1e-10).
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _trace_eps15() { return 0x3CD203AF9EE75616; }
# 1 if the hit at parameter `t` lies on the cap of the sphere that contains the
# surface vertex, else 0. The vertex sits at z = cz - radius, so the vertex cap
# is the side where (hit_z - cz) has the OPPOSITE sign to radius; the product
# being <= 0 is that test, and it admits the equator exactly. See the sphere
# branch of trace_surface for why taking the nearest root alone is wrong.
#must_use
fn _trace_on_vertex_cap(pz, dz, t, cz, radius) {
    var hz = f64_add(pz, f64_mul(t, dz));
    if (f64_gt(f64_mul(f64_sub(hz, cz), radius), f64_from(0)) == 1) { return 0; }
    return 1;
}

# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(10000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3DDB7CDFD9D7BDBB is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _trace_eps10() { return 0x3DDB7CDFD9D7BDBB; }

# An interface between two media. shape_tag is SURF_SPHERE/SURF_PLANE; radius is
# the radius of curvature (sphere only; +radius = center to the right).
#derive(accessors)
struct OpticalSurface { shape_tag; radius; z_position; n_after; aperture_radius; }

#must_use
fn surface_sphere(radius, z_position, n_after, aperture_radius) {
    var s = alloc(sizeof(OpticalSurface));
    if (s == 0) { return 0; }
    OpticalSurface_set_shape_tag(s, SURF_SPHERE);
    OpticalSurface_set_radius(s, radius);
    OpticalSurface_set_z_position(s, z_position);
    OpticalSurface_set_n_after(s, n_after);
    OpticalSurface_set_aperture_radius(s, aperture_radius);
    return s;
}

#must_use
fn surface_plane(z_position, n_after, aperture_radius) {
    var s = alloc(sizeof(OpticalSurface));
    if (s == 0) { return 0; }
    OpticalSurface_set_shape_tag(s, SURF_PLANE);
    OpticalSurface_set_radius(s, f64_from(0));
    OpticalSurface_set_z_position(s, z_position);
    OpticalSurface_set_n_after(s, n_after);
    OpticalSurface_set_aperture_radius(s, aperture_radius);
    return s;
}

# A ray state during tracing: position, direction (normalized), medium index n.
# position and direction are RayVec3.
#derive(accessors)
struct TraceRay { pos; dir; n; }

#must_use
fn trace_ray_new(pos, dir, n) {
    var r = alloc(sizeof(TraceRay));
    if (r == 0) { return 0; }
    TraceRay_set_pos(r, pos);
    TraceRay_set_dir(r, dir);
    TraceRay_set_n(r, n);
    return r;
}

# Result of tracing through one surface: hit point, outward normal (both
# RayVec3), refracted ray_after (TraceRay), and Fresnel reflectance.
#derive(accessors)
struct TraceHit { hit_point; normal; ray_after; reflectance; }

# Trace a ray through a single optical surface. Returns a TraceHit (0 on error)
# and writes PK_ERR_NONE / PK_ERR_* to err_out. Surfaces are centered on the z
# axis; a spherical surface's center of curvature is at z_position + radius.
#must_use
fn trace_surface(ray, surface, err_out) {
    _prk_trace("trace_surface");
    store64(err_out, PK_ERR_NONE);
    # ⛔ 2.3.5: a null `ray` or `surface` read straight off address 0 and SIGSEGVed
    # — `TraceRay_pos(0)` on the next line. Verified: `trace_surface(0, 0, &e)`
    # exited 139 with a core dump. This is the defect class 2.0.2 swept seven
    # public entry points for and 2.2.8 found four more of; trace_surface was
    # missed by both, and `cyrius coverage` cannot see it because every test calls
    # it with valid handles. The whole tracing stack funnels through here —
    # trace_sequential, trace_sequential_polarized and the recursive tracer all
    # call it in a loop — so one null surface in a caller-built list took the
    # process down rather than reporting. PK_ERR_INVALID_PARAMETER and a 0 return
    # match what the aperture and geometry rejects below already do.
    if (ray == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (surface == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var pos = TraceRay_pos(ray);
    var dir = TraceRay_dir(ray);
    var px = RayVec3_x(pos);
    var py = RayVec3_y(pos);
    var pz = RayVec3_z(pos);
    var dx = RayVec3_x(dir);
    var dy = RayVec3_y(dir);
    var dz = RayVec3_z(dir);
    var z_pos = OpticalSurface_z_position(surface);

    var hit_x = f64_from(0);
    var hit_y = f64_from(0);
    var hit_z = f64_from(0);
    var nx = f64_from(0);
    var ny = f64_from(0);
    var nz = f64_from(0);

    if (OpticalSurface_shape_tag(surface) == SURF_PLANE) {
        # Intersection with the z = z_position plane.
        if (f64_lt(f64_abs(dz), _trace_eps15()) == 1) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        var t = f64_div(f64_sub(z_pos, pz), dz);
        # 2.2.6: was `f64_lt(t, 0)`, which ACCEPTS t == 0 — a ray whose origin
        # already lies on the plane re-hits it at zero distance, so
        # trace_recursive re-enters the same surface forever. The sphere branch
        # below always required t > _trace_eps10(); this now matches it.
        if (f64_gt(t, _trace_eps10()) == 0) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        hit_x = f64_add(px, f64_mul(t, dx));
        hit_y = f64_add(py, f64_mul(t, dy));
        hit_z = f64_add(pz, f64_mul(t, dz));
        # Normal points back against propagation.
        if (f64_gt(dz, f64_from(0)) == 1) {
            nz = f64_neg(F64_ONE);
        } else {
            nz = F64_ONE;
        }
    } else {
        # Spherical surface. Center of curvature at [0, 0, z_pos + radius].
        var radius = OpticalSurface_radius(surface);
        var cz = f64_add(z_pos, radius);
        var ocx = px;
        var ocy = py;
        var ocz = f64_sub(pz, cz);
        var half_b = f64_add(f64_add(f64_mul(ocx, dx), f64_mul(ocy, dy)), f64_mul(ocz, dz));
        var cc = f64_sub(
          f64_add(f64_add(f64_mul(ocx, ocx), f64_mul(ocy, ocy)), f64_mul(ocz, ocz)),
          f64_mul(radius, radius));
        var disc = f64_sub(f64_mul(half_b, half_b), cc);
        if (f64_lt(disc, f64_from(0)) == 1) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        var sqrt_d = f64_sqrt(disc);
        var t1 = f64_sub(f64_neg(half_b), sqrt_d);
        var t2 = f64_add(f64_neg(half_b), sqrt_d);
        # 2.2.6: this took the nearest positive root of the WHOLE sphere. The
        # optical surface is only the cap containing the vertex at z_position —
        # the cap where sign(hit_z - cz) == sign(-radius). For radius > 0 the
        # vertex cap IS the near cap, so convex surfaces were always right; for
        # radius < 0 the vertex cap is the FAR one, so any concave surface
        # reached from outside its own sphere took the back cap. That is not
        # merely a displaced hit: the normal is flipped to face the incoming ray
        # below, so the transverse component comes out with the opposite sign
        # and the concave surface REFRACTS LIKE A CONVEX ONE, with err_out left
        # at PK_ERR_NONE. Measured (radius = -50, z = 0, axis-parallel ray at
        # y = 10): from z = -200 the hit was z = -98.99 with outgoing dy
        # -0.067575; the correct vertex-cap hit is z = -1.010205 with dy
        # +0.067575. The shipped prescriptions all place the concave centre far
        # enough left that the ray starts inside the sphere, which is why the
        # suite never saw it.
        var t = f64_from(0);
        var got = 0;
        if (f64_gt(t1, _trace_eps10()) == 1) {
            if (_trace_on_vertex_cap(pz, dz, t1, cz, radius) == 1) { t = t1; got = 1; }
        }
        if (got == 0) {
            if (f64_gt(t2, _trace_eps10()) == 1) {
                if (_trace_on_vertex_cap(pz, dz, t2, cz, radius) == 1) { t = t2; got = 1; }
            }
        }
        if (got == 0) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        hit_x = f64_add(px, f64_mul(t, dx));
        hit_y = f64_add(py, f64_mul(t, dy));
        hit_z = f64_add(pz, f64_mul(t, dz));
        # Outward normal = (hit - center) / |hit - center|.
        nx = hit_x;
        ny = hit_y;
        nz = f64_sub(hit_z, cz);
        var nlen = f64_sqrt(f64_add(f64_add(f64_mul(nx, nx), f64_mul(ny, ny)), f64_mul(nz, nz)));
        nx = f64_div(nx, nlen);
        ny = f64_div(ny, nlen);
        nz = f64_div(nz, nlen);
        # Ensure the normal faces the incoming ray.
        var dot_dn = f64_add(f64_add(f64_mul(dx, nx), f64_mul(dy, ny)), f64_mul(dz, nz));
        if (f64_gt(dot_dn, f64_from(0)) == 1) {
            nx = f64_neg(nx);
            ny = f64_neg(ny);
            nz = f64_neg(nz);
        }
    }

    # Aperture check.
    var r2 = f64_add(f64_mul(hit_x, hit_x), f64_mul(hit_y, hit_y));
    var ap = OpticalSurface_aperture_radius(surface);
    if (f64_gt(r2, f64_mul(ap, ap)) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }

    # Refract through the surface.
    #
    # ⭐ 2.3.6: Snell answers through stack locals and the five objects below share
    # ONE allocation. This function used to make FIVE separate ones per hit —
    # normal, the refracted direction, hit_point, the after-ray and the TraceHit
    # header, 128 bytes total — and it runs twice per trace_sequential and 38
    # times per spot_diagram.
    #
    # ⚠ The obvious fix is illegal here and was measured to corrupt. CLAUDE.md says
    # "write into a caller buffer, not a fresh allocation", but that rule assumes
    # the CALLER owns the lifetime, and no caller in src/ does: trace_sequential
    # retains every hit in the vec it returns, and _trace_recursive_inner hands
    # best_hit's hit_point to TraceSegments that outlive the trace. A reused buffer
    # aliases them — demonstrated, both entries of the returned vec became the same
    # pointer and the first surface's hit was destroyed, silently and with no error
    # code. Sub-allocating one FRESH block per call keeps lifetimes bit-for-bit
    # what they are today while paying for one alloc instead of five.
    #
    # ⚠ This buys TIME, not memory: the block is the same 128 bytes the five
    # separate objects occupied, so allocation VOLUME is unchanged.
    var refl = f64_from(0);
    var serr = 0;
    var rx = f64_from(0);
    var ry = f64_from(0);
    var rz = f64_from(0);
    var _sr = _ray_snell_3d_out(dir, nx, ny, nz, TraceRay_n(ray),
      OpticalSurface_n_after(surface), &rx, &ry, &rz, &refl, &serr);
    # ⚠ 2.2.8: TOTAL INTERNAL REFLECTION IS A HIT, NOT A MISS. This returned 0
    # for TIR exactly as it does for a geometric miss, and trace_recursive's
    # candidate filter is `prakash_is_err(e) == 0` — so a totally-internally-
    # reflecting surface was dropped from the nearest-surface search and THE RAY
    # PASSED STRAIGHT THROUGH IT. Measured: a ray at 60 deg inside n=1.5
    # (critical angle 41.8 deg) hitting a glass-air plane produced
    # interactions = 0 and a single EVENT_ESCAPED segment at full energy — the
    # defining phenomenon of a prism or a light guide, silently deleted.
    # TIR now returns a real TraceHit carrying the hit point and normal, with
    # reflectance = 1.0 and ray_after = 0 (there is no transmitted ray), while
    # STILL reporting PK_ERR_TIR through err_out. A caller that only checks
    # err_out is unaffected; one that wants to reflect now has the geometry it
    # needs, which it previously could not obtain at all.
    var tir = 0;
    if (prakash_is_err(serr) == 1) {
        if (serr != PK_ERR_TIR) {
            store64(err_out, serr);
            return 0;
        }
        tir = 1;
        refl = F64_ONE;
    }

    # One block: [TraceHit][hit_point][normal][after dir][after ray]. TIR needs
    # only the first three — there is no transmitted ray — so it takes 80 bytes
    # where a refracting hit takes 128. Knowing `tir` before this point is exactly
    # what the _ray_snell_3d_out split above bought. Every offset is a multiple of
    # 8 and alloc returns 16-byte aligned memory.
    var size = _trace_hit_block();
    if (tir == 1) { size = _trace_hit_block_tir(); }
    var hit = alloc(size);
    if (hit == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    var hit_point = hit + sizeof(TraceHit);
    RayVec3_set_x(hit_point, hit_x);
    RayVec3_set_y(hit_point, hit_y);
    RayVec3_set_z(hit_point, hit_z);
    var normal = hit_point + sizeof(RayVec3);
    RayVec3_set_x(normal, nx);
    RayVec3_set_y(normal, ny);
    RayVec3_set_z(normal, nz);
    var ray_after = 0;
    if (tir == 0) {
        var after_dir = normal + sizeof(RayVec3);
        RayVec3_set_x(after_dir, rx);
        RayVec3_set_y(after_dir, ry);
        RayVec3_set_z(after_dir, rz);
        ray_after = after_dir + sizeof(RayVec3);
        TraceRay_set_pos(ray_after, hit_point);
        TraceRay_set_dir(ray_after, after_dir);
        TraceRay_set_n(ray_after, OpticalSurface_n_after(surface));
    }
    TraceHit_set_hit_point(hit, hit_point);
    TraceHit_set_normal(hit, normal);
    TraceHit_set_ray_after(hit, ray_after);
    TraceHit_set_reflectance(hit, refl);
    if (tir == 1) { store64(err_out, PK_ERR_TIR); }
    return hit;
}

# Trace a ray through a sequence of surfaces (a `vec` of OpticalSurface).
# Returns a `vec` of TraceHit (0 on error, with err_out set).
#must_use
fn trace_sequential(initial_ray, surfaces, err_out) {
    _prk_trace("trace_sequential");
    store64(err_out, PK_ERR_NONE);
    var hits = vec_new();
    var current = initial_ray;
    var count = vec_len(surfaces);
    var i = 0;
    while (i < count) {
        var surface = vec_get(surfaces, i);
        var he = 0;
        var hit = trace_surface(current, surface, &he);
        if (prakash_is_err(he) == 1) {
            store64(err_out, he);
            return 0;
        }
        current = TraceHit_ray_after(hit);
        vec_push(hits, hit);
        i = i + 1;
    }
    return hits;
}

# ── Polarization ray tracing ────────

# A geometric hit plus cumulative s/p transmittance and the R_p/R_s ratio.
#derive(accessors)
struct PolarizedTraceHit { hit; rp_over_rs; transmittance_s; transmittance_p; }

# Trace with polarization tracking: at each surface accumulate the s- and
# p-polarized Fresnel transmittances. Returns a `vec` of PolarizedTraceHit
# (0 on error, err_out set).
#must_use
fn trace_sequential_polarized(initial_ray, surfaces, err_out) {
    _prk_trace("trace_sequential_polarized");
    store64(err_out, PK_ERR_NONE);
    var results = vec_new();
    var current = initial_ray;
    var cum_ts = F64_ONE;
    var cum_tp = F64_ONE;
    var count = vec_len(surfaces);
    var i = 0;
    while (i < count) {
        var surface = vec_get(surfaces, i);
        var he = 0;
        var hit = trace_surface(current, surface, &he);
        if (prakash_is_err(he) == 1) {
            store64(err_out, he);
            return 0;
        }
        var nrm = TraceHit_normal(hit);
        var cdir = TraceRay_dir(current);
        var dot_i = f64_add(
          f64_add(f64_mul(RayVec3_x(cdir), RayVec3_x(nrm)), f64_mul(RayVec3_y(cdir), RayVec3_y(nrm))),
          f64_mul(RayVec3_z(cdir), RayVec3_z(nrm)));
        var cos_i = f64_neg(f64_abs(dot_i));
        var adir = TraceRay_dir(TraceHit_ray_after(hit));
        var dot_t = f64_add(
          f64_add(f64_mul(RayVec3_x(adir), RayVec3_x(nrm)), f64_mul(RayVec3_y(adir), RayVec3_y(nrm))),
          f64_mul(RayVec3_z(adir), RayVec3_z(nrm)));
        var cos_t = f64_neg(f64_abs(dot_t));
        var n1 = TraceRay_n(current);
        var n2 = OpticalSurface_n_after(surface);
        var rs = fresnel_s(n1, n2, cos_i, cos_t);
        var rp = fresnel_p(n1, n2, cos_i, cos_t);
        cum_ts = f64_mul(cum_ts, f64_sub(F64_ONE, rs));
        cum_tp = f64_mul(cum_tp, f64_sub(F64_ONE, rp));
        var rp_over_rs = f64_from(0);
        if (f64_gt(rs, _trace_eps15()) == 1) {
            rp_over_rs = f64_div(rp, rs);
        }
        var pth = alloc(sizeof(PolarizedTraceHit));
        if (pth == 0) { return 0; }
        PolarizedTraceHit_set_hit(pth, hit);
        PolarizedTraceHit_set_rp_over_rs(pth, rp_over_rs);
        PolarizedTraceHit_set_transmittance_s(pth, cum_ts);
        PolarizedTraceHit_set_transmittance_p(pth, cum_tp);
        vec_push(results, pth);
        current = TraceHit_ray_after(hit);
        i = i + 1;
    }
    return results;
}
