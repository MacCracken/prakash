# serialize.cyr -- JSON (de)serialization for the types that had serde derives
# Usage: include "lib/serialize.cyr"  (requires the type modules + bayan)
#
# Ported from the Rust `#[derive(Serialize, Deserialize)]` types that had serde
# roundtrip tests: Rgb, Medium, SellmeierCoefficients, LensType, Polarization,
# Prescription, Spd. Uses the bayan recipe — build with str_from() keys/values +
# v_float_new(bits), parse with parse_buf(data,len); *_from_json takes (data ptr,
# byte len) since bayan's build output Str is not NUL-terminated.
#
# FLOAT FIDELITY: since bayan 1.2.1 the encoder is Grisu2 round-trip-correct, so
# f64 values survive a to_json/from_json cycle BIT-EXACTLY. (Before that it
# rendered 6 decimals, which silently flushed any |x| < 5e-7 to zero — prakash
# 2.0.0 shipped against that encoder.)
#
# FAILURE CONVENTION (2.1.0): every `*_from_json` takes a trailing `err_out`
# pointer, per the library-wide convention in error.cyr. It writes PK_ERR_NONE on
# entry and one of these on failure, returning 0:
#
#   PK_ERR_PARSE              the bytes are not well-formed JSON, or the document
#                             is not the type the decoder needs (bad bytes)
#   PK_ERR_INVALID_PARAMETER  parsed fine, but a required field is absent or of
#                             the wrong type (wrong schema)
#   PK_ERR_ALLOCATION         a caller-sized buffer could not be allocated
#
# Callers: `var e = 0; var c = rgb_from_json(p, n, &e); if (prakash_is_err(e))`.
# `lens_type_from_json` still returns LENS_TYPE_INVALID as its in-band failure
# value, since 0 is already LENS_CONVERGING.
#
# Before 2.0.2 these paths either dereferenced null and aborted the process
# (`str_data(0)` is `load64(0)`) or silently fabricated a zero-valued struct,
# because every bayan accessor returns 0 for a missing or wrong-typed node and 0
# is the bit pattern for 0.0. 2.0.2 made them fail safely; 2.1.0 makes them say
# why.

# Returned by lens_type_from_json when the input is not a known lens type.
# Distinct from LENS_CONVERGING (0) and LENS_DIVERGING (1).
var LENS_TYPE_INVALID = (0 - 1);

# ── decode helpers ────────
#
# Each helper writes its own failure code into `err_out` and returns a zero
# value. Callers read several fields in a row and then test `err_out` ONCE, so
# `err_out` doubles as the failure accumulator — the first code written is not
# overwritten by a later success, because success never writes.

# Parse `json`/`len` and require a JSON object. Returns the value, or 0 with
# PK_ERR_PARSE.
#must_use
fn _ser_obj(json, len, err_out) {
    var v = bayan_json_v_parse_buf(json, len);
    if (v == 0) {
        store64(err_out, PK_ERR_PARSE);
        return 0;
    }
    if (bayan_json_v_is_obj(v) == 0) {
        store64(err_out, PK_ERR_PARSE);
        return 0;
    }
    return v;
}

# Read a required numeric field. JSON integers are accepted as well as floats
# (bayan tags `1` as JTAG_INT and `1.0` as JTAG_FLOAT; both are valid f64 input).
# A missing or wrong-typed field writes PK_ERR_INVALID_PARAMETER and returns 0.0.
#must_use
fn _ser_num(v, key, err_out) {
    var node = bayan_json_v_obj_get(v, key);
    if (bayan_json_v_is_float(node) == 1) { return bayan_json_v_float(node); }
    if (bayan_json_v_is_int(node) == 1) { return bayan_json_v_float(node); }
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return f64_from(0);
}

# Read a required numeric field that may legitimately be non-finite. JSON has no
# infinity literal, so bayan encodes a non-finite f64 as `null`; this restores
# +inf for it. Used for an optical surface radius, where `null` means a FLAT
# surface (radius = infinity, i.e. zero curvature). Without this, a plano
# surface decoded as 0.0 — a zero radius, i.e. INFINITE curvature, the exact
# physical inverse.
#must_use
fn _ser_num_or_inf(v, key, err_out) {
    var node = bayan_json_v_obj_get(v, key);
    if (bayan_json_v_is_null(node) == 1) { return 0x7FF0000000000000; }
    if (bayan_json_v_is_float(node) == 1) { return bayan_json_v_float(node); }
    if (bayan_json_v_is_int(node) == 1) { return bayan_json_v_float(node); }
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return f64_from(0);
}

# Read a required string field. Returns a cstring, or 0 with
# PK_ERR_INVALID_PARAMETER.
#must_use
fn _ser_str(v, key, err_out) {
    var node = bayan_json_v_obj_get(v, key);
    if (bayan_json_v_is_str(node) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var s = bayan_json_v_str(node);
    if (s == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return str_data(s);
}

# ── Rgb (spectral) ────────

# Rgb -> JSON Str: {"r":..,"g":..,"b":..}.
#must_use
fn rgb_to_json(c) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (c == 0) { return 0; }
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("r"), bayan_json_v_float_new(Rgb_r(c)));
    bayan_json_v_obj_set(o, str_from("g"), bayan_json_v_float_new(Rgb_g(c)));
    bayan_json_v_obj_set(o, str_from("b"), bayan_json_v_float_new(Rgb_b(c)));
    return bayan_json_v_build(o);
}

# JSON -> Rgb. Sets err_out and returns 0 if r/g/b are not all present and
# numeric.
#must_use
fn rgb_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var r = _ser_num(v, "r", err_out);
    var g = _ser_num(v, "g", err_out);
    var b = _ser_num(v, "b", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var built = rgb_new(r, g, b);
    if (built == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return built;
}

# ── Medium (ray) ────────

# Medium -> JSON Str: {"n":..,"name":".."}.
#must_use
fn medium_to_json(m) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (m == 0) { return 0; }
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("n"), bayan_json_v_float_new(Medium_n(m)));
    bayan_json_v_obj_set(o, str_from("name"), bayan_json_v_str_new(str_from(Medium_name(m))));
    return bayan_json_v_build(o);
}

# JSON -> Medium. Sets err_out and returns 0 if "n" is not numeric or "name" is
# not a string.
#must_use
fn medium_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var n = _ser_num(v, "n", err_out);
    var name = _ser_str(v, "name", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    # 2.2.6: was `_medium_mk(n, name)`, which skips the n >= 1.0 check that
    # medium_custom enforces — a document carrying "n": -0.5 minted a Medium
    # with a negative refractive index and reported PK_ERR_NONE. Routing
    # through medium_custom makes the decoder honour the same invariant as the
    # constructor, reporting PK_ERR_INVALID_INDEX instead.
    var built = medium_custom(n, name, err_out);
    if (built == 0) {
        if (prakash_is_err(load64(err_out)) == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    }
    return built;
}

# ── SellmeierCoefficients (ray) ────────

# SellmeierCoefficients -> JSON Str: {"b1":..,"c1":..,"b2":..,"c2":..,"b3":..,"c3":..}.
#must_use
fn sellmeier_to_json(s) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (s == 0) { return 0; }
    var o = bayan_json_v_obj_new();
    bayan_json_v_obj_set(o, str_from("b1"), bayan_json_v_float_new(SellmeierCoefficients_b1(s)));
    bayan_json_v_obj_set(o, str_from("c1"), bayan_json_v_float_new(SellmeierCoefficients_c1(s)));
    bayan_json_v_obj_set(o, str_from("b2"), bayan_json_v_float_new(SellmeierCoefficients_b2(s)));
    bayan_json_v_obj_set(o, str_from("c2"), bayan_json_v_float_new(SellmeierCoefficients_c2(s)));
    bayan_json_v_obj_set(o, str_from("b3"), bayan_json_v_float_new(SellmeierCoefficients_b3(s)));
    bayan_json_v_obj_set(o, str_from("c3"), bayan_json_v_float_new(SellmeierCoefficients_c3(s)));
    return bayan_json_v_build(o);
}

# JSON -> SellmeierCoefficients. Sets err_out and returns 0 if any of the six
# terms is missing or non-numeric.
#must_use
fn sellmeier_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var b1 = _ser_num(v, "b1", err_out);
    var c1 = _ser_num(v, "c1", err_out);
    var b2 = _ser_num(v, "b2", err_out);
    var c2 = _ser_num(v, "c2", err_out);
    var b3 = _ser_num(v, "b3", err_out);
    var c3 = _ser_num(v, "c3", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var built = _sellmeier_mk(b1, c1, b2, c2, b3, c3);
    if (built == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return built;
}

# ── LensType (lens) ────────

# LensType -> JSON Str: bare "Converging" / "Diverging" (serde unit-variant).
#must_use
fn lens_type_to_json(lt) {
    if (lt == LENS_CONVERGING) {
        return bayan_json_v_build(bayan_json_v_str_new(str_from("Converging")));
    }
    return bayan_json_v_build(bayan_json_v_str_new(str_from("Diverging")));
}

# JSON -> LensType. Returns LENS_TYPE_INVALID (and sets err_out) for anything
# that is not one of the two unit-variant strings — 0 is already LENS_CONVERGING,
# so the return value alone cannot signal failure.
#must_use
fn lens_type_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = bayan_json_v_parse_buf(json, len);
    if (v == 0) {
        store64(err_out, PK_ERR_PARSE);
        return LENS_TYPE_INVALID;
    }
    if (bayan_json_v_is_str(v) == 0) {
        store64(err_out, PK_ERR_PARSE);
        return LENS_TYPE_INVALID;
    }
    var s = bayan_json_v_str(v);
    if (s == 0) {
        store64(err_out, PK_ERR_PARSE);
        return LENS_TYPE_INVALID;
    }
    var t = str_data(s);
    if (streq(t, "Converging") == 1) { return LENS_CONVERGING; }
    if (streq(t, "Diverging") == 1) { return LENS_DIVERGING; }
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return LENS_TYPE_INVALID;
}

