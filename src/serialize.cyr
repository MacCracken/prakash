# serialize.cyr -- JSON (de)serialization for the types that had serde derives
# Usage: include "lib/serialize.cyr"  (requires the type modules + bayan)
#
# Ported from the Rust `#[derive(Serialize, Deserialize)]` types that had serde
# roundtrip tests: Rgb, Medium, SellmeierCoefficients, LensType, Polarization,
# Prescription, Spd. Uses the bayan recipe — build with str_from() keys/values +
# v_float_new(bits), parse with parse_buf(data,len); *_from_json takes (data ptr,
# byte len) since bayan's build output Str is not NUL-terminated.
#
# FLOAT FIDELITY: since bayan 1.2.1 the ENCODER is Grisu2 round-trip-correct — it
# always emits the shortest string that parses back to the original bits. (Before
# that it rendered 6 decimals, which silently flushed any |x| < 5e-7 to zero —
# prakash 2.0.0 shipped against that encoder.)
# ⛔ 2.4.9: "survives a to_json/from_json cycle BIT-EXACTLY" WAS STATED HERE WITHOUT
# QUALIFICATION, AND IT IS NOT TRUE. The encoder is right; bayan's DECODER
# (`_d_decimal_to_f64`, vendored in lib/bayan.cyr) mis-rounds a small fraction of
# the strings it is handed by exactly 1 ULP. Measured with seeded random doubles
# through rgb_to_json -> rgb_from_json: **2 in 200,000 with |x| in 1e-16..1e16** —
# prakash's own magnitude band, e.g. 1.621274542797433e-9 comes back one ULP high —
# and 5 in 200,000 across the full exponent range. A correctly-rounded parser
# (Python's float()) returns the ORIGINAL bits from every one of those strings, so
# the defect is the decoder, not the text. There is no band in which it cannot
# happen; it is rare, not absent. Upstream's to fix (CLAUDE.md: never edit lib/);
# tests/hardening.tcyr pins a known-failing value so this note retires itself.
# 2.5.0: filed upstream as bayan docs/development/issues/
# 2026-09-22-prakash-f64-parse-double-rounding-at-midpoint.md. Root cause: the
# slow path rounds W*10^E to 64 bits, which lands near-midpoint values EXACTLY on
# the midpoint, then breaks that false tie to even — so the error is 1 ULP in
# EITHER direction (13 up, 14 down of 27 cases) and only ever hits odd doubles.
# Re-measured by direct to_json/from_json at 1.5.6: 22 per 10^6 across all
# doubles.
#
# FAILURE CONVENTION (2.1.0): every `*_from_json` takes a trailing `err_out`
# pointer, per the library-wide convention in error.cyr. It writes PK_ERR_NONE on
# entry and one of these on failure, returning 0:
#
#   PK_ERR_PARSE              the bytes are not well-formed JSON, or the document
#                             is not the type the decoder needs (bad bytes)
#   PK_ERR_INVALID_PARAMETER  parsed fine, but a required field is absent or of
#                             the wrong type (wrong schema)
#   PK_ERR_ALLOCATION         a caller-sized buffer could not be allocated
#
# Callers: `var e = 0; var c = rgb_from_json(p, n, &e); if (prakash_is_err(e))`.
# `lens_type_from_json` still returns LENS_TYPE_INVALID as its in-band failure
# value, since 0 is already LENS_CONVERGING.
#
# Before 2.0.2 these paths either dereferenced null and aborted the process
# (`str_data(0)` is `load64(0)`) or silently fabricated a zero-valued struct,
# because every bayan accessor returns 0 for a missing or wrong-typed node and 0
# is the bit pattern for 0.0. 2.0.2 made them fail safely; 2.1.0 makes them say
# why.

# Returned by lens_type_from_json when the input is not a known lens type.
# Distinct from LENS_CONVERGING (0) and LENS_DIVERGING (1).
var LENS_TYPE_INVALID = (0 - 1);

# ── decode helpers ────────
#
# Each helper writes its own failure code into `err_out` and returns a zero
# value. Callers read several fields in a row and then test `err_out` ONCE, so
# `err_out` doubles as the failure accumulator — the first code written is not
# overwritten by a later success, because success never writes.

# Parse `json`/`len` and require a JSON object. Returns the value, or 0 with
# PK_ERR_PARSE.
#must_use
fn _ser_obj(json, len, err_out) {
    # 2.4.9: a null buffer with a nonzero length was read straight off address 0
    # inside bayan (vendored, not ours to guard), so every decoder routed through
    # here exited 139 on it. This is the untrusted-input boundary; report PARSE.
    if (json == 0) {
        store64(err_out, PK_ERR_PARSE);
        return 0;
    }
    var v = bayan_json_v_parse_buf(json, len);
    if (v == 0) {
        store64(err_out, PK_ERR_PARSE);
        return 0;
    }
    if (bayan_json_v_is_obj(v) == 0) {
        store64(err_out, PK_ERR_PARSE);
        return 0;
    }
    return v;
}

# Read a required numeric field. JSON integers are accepted as well as floats
# (bayan tags `1` as JTAG_INT and `1.0` as JTAG_FLOAT; both are valid f64 input).
# A missing or wrong-typed field writes PK_ERR_INVALID_PARAMETER and returns 0.0.
#must_use
fn _ser_num(v, key, err_out) {
    var node = bayan_json_v_obj_get(v, key);
    if (bayan_json_v_is_float(node) == 1) { return bayan_json_v_float(node); }
    if (bayan_json_v_is_int(node) == 1) { return bayan_json_v_float(node); }
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return f64_from(0);
}

# Read a required numeric field that may legitimately be non-finite. JSON has no
# infinity literal, so bayan encodes a non-finite f64 as `null`; this restores
# +inf for it. Used for an optical surface radius, where `null` means a FLAT
# surface (radius = infinity, i.e. zero curvature). Without this, a plano
# surface decoded as 0.0 — a zero radius, i.e. INFINITE curvature, the exact
# physical inverse.
#must_use
fn _ser_num_or_inf(v, key, err_out) {
    var node = bayan_json_v_obj_get(v, key);
    if (bayan_json_v_is_null(node) == 1) { return 0x7FF0000000000000; }
    if (bayan_json_v_is_float(node) == 1) { return bayan_json_v_float(node); }
    if (bayan_json_v_is_int(node) == 1) { return bayan_json_v_float(node); }
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return f64_from(0);
}

# Read a required string field. Returns a cstring, or 0 with
# PK_ERR_INVALID_PARAMETER.
#must_use
fn _ser_str(v, key, err_out) {
    var node = bayan_json_v_obj_get(v, key);
    if (bayan_json_v_is_str(node) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var s = bayan_json_v_str(node);
    if (s == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return str_data(s);
}

# 1 if `bits` is a NaN: exponent all ones with a nonzero mantissa. A signed
# compare is exact here because masking the sign bit leaves a non-negative i64.
fn _ser_is_nan(bits) {
    if ((bits & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000) { return 1; }
    return 0;
}

# ── Rgb (spectral) ────────

# Append one f64 to a str_builder in bayan's JSON form.
#
# Uses `bayan_f64_to_json` — the SAME Grisu2 renderer bayan's own value-tree
# walker uses — so a hand-assembled document is byte-identical to the tree-built
# one. Non-finite values render as `null`, exactly as the tree path does.
#
# ⚠ Placed ABOVE rgb_to_json's doc block, not between it and its function. The
# first attempt in 2.3.4 inserted it in the gap and silently took rgb_to_json's
# `#must_use` with it — the third time this session that landing a function
# between a doc block and its target rebound the attribute. `cyrius audit`
# reported only "1 undocumented public fn"; the lost `#must_use` was invisible.
#
# ⛔ NOT `#must_use`, and that is deliberate as of 2.3.9. It carried the attribute
# from 2.3.4 while all 15 of its own call sites discard the result — cycc warns
# `#must_use result of '_ser_sb_f64' is discarded` at every one. ⚠ `cyrius lint`
# does NOT report that class, so it only surfaces under `cyrius build`/`bench`,
# which is how it went unnoticed for two releases. The attribute was also
# inconsistent with its neighbours: none of the 40-odd `str_builder_add_cstr`
# calls in this file checks its return either. The failure mode here is OOM
# inside a str_builder, which the surrounding code does not handle at any site;
# marking one helper and not the rest bought nothing.
fn _ser_sb_f64(sb, bits) {
    var fb[64];
    var fl = bayan_f64_to_json(bits, &fb);
    store8(&fb + fl, 0);
    return str_builder_add_cstr(sb, &fb);
}

# Rgb -> JSON Str: {"r":..,"g":..,"b":..}.
#must_use
fn rgb_to_json(c) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (c == 0) { return 0; }
    # 2.3.5: emitted straight into a str_builder instead of through a bayan value
    # tree. See _ser_sb_f64 and the [2.3.5] CHANGELOG entry for why; output is
    # byte-identical and pinned in tests/serialize.tcyr.
    var sb = str_builder_new();
    if (sb == 0) { return 0; }
    str_builder_add_cstr(sb, "{\"r\":");
    _ser_sb_f64(sb, Rgb_r(c));
    str_builder_add_cstr(sb, ",\"g\":");
    _ser_sb_f64(sb, Rgb_g(c));
    str_builder_add_cstr(sb, ",\"b\":");
    _ser_sb_f64(sb, Rgb_b(c));
    str_builder_putc(sb, 125);
    return str_builder_build(sb);
}

# JSON -> Rgb. Sets err_out and returns 0 if r/g/b are not all present and
# numeric.
#must_use
fn rgb_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var r = _ser_num(v, "r", err_out);
    var g = _ser_num(v, "g", err_out);
    var b = _ser_num(v, "b", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var built = rgb_new(r, g, b);
    if (built == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return built;
}

# ── Medium (ray) ────────

# Medium -> JSON Str: {"n":..,"name":".."}.
#must_use
fn medium_to_json(m) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (m == 0) { return 0; }
    # 2.3.5: emitted straight into a str_builder instead of through a bayan value
    # tree. See _ser_sb_f64 and the [2.3.5] CHANGELOG entry for why; output is
    # byte-identical and pinned in tests/serialize.tcyr.
    var sb = str_builder_new();
    if (sb == 0) { return 0; }
    str_builder_add_cstr(sb, "{\"n\":");
    _ser_sb_f64(sb, Medium_n(m));
    str_builder_add_cstr(sb, ",\"name\":");
    str_builder_add_json_str(sb, str_from(Medium_name(m)));
    str_builder_putc(sb, 125);
    return str_builder_build(sb);
}

# JSON -> Medium. Sets err_out and returns 0 if "n" is not numeric or "name" is
# not a string.
#must_use
fn medium_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var n = _ser_num(v, "n", err_out);
    var name = _ser_str(v, "name", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    # 2.2.6: was `_medium_mk(n, name)`, which skips the n >= 1.0 check that
    # medium_custom enforces — a document carrying "n": -0.5 minted a Medium
    # with a negative refractive index and reported PK_ERR_NONE. Routing
    # through medium_custom makes the decoder honour the same invariant as the
    # constructor, reporting PK_ERR_INVALID_INDEX instead.
    var built = medium_custom(n, name, err_out);
    if (built == 0) {
        if (prakash_is_err(load64(err_out)) == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    }
    return built;
}

# ── SellmeierCoefficients (ray) ────────

# SellmeierCoefficients -> JSON Str: {"b1":..,"c1":..,"b2":..,"c2":..,"b3":..,"c3":..}.
#must_use
fn sellmeier_to_json(s) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (s == 0) { return 0; }
    # 2.3.5: emitted straight into a str_builder instead of through a bayan value
    # tree. See _ser_sb_f64 and the [2.3.5] CHANGELOG entry for why; output is
    # byte-identical and pinned in tests/serialize.tcyr.
    var sb = str_builder_new();
    if (sb == 0) { return 0; }
    str_builder_add_cstr(sb, "{\"b1\":");
    _ser_sb_f64(sb, SellmeierCoefficients_b1(s));
    str_builder_add_cstr(sb, ",\"c1\":");
    _ser_sb_f64(sb, SellmeierCoefficients_c1(s));
    str_builder_add_cstr(sb, ",\"b2\":");
    _ser_sb_f64(sb, SellmeierCoefficients_b2(s));
    str_builder_add_cstr(sb, ",\"c2\":");
    _ser_sb_f64(sb, SellmeierCoefficients_c2(s));
    str_builder_add_cstr(sb, ",\"b3\":");
    _ser_sb_f64(sb, SellmeierCoefficients_b3(s));
    str_builder_add_cstr(sb, ",\"c3\":");
    _ser_sb_f64(sb, SellmeierCoefficients_c3(s));
    str_builder_putc(sb, 125);
    return str_builder_build(sb);
}

# JSON -> SellmeierCoefficients. Sets err_out and returns 0 if any of the six
# terms is missing or non-numeric.
#must_use
fn sellmeier_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var b1 = _ser_num(v, "b1", err_out);
    var c1 = _ser_num(v, "c1", err_out);
    var b2 = _ser_num(v, "b2", err_out);
    var c2 = _ser_num(v, "c2", err_out);
    var b3 = _ser_num(v, "b3", err_out);
    var c3 = _ser_num(v, "c3", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var built = _sellmeier_mk(b1, c1, b2, c2, b3, c3);
    if (built == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return built;
}

# ── LensType (lens) ────────

# LensType -> JSON Str: bare "Converging" / "Diverging" (serde unit-variant).
#must_use
fn lens_type_to_json(lt) {
    # 2.3.5: both variants are fixed ASCII with nothing JSON-escapable, so the
    # quoted form is a literal. This was 5 allocations and 472 ns to produce one
    # of two constant strings; it is now one str_from.
    if (lt == LENS_CONVERGING) {
        return str_from("\"Converging\"");
    }
    return str_from("\"Diverging\"");
}

# JSON -> LensType. Returns LENS_TYPE_INVALID (and sets err_out) for anything
# that is not one of the two unit-variant strings — 0 is already LENS_CONVERGING,
# so the return value alone cannot signal failure.
#must_use
fn lens_type_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    # The one decoder that does not enter through _ser_obj, so it needs its own.
    if (json == 0) {
        store64(err_out, PK_ERR_PARSE);
        return LENS_TYPE_INVALID;
    }
    var v = bayan_json_v_parse_buf(json, len);
    if (v == 0) {
        store64(err_out, PK_ERR_PARSE);
        return LENS_TYPE_INVALID;
    }
    if (bayan_json_v_is_str(v) == 0) {
        store64(err_out, PK_ERR_PARSE);
        return LENS_TYPE_INVALID;
    }
    var s = bayan_json_v_str(v);
    if (s == 0) {
        store64(err_out, PK_ERR_PARSE);
        return LENS_TYPE_INVALID;
    }
    var t = str_data(s);
    if (streq(t, "Converging") == 1) { return LENS_CONVERGING; }
    if (streq(t, "Diverging") == 1) { return LENS_DIVERGING; }
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return LENS_TYPE_INVALID;
}

# ── Polarization (wave) ────────

# Polarization -> JSON Str: {"ex":..,"ey":..,"phase":..}.
#must_use
fn polarization_to_json(p) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (p == 0) { return 0; }
    # 2.3.5: emitted straight into a str_builder instead of through a bayan value
    # tree. See _ser_sb_f64 and the [2.3.5] CHANGELOG entry for why; output is
    # byte-identical and pinned in tests/serialize.tcyr.
    var sb = str_builder_new();
    if (sb == 0) { return 0; }
    str_builder_add_cstr(sb, "{\"ex\":");
    _ser_sb_f64(sb, Polarization_ex(p));
    str_builder_add_cstr(sb, ",\"ey\":");
    _ser_sb_f64(sb, Polarization_ey(p));
    str_builder_add_cstr(sb, ",\"phase\":");
    _ser_sb_f64(sb, Polarization_phase(p));
    str_builder_putc(sb, 125);
    return str_builder_build(sb);
}

# JSON -> Polarization. Sets err_out and returns 0 if ex/ey/phase are not all
# present and numeric.
#must_use
fn polarization_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var ex = _ser_num(v, "ex", err_out);
    var ey = _ser_num(v, "ey", err_out);
    var phase = _ser_num(v, "phase", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var built = polarization_new(ex, ey, phase);
    if (built == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return built;
}

# ── Prescription (ray/system) ────────

# Prescription -> JSON Str: {"name":..,"surfaces":[{radius,thickness,n_after,
# aperture_radius}...],"n_initial":..}. A flat surface has radius = infinity,
# which JSON cannot express; bayan encodes it as `null` and
# `prescription_from_json` restores it (see `_ser_num_or_inf`).
#must_use
fn prescription_to_json(p) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (p == 0) { return 0; }
    # ⛔ 2.4.9: REFUSE A NaN RATHER THAN LAUNDER IT INTO A VALID LENS. JSON has no
    # NaN, so bayan writes every non-finite f64 as `null` — and the decoder reads a
    # null RADIUS as +inf, a flat surface (_ser_num_or_inf, which exists because a
    # plano surface must survive). So a corrupt or uninitialised radius went in as
    # garbage and came out as a legitimate, silently different lens, with
    # err = PK_ERR_NONE on the way back. A NaN in any other field encoded as null
    # and was REJECTED on decode — loud, but the encoder had still emitted a document
    # its own decoder refuses. Either way the right answer is to not emit it: return
    # the 0 sentinel, the same one a null handle gets.
    if (_ser_is_nan(Prescription_n_initial(p)) == 1) { return 0; }
    var ns = Prescription_surfaces(p);
    for (var ci = 0; ci < vec_len(ns); ci = ci + 1) {
        var cs = vec_get(ns, ci);
        if (_ser_is_nan(PrescriptionSurface_radius(cs)) == 1) { return 0; }
        if (_ser_is_nan(PrescriptionSurface_thickness(cs)) == 1) { return 0; }
        if (_ser_is_nan(PrescriptionSurface_n_after(cs)) == 1) { return 0; }
        if (_ser_is_nan(PrescriptionSurface_aperture_radius(cs)) == 1) { return 0; }
    }
    # 2.3.5: emitted straight into a str_builder instead of through a bayan value
    # tree. See _ser_sb_f64 and the [2.3.5] CHANGELOG entry for why; output is
    # byte-identical and pinned in tests/serialize.tcyr.
    var sb = str_builder_new();
    if (sb == 0) { return 0; }
    str_builder_add_cstr(sb, "{\"name\":");
    str_builder_add_json_str(sb, str_from(Prescription_name(p)));
    str_builder_add_cstr(sb, ",\"surfaces\":[");
    var vec = Prescription_surfaces(p);
    var n = vec_len(vec);
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { str_builder_putc(sb, 44); }
        var surf = vec_get(vec, i);
        str_builder_add_cstr(sb, "{\"radius\":");
        _ser_sb_f64(sb, PrescriptionSurface_radius(surf));
        str_builder_add_cstr(sb, ",\"thickness\":");
        _ser_sb_f64(sb, PrescriptionSurface_thickness(surf));
        str_builder_add_cstr(sb, ",\"n_after\":");
        _ser_sb_f64(sb, PrescriptionSurface_n_after(surf));
        str_builder_add_cstr(sb, ",\"aperture_radius\":");
        _ser_sb_f64(sb, PrescriptionSurface_aperture_radius(surf));
        str_builder_putc(sb, 125);
    }
    str_builder_add_cstr(sb, "],\"n_initial\":");
    _ser_sb_f64(sb, Prescription_n_initial(p));
    str_builder_putc(sb, 125);
    return str_builder_build(sb);
}

# JSON -> Prescription. Sets err_out and returns 0 if the name, n_initial,
# surfaces array, or any surface field is missing or of the wrong type.
#must_use
fn prescription_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var name = _ser_str(v, "name", err_out);
    var n_initial = _ser_num(v, "n_initial", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var surfaces_v = bayan_json_v_obj_get(v, "surfaces");
    if (bayan_json_v_is_arr(surfaces_v) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var p = prescription_new(name);
    if (p == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    Prescription_set_n_initial(p, n_initial);
    for (var i = 0; i < bayan_json_v_arr_len(surfaces_v); i = i + 1) {
        var so = bayan_json_v_arr_get(surfaces_v, i);
        if (bayan_json_v_is_obj(so) == 0) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        var radius = _ser_num_or_inf(so, "radius", err_out);
        var thickness = _ser_num(so, "thickness", err_out);
        var n_after = _ser_num(so, "n_after", err_out);
        var aperture_radius = _ser_num(so, "aperture_radius", err_out);
        if (prakash_is_err(load64(err_out)) == 1) { return 0; }
        # A dropped surface would return a Prescription with FEWER elements
        # than the document and PK_ERR_NONE — a silently different lens.
        if (prescription_add_surface(p, radius, thickness, n_after, aperture_radius) == 0) {
            store64(err_out, PK_ERR_ALLOCATION);
            return 0;
        }
    }
    return p;
}

# ── Spd (spectral/cie) ────────

# Spd -> JSON Str: {"start_nm":..,"step_nm":..,"values":[..]}.
#must_use
fn spd_to_json(s) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (s == 0) { return 0; }
    # ⛔ 2.4.9: an EMPTY Spd encoded to {"start_nm":..,"step_nm":..,"values":[]},
    # which spd_from_json then rejected with PK_ERR_INVALID_PARAMETER (its `n <= 0`
    # check is deliberate). A document prakash produced that prakash refuses to
    # read breaks the round-trip property the module exists for. The decoder's
    # strictness stands; the encoder now declines to emit what it would refuse.
    if (Spd_len(s) <= 0) { return 0; }
    # ⭐ 2.3.4: emitted straight into a str_builder rather than through a bayan
    # value tree. An Spd carries ~81 samples, so the tree form allocated a JSON
    # float node AND a vec push PER SAMPLE — 162 allocations for one call — to
    # build a structure whose only consumer was the serializer three lines later.
    #
    # Measured same-binary with interleaved arms: **71.76 -> 67.59 us (-5.8%)**,
    # and allocation volume **6,808 -> 2,576 bytes per call (-62%)** for D65 — the
    # cost tracks the rendered decimal length of the values, not only the sample
    # count, so at 81 samples it spans 1,464 (F2) to 5,632 (a 5000 K blackbody).
    # ⚠ The memory figure is the one that matters: prakash's bump allocator NEVER FREES, so
    # every spd_to_json call permanently consumed 6.8 KB. A consumer serializing a
    # few thousand SPDs was giving up ~27 MB it could never get back.
    #
    # ⚠ Grisu2 is UNTOUCHED and deliberately so. `bayan_f64_to_json` is the same
    # renderer the tree path used; it is ~68% of this function's cost and it is
    # why the EMITTED text is round-trip-correct — decoding is bayan's and is not
    # always exact, see the file header (2.3.3 measured it at 671 ns against
    # 66 ns for the 6-decimal renderer it replaced, which silently flushed
    # |x| < 5e-7 to zero). Only the tree is skipped, never the float path.
    #
    # Output is BYTE-IDENTICAL, pinned by tests/serialize.tcyr against the exact
    # wire format: {"start_nm":380.0,"step_nm":5.0,"values":[...]} — no spaces,
    # keys in insertion order.
    var sb = str_builder_new();
    if (sb == 0) { return 0; }
    str_builder_add_cstr(sb, "{\"start_nm\":");
    _ser_sb_f64(sb, Spd_start_nm(s));
    str_builder_add_cstr(sb, ",\"step_nm\":");
    _ser_sb_f64(sb, Spd_step_nm(s));
    str_builder_add_cstr(sb, ",\"values\":[");
    var data = Spd_values(s);
    var n = Spd_len(s);
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { str_builder_putc(sb, 44); }
        _ser_sb_f64(sb, load64(data + i * 8));
    }
    str_builder_add_cstr(sb, "]}");
    return str_builder_build(sb);
}

# JSON -> Spd. Sets err_out and returns 0 if start_nm/step_nm are not numeric,
# "values" is not a non-empty array, an element is not numeric, or the sample
# buffer cannot be allocated.
#must_use
fn spd_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var start_nm = _ser_num(v, "start_nm", err_out);
    var step_nm = _ser_num(v, "step_nm", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var vals_v = bayan_json_v_obj_get(v, "values");
    if (bayan_json_v_is_arr(vals_v) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var n = bayan_json_v_arr_len(vals_v);
    if (n <= 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # `alloc` returns 0 past ALLOC_MAX or on heap exhaustion; `n` comes from the
    # input, so this must be checked before the fill loop stores through it.
    var data = alloc(n * 8);
    if (data == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    for (var i = 0; i < n; i = i + 1) {
        var e = bayan_json_v_arr_get(vals_v, i);
        if (bayan_json_v_is_float(e) == 0) {
            if (bayan_json_v_is_int(e) == 0) {
                store64(err_out, PK_ERR_INVALID_PARAMETER);
                return 0;
            }
        }
        store64(data + i * 8, bayan_json_v_float(e));
    }
    var built = spd_new(start_nm, step_nm, data, n);
    if (built == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return built;
}
