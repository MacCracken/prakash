# ai.cyr -- daimon/hoosh AI client (OUT of the core distlib bundle)
# Usage: include "lib/ai.cyr"  (requires error.cyr; bayan for JSON; sandhi for HTTP)
#
# Ported from the Rust `ai.rs`. This module is deliberately NOT in the prakash
# [lib] bundle — it pulls the sandhi HTTP/TLS stack, mirroring the old `ai` cargo
# feature. Consumers opt in explicitly (stdlib: bayan, sandhi + companions).
#
# String fields are cstrings; Option<String> api_key = cstr or 0 (None).
# JSON via bayan: build with str_from() keys/values, parse with parse_buf
# (str_data,str_len) — the built Str is not NUL-terminated.
#
# FAILURE CONVENTION (2.1.0): `*_from_json` takes a trailing `err_out` pointer
# per the library-wide convention in error.cyr — PK_ERR_NONE on entry, then
# PK_ERR_PARSE for bytes that are not well-formed JSON (or not an object),
# PK_ERR_INVALID_PARAMETER for a document that parsed but has no string
# "endpoint", or PK_ERR_ALLOCATION if the config cannot be allocated; 0 is
# returned in every failure case. The constructors still return a bare 0 on a
# failed allocation. Before 2.0.2 these paths dereferenced null and aborted the
# process; every bayan accessor returns 0 for a missing or wrong-typed node, and
# `str_data(0)` is `load64(0)`.

#derive(accessors)
struct DaimonConfig { endpoint; api_key; }

#derive(accessors)
struct HooshConfig { endpoint; }

#derive(accessors)
struct DaimonClient { config; }

# ── DaimonConfig ────────

#must_use
fn ai_daimon_config_new(endpoint, api_key) {
    var c = alloc(sizeof(DaimonConfig));
    if (c == 0) { return 0; }
    DaimonConfig_set_endpoint(c, endpoint);
    DaimonConfig_set_api_key(c, api_key);
    return c;
}

# Read a required string field out of a parsed JSON object. Returns a cstring,
# or 0 (writing err_out) when `v` is not an object, the key is absent, or the
# value is not a string. Guards the whole chain that used to end in
# `str_data(0)`.
#must_use
fn _ai_json_str_field(v, key, err_out) {
    if (v == 0) {
        store64(err_out, PK_ERR_PARSE);
        return 0;
    }
    # A non-object document is bad SHAPE, not a bad field: the module contract
    # (and the sibling serialize family, via _ser_obj) reports PK_ERR_PARSE.
    if (bayan_json_v_is_obj(v) == 0) {
        store64(err_out, PK_ERR_PARSE);
        return 0;
    }
    var node = bayan_json_v_obj_get(v, key);
    if (bayan_json_v_is_str(node) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var s = bayan_json_v_str(node);
    if (s == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return str_data(s);
}

# Default daimon config: endpoint http://localhost:8090, no api key.
#must_use
fn ai_daimon_config_default() {
    return ai_daimon_config_new("http://localhost:8090", 0);
}

# ── HooshConfig ────────

#must_use
fn ai_hoosh_config_new(endpoint) {
    var c = alloc(sizeof(HooshConfig));
    if (c == 0) { return 0; }
    HooshConfig_set_endpoint(c, endpoint);
    return c;
}

# Default hoosh config: endpoint http://localhost:8088.
#must_use
fn ai_hoosh_config_default() {
    return ai_hoosh_config_new("http://localhost:8088");
}

# ── DaimonClient ────────

# Create a daimon client from config (30s timeout is applied per-request in
# register_agent via sandhi options). Returns 0 with PK_ERR_ALLOCATION if the
# handle cannot be allocated.
#must_use
fn ai_daimon_client_new(config, err_out) {
    store64(err_out, PK_ERR_NONE);
    var cl = alloc(sizeof(DaimonClient));
    if (cl == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    DaimonClient_set_config(cl, config);
    return cl;
}

# ── JSON serialization (bayan) ────────

# DaimonConfig -> JSON Str: {"endpoint":"...","api_key":"..."|null}.
#must_use
fn ai_daimon_config_to_json(config) {
    var obj = bayan_json_v_obj_new();
    bayan_json_v_obj_set(obj, str_from("endpoint"),
      bayan_json_v_str_new(str_from(DaimonConfig_endpoint(config))));
    var ak = DaimonConfig_api_key(config);
    if (ak == 0) {
        bayan_json_v_obj_set(obj, str_from("api_key"), bayan_json_v_null());
    } else {
        bayan_json_v_obj_set(obj, str_from("api_key"), bayan_json_v_str_new(str_from(ak)));
    }
    return bayan_json_v_build(obj);
}

# JSON (data ptr + byte length) -> DaimonConfig (api_key = 0 when null/absent).
# Sets err_out and returns 0 if the input does not parse, or has no string
# "endpoint". `api_key` is genuinely optional and never sets err_out.
#must_use
fn ai_daimon_config_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = bayan_json_v_parse_buf(json, len);
    var endpoint = _ai_json_str_field(v, "endpoint", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var ak_v = bayan_json_v_obj_get(v, "api_key");
    var api_key = 0;
    if (bayan_json_v_is_str(ak_v) == 1) {
        api_key = str_data(bayan_json_v_str(ak_v));
    }
    var c = ai_daimon_config_new(endpoint, api_key);
    if (c == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return c;
}

# HooshConfig -> JSON Str: {"endpoint":"..."}.
#must_use
fn ai_hoosh_config_to_json(config) {
    var obj = bayan_json_v_obj_new();
    bayan_json_v_obj_set(obj, str_from("endpoint"),
      bayan_json_v_str_new(str_from(HooshConfig_endpoint(config))));
    return bayan_json_v_build(obj);
}

# JSON (data ptr + byte length) -> HooshConfig. Sets err_out and returns 0 if
# the input does not parse, or has no string "endpoint".
#must_use
fn ai_hoosh_config_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = bayan_json_v_parse_buf(json, len);
    var endpoint = _ai_json_str_field(v, "endpoint", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var c = ai_hoosh_config_new(endpoint);
    if (c == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return c;
}

# ── Agent registration (sandhi HTTP POST) ────────

# Register prakash as an agent with the daimon service. Blocking sandhi POST of
# {"name":"prakash","capabilities":[...]} to <endpoint>/v1/agents/register;
# returns the "agent_id" cstring ("unknown" if absent). Sets err_out on failure.
#
# Not unit-tested — needs a live daimon server (matches the Rust module, which
# has no register_agent test).
#must_use
fn ai_register_agent(client, err_out) {
    store64(err_out, PK_ERR_NONE);
    var config = DaimonClient_config(client);
    # Request body: {"name":"prakash","capabilities":[...5 caps...]}
    var body = bayan_json_v_obj_new();
    bayan_json_v_obj_set(body, str_from("name"), bayan_json_v_str_new(str_from("prakash")));
    var caps = bayan_json_v_arr_new();
    bayan_json_v_arr_push(caps, bayan_json_v_str_new(str_from("optics")));
    bayan_json_v_arr_push(caps, bayan_json_v_str_new(str_from("ray_tracing")));
    bayan_json_v_arr_push(caps, bayan_json_v_str_new(str_from("spectral")));
    bayan_json_v_arr_push(caps, bayan_json_v_str_new(str_from("pbr")));
    bayan_json_v_arr_push(caps, bayan_json_v_str_new(str_from("wave_optics")));
    bayan_json_v_obj_set(body, str_from("capabilities"), caps);
    var body_str = bayan_json_v_build(body);
    # URL: endpoint + "/v1/agents/register". `str_cat` returns a Str whose buffer
    # is exactly la+lb bytes with NO terminator, but sandhi consumes the URL as a
    # cstring (sandhi_url_parse_a runs off the end), so it must be terminated
    # explicitly — `str_cstr` copies into a len+1 buffer and stores the NUL.
    var url_s = str_cat(str_from(DaimonConfig_endpoint(config)), str_from("/v1/agents/register"));
    if (url_s == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return "unknown";
    }
    var url = str_cstr(url_s);
    if (url == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return "unknown";
    }
    var headers = sandhi_headers_new();
    sandhi_headers_set(headers, "content-type", "application/json");
    var opts = sandhi_http_options_new();
    sandhi_http_options_total_ms(opts, 30000);
    var resp = sandhi_http_post_opts(url, headers, str_data(body_str),
      str_len(body_str), opts);
    if (sandhi_http_err_kind(resp) != SANDHI_OK) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return "unknown";
    }
    var data = bayan_json_v_parse_buf(sandhi_http_body(resp), sandhi_http_body_len(resp));
    if (data == 0) {
        # invalid registration response (parse failure) -> error, matches Rust
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return "unknown";
    }
    var aid = bayan_json_v_obj_get(data, "agent_id");
    if (bayan_json_v_is_str(aid) == 1) {
        return str_data(bayan_json_v_str(aid));
    }
    return "unknown";
}
