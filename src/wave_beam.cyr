# wave_beam.cyr -- Gaussian beam optics: TEM00 parameters, q-parameter ABCD
# propagation, Hermite-Gaussian and Laguerre-Gaussian modes, M^2, and the orbital
# angular momentum of LG beams
# Usage: include "lib/wave_beam.cyr"  (requires error.cyr; ganita for atan2)
#
# New in 2.6.0, and NOT a port. The Rust 1.x crate re-exported bijli's Gaussian
# beam and ABCD types until 1.2.0 removed them, so there is no fidelity reference
# for anything here: every formula is checked against the literature instead —
# Siegman, "Lasers" (1986) ch. 16-21; Saleh & Teich, "Fundamentals of Photonics"
# ch. 3; ISO 11146-1 for second-moment widths and M^2; Allen, Beijersbergen,
# Spreeuw & Woerdman, Phys. Rev. A 45, 8185 (1992) for OAM.
#
# CONVENTIONS — read these before comparing a value against another source:
# - Lengths are in any ONE unit (the tests use metres). `wavelength` is the
#   wavelength IN THE MEDIUM the beam travels through, lambda0/n.
# - w is the 1/e^2 INTENSITY radius, which is also the ISO 11146 second-moment
#   radius of a TEM00 beam — not the 1/e field radius.
# - Time dependence e^{+i*omega*t} (Siegman; Saleh & Teich), so the carrier is
#   e^{-ikz}. It is common to every mode at a given plane and is omitted from the
#   fields below.
# - q = z + i*z_R, with z measured from the waist and positive downstream, so
#   1/q = 1/R - i*lambda/(pi*w^2) and R > 0 past the waist (a diverging beam).
# - An LG field carries e^{-i*l*phi}. In this time convention that is +l*hbar of
#   orbital angular momentum per photon; the physics convention writes the same
#   real field as e^{+i*l*phi} e^{-i*omega*t}.

fn _bm_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# 1 if x is finite and strictly positive. f64_gt is false for NaN, so NaN fails.
fn _bm_pos(x) {
    if (f64_gt(x, 0) == 0) { return 0; }
    if (x == _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite (not NaN, not +-inf).
fn _bm_finite(x) {
    if ((x & _PRK_ABS) >= _PRK_INF) { return 0; }
    return 1;
}

# Validate a waist radius and wavelength: both finite and positive. On failure
# writes PK_ERR_INVALID_PARAMETER and returns 0.
fn _bm_check(w0, wavelength, err_out) {
    if (_bm_pos(w0) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_pos(wavelength) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return 1;
}

# 1 if x is finite and >= 0 (-0.0 included). f64_ge is false for NaN.
fn _bm_nonneg(x) {
    if (f64_ge(x, 0) == 0) { return 0; }
    if (x == _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite, positive and NORMAL (>= 2^-1022). A subnormal Rayleigh range
# or Im q carries only a few bits, and everything built on it (the Gouy step, w,
# 1/R) silently lost precision — round 2 measured 1e-4 errors and a Gouy
# increment of exactly 0 — so results must be normal, not merely positive.
fn _bm_normal(x) {
    if (_bm_pos(x) == 0) { return 0; }
    if ((x & 0x7FF0000000000000) == 0) { return 0; }
    return 1;
}

# max(|x|, |y|) rounded DOWN to a power of two, for scaling before squaring
# (2^-1022 when both are zero or subnormal). Dividing by a power of two is exact,
# so a formula evaluated on x/h, y/h and rescaled gives the SAME BITS as the
# unscaled one wherever that one does not over- or underflow — and a finite
# answer where it would have. For non-negative finite doubles the bit patterns
# order like the values, so the max is an integer compare.
fn _bm_scale2(x, y) {
    var ax = x & _PRK_ABS;
    var ay = y & _PRK_ABS;
    var m = ax;
    if (ay > ax) { m = ay; }
    var e = m & 0x7FF0000000000000;
    if (e == 0) { return 0x0010000000000000; }
    return e;
}

# 1 - e^(-x) for x >= 0 without cancellation at small x. Kahan's expm1 identity:
# with u = e^(-x), (1-u)/(-ln u) corrects the rounding in u and in 1-u together.
# The same construction as spectral_core's `_expm1`, INCLUDING its saturation
# guard — repeated rather than shared because no module reaches into another's
# private helpers.
# ⛔ 2.6.0 review: the first version dropped that guard and kept only `u == 0`,
# which fires after FULL underflow (x > 745.13). Between x ~ 708 and 745 u is
# subnormal, carries a few bits, and ln(u) misses -x by up to 0.7, so the ratio
# wandered either side of 1: gaussian_power_fraction(w, 19.3w) returned 1.00073,
# a "fraction" above 1, non-monotone in a. Once 1 - u rounds to 1 there is nothing
# left to correct, so it returns exactly 1.
fn _bm_one_minus_exp_neg(x) {
    var u = _prk_exp(f64_neg(x));
    if (u == F64_ONE) { return x; }
    var om = f64_sub(F64_ONE, u);
    if (om == F64_ONE) { return F64_ONE; }
    return f64_div(f64_mul(om, x), f64_neg(f64_ln(u)));
}

# ── TEM00: the fundamental Gaussian beam ────────

# Rayleigh range z_R = pi*w0^2/lambda, the distance from the waist at which the
# beam area has doubled. Writes PK_ERR_INVALID_PARAMETER (returns 0) unless w0
# and wavelength are finite and positive and z_R itself is a finite, NORMAL
# double (>= 2^-1022) — every closed form below and gaussian_beam_new inherit that, so
# none of them builds on a z_R that has overflowed or underflowed.
#must_use
fn gaussian_rayleigh_range(w0, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_check(w0, wavelength, err_out) == 0) { return 0; }
    # w0*(w0/lambda), not w0^2/lambda: the square cannot overflow or underflow
    # while the answer is representable.
    var zr = f64_mul(F64_PI, f64_mul(w0, f64_div(w0, wavelength)));
    if (_bm_normal(zr) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return zr;
}

# Beam radius at distance z from the waist: w(z) = w0*sqrt(1 + (z/z_R)^2).
# Writes PK_ERR_INVALID_PARAMETER (returns 0) for a bad w0/wavelength or a
# non-finite z.
#must_use
fn gaussian_beam_radius(w0, wavelength, z, err_out) {
    var zr = gaussian_rayleigh_range(w0, wavelength, err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    if (_bm_finite(z) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var t = f64_div(z, zr);
    # Past |t| = 2^27, sqrt(1 + t^2) rounds to |t| exactly; returning it there keeps
    # the same bits and cannot overflow through t^2.
    if ((t & _PRK_ABS) > 0x41A0000000000000) { return f64_mul(w0, f64_abs(t)); }
    return f64_mul(w0, f64_sqrt(f64_add(F64_ONE, f64_mul(t, t))));
}

# Wavefront curvature 1/R(z) = z/(z^2 + z_R^2). It is 0 at the waist, where the
# wavefront is plane, and largest in magnitude at z = +-z_R. Errors as
# gaussian_beam_radius.
#must_use
fn gaussian_curvature(w0, wavelength, z, err_out) {
    var zr = gaussian_rayleigh_range(w0, wavelength, err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    if (_bm_finite(z) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # Scaled by a power of two before squaring (see _bm_scale2): same bits in range.
    var h = _bm_scale2(z, zr);
    var zs = f64_div(z, h);
    var rs = f64_div(zr, h);
    return f64_div(f64_div(zs, f64_add(f64_mul(zs, zs), f64_mul(rs, rs))), h);
}

# Wavefront radius of curvature R(z) = z*(1 + (z_R/z)^2). The wavefront is plane
# at the waist, so z = 0 returns +inf (0x7FF0000000000000) — a real answer, not
# an error. Prefer gaussian_curvature, which is finite everywhere. Errors as
# gaussian_beam_radius.
#must_use
fn gaussian_radius_of_curvature(w0, wavelength, z, err_out) {
    var zr = gaussian_rayleigh_range(w0, wavelength, err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    if (_bm_finite(z) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if ((z & _PRK_ABS) == 0) { return _PRK_INF; }
    var h = _bm_scale2(z, zr);
    var zs = f64_div(z, h);
    var rs = f64_div(zr, h);
    return f64_mul(f64_div(f64_add(f64_mul(zs, zs), f64_mul(rs, rs)), zs), h);
}

# Gouy phase psi(z) = atan(z/z_R): the extra phase a focused beam gains over a
# plane wave, -pi/2 -> +pi/2 through the focus. Errors as gaussian_beam_radius.
#must_use
fn gaussian_gouy_phase(w0, wavelength, z, err_out) {
    var zr = gaussian_rayleigh_range(w0, wavelength, err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    if (_bm_finite(z) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return ganita_f64_atan2(z, zr);
}

# Far-field half-angle divergence theta = lambda/(pi*w0) (radians), the
# asymptote of w(z)/z. Errors as gaussian_rayleigh_range.
#must_use
fn gaussian_divergence(w0, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_check(w0, wavelength, err_out) == 0) { return 0; }
    return f64_div(wavelength, f64_mul(F64_PI, w0));
}

# Intensity of a TEM00 beam of total power P at radius r and distance z:
# I = (2P/(pi*w^2))*exp(-2r^2/w^2). The 2/(pi*w^2) makes the integral over the
# plane equal P. Errors as gaussian_beam_radius, and for a power that is
# negative or not finite, or an r that is not finite (a power carries no sign:
# a negative one would come back as a plausible negative intensity).
#must_use
fn gaussian_intensity(power, w0, wavelength, r, z, err_out) {
    var w = gaussian_beam_radius(w0, wavelength, z, err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    if ((_bm_nonneg(power) & _bm_finite(r)) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # pi*w^2 on w scaled by a power of two: same bits in range, and no spurious
    # 0 or inf where w^2 alone over- or underflows (round 2).
    var h = _bm_scale2(w, w);
    var ws = f64_div(w, h);
    var peak = f64_div(f64_div(f64_div(f64_mul(F64_TWO, power), f64_mul(F64_PI, f64_mul(ws, ws))), h), h);
    var t = f64_div(r, w);
    return f64_mul(peak, _prk_exp(f64_neg(f64_mul(F64_TWO, f64_mul(t, t)))));
}

# Fraction of a TEM00 beam's power inside a centred circle of radius a, at a
# plane where the beam radius is w: 1 - exp(-2a^2/w^2). a = w gives 86.47%.
# Writes PK_ERR_INVALID_PARAMETER (returns 0) unless w is finite and positive
# and a is finite.
#must_use
fn gaussian_power_fraction(w, a, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_pos(w) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_finite(a) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # Square the RATIO: a^2 and w^2 formed separately overflow (or underflow) to
    # inf/inf = NaN for large (small) lengths, though the answer depends on a/w only.
    var t = f64_div(a, w);
    return _bm_one_minus_exp_neg(f64_mul(F64_TWO, f64_mul(t, t)));
}

# Beam radius of a real beam with quality factor M^2 >= 1 (ISO 11146):
# W(z) = W0*sqrt(1 + (z*M^2*lambda/(pi*W0^2))^2). Its Rayleigh range is
# z_R/M^2 and its divergence M^2 times a TEM00 beam's of the same waist. Errors
# as gaussian_beam_radius, and for M^2 < 1 (no beam beats a TEM00).
#must_use
fn gaussian_beam_radius_m2(w0, wavelength, m2, z, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_finite(m2) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (f64_lt(m2, F64_ONE) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return gaussian_beam_radius(w0, f64_mul(wavelength, m2), z, err_out);
}

# ── The q parameter: a beam carried through ABCD optics ────────
#
# A GaussianBeam is the state of one TEM00 beam (or the embedded Gaussian of a
# mode family) at one plane: q = q_re + i*q_im, the local wavelength, and the
# accumulated Gouy phase. The element functions below update it IN PLACE — the
# bump allocator never frees, so a builder that returned a fresh struct per
# element would leak one per call.
#
# ABCD matrices act on (height, REAL slope), so a lossless element has
# det = AD - BC = n_in/n_out. The local wavelength is updated by that same
# determinant, which makes every element change the medium consistently without
# being told the indices: free space, lenses and mirrors have det = 1, an
# interface n1 -> n2 has det = n1/n2 and lambda2 = lambda1*n1/n2.
#
# Gouy phase through an element is -arg(A + B/q) (Siegman §20.2): atan(z/z_R)
# for free space from a waist; 0 for an element with B = 0 and A > 0 (a lens,
# mirror or interface); pi for B = 0 and A < 0 — an inverting relay such as a 4f
# telescope or 2f-2f imaging, whose output is the input field inverted and scaled
# by 1/A. The field of a mode of order N carries (N+1) times it, so only its value
# modulo 2*pi matters to a field and each element contributes its principal value.
# Checked in the 2.6.0 review against FFT angular-spectrum propagation (lens +
# free space, diverging lenses, virtual waists, A < 0, curved interfaces into
# glass): phase, amplitude 1/|A + B/q| and q agree to 1e-12.

#derive(accessors)
struct GaussianBeam { q_re; q_im; wavelength; gouy; }

fn _bm_new(q_re, q_im, wavelength, gouy) {
    var b = alloc(sizeof(GaussianBeam));
    if (b == 0) { return 0; }
    GaussianBeam_set_q_re(b, q_re);
    GaussianBeam_set_q_im(b, q_im);
    GaussianBeam_set_wavelength(b, wavelength);
    GaussianBeam_set_gouy(b, gouy);
    return b;
}

# New beam at its waist (q = i*z_R, Gouy phase 0). Writes
# PK_ERR_INVALID_PARAMETER for a bad w0/wavelength and PK_ERR_ALLOCATION if the
# struct cannot be allocated; returns 0 on either.
#must_use
fn gaussian_beam_new(w0, wavelength, err_out) {
    var zr = gaussian_rayleigh_range(w0, wavelength, err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var b = _bm_new(0, zr, wavelength, 0);
    if (b == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return b;
}

# New beam from a q parameter at the current plane: q_re is the distance past
# the waist (negative before it), q_im the Rayleigh range. The Gouy phase starts
# at the local atan(q_re/q_im), so free propagation continues the TEM00 law.
# Writes PK_ERR_INVALID_PARAMETER unless q_re is finite, q_im is finite, positive
# and normal (>= 2^-1022), and wavelength is finite and positive;
# PK_ERR_ALLOCATION on allocation failure.
#must_use
fn gaussian_beam_from_q(q_re, q_im, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_finite(q_re) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_check(q_im, wavelength, err_out) == 0) { return 0; }
    if (_bm_normal(q_im) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var b = _bm_new(q_re, q_im, wavelength, ganita_f64_atan2(q_re, q_im));
    if (b == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return b;
}

# Apply a general ray-transfer matrix [[a, b], [c, d]] (height, real slope):
# q' = (a*q + b)/(c*q + d), wavelength' = wavelength*(ad - bc), Gouy phase
# advanced by -arg(a + b/q). Returns PK_ERR_NONE; PK_ERR_INVALID_PARAMETER for a
# null beam, a non-finite entry, ad - bc <= 0 (no lossless element has one), or a
# result that is not representable — q' not finite with Im q' a normal positive
# double, or a wavelength that over- or underflows (the entries must then be
# ~1e150 or beyond); PK_ERR_DIVISION_BY_ZERO if c*q + d = 0, which needs c = d = 0 and so
# is already refused as det = 0. Every check precedes every store: the beam is
# untouched on error.
fn beam_abcd(beam, a, b, c, d) {
    if (beam == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_bm_finite(a) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_bm_finite(b) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_bm_finite(c) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_bm_finite(d) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var det = f64_sub(f64_mul(a, d), f64_mul(b, c));
    if (_bm_pos(det) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var qr = GaussianBeam_q_re(beam);
    var qi = GaussianBeam_q_im(beam);
    var dr = f64_add(f64_mul(c, qr), d);
    var di = f64_mul(c, qi);
    if (((dr | di) & _PRK_ABS) == 0) { return PK_ERR_DIVISION_BY_ZERO; }
    # |cq + d|^2 is formed on (dr, di) scaled by a power of two (_bm_scale2): the
    # same bits wherever the plain square is representable, and no spurious
    # overflow or underflow where it is not. Division by hd is exact.
    var hd = _bm_scale2(dr, di);
    var drs = f64_div(dr, hd);
    var dis = f64_div(di, hd);
    var dens = f64_add(f64_mul(drs, drs), f64_mul(dis, dis));
    var nr = f64_add(f64_mul(a, qr), b);
    var ni = f64_mul(a, qi);
    var new_qr = f64_div(f64_div(f64_add(f64_mul(nr, drs), f64_mul(ni, dis)), dens), hd);
    # Im q' = det*Im(q)/|cq + d|^2 exactly; written that way rather than as
    # ni*dr - nr*di, whose two a*c*qr*qi terms cancel only to rounding.
    var new_qi = f64_div(f64_div(f64_div(f64_mul(det, qi), dens), hd), hd);
    # With det > 0 these two cannot fail in exact arithmetic; they catch q' over-
    # or underflowing when the entries are ~1e150 or beyond.
    if (_bm_normal(new_qi) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_bm_finite(new_qr) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var new_wl = f64_mul(GaussianBeam_wavelength(beam), det);
    if (_bm_normal(new_wl) == 0) { return PK_ERR_INVALID_PARAMETER; }
    # -arg(a + b/q) = atan2(b*qi, a*|q|^2 + b*qr): both parts divided by the power
    # of two hq (atan2 is unchanged, the bits are the same in range), so |q|^2 can
    # neither overflow into a 0*inf = NaN for an a = 0 element nor underflow.
    var hq = _bm_scale2(qr, qi);
    var qrs = f64_div(qr, hq);
    var qis = f64_div(qi, hq);
    var q2s = f64_add(f64_mul(qrs, qrs), f64_mul(qis, qis));
    var dpsi = ganita_f64_atan2(f64_mul(b, qis), f64_add(f64_mul(f64_mul(a, hq), q2s), f64_mul(b, qrs)));
    GaussianBeam_set_q_re(beam, new_qr);
    GaussianBeam_set_q_im(beam, new_qi);
    GaussianBeam_set_wavelength(beam, new_wl);
    GaussianBeam_set_gouy(beam, f64_add(GaussianBeam_gouy(beam), dpsi));
    return PK_ERR_NONE;
}

# Propagate a distance d through a uniform medium: q' = q + d (exact). Negative
# d propagates backwards. Errors as beam_abcd.
fn beam_propagate(beam, d) {
    return beam_abcd(beam, F64_ONE, d, 0, F64_ONE);
}

# Thin lens of focal length f (> 0 converging): 1/q' = 1/q - 1/f. Returns
# PK_ERR_DIVISION_BY_ZERO for f = 0; otherwise errors as beam_abcd.
fn beam_thin_lens(beam, f) {
    if (beam == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((f & _PRK_ABS) == 0) { return PK_ERR_DIVISION_BY_ZERO; }
    return beam_abcd(beam, F64_ONE, 0, f64_div(f64_neg(F64_ONE), f), F64_ONE);
}

# Reflection from a mirror of radius R, unfolded so the beam keeps travelling
# in +z: C = -2/R, R > 0 for a concave (focusing) mirror. A flat mirror is
# R = +inf. Returns PK_ERR_DIVISION_BY_ZERO for R = 0; otherwise errors as
# beam_abcd.
fn beam_mirror(beam, radius) {
    if (beam == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((radius & _PRK_ABS) == 0) { return PK_ERR_DIVISION_BY_ZERO; }
    if ((radius & _PRK_ABS) > _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    return beam_abcd(beam, F64_ONE, 0, f64_div(f64_neg(F64_TWO), radius), F64_ONE);
}

# Refraction at a spherical interface from index n1 into n2, radius R > 0 when
# the centre of curvature lies downstream (a convex face toward the beam):
# [[1, 0], [(n1 - n2)/(n2*R), n1/n2]]. A flat interface is R = +inf. Returns
# PK_ERR_INVALID_PARAMETER unless n1, n2 are finite and positive,
# PK_ERR_DIVISION_BY_ZERO for R = 0; otherwise errors as beam_abcd.
fn beam_curved_interface(beam, n1, n2, radius) {
    if (beam == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_bm_pos(n1) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_bm_pos(n2) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((radius & _PRK_ABS) == 0) { return PK_ERR_DIVISION_BY_ZERO; }
    if ((radius & _PRK_ABS) > _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    var c = f64_div(f64_sub(n1, n2), f64_mul(n2, radius));
    return beam_abcd(beam, F64_ONE, 0, c, f64_div(n1, n2));
}

# Refraction at a flat interface from index n1 into n2: q' = q*n2/n1, and the
# wavelength becomes wavelength*n1/n2. The beam radius is continuous. Errors as
# beam_curved_interface.
fn beam_interface(beam, n1, n2) {
    return beam_curved_interface(beam, n1, n2, _PRK_INF);
}

# ── Queries (NaN for a null beam: 0 is a legitimate value for most) ────────

# Beam radius w at the current plane: w^2 = lambda*|q|^2/(pi*Im q).
#must_use
fn beam_radius(beam) {
    if (beam == 0) { return _PRK_NAN; }
    var qr = GaussianBeam_q_re(beam);
    var qi = GaussianBeam_q_im(beam);
    # w = h*sqrt(lambda*|q/h|^2/(pi*Im q)) for the power of two h: h^2 = 4^k, so
    # the sqrt takes it out exactly and the bits match the unscaled form in range.
    var h = _bm_scale2(qr, qi);
    var qrs = f64_div(qr, h);
    var qis = f64_div(qi, h);
    var q2s = f64_add(f64_mul(qrs, qrs), f64_mul(qis, qis));
    return f64_mul(h, f64_sqrt(f64_div(f64_mul(GaussianBeam_wavelength(beam), q2s), f64_mul(F64_PI, qi))));
}

# Waist radius w0 of the beam's current Gaussian: sqrt(lambda*z_R/pi).
#must_use
fn beam_waist_radius(beam) {
    if (beam == 0) { return _PRK_NAN; }
    # beam_radius at Re q = 0, in the same scaled form: w0 = h*sqrt(lambda*(qi/h)^2/(pi*qi)).
    var qi = GaussianBeam_q_im(beam);
    var h = _bm_scale2(0, qi);
    var qis = f64_div(qi, h);
    var num = f64_mul(GaussianBeam_wavelength(beam), f64_mul(qis, qis));
    return f64_mul(h, f64_sqrt(f64_div(num, f64_mul(F64_PI, qi))));
}

# Distance from the current plane to the waist, positive when the waist lies
# ahead (downstream) and negative when it is behind: -Re q.
#must_use
fn beam_waist_distance(beam) {
    if (beam == 0) { return _PRK_NAN; }
    return f64_neg(GaussianBeam_q_re(beam));
}

# Wavefront curvature 1/R = Re q/|q|^2 at the current plane: > 0 diverging,
# < 0 converging, 0 at a waist.
#must_use
fn beam_curvature(beam) {
    if (beam == 0) { return _PRK_NAN; }
    var qr = GaussianBeam_q_re(beam);
    var qi = GaussianBeam_q_im(beam);
    var h = _bm_scale2(qr, qi);
    var qrs = f64_div(qr, h);
    var qis = f64_div(qi, h);
    return f64_div(f64_div(qrs, f64_add(f64_mul(qrs, qrs), f64_mul(qis, qis))), h);
}

# Rayleigh range of the beam's current Gaussian: Im q.
#must_use
fn beam_rayleigh_range(beam) {
    if (beam == 0) { return _PRK_NAN; }
    return GaussianBeam_q_im(beam);
}

# The beam's Gouy phase (radians), for TEM00: its starting value — 0 from
# gaussian_beam_new, the local atan(Re q/Im q) from gaussian_beam_from_q and
# beam_resonator_mode — plus every element's increment. A mode of order N (m+n
# for HG, 2p+|l| for LG) carries (N+1) times it. From a waist through free space
# alone this is atan(z/z_R).
#must_use
fn beam_gouy_phase(beam) {
    if (beam == 0) { return _PRK_NAN; }
    return GaussianBeam_gouy(beam);
}

# ── Resonators and mode matching ────────

# The self-consistent TEM00 mode of a resonator whose ROUND-TRIP matrix, taken
# from the reference plane, is [[a, b], [c, d]]: the q that the round trip maps
# to itself, 1/q = (d - a)/(2b) - i*sqrt(4 - (a + d)^2)/(2|b|) (Kogelnik & Li,
# Appl. Opt. 5, 1550, 1966). Returns a new beam at the reference plane, or 0
# with PK_ERR_INVALID_PARAMETER if the resonator is unstable or on a stability
# edge (see below), b = 0, an entry is not finite, or ad - bc is not within 1e-9
# of 1 (a round trip starts and ends in the same medium); PK_ERR_ALLOCATION on
# allocation failure. Its Gouy phase starts at the local atan(Re q/Im q).
# ⚠ STABILITY EDGES ARE REFUSED, with a margin. At |a + d| = 2 — the confocal,
# concentric and planar/hemispherical edges — the round trip does not select a
# mode: a symmetric confocal cavity's is exactly -I, so every q reproduces itself.
# Built in floating point it comes out as -I plus ~1e-16 of noise, and a bare
# `s > 0` test then returned a q made of rounding error, as success (2.6.0
# review). So (ad - bc) - ((a + d)/2)^2 must exceed 1e-12*(|a| + |d|): cavities within
# g ~ 5e-7 of an edge are refused. The textbook confocal spot sqrt(lambda*L/pi)
# is the g -> 0 limit of a nearby cavity, not a property of the matrix.
#must_use
fn beam_resonator_mode(a, b, c, d, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    var ok = _bm_finite(a) & _bm_finite(b) & _bm_finite(c) & _bm_finite(d);
    if (ok == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # A divide guard only: with b = 0 and det = 1, |a + d| >= 2 already refuses it.
    if ((b & _PRK_ABS) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # f64_le, not "f64_gt(...) == 1 refuses": a NaN determinant (a*d and b*c
    # overflowing to like infinities) compares false both ways and must fail.
    var det = f64_sub(f64_mul(a, d), f64_mul(b, c));
    if (f64_le(f64_abs(f64_sub(det, F64_ONE)), _bm_r(1, 1000000000)) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var half_tr = f64_div(f64_add(a, d), F64_TWO);
    # (ad - bc) - ((a+d)/2)^2, NOT 1 - ((a+d)/2)^2: the det check above admits
    # |det - 1| up to 1e-9, 500x the stability margin, so assuming det = 1 judged a
    # DIFFERENT matrix and returned modes for unstable input (round 2). With the
    # real det, dd = (d-a)^2 + 4s = -4bc exactly and q is the true fixed point.
    var s = f64_sub(det, f64_mul(half_tr, half_tr));
    var s_tol = f64_mul(_bm_r(1, 1000000000000), f64_add(f64_abs(a), f64_abs(d)));
    if (f64_gt(s, s_tol) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # q directly, not as the reciprocal of 1/q (which went subnormal for |b| >~
    # 1e155): with D = d - a and dd = D^2 + 4s = -4bc > 0,
    #   Re q = 2b*D/dd,  Im q = 4|b|*sqrt(s)/dd.
    var dma = f64_sub(d, a);
    var dd = f64_add(f64_mul(dma, dma), f64_mul(f64_from(4), s));
    var q_re = f64_div(f64_mul(f64_mul(F64_TWO, b), dma), dd);
    var q_im = f64_div(f64_mul(f64_mul(f64_from(4), f64_abs(b)), f64_sqrt(s)), dd);
    return gaussian_beam_from_q(q_re, q_im, wavelength, err_out);
}

# Power coupling efficiency between two TEM00 beams at the same plane — the
# squared overlap of their normalised fields:
# eta = 4 / ((w1/w2 + w2/w1)^2 + (pi*w1*w2/lambda)^2*(1/R1 - 1/R2)^2).
# Axes are taken as coincident and parallel. At two waists it reduces to
# ray_fiber's coupling_efficiency_gaussian. Writes PK_ERR_INVALID_PARAMETER
# (returns 0) for a null beam or wavelengths that differ by more than 1e-9
# relative (different media: no single overlap exists).
#must_use
fn beam_coupling_efficiency(beam1, beam2, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (beam1 == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (beam2 == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var wl = GaussianBeam_wavelength(beam1);
    var dwl = f64_abs(f64_sub(wl, GaussianBeam_wavelength(beam2)));
    if (f64_gt(dwl, f64_mul(wl, _bm_r(1, 1000000000))) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var w1 = beam_radius(beam1);
    var w2 = beam_radius(beam2);
    var ratio = f64_add(f64_div(w1, w2), f64_div(w2, w1));
    var dc = f64_sub(beam_curvature(beam1), beam_curvature(beam2));
    var t = f64_mul(f64_div(f64_mul(F64_PI, f64_mul(w1, w2)), wl), dc);
    return f64_div(f64_from(4), f64_add(f64_mul(ratio, ratio), f64_mul(t, t)));
}

# ── Orthogonal polynomials ────────

# Physicists' Hermite polynomial H_n(x), by the recurrence
# H_{k+1} = 2x*H_k - 2k*H_{k-1}, H_0 = 1, H_1 = 2x (Abramowitz & Stegun
# 22.7.13). |H_n(x)| grows like (2n/e)^(n/2) for bounded x (DLMF 18.15.26) and
# like (2x)^n for |x| >> sqrt(n), so it overflows for n >~ 250 at EVERY x — even
# x = 0 for even n. The mode fields below use the normalised Hermite functions,
# which do not. NaN for n < 0 (0 is a legitimate value).
# x = 0 is evaluated in closed form, H_odd(0) = 0 and H_2m(0) = (-1)^m (2m)!/m!:
# the recurrence there forms 0*inf once the even iterates overflow (n ~ 270) and
# returned NaN for an exact zero (2.6.0 review).
#must_use
fn hermite_poly(n, x) {
    if (n < 0) { return _PRK_NAN; }
    if (n == 0) { return F64_ONE; }
    if ((x & _PRK_ABS) == 0) {
        if ((n & 1) == 1) { return 0; }
        # H_2m = -2(2m-1)*H_{2m-2} at x = 0 — the recurrence's own step, exactly.
        var h0 = F64_ONE;
        for (var j = 2; j <= n; j = j + 2) { h0 = f64_mul(h0, f64_from(0 - 2 * (j - 1))); }
        return h0;
    }
    var two_x = f64_mul(F64_TWO, x);
    var hm1 = F64_ONE;
    var h = two_x;
    for (var k = 1; k < n; k = k + 1) {
        var hp1 = f64_sub(f64_mul(two_x, h), f64_mul(f64_from(2 * k), hm1));
        hm1 = h;
        h = hp1;
    }
    return h;
}

# Generalised Laguerre polynomial L_p^alpha(x) for integers p >= 0, alpha >= 0,
# by the recurrence (k+1)*L_{k+1} = (2k+1+alpha-x)*L_k - (k+alpha)*L_{k-1},
# L_0 = 1, L_1 = 1 + alpha - x (A&S 22.7.12). L_p^alpha(0) = C(p+alpha, p).
# NaN for p < 0 or alpha < 0.
#must_use
fn laguerre_poly(p, alpha, x) {
    if (p < 0) { return _PRK_NAN; }
    if (alpha < 0) { return _PRK_NAN; }
    if (p == 0) { return F64_ONE; }
    var al = f64_from(alpha);
    var lm1 = F64_ONE;
    var l = f64_sub(f64_add(F64_ONE, al), x);
    for (var k = 1; k < p; k = k + 1) {
        var a = f64_mul(f64_sub(f64_add(f64_from(2 * k + 1), al), x), l);
        var b = f64_mul(f64_add(f64_from(k), al), lm1);
        var lp1 = f64_div(f64_sub(a, b), f64_from(k + 1));
        lm1 = l;
        l = lp1;
    }
    return l;
}

# Normalised Hermite function phi_n(t) = H_n(t)*e^(-t^2/2)/sqrt(2^n*n!*sqrt(pi)),
# which has integral phi_n^2 dt = 1 and |phi_n| <= pi^(-1/4) (Cramer). Evaluated
# by its own three-term recurrence
#   phi_{k+1} = sqrt(2/(k+1))*t*phi_k - sqrt(k/(k+1))*phi_{k-1},
# which never forms H_n or n!.
# ⛔ 2.6.0 review: seeding it with phi_0 = pi^(-1/4)*e^(-t^2/2) UNDERFLOWS for
# |t| > ~37.6, and every later iterate is a multiple of the seed — so HG_m with
# m >~ 745, whose outer (brightest) lobes lie past that, came back as exact
# zeros, a plausible "node", with no error. Two paths now:
#   |t| < 36   — the seeded recurrence as before: the seed keeps full precision,
#                every iterate is bounded by Cramer, the result is unchanged.
#   |t| >= 36  — the same recurrence on h_k = phi_k*e^(t^2/2) (seed pi^(-1/4)),
#                rescaled by 2^-512 whenever |h| passes 2^512, and the Gaussian
#                applied once at the end in log form. Accurate to ~t^2*ulp
#                (~1e-13 at t = 40), the condition number of e^(-t^2/2) itself.
#   |t| > 2^100 — 0: e^(-t^2/2) is below every double long before the order can
#                matter, and a recurrence step there could overflow.
fn _bm_hermite_fn(n, t) {
    var at = t & _PRK_ABS;
    if (at > 0x4630000000000000) { return 0; }
    if (f64_lt(at, f64_from(36)) == 1) {
        # Divided, not multiplied by 1/pi^(1/4): the pre-review expression exactly,
        # so this path IS unchanged bit for bit (round 2 measured 1-ulp moves when
        # it multiplied by the reciprocal while this comment said "unchanged").
        var p0 = f64_div(_prk_exp(f64_neg(f64_div(f64_mul(t, t), F64_TWO))), f64_sqrt(f64_sqrt(F64_PI)));
        if (n == 0) { return p0; }
        var pm1 = p0;
        var p = f64_mul(f64_mul(f64_sqrt(F64_TWO), t), p0);
        for (var k = 1; k < n; k = k + 1) {
            var kf = f64_from(k);
            var k1 = f64_from(k + 1);
            var a = f64_mul(f64_mul(f64_sqrt(f64_div(F64_TWO, k1)), t), p);
            var pp1 = f64_sub(a, f64_mul(f64_sqrt(f64_div(kf, k1)), pm1));
            pm1 = p;
            p = pp1;
        }
        return p;
    }
    var c = f64_div(F64_ONE, f64_sqrt(f64_sqrt(F64_PI)));
    var hm1 = c;
    var h = c;
    if (n > 0) { h = f64_mul(f64_mul(f64_sqrt(F64_TWO), t), c); }
    var cnt = 0;
    for (var j = 1; j < n; j = j + 1) {
        var jf = f64_from(j);
        var j1 = f64_from(j + 1);
        var aj = f64_mul(f64_mul(f64_sqrt(f64_div(F64_TWO, j1)), t), h);
        var hp1 = f64_sub(aj, f64_mul(f64_sqrt(f64_div(jf, j1)), hm1));
        hm1 = h;
        h = hp1;
        if ((h & _PRK_ABS) > 0x5FF0000000000000) {
            h = f64_mul(h, 0x1FF0000000000000);
            hm1 = f64_mul(hm1, 0x1FF0000000000000);
            cnt = cnt + 1;
        }
    }
    if ((h & _PRK_ABS) == 0) { return 0; }
    # ln|phi| = ln|h| + 512*cnt*ln2 - t^2/2, with ln2 split (Cody-Waite) so the
    # count term is exact.
    var k512 = f64_from(512 * cnt);
    var lg = f64_sub(f64_ln(f64_abs(h)), f64_div(f64_mul(t, t), F64_TWO));
    lg = f64_add(f64_add(lg, f64_mul(k512, 0x3FE62E42FEE00000)), f64_mul(k512, 0x3DEA39EF35793C76));
    var v = _prk_exp(lg);
    if (f64_lt(h, 0) == 1) { return f64_neg(v); }
    return v;
}

# ── Hermite-Gaussian and Laguerre-Gaussian modes ────────
#
# Both families are evaluated on the CURRENT plane of a GaussianBeam, whose q
# supplies w and R and whose accumulated Gouy phase Psi supplies the mode's
# (N+1)*Psi. Each is normalised to unit power: the integral of |u|^2 over the
# plane is 1. The phase follows the header's conventions: curvature
# e^(-i*k*r^2/(2R)) with k = 2*pi/wavelength, Gouy e^(+i*(N+1)*Psi), and for LG
# e^(-i*l*phi), which carries +l*hbar per photon.

# Writes re/im and returns the status; on error writes 0 to both. A zero
# amplitude is a zero field whatever the phase: far off axis the Gaussian has
# underflowed while the curvature phase k*r^2/(2R) is past _prk_cos's 2^63 guard
# (or is inf*0 at a waist), and 0*NaN came back as a NaN field (2.6.0 review).
fn _bm_field_out(amp, phase, re_out, im_out) {
    if ((amp & _PRK_ABS) == 0) {
        store64(re_out, 0);
        store64(im_out, 0);
        return PK_ERR_NONE;
    }
    store64(re_out, f64_mul(amp, _prk_cos(phase)));
    store64(im_out, f64_mul(amp, _prk_sin(phase)));
    return PK_ERR_NONE;
}

fn _bm_field_fail(re_out, im_out) {
    store64(re_out, 0);
    store64(im_out, 0);
    return PK_ERR_INVALID_PARAMETER;
}

# Real amplitude of HG_mn at (x, y): (sqrt2/w)*phi_m(sqrt2*x/w)*phi_n(sqrt2*y/w).
fn _bm_hg_amp(beam, m, n, x, y) {
    var w = beam_radius(beam);
    var s = f64_div(f64_sqrt(F64_TWO), w);
    return f64_mul(s, f64_mul(_bm_hermite_fn(m, f64_mul(s, x)), _bm_hermite_fn(n, f64_mul(s, y))));
}

# Real amplitude of LG_pl at radius r, with s = 2r^2/w^2 and a = |l|:
#   sqrt(2/pi)/w * s^(a/2) * e^(-s/2) * sqrt(p!/(p+a)!) * L_p^a(s)
#   = sqrt(2/pi)/w * exp(E) * P_p,   E = (a*ln s - s - ln a! + ln C(p+a, p))/2,
# with P_k = L_k^a(s)/C(k+a, k), which is 1 at s = 0 and at most e^(s/2).
# ⛔ The first version multiplied a running product by the RAW L_p^a(s): it
# overflowed for a >~ 3850, L_p^a overflowed on the outer rings once 4p + 2a >~
# 1420, and 0*inf came back as NaN inside the mode, as success, under a comment
# claiming the opposite. The second (review round 1) fixed that and was itself
# measured in round 2 — every point below is the result of a measurement:
#   - P_k by the DIFFERENCE form of A&S 22.7.12 that scipy's eval_genlaguerre
#     uses, D_{k+1} = (k*D_k - s*P_k)/(k+1+a), P_{k+1} = P_k + D_{k+1}. The plain
#     three-term form cancels near the axis: ~3e-12 of peak for LG_400,0 at its
#     brightest point, where this is at rounding level.
#   - P and D rescaled together by 2^-+512 when they leave [2^-512, 2^512].
#   - ln a! NOT summed and subtracted: a*ln s, s and ln a! are each ~1e4 at
#     |l| = 1500 and a naive sum left 2.5e-12 there (18x worse than the pre-review
#     code, 1e-11 at |l| = 4000). For a >= 10, E uses Stirling's ratio,
#     a*ln(s/a) - (s - a) - (ln a! - a*ln a + a), whose last term is the series
#     ln(2*pi*a)/2 + sum_k B_2k/(2k(2k-1)*a^(2k-1)), k = 1..7 (tail < 3e-17 at a = 10).
#   - ln C(p+a, p) as the SHORTER of its two products, prod_{j<=min} (max+j)/j:
#     0 terms whenever p = 0 or l = 0.
#   - ln s taken from t when s = 2t^2 is subnormal, so LG_0,1 does not drop to 0
#     for r/w < 1.6e-162 while its true value is still a normal double.
#   - s > 2^200 returns 0 at once: e^(-s/2) is below every double for any order,
#     and a recurrence step multiplies by ~s (s > 2^512 gave NaN/inf as success).
#   - one multiply by exp(E) where nothing was rescaled and exp(E) is a normal
#     double, the log form otherwise.
fn _bm_lg_amp(beam, p, al, r) {
    var w = beam_radius(beam);
    var pref = f64_div(f64_sqrt(f64_div(F64_TWO, F64_PI)), w);
    var t = f64_div(r, w);
    if ((t & _PRK_ABS) == 0) {
        if (al == 0) { return pref; }
        return 0;
    }
    var s = f64_mul(F64_TWO, f64_mul(t, t));
    # f64_le is false for NaN, so this also sends an inf/NaN s to 0.
    if (f64_le(s, 0x4C70000000000000) == 0) { return 0; }
    var s_sub = 0;
    if ((s & _PRK_ABS) < 0x0010000000000000) { s_sub = 1; }
    var lns = 0;
    if (s_sub == 1) {
        lns = f64_add(F64_LN2, f64_mul(F64_TWO, f64_ln(t)));
    } else {
        lns = f64_ln(s);
    }
    var ef = 0;
    if (al < 10) {
        var lfact = 0;
        for (var j = 2; j <= al; j = j + 1) { lfact = f64_add(lfact, f64_ln(f64_from(j))); }
        ef = f64_div(f64_sub(f64_sub(f64_mul(f64_from(al), lns), s), lfact), F64_TWO);
    } else {
        var af = f64_from(al);
        var ia = f64_div(F64_ONE, af);
        var ia2 = f64_mul(ia, ia);
        var c = f64_sub(f64_div(f64_from(691), f64_from(360360)), f64_div(ia2, f64_from(156)));
        c = f64_sub(f64_div(F64_ONE, f64_from(1188)), f64_mul(ia2, c));
        c = f64_sub(f64_div(F64_ONE, f64_from(1680)), f64_mul(ia2, c));
        c = f64_sub(f64_div(F64_ONE, f64_from(1260)), f64_mul(ia2, c));
        c = f64_sub(f64_div(F64_ONE, f64_from(360)), f64_mul(ia2, c));
        c = f64_sub(f64_div(F64_ONE, f64_from(12)), f64_mul(ia2, c));
        var st = f64_add(f64_mul(f64_ln(f64_mul(f64_mul(F64_TWO, F64_PI), af)), F64_HALF), f64_mul(ia, c));
        # ln(s/a) formed as a ratio first, so s ~ a does not cancel; for a
        # subnormal s there is nothing to cancel and s/a would lose bits.
        var lsa = 0;
        if (s_sub == 1) {
            lsa = f64_sub(lns, f64_ln(af));
        } else {
            lsa = f64_ln(f64_div(s, af));
        }
        ef = f64_div(f64_sub(f64_sub(f64_mul(af, lsa), f64_sub(s, af)), st), F64_TWO);
    }
    var mlo = p;
    var mhi = al;
    if (al < p) {
        mlo = al;
        mhi = p;
    }
    var lbin = 0;
    for (var jb = 1; jb <= mlo; jb = jb + 1) {
        lbin = f64_add(lbin, f64_ln(f64_div(f64_from(mhi + jb), f64_from(jb))));
    }
    ef = f64_add(ef, f64_div(lbin, F64_TWO));
    var dk = 0;
    var el = F64_ONE;
    var cnt = 0;
    for (var k = 0; k < p; k = k + 1) {
        dk = f64_div(f64_sub(f64_mul(f64_from(k), dk), f64_mul(s, el)), f64_from(k + 1 + al));
        el = f64_add(el, dk);
        var mx = el & _PRK_ABS;
        if ((dk & _PRK_ABS) > mx) { mx = dk & _PRK_ABS; }
        if (mx > 0x5FF0000000000000) {
            el = f64_mul(el, 0x1FF0000000000000);
            dk = f64_mul(dk, 0x1FF0000000000000);
            cnt = cnt + 1;
        }
        if (mx < 0x1FF0000000000000) {
            if (mx != 0) {
                el = f64_mul(el, 0x5FF0000000000000);
                dk = f64_mul(dk, 0x5FF0000000000000);
                cnt = cnt - 1;
            }
        }
    }
    if ((el & _PRK_ABS) == 0) { return 0; }
    if (cnt == 0) {
        if (f64_gt(ef, f64_from(0 - 700)) == 1) {
            return f64_mul(f64_mul(pref, _prk_exp(ef)), el);
        }
    }
    var k512 = f64_from(512 * cnt);
    var lg = f64_add(f64_add(f64_ln(pref), ef), f64_ln(f64_abs(el)));
    lg = f64_add(f64_add(lg, f64_mul(k512, 0x3FE62E42FEE00000)), f64_mul(k512, 0x3DEA39EF35793C76));
    var v = _prk_exp(lg);
    if (f64_lt(el, 0) == 1) { return f64_neg(v); }
    return v;
}

# 1 if the HG arguments are usable: beam non-null, m, n >= 0, x, y finite.
fn _bm_hg_ok(beam, m, n, x, y) {
    if (beam == 0) { return 0; }
    if (m < 0) { return 0; }
    if (n < 0) { return 0; }
    return _bm_finite(x) & _bm_finite(y);
}

# Complex field of the Hermite-Gaussian mode HG_mn at (x, y) on the beam's
# current plane:
#   u = (sqrt2/w)*phi_m(sqrt2*x/w)*phi_n(sqrt2*y/w)
#       * exp(-i*k*(x^2+y^2)/(2R)) * exp(i*(m+n+1)*Psi),
# phi_k the normalised Hermite function. Writes Re u / Im u through re_out /
# im_out. Returns PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER (writing 0, 0) for a
# null beam, a negative order or a non-finite coordinate.
fn hg_mode_field(beam, m, n, x, y, re_out, im_out) {
    if (_bm_hg_ok(beam, m, n, x, y) == 0) { return _bm_field_fail(re_out, im_out); }
    var amp = _bm_hg_amp(beam, m, n, x, y);
    var k = f64_div(f64_mul(F64_TWO, F64_PI), GaussianBeam_wavelength(beam));
    var r2 = f64_add(f64_mul(x, x), f64_mul(y, y));
    var curv = f64_neg(f64_div(f64_mul(f64_mul(k, r2), beam_curvature(beam)), F64_TWO));
    var gouy = f64_mul(f64_from(m + n + 1), GaussianBeam_gouy(beam));
    return _bm_field_out(amp, f64_add(curv, gouy), re_out, im_out);
}

# Intensity |u|^2 of HG_mn at (x, y) (power per unit area for a 1 W beam). NaN
# for a null beam, a negative order or a non-finite coordinate.
#must_use
fn hg_mode_intensity(beam, m, n, x, y) {
    if (_bm_hg_ok(beam, m, n, x, y) == 0) { return _PRK_NAN; }
    var amp = _bm_hg_amp(beam, m, n, x, y);
    return f64_mul(amp, amp);
}

# 1 if the LG arguments are usable: beam non-null, p >= 0, |l| representable
# (l = INT64_MIN has no positive counterpart), r finite and >= 0.
fn _bm_lg_ok(beam, p, l, r) {
    if (beam == 0) { return 0; }
    if (p < 0) { return 0; }
    if (l == 0x8000000000000000) { return 0; }
    if (_bm_finite(r) == 0) { return 0; }
    if (f64_lt(r, 0) == 1) { return 0; }
    return 1;
}

fn _bm_iabs(l) {
    if (l < 0) { return 0 - l; }
    return l;
}

# Complex field of the Laguerre-Gaussian mode LG_pl at polar (r, phi) on the
# beam's current plane:
#   u = sqrt(2*p!/(pi*(p+|l|)!))/w * s^(|l|/2) * L_p^|l|(s) * e^(-s/2)
#       * exp(-i*k*r^2/(2R)) * exp(-i*l*phi) * exp(i*(2p+|l|+1)*Psi),
# s = 2r^2/w^2. l > 0 carries +l*hbar of orbital angular momentum per photon (see
# the header). LG_0,+-1 = (HG_10 -+ i*HG_01)/sqrt2. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER (writing 0, 0) for a null beam, p < 0, l = INT64_MIN,
# r < 0, or a non-finite r or phi.
fn lg_mode_field(beam, p, l, r, phi, re_out, im_out) {
    if (_bm_lg_ok(beam, p, l, r) == 0) { return _bm_field_fail(re_out, im_out); }
    if (_bm_finite(phi) == 0) { return _bm_field_fail(re_out, im_out); }
    var al = _bm_iabs(l);
    var amp = _bm_lg_amp(beam, p, al, r);
    var k = f64_div(f64_mul(F64_TWO, F64_PI), GaussianBeam_wavelength(beam));
    var curv = f64_neg(f64_div(f64_mul(f64_mul(k, f64_mul(r, r)), beam_curvature(beam)), F64_TWO));
    var gouy = f64_mul(f64_from(2 * p + al + 1), GaussianBeam_gouy(beam));
    var helix = f64_neg(f64_mul(f64_from(l), phi));
    return _bm_field_out(amp, f64_add(f64_add(curv, helix), gouy), re_out, im_out);
}

# Intensity |u|^2 of LG_pl at radius r (independent of phi and of the sign of
# l). NaN for a null beam, p < 0, l = INT64_MIN, or r negative or non-finite.
#must_use
fn lg_mode_intensity(beam, p, l, r) {
    if (_bm_lg_ok(beam, p, l, r) == 0) { return _PRK_NAN; }
    var amp = _bm_lg_amp(beam, p, _bm_iabs(l), r);
    return f64_mul(amp, amp);
}

# Radius of the bright ring of LG_0l: w*sqrt(|l|/2), where s^|l|*e^(-s) peaks.
# 0 for l = 0 (the peak is on axis); NaN for a null beam or l = INT64_MIN.
#must_use
fn lg_mode_peak_radius(beam, l) {
    if (beam == 0) { return _PRK_NAN; }
    if (l == 0x8000000000000000) { return _PRK_NAN; }
    return f64_mul(beam_radius(beam), f64_sqrt(f64_div(f64_from(_bm_iabs(l)), F64_TWO)));
}

# ── Beam quality: M^2 and second moments (ISO 11146) ────────

# M^2 of HG_mn along the axis of order m: 2m+1 (so HG_mn has M^2_x = 2m+1,
# M^2_y = 2n+1). NaN for m < 0.
#must_use
fn hg_mode_m2(m) {
    if (m < 0) { return _PRK_NAN; }
    # In f64: 2*m + 1 in i64 wraps negative for m >= 2^62 (2.6.0 review).
    return f64_add(f64_mul(F64_TWO, f64_from(m)), F64_ONE);
}

# M^2 of LG_pl, the same on every transverse axis: 2p + |l| + 1. NaN for p < 0.
#must_use
fn lg_mode_m2(p, l) {
    if (p < 0) { return _PRK_NAN; }
    # In f64, where |l| of INT64_MIN is exactly 2^63 and nothing wraps.
    return f64_add(f64_add(f64_mul(F64_TWO, f64_from(p)), f64_abs(f64_from(l))), F64_ONE);
}

# Beam quality factor from a second-moment waist radius W0 and far-field
# half-angle divergence theta: M^2 = pi*W0*theta/lambda (ISO 11146-1). A TEM00
# beam gives exactly 1. Writes PK_ERR_INVALID_PARAMETER (returns 0) unless all
# three are finite and positive.
#must_use
fn beam_m2(w0, theta, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_check(w0, wavelength, err_out) == 0) { return 0; }
    if (_bm_pos(theta) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return f64_div(f64_mul(F64_PI, f64_mul(w0, theta)), wavelength);
}

# Beam parameter product W0*theta = M^2*lambda/pi, invariant through any
# lossless paraxial system in one medium. Writes PK_ERR_INVALID_PARAMETER
# (returns 0) for M^2 < 1 or non-finite, or a bad wavelength.
#must_use
fn beam_parameter_product(m2, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_finite(m2) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (f64_lt(m2, F64_ONE) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_pos(wavelength) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return f64_div(f64_mul(m2, wavelength), F64_PI);
}

# Second-moment ("D4-sigma") beam radius W = 2*sigma of a sampled 1D intensity
# profile, samples[i] at x0 + i*dx (ISO 11146-1). The centroid is removed first
# (two passes), so the profile need not be centred. For a TEM00 beam W is its
# 1/e^2 radius w; for HG_m it is w*sqrt(2m+1). For a 2D beam pass the marginal
# (the profile summed across the other axis). Samples may be negative after
# background subtraction, but must be finite. Writes PK_ERR_INVALID_PARAMETER
# (returns 0) for a null buffer, count < 3, dx not finite and positive, x0 not
# finite, a non-finite sample, or a total or variance that is not positive.
#must_use
fn beam_second_moment_radius(samples, count, x0, dx, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (samples == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (count < 3) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if ((_bm_pos(dx) & _bm_finite(x0)) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var s0 = 0;
    var s1 = 0;
    for (var i = 0; i < count; i = i + 1) {
        var v = load64(samples + i * 8);
        if (_bm_finite(v) == 0) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        s0 = f64_add(s0, v);
        s1 = f64_add(s1, f64_mul(v, f64_mul(dx, f64_from(i))));
    }
    if (f64_gt(s0, 0) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # Offsets are measured from x0, so x0 cancels out of the variance exactly.
    var mean = f64_div(s1, s0);
    var s2 = 0;
    for (var j = 0; j < count; j = j + 1) {
        var d = f64_sub(f64_mul(dx, f64_from(j)), mean);
        s2 = f64_add(s2, f64_mul(load64(samples + j * 8), f64_mul(d, d)));
    }
    var var_ = f64_div(s2, s0);
    if (f64_gt(var_, 0) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return f64_mul(F64_TWO, f64_sqrt(var_));
}

# ── Orbital angular momentum ────────

# Speed of light in vacuum, m/s (exact by the SI definition of the metre).
fn _bm_c() { return f64_from(299792458); }

# Orbital angular momentum carried per unit time by a beam of power P whose
# photons each carry l*hbar: l*P/omega = l*P*lambda0/(2*pi*c), in N*m for SI
# inputs — the torque it exerts on anything that absorbs it fully. lambda0 is the
# VACUUM wavelength in metres (omega does not change between media). The sign of
# l carries the handedness; a power has none. Writes PK_ERR_INVALID_PARAMETER
# (returns 0) for a power that is negative or not finite — oam_flux(l, -P) would
# otherwise be indistinguishable from oam_flux(-l, P) — or a bad wavelength.
#must_use
fn oam_flux(l, power, vacuum_wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_nonneg(power) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_pos(vacuum_wavelength) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var omega_inv = f64_div(vacuum_wavelength, f64_mul(F64_TWO, f64_mul(F64_PI, _bm_c())));
    return f64_mul(f64_mul(f64_from(l), power), omega_inv);
}

# Total step height of a spiral phase plate that gives a TEM00 beam topological
# charge l: h = l*lambda/(n_rel - 1), with the thickness rising as h*phi/(2*pi).
# lambda is the wavelength in the surrounding medium and n_rel the plate's index
# relative to it. In this module's convention a thickness that rises with phi
# (from +x toward +y) adds e^(-i*l*phi), i.e. charge +l. Writes
# PK_ERR_INVALID_PARAMETER (returns 0) for n_rel <= 1 or not finite, or a bad
# wavelength.
#must_use
fn spiral_phase_plate_step(l, wavelength, n_rel, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_pos(wavelength) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_finite(n_rel) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (f64_gt(n_rel, F64_ONE) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return f64_div(f64_mul(f64_from(l), wavelength), f64_sub(n_rel, F64_ONE));
}
