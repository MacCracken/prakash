# spectral_photometry.cyr -- radiometric-to-photometric conversion via V(lambda)
# Usage: include "lib/spectral_photometry.cyr"
#   (requires error.cyr, spectral_core.cyr, spectral_cie.cyr for Spd + spd_at)
#
# Ported from the Rust `spectral/photometry.rs`. The two 81-value luminous-
# efficiency tables (photopic V and scotopic V') are lazily-initialized flat f64
# buffers of exact IEEE-754 hex bit patterns generated from the Rust source.

fn _vl(t, i) { return load64(t + i * 8); }
fn _phot_eps15() { return f64_div(F64_ONE, f64_from(1000000000000000)); }

# ── V(lambda) tables (generated: exact IEEE-754 hex from spectral/photometry.rs) ──

