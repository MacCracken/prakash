[package]
name = "prakash"
version = "${file:VERSION}"
description = "prakash — optics and light simulation (ray optics, wave optics, spectral math, lens geometry, PBR, atmospheric scattering)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/prakash"
language = "cyrius"
cyrius = "6.4.10"

[build]
src = "src/main.cyr"
output = "build/prakash"

# `[lib]` declares the bundle layout that `cyrius distlib` writes into
# `dist/prakash.cyr`. Optics modules live in `src/`; `lib/` holds only vendored
# stdlib + first-party deps managed by `cyrius deps`. Order = dependency order:
# error/constants → ray → spectral → wave → lens/pbr/atmosphere → bridge.
# The bundler strips `include` lines; every module here is self-contained and
# resolves stdlib from the consumer's `[deps] stdlib` list. `ai.cyr` is
# deliberately NOT bundled here (it pulls sandhi/TLS) — it ships as an opt-in
# module, mirroring the old `ai` cargo feature.
#
# Modules are appended as the Rust→Cyrius port lands them (see
# docs/development/cyrius-port-plan.md). Only ported modules are listed.
[lib]
modules = [
    "src/error.cyr",
    "src/ray_core.cyr",
    "src/ray_fresnel.cyr",
    "src/ray_trace.cyr",
    "src/ray_simulate.cyr",
    "src/ray_system.cyr",
    "src/ray_dispersion.cyr",
    "src/ray_fiber.cyr",
    "src/spectral_core.cyr",
    "src/spectral_cie.cyr",
    "src/spectral_photometry.cyr",
    "src/wave_core.cyr",
    "src/wave_polarization.cyr",
    "src/wave_coherence.cyr",
    "src/wave_airy.cyr",
    "src/wave_fabry_perot.cyr",
    "src/wave_diffraction.cyr",
    "src/wave_zernike.cyr",
    "src/wave_pattern.cyr",
    "src/pbr_core.cyr",
    "src/pbr_advanced.cyr",
    "src/lens.cyr",
    "src/atmosphere.cyr",
    "src/bridge.cyr",
    "src/serialize.cyr",
]

# `[lib.ai]` — the opt-in profile that ADDS the daimon/hoosh AI client
# (`cyrius distlib ai` -> dist/prakash-ai.cyr). Same optics core as [lib] PLUS
# `src/ai.cyr`, which pulls the sandhi HTTP/TLS stack. Consumers pick ONE bundle:
# dist/prakash.cyr (math-only, no TLS) or dist/prakash-ai.cyr (with the AI client).
[lib.ai]
modules = [
    "src/error.cyr",
    "src/ray_core.cyr",
    "src/ray_fresnel.cyr",
    "src/ray_trace.cyr",
    "src/ray_simulate.cyr",
    "src/ray_system.cyr",
    "src/ray_dispersion.cyr",
    "src/ray_fiber.cyr",
    "src/spectral_core.cyr",
    "src/spectral_cie.cyr",
    "src/spectral_photometry.cyr",
    "src/wave_core.cyr",
    "src/wave_polarization.cyr",
    "src/wave_coherence.cyr",
    "src/wave_airy.cyr",
    "src/wave_fabry_perot.cyr",
    "src/wave_diffraction.cyr",
    "src/wave_zernike.cyr",
    "src/wave_pattern.cyr",
    "src/pbr_core.cyr",
    "src/pbr_advanced.cyr",
    "src/lens.cyr",
    "src/atmosphere.cyr",
    "src/bridge.cyr",
    "src/serialize.cyr",
    "src/ai.cyr",
]

[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "result",
    "math",
    "ganita",
    "tagged",
    "fnptr",
    "bench",
    "callback",
    "bayan",
    "net",
    "http",
    "tls",
    "async",
    "random",
    "fdlopen",
    "dynlib",
    "chrono",
    "sandhi",
    "sakshi",
]

# hisab (higher mathematics) — Complex + FFT (num_fft/num_ifft) for wave/pattern.
# 2.6.8 = collision-hardening patch (FLOAT_RENDER_BUF stack-array -> alloc; ERR_* ->
# HSB_ERR_) so hisab co-compiles with the sandhi/TLS stack pulled by [lib.ai].
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "2.6.8"
modules = ["dist/hisab.cyr"]
