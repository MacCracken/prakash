[package]
name = "prakash"
version = "${file:VERSION}"
description = "prakash — optics and light simulation (ray optics, wave optics, spectral math, lens geometry, PBR, atmospheric scattering)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/prakash"
language = "cyrius"
cyrius = "6.6.6"

[build]
src = "src/main.cyr"
output = "build/prakash"

# `[lib]` declares the bundle layout that `cyrius distlib` writes into
# `dist/prakash.cyr`. Optics modules live in `src/`; `lib/` holds only vendored
# stdlib + first-party deps managed by `cyrius deps`. Order = dependency order:
# error/constants → ray → spectral → wave → lens/pbr/atmosphere → bridge.
# The bundler strips `include` lines; every module here is self-contained and
# resolves stdlib from the consumer's `[deps] stdlib` list. `ai.cyr` is
# deliberately NOT bundled here (it pulls sandhi/TLS) — it ships as an opt-in
# module, mirroring the old `ai` cargo feature.
#
# The module list below IS the bundle's concatenation order, and it is
# load-bearing: no file in src/ contains an `include`, so every module resolves at
# file scope against whatever precedes it. error.cyr is first because every module
# uses PK_ERR_*/_prk_trace; serialize is last because it reads accessors from the
# ray/spectral/wave/lens types.
# (The Rust→Cyrius port plan this note used to cite was deleted in 2.4.0 — the port
# completed at 2.0.0 and the document had drifted into describing an API prakash
# does not have. Recover it with `git show 2.4.0^:docs/development/cyrius-port-plan.md`.)
[lib]
modules = [
    "src/error.cyr",
    "src/ray_core.cyr",
    "src/ray_fresnel.cyr",
    "src/ray_trace.cyr",
    "src/ray_simulate.cyr",
    "src/ray_system.cyr",
    "src/ray_dispersion.cyr",
    "src/ray_fiber.cyr",
    "src/ray_grin.cyr",
    "src/spectral_core.cyr",
    "src/spectral_cie.cyr",
    "src/spectral_photometry.cyr",
    "src/wave_core.cyr",
    "src/wave_polarization.cyr",
    "src/wave_coherence.cyr",
    "src/wave_airy.cyr",
    "src/wave_fabry_perot.cyr",
    "src/wave_diffraction.cyr",
    "src/wave_doe.cyr",
    "src/wave_zernike.cyr",
    "src/wave_pattern.cyr",
    "src/wave_beam.cyr",
    "src/pbr_core.cyr",
    "src/pbr_advanced.cyr",
    "src/lens.cyr",
    "src/atmosphere.cyr",
    "src/bridge.cyr",
    "src/serialize.cyr",
]

# `[lib.ai]` — the opt-in profile that ADDS the daimon/hoosh AI client
# (`cyrius distlib ai` -> dist/prakash-ai.cyr). Same optics core as [lib] PLUS
# `src/ai.cyr`, which pulls the sandhi HTTP/TLS stack. Consumers pick ONE bundle:
# dist/prakash.cyr (math-only, no TLS) or dist/prakash-ai.cyr (with the AI client).
[lib.ai]
modules = [
    "src/error.cyr",
    "src/ray_core.cyr",
    "src/ray_fresnel.cyr",
    "src/ray_trace.cyr",
    "src/ray_simulate.cyr",
    "src/ray_system.cyr",
    "src/ray_dispersion.cyr",
    "src/ray_fiber.cyr",
    "src/ray_grin.cyr",
    "src/spectral_core.cyr",
    "src/spectral_cie.cyr",
    "src/spectral_photometry.cyr",
    "src/wave_core.cyr",
    "src/wave_polarization.cyr",
    "src/wave_coherence.cyr",
    "src/wave_airy.cyr",
    "src/wave_fabry_perot.cyr",
    "src/wave_diffraction.cyr",
    "src/wave_doe.cyr",
    "src/wave_zernike.cyr",
    "src/wave_pattern.cyr",
    "src/wave_beam.cyr",
    "src/pbr_core.cyr",
    "src/pbr_advanced.cyr",
    "src/lens.cyr",
    "src/atmosphere.cyr",
    "src/bridge.cyr",
    "src/serialize.cyr",
    "src/ai.cyr",
]

[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "result",
    "math",
    "simd",
    "ganita",
    "tagged",
    "fnptr",
    "bench",
    "callback",
    "bayan",
    "net",
    "http",
    "tls",
    "async",
    "random",
    "fdlopen",
    "dynlib",
    "chrono",
    "sandhi",
    "sakshi",
]

# hisab (higher mathematics) — FFT (num_fft) for wave_pattern.
# prakash's library surface is exactly that one entry point (the test suite
# also exercises num_ifft); the rest of hisab's modules ride along in the bundle
# unused. 2.6.8 was the collision-hardening patch (FLOAT_RENDER_BUF stack-array
# -> alloc; ERR_* -> HSB_ERR_) that let hisab co-compile with the sandhi/TLS
# stack pulled by [lib.ai]; both properties still hold in 3.2.1, which pins
# cyrius 6.6.6 itself and sakshi 2.5.2 / ganita 1.2.6 to match its stdlib.
# ⚠ hisab >= 3.1.0 requires cyrius >= 6.6.3 (`public struct` + `#derive`) —
# stated by hisab only from 3.2.1; prakash has been above that floor since 2.3.0.
#
# ⚠ 3.0.0 IS A BREAKING RELEASE AND THE BREAK REACHES prakash. hisab replaced
# the integer-error-code convention with the stdlib `Result<T, E>` across 48
# functions, and `num_fft` / `num_ifft` are among them: they now answer Ok(0) or
# Err(HSB_ERR_INVALID_INPUT) and carry #must_use. Discarding that Result still
# COMPILES — it is not a build error — so the migration was driven by grepping
# the call sites, not by waiting for the compiler. prakash's four sites moved in
# 2.3.0; see `_pat_fft2d` in src/wave_pattern.cyr and the [2.3.0] CHANGELOG entry.
#
# ⚠ The ganita `f64_pow` domain change described in src/error.cyr's shim block
# dates from 1.1.4 and prakash re-measured it at 2.2.4 rather than inheriting the
# claim. Re-measured at 1.2.5 (2.3.0) and again at 1.2.6 (2.4.1): ganita still
# answers 0.0 / 1.0 / +inf for a zero base, bit-for-bit, so the shim's zero-base
# branch stays a redundant pin rather than a live repair.
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "3.2.1"
modules = ["dist/hisab.cyr"]
