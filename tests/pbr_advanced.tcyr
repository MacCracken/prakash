# pbr_advanced test suite (part 1) — aniso / sheen / clearcoat / SSS tests
# from rust-old/src/pbr/advanced.rs (inline #[cfg(test)] mod).

include "src/error.cyr"
include "src/pbr_core.cyr"
include "src/pbr_advanced.cyr"

fn _fd(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }
fn _assert_near(a, b, tol, msg) { assert(_near(a, b, tol), msg); }

var EPS = f64_div(F64_ONE, f64_from(1000000));   # 1e-6
var Z = f64_from(0);

alloc_init();

# ── Anisotropic GGX ────────
test_group("ggx_aniso");

var sinT = f64_sqrt(f64_sub(F64_ONE, f64_mul(_fd(9, 10), _fd(9, 10))));
assert(f64_gt(pbr_distribution_ggx_aniso(_fd(9, 10), sinT, Z, _fd(3, 10), _fd(3, 10)), Z),
  "aniso positive");
assert(f64_gt(pbr_distribution_ggx(_fd(9, 10), _fd(3, 10)), Z), "iso positive");

# always positive over grid
var ndh4 = alloc(4 * 8);
store64(ndh4, _fd(1, 10));
store64(ndh4 + 8, F64_HALF);
store64(ndh4 + 16, _fd(9, 10));
store64(ndh4 + 24, F64_ONE);
var rxy3 = alloc(3 * 8);
store64(rxy3, _fd(1, 10));
store64(rxy3 + 8, _fd(3, 10));
store64(rxy3 + 16, _fd(7, 10));
for (var i = 0; i < 4; i = i + 1) {
    for (var jx = 0; jx < 3; jx = jx + 1) {
        for (var jy = 0; jy < 3; jy = jy + 1) {
            assert(f64_ge(pbr_distribution_ggx_aniso(load64(ndh4 + i * 8), _fd(3, 10), _fd(2, 10),
                  load64(rxy3 + jx * 8), load64(rxy3 + jy * 8)), Z), "aniso non-negative");
        }
    }
}

assert(f64_gt(pbr_distribution_ggx_aniso(F64_ONE, Z, Z, _fd(3, 10), F64_HALF),
    pbr_distribution_ggx_aniso(F64_HALF, F64_HALF, F64_HALF, _fd(3, 10), F64_HALF)),
  "aniso peaks at normal");

var dx_off = pbr_distribution_ggx_aniso(_fd(9, 10), _fd(4, 10), Z, _fd(8, 10), _fd(1, 10));
var dy_off = pbr_distribution_ggx_aniso(_fd(9, 10), Z, _fd(4, 10), _fd(8, 10), _fd(1, 10));
assert(f64_gt(f64_abs(f64_sub(dx_off, dy_off)), EPS), "aniso directional");

var ndv3 = alloc(3 * 8);
store64(ndv3, _fd(1, 10));
store64(ndv3 + 8, F64_HALF);
store64(ndv3 + 16, _fd(9, 10));
for (var gi = 0; gi < 3; gi = gi + 1) {
    var g = pbr_geometry_ggx_aniso(load64(ndv3 + gi * 8), _fd(3, 10), _fd(2, 10), _fd(3, 10), F64_HALF);
    assert(f64_ge(g, Z), "aniso G lo");
    assert(f64_le(g, f64_add(F64_ONE, EPS)), "aniso G hi");
}

_assert_near(
  pbr_geometry_smith_aniso(_fd(8, 10), _fd(6, 10), _fd(3, 10), _fd(2, 10), _fd(3, 10), _fd(2, 10),
    _fd(3, 10), F64_HALF),
  pbr_geometry_smith_aniso(_fd(6, 10), _fd(8, 10), _fd(3, 10), _fd(2, 10), _fd(3, 10), _fd(2, 10),
    _fd(3, 10), F64_HALF),
  EPS, "aniso smith symmetric");

# ── Sheen ────────
test_group("sheen");

var rough5 = alloc(5 * 8);
store64(rough5, _fd(1, 10));
store64(rough5 + 8, _fd(3, 10));
store64(rough5 + 16, F64_HALF);
store64(rough5 + 24, _fd(7, 10));
store64(rough5 + 32, _fd(9, 10));
for (var ci = 0; ci < 5; ci = ci + 1) {
    assert(f64_ge(pbr_distribution_charlie(_fd(8, 10), load64(rough5 + ci * 8)), Z), "charlie positive");
}
assert(f64_gt(f64_abs(f64_sub(pbr_distribution_charlie(F64_HALF, _fd(1, 10)),
        pbr_distribution_charlie(F64_HALF, _fd(9, 10)))), _fd(1, 1000)), "charlie varies with roughness");
assert(f64_ge(pbr_sheen_charlie(_fd(9, 10), _fd(8, 10), _fd(7, 10), F64_HALF), Z), "sheen charlie positive");
_assert_near(pbr_sheen_ashikhmin(F64_ONE, F64_ONE), Z, EPS, "ashikhmin normal = 0");
_assert_near(pbr_sheen_ashikhmin(Z, _fd(8, 10)), _fd(8, 10), EPS, "ashikhmin grazing = intensity");
var as1 = pbr_sheen_ashikhmin(F64_HALF, F64_HALF);
var as2 = pbr_sheen_ashikhmin(F64_HALF, F64_ONE);
_assert_near(f64_div(as2, as1), F64_TWO, EPS, "ashikhmin scales linearly");

# ── Clearcoat ────────
test_group("clearcoat");

_assert_near(pbr_clearcoat_fresnel(F64_ONE), _fd(4, 100), EPS, "clearcoat fresnel normal = 0.04");
_assert_near(pbr_clearcoat_fresnel(Z), F64_ONE, EPS, "clearcoat fresnel grazing = 1");
assert(f64_gt(pbr_clearcoat_brdf(_fd(9, 10), _fd(8, 10), _fd(7, 10), _fd(85, 100), _fd(5, 100)), Z),
  "clearcoat brdf positive");
assert(f64_gt(pbr_clearcoat_brdf(F64_ONE, _fd(8, 10), _fd(7, 10), _fd(9, 10), _fd(1, 100)),
    pbr_clearcoat_brdf(F64_ONE, _fd(8, 10), _fd(7, 10), _fd(9, 10), _fd(1, 10))), "smoother sharper peak");
_assert_near(pbr_clearcoat_blend(F64_HALF, _fd(3, 10), Z, _fd(8, 10)), F64_HALF, EPS, "zero clearcoat = base");
var blend_ec = pbr_clearcoat_blend(F64_ONE, F64_ONE, F64_ONE, _fd(8, 10));
assert(f64_ge(blend_ec, Z), "blend >= 0");
assert(f64_le(blend_ec, F64_TWO), "blend <= 2");
assert(f64_gt(f64_abs(f64_sub(
        pbr_clearcoat_blend(F64_ONE, F64_HALF, F64_HALF, _fd(8, 10)),
        pbr_clearcoat_blend(F64_ONE, F64_HALF, F64_ONE, _fd(8, 10)))), EPS), "clearcoat levels differ");
var ccg5 = alloc(5 * 8);
store64(ccg5, _fd(1, 10));
store64(ccg5 + 8, _fd(3, 10));
store64(ccg5 + 16, F64_HALF);
store64(ccg5 + 24, _fd(7, 10));
store64(ccg5 + 32, _fd(9, 10));
for (var vi = 0; vi < 5; vi = vi + 1) {
    for (var li = 0; li < 5; li = li + 1) {
        assert(f64_gt(pbr_clearcoat_geometry(load64(ccg5 + vi * 8), load64(ccg5 + li * 8)), Z),
          "clearcoat G positive");
    }
}

# ── Subsurface scattering ────────
test_group("sss");

var br5 = alloc(5 * 8);
store64(br5, Z);
store64(br5 + 8, _fd(1, 10));
store64(br5 + 16, F64_HALF);
store64(br5 + 24, F64_ONE);
store64(br5 + 32, f64_from(5));
for (var ri = 0; ri < 5; ri = ri + 1) {
    assert(f64_ge(pbr_sss_profile_burley(load64(br5 + ri * 8), F64_ONE), Z), "burley non-negative");
}
assert(f64_gt(pbr_sss_profile_burley(_fd(1, 10), F64_ONE), pbr_sss_profile_burley(F64_TWO, F64_ONE)),
  "burley decreases with distance");
assert(f64_gt(f64_abs(f64_sub(pbr_sss_profile_burley(F64_ONE, F64_HALF),
        pbr_sss_profile_burley(F64_ONE, F64_TWO))), EPS), "burley wider d differs");
assert(f64_gt(pbr_sss_profile_gaussian(F64_HALF, F64_ONE), Z), "gaussian positive");
assert(f64_gt(pbr_sss_profile_gaussian(Z, F64_ONE), pbr_sss_profile_gaussian(F64_ONE, F64_ONE)),
  "gaussian peak at zero");
assert(f64_gt(pbr_sss_profile_gaussian(Z, F64_HALF), pbr_sss_profile_gaussian(Z, F64_TWO)),
  "narrower sigma taller");
var sndlv = alloc(3 * 8);
store64(sndlv, _fd(1, 10));
store64(sndlv + 8, F64_HALF);
store64(sndlv + 16, _fd(9, 10));
for (var di = 0; di < 3; di = di + 1) {
    for (var dj = 0; dj < 3; dj = dj + 1) {
        var sv = pbr_subsurface_diffuse(load64(sndlv + di * 8), load64(sndlv + dj * 8), F64_HALF);
        assert(f64_gt(sv, Z), "sss diffuse positive");
        assert(f64_lt(sv, F64_TWO), "sss diffuse bounded");
    }
}
_assert_near(pbr_sss_transmittance(Z, F64_ONE), F64_ONE, EPS, "transmittance 0 thick = 1");
assert(f64_lt(pbr_sss_transmittance(F64_ONE, F64_ONE), F64_ONE), "transmittance < 1");
assert(f64_gt(pbr_sss_transmittance(F64_ONE, F64_ONE), Z), "transmittance > 0");

var h3 = alloc(24);
var d3 = alloc(24);
var rgb3 = alloc(24);
var sb2 = alloc(16);
var sb2b = alloc(16);
var N13 = _fd(13, 10);
var N15 = _fd(15, 10);
var THR = _fd(1, 1000);

# ── Iridescence ────────
test_group("iridescence");

var ir_ct = alloc(5 * 8);
store64(ir_ct, _fd(1, 10));
store64(ir_ct + 8, _fd(3, 10));
store64(ir_ct + 16, F64_HALF);
store64(ir_ct + 24, _fd(7, 10));
store64(ir_ct + 32, _fd(9, 10));
for (var ic = 0; ic < 5; ic = ic + 1) {
    var rr = pbr_iridescence_fresnel(F64_ONE, N13, N15, f64_from(300), f64_from(550), load64(ir_ct + ic * 8));
    assert(f64_ge(rr, Z), "iridescence range lo");
    assert(f64_le(rr, F64_ONE), "iridescence range hi");
}
assert(f64_gt(f64_abs(f64_sub(
        pbr_iridescence_fresnel(F64_ONE, N13, N15, f64_from(300), f64_from(650), _fd(8, 10)),
        pbr_iridescence_fresnel(F64_ONE, N13, N15, f64_from(300), f64_from(450), _fd(8, 10)))), THR),
  "iridescence varies with wavelength");
assert(f64_gt(f64_abs(f64_sub(
        pbr_iridescence_fresnel(F64_ONE, N13, N15, f64_from(200), f64_from(550), _fd(8, 10)),
        pbr_iridescence_fresnel(F64_ONE, N13, N15, f64_from(400), f64_from(550), _fd(8, 10)))), THR),
  "iridescence varies with thickness");
assert(f64_gt(f64_abs(f64_sub(
        pbr_iridescence_fresnel(F64_ONE, N13, N15, f64_from(300), f64_from(550), F64_ONE),
        pbr_iridescence_fresnel(F64_ONE, N13, N15, f64_from(300), f64_from(550), _fd(2, 10)))), _fd(1, 100)),
  "iridescence varies with angle");
pbr_iridescence_rgb(F64_ONE, N13, N15, f64_from(300), _fd(8, 10), rgb3);
assert(f64_ge(load64(rgb3), Z), "irid rgb R >= 0");
assert(f64_ge(load64(rgb3 + 8), Z), "irid rgb G >= 0");
assert(f64_ge(load64(rgb3 + 16), Z), "irid rgb B >= 0");
var col_any = 0;
if (f64_gt(f64_abs(f64_sub(load64(rgb3), load64(rgb3 + 8))), THR) == 1) {
    col_any = 1;
}
if (f64_gt(f64_abs(f64_sub(load64(rgb3 + 8), load64(rgb3 + 16))), THR) == 1) {
    col_any = 1;
}
assert_eq(col_any, 1, "iridescence produces color variation");

# ── Volumetric ────────
test_group("volumetric");

_assert_near(pbr_henyey_greenstein(F64_HALF, Z), pbr_phase_isotropic(), THR, "HG(g=0) = isotropic");
assert(f64_gt(pbr_henyey_greenstein(F64_ONE, _fd(8, 10)),
    pbr_henyey_greenstein(f64_neg(F64_ONE), _fd(8, 10))), "HG forward > backward");
assert(f64_gt(pbr_henyey_greenstein(f64_neg(F64_ONE), f64_neg(F64_HALF)),
    pbr_henyey_greenstein(F64_ONE, f64_neg(F64_HALF))), "HG backward > forward");
var g_vals = alloc(5 * 8);
store64(g_vals, f64_neg(_fd(9, 10)));
store64(g_vals + 8, f64_neg(F64_HALF));
store64(g_vals + 16, Z);
store64(g_vals + 24, F64_HALF);
store64(g_vals + 32, _fd(9, 10));
var ct_vals = alloc(5 * 8);
store64(ct_vals, f64_neg(F64_ONE));
store64(ct_vals + 8, f64_neg(F64_HALF));
store64(ct_vals + 16, Z);
store64(ct_vals + 24, F64_HALF);
store64(ct_vals + 32, F64_ONE);
for (var hi = 0; hi < 5; hi = hi + 1) {
    for (var hj = 0; hj < 5; hj = hj + 1) {
        assert(f64_ge(pbr_henyey_greenstein(load64(ct_vals + hj * 8), load64(g_vals + hi * 8)), Z),
          "HG non-negative");
    }
}
_assert_near(pbr_phase_rayleigh(F64_ONE), pbr_phase_rayleigh(f64_neg(F64_ONE)), EPS, "rayleigh symmetric");
assert(f64_gt(pbr_phase_rayleigh(F64_ONE), pbr_phase_rayleigh(Z)), "rayleigh min at 90");
_assert_near(pbr_extinction_coefficient(F64_HALF, _fd(3, 10)), _fd(8, 10), EPS, "extinction = 0.8");
_assert_near(pbr_volume_transmittance(Z, f64_from(10)), F64_ONE, EPS, "vol_t 0 = 1");
assert(f64_lt(pbr_volume_transmittance(F64_ONE, F64_ONE), F64_ONE), "vol_t < 1");
assert(f64_gt(pbr_volume_transmittance(F64_ONE, F64_ONE), Z), "vol_t > 0");
assert(f64_lt(pbr_volume_transmittance(F64_HALF, f64_from(3)), pbr_volume_transmittance(F64_HALF, F64_ONE)),
  "thicker less transmittance");
_assert_near(pbr_single_scatter_albedo(Z, F64_ONE), F64_ONE, EPS, "ssa(0,1) = 1");
assert(f64_lt(f64_abs(pbr_single_scatter_albedo(F64_ONE, Z)), EPS), "ssa(1,0) = 0");
_assert_near(pbr_single_scatter_albedo(F64_HALF, F64_HALF), F64_HALF, EPS, "ssa(0.5,0.5) = 0.5");
assert(f64_lt(f64_abs(pbr_single_scatter_albedo(Z, Z)), EPS), "ssa(0,0) = 0");
assert(f64_gt(pbr_single_scatter_inscattering(F64_HALF, _fd(8, 10), F64_HALF, F64_ONE, F64_HALF, F64_ONE), Z),
  "inscattering positive");
assert(f64_lt(f64_abs(
      pbr_single_scatter_inscattering(Z, _fd(8, 10), F64_HALF, F64_ONE, F64_HALF, F64_ONE)), EPS),
  "zero scattering = zero inscattering");

# ── Importance sampling ────────
test_group("importance_sampling");

pbr_sample_ggx(_fd(3, 10), F64_HALF, F64_HALF, h3);
var glen = f64_sqrt(f64_add(f64_add(f64_mul(load64(h3), load64(h3)),
      f64_mul(load64(h3 + 8), load64(h3 + 8))), f64_mul(load64(h3 + 16), load64(h3 + 16))));
_assert_near(glen, F64_ONE, _fd(1, 100), "sample_ggx unit length");
for (var gh = 0; gh < 20; gh = gh + 1) {
    pbr_sample_ggx(F64_HALF, _fd(gh, 20), _fd(3, 10), h3);
    assert(f64_ge(load64(h3 + 16), Z), "sample_ggx upper hemisphere");
}
pbr_sample_ggx(_fd(1, 100), F64_HALF, Z, h3);
assert(f64_gt(load64(h3 + 16), _fd(9, 10)), "smooth concentrates near normal");
pbr_sample_ggx(_fd(9, 10), F64_HALF, Z, h3);
assert(f64_lt(load64(h3 + 16), _fd(9, 10)), "rough spreads");
assert(f64_gt(pbr_sample_ggx_pdf(_fd(9, 10), _fd(8, 10), _fd(3, 10)), Z), "ggx pdf positive");
assert(f64_gt(pbr_sample_ggx_pdf(F64_ONE, F64_ONE, _fd(1, 100)),
    pbr_sample_ggx_pdf(F64_ONE, F64_ONE, _fd(9, 10))), "smooth higher peak pdf");
pbr_sample_cosine_hemisphere(F64_HALF, F64_HALF, d3);
var dlen = f64_sqrt(f64_add(f64_add(f64_mul(load64(d3), load64(d3)),
      f64_mul(load64(d3 + 8), load64(d3 + 8))), f64_mul(load64(d3 + 16), load64(d3 + 16))));
_assert_near(dlen, F64_ONE, _fd(1, 100), "cosine sample unit length");
for (var ch = 0; ch < 20; ch = ch + 1) {
    pbr_sample_cosine_hemisphere(_fd(ch, 20), _fd(3, 10), d3);
    assert(f64_ge(load64(d3 + 16), Z), "cosine sample upper hemisphere");
}
_assert_near(pbr_sample_cosine_pdf(F64_ONE), f64_div(F64_ONE, F64_PI), EPS, "cosine pdf at normal");
assert(f64_lt(f64_abs(pbr_sample_cosine_pdf(Z)), EPS), "cosine pdf at grazing = 0");

# ── Split-sum IBL ────────
test_group("split_sum");

for (var nv = 1; nv <= 10; nv = nv + 1) {
    for (var rg = 0; rg <= 10; rg = rg + 1) {
        pbr_split_sum_scale_bias(_fd(nv, 10), _fd(rg, 10), sb2);
        assert(f64_ge(load64(sb2), Z), "scale >= 0");
        assert(f64_le(load64(sb2), F64_ONE), "scale <= 1");
        assert(f64_ge(load64(sb2 + 8), Z), "bias >= 0");
        assert(f64_le(load64(sb2 + 8), F64_ONE), "bias <= 1");
    }
}
pbr_split_sum_scale_bias(F64_ONE, Z, sb2);
assert(f64_gt(load64(sb2), F64_HALF), "smooth normal high scale");

# ⚠ 2.2.7: THE 440 ASSERTIONS ABOVE ARE ALL BOUNDS CHECKS, AND A BIAS THAT IS
# IDENTICALLY ZERO SATISFIES EVERY ONE OF THEM. It was: the old fit's bias
# polynomial ((0.042x - 0.1)x + 0.03)x - 0.002 is negative across the entire
# x = roughness^2 in [0,1] domain, was multiplied by a non-negative angular
# factor, and then clamped to [0,1] — so it returned -0.000000 at all 110 grid
# points. The scale's angular factor also ran backwards, sitting flat at 0.998
# for every n.v below 0.761 and falling to its LOWEST value at normal
# incidence. These assert the two properties that were actually violated.
var _ss_lo = alloc(16);
var _ss_hi = alloc(16);
var _ss_nonzero = 0;
for (var _sv = 1; _sv <= 10; _sv = _sv + 1) {
    for (var _sr = 0; _sr <= 10; _sr = _sr + 1) {
        pbr_split_sum_scale_bias(_fd(_sv, 10), _fd(_sr, 10), sb2);
        if (f64_gt(load64(sb2 + 8), _fd(1, 1000)) == 1) { _ss_nonzero = _ss_nonzero + 1; }
    }
}
assert(_ss_nonzero > 20, "the bias term is not identically zero (it was, at every grid point)");

# Scale must RISE toward normal incidence, not fall — the inverted direction.
# ⚠ ONLY FOR SMOOTH SURFACES. Checked against the integrator: A is monotonic
# rising in n.v up to roughness ~0.4 (r=0.3: 0.660 -> 0.951 -> 0.992), then the
# ordering REVERSES (r=1.0: 0.544 at grazing against 0.307 at normal), because
# the grazing lobe keeps energy the normal-incidence one has already lost. So
# the loop stops at 0.3 — asserting it at r=1.0 would be asserting wrong physics
# and would fail on a correct implementation, which is how the first draft of
# this test failed. The old fit violated it everywhere: scale sat flat at 0.998
# for every n.v below 0.761 and then fell to its minimum at normal incidence.
for (var _sr2 = 0; _sr2 <= 3; _sr2 = _sr2 + 1) {
    pbr_split_sum_scale_bias(_fd(1, 10), _fd(_sr2, 10), _ss_lo);
    pbr_split_sum_scale_bias(F64_ONE, _fd(_sr2, 10), _ss_hi);
    assert(f64_gt(load64(_ss_hi), load64(_ss_lo)),
      "split-sum scale rises toward normal incidence for a smooth surface");
}
# And the integrator agrees on that ordering, independently.
var _mo_lo = alloc(16);
var _mo_hi = alloc(16);
for (var _mr = 0; _mr <= 3; _mr = _mr + 1) {
    pbr_integrate_brdf_lut(_fd(1, 10), _fd(_mr, 10), 2048, _mo_lo);
    pbr_integrate_brdf_lut(F64_ONE, _fd(_mr, 10), 2048, _mo_hi);
    assert(f64_gt(load64(_mo_hi), load64(_mo_lo)),
      "integrated split-sum scale rises toward normal for a smooth surface");
}

# ⚠ AND THE INTEGRATOR IT IS APPROXIMATING WAS ALSO WRONG. It used the
# DIRECT-lighting Smith remap k = (r+1)^2/8 where image-based lighting needs
# k = alpha^2/2. The invariant that settles it: at roughness 0 the split sum is
# exactly A + B = 1 for every angle, because F is the only thing being split.
# It returned 0.2215 at n.v = 0.1. Reference values below are an independent
# complex-free Python integrator agreeing to 1e-6.
var _lut = alloc(16);
for (var _lv = 1; _lv <= 10; _lv = _lv + 1) {
    pbr_integrate_brdf_lut(_fd(_lv, 10), Z, 2048, _lut);
    _assert_near(f64_add(load64(_lut), load64(_lut + 8)), F64_ONE, _fd(1, 10000),
      "split-sum A + B = 1 at roughness 0, every angle (was 0.22 at grazing)");
}
pbr_integrate_brdf_lut(_fd(1, 10), Z, 2048, _lut);
_assert_near(load64(_lut), _fd(409510, 1000000), _fd(1, 10000), "lut A(r=0, nv=0.1) = 0.409510");
_assert_near(load64(_lut + 8), _fd(590490, 1000000), _fd(1, 10000), "lut B(r=0, nv=0.1) = 0.590490");
pbr_integrate_brdf_lut(F64_HALF, Z, 2048, _lut);
_assert_near(load64(_lut), _fd(96875, 100000), _fd(1, 10000), "lut A(r=0, nv=0.5) = 0.968750");
pbr_integrate_brdf_lut(F64_ONE, Z, 2048, _lut);
_assert_near(load64(_lut), F64_ONE, _fd(1, 10000), "lut A(r=0, nv=1) = 1.0 (perfect mirror, normal)");
# ⚠ 2.2.8: this pin MOVED, and only this one. 0.871732 was computed with the
# wrong k = alpha^2/2; the canonical k = alpha/2 gives 0.728832. Every r = 0
# value above is unchanged, because both remaps give k = 0 there — which is
# exactly why the r = 0 assertions could not detect the defect.
pbr_integrate_brdf_lut(F64_HALF, F64_HALF, 2048, _lut);
_assert_near(load64(_lut), _fd(728832, 1000000), _fd(1, 10000),
  "lut A(r=0.5, nv=0.5) = 0.728832 (was 0.871732 under k = alpha^2/2)");

# ⚠ 2.2.8: THE ENERGY-CONSERVATION INVARIANT, which is the only assertion here
# that could have caught the wrong IBL k. The split-sum scale A is the
# directional albedo of an F0 = 1 material, so A + B <= 1 at EVERY point. 2.2.7
# shipped k = alpha^2/2 instead of alpha/2 and this LUT returned A + B = 1.304 at
# r = 0.6 / n.v = 0.1, and A = 1.4547 at r = 0.5 / n.v = 0.05 — a surface
# reflecting 45% more light than reached it. The invariant 2.2.7 DID assert,
# A + B = 1 at roughness 0, holds for both remaps (k = 0 either way) and so
# discriminated nothing. Grid, not spot-checks, because the error was a bulge
# over the interior that vanished at both roughness endpoints.
var _en = alloc(16);
for (var _er = 0; _er <= 10; _er = _er + 1) {
    for (var _ev = 1; _ev <= 10; _ev = _ev + 1) {
        pbr_integrate_brdf_lut(_fd(_ev, 10), _fd(_er, 10), 1024, _en);
        assert(f64_le(f64_add(load64(_en), load64(_en + 8)), f64_add(F64_ONE, _fd(1, 1000))),
          "split-sum A + B <= 1: an F0=1 material cannot reflect more than it receives");
        assert(f64_le(load64(_en), f64_add(F64_ONE, _fd(1, 1000))), "split-sum scale A <= 1");
    }
}
# The worst point under the old k, asserted directly.
pbr_integrate_brdf_lut(_fd(1, 10), _fd(6, 10), 1024, _en);
_assert_near(f64_add(load64(_en), load64(_en + 8)), _fd(700512, 1000000), _fd(1, 1000),
  "A+B at r=0.6, nv=0.1 is 0.7005 (was 1.3041 under k = alpha^2/2)");
_assert_near(pbr_env_map_lod(Z, f64_from(8)), Z, EPS, "env_lod 0 = 0");
_assert_near(pbr_env_map_lod(F64_ONE, f64_from(8)), f64_from(8), EPS, "env_lod 1 = 8");
_assert_near(pbr_env_map_lod(F64_HALF, f64_from(8)), f64_from(4), EPS, "env_lod 0.5 = 4");
pbr_integrate_brdf_lut(F64_HALF, _fd(3, 10), 64, sb2);
assert(f64_ge(load64(sb2), Z), "lut scale >= 0");
assert(f64_ge(load64(sb2 + 8), Z), "lut bias >= 0");
assert(f64_le(f64_add(load64(sb2), load64(sb2 + 8)), F64_TWO), "lut scale+bias <= 2");
pbr_integrate_brdf_lut(_fd(8, 10), _fd(1, 10), 64, sb2);
pbr_integrate_brdf_lut(_fd(8, 10), _fd(9, 10), 64, sb2b);
assert(f64_gt(load64(sb2), load64(sb2b)), "lut smooth higher scale");
pbr_integrate_brdf_lut(F64_HALF, _fd(3, 10), 64, sb2);
pbr_integrate_brdf_lut(F64_HALF, _fd(3, 10), 64, sb2b);
assert(f64_lt(f64_abs(f64_sub(load64(sb2), load64(sb2b))), EPS), "lut deterministic scale");
assert(f64_lt(f64_abs(f64_sub(load64(sb2 + 8), load64(sb2b + 8))), EPS), "lut deterministic bias");

var r = assert_summary();
