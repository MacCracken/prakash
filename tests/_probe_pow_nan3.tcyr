}
var NAN = 0x7FF8000000000000;
var PINF = 0x7FF0000000000000;
var NZERO = 0x8000000000000000;
syscall(1, 1, "--- root cause: raw f64_exp at the infinities ---\n", 49);
_pr("f64_exp(PINF)           ", f64_exp(PINF));
_pr("f64_exp(NINF)           ", f64_exp(0xFFF0000000000000));
