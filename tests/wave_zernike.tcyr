var _zr80 = _zr_pin(60, 2, 0x3FE6A09E667F3BCD, 0xBFC27DCF9FFFFFFF, "R_60^2(0.7071067811865476)");
var _zr81 = _zr_pin(60, 2, 0x3FECCCCCCCCCCCCD, 0xBF487E3D6512EE8E, "R_60^2(0.9)");
var _zr82 = _zr_pin(60, 2, 0x3FEFAE147AE147AE, 0x3F7B03D4B6021CD0, "R_60^2(0.99)");
var _zr83 = _zr_pin(60, 2, 0x3FF0000000000000, 0x3FF0000000000000, "R_60^2(1.0)");
# R_n^m(1) = 1 for every valid (n, m) through n = 200, and R_n^m(0) = (-1)^(n/2) for m = 0.
var _zr1 = 1;
var _zr0 = 1;
for (var n = 0; n <= 200; n = n + 1) {
    for (var mm = n % 2; mm <= n; mm = mm + 2) {
        if (zernike_radial(n, mm, F64_ONE) != F64_ONE) { _zr1 = 0; }
    }
    if (n % 2 == 0) {
        var want = F64_ONE;
        if ((n / 2) % 2 == 1) { want = f64_neg(F64_ONE); }
        if (zernike_radial(n, 0, f64_from(0)) != want) { _zr0 = 0; }
    }
}
assert_eq(_zr1, 1, "R_n^m(1) = 1 exactly through n = 200 (R_22^0(1) was -1.2e3)");
assert_eq(_zr0, 1, "R_n^0(0) = (-1)^(n/2) exactly through n = 200");
assert_eq(zernike_radial(4, 0 - 2, F64_HALF), f64_from(0), "negative |m| is not a radial order: 0");

# Noll's table (Noll 1976, Table 1) through j = 28: even j is the cosine (m > 0), odd the sine.
test_group("2.15.1 Noll table");
fn _noll_pin(j, n, m) {
    var gn = 0 - 1;
    var gm = 0 - 99;
    var e = zernike_noll_to_nm(j, &gn, &gm);
    return (e == 0) & (gn == n) & (gm == m) & (zernike_nm_to_noll(n, m) == j);
}
var _nok = 1;
if (_noll_pin(1, 0, 0) == 0) { _nok = 0; }
if (_noll_pin(2, 1, 1) == 0) { _nok = 0; }
if (_noll_pin(3, 1, -1) == 0) { _nok = 0; }
if (_noll_pin(4, 2, 0) == 0) { _nok = 0; }
if (_noll_pin(5, 2, -2) == 0) { _nok = 0; }
if (_noll_pin(6, 2, 2) == 0) { _nok = 0; }
if (_noll_pin(7, 3, -1) == 0) { _nok = 0; }
if (_noll_pin(8, 3, 1) == 0) { _nok = 0; }
if (_noll_pin(9, 3, -3) == 0) { _nok = 0; }
if (_noll_pin(10, 3, 3) == 0) { _nok = 0; }
if (_noll_pin(11, 4, 0) == 0) { _nok = 0; }
if (_noll_pin(12, 4, 2) == 0) { _nok = 0; }
if (_noll_pin(13, 4, -2) == 0) { _nok = 0; }
if (_noll_pin(14, 4, 4) == 0) { _nok = 0; }
if (_noll_pin(15, 4, -4) == 0) { _nok = 0; }
if (_noll_pin(16, 5, 1) == 0) { _nok = 0; }
if (_noll_pin(17, 5, -1) == 0) { _nok = 0; }
if (_noll_pin(18, 5, 3) == 0) { _nok = 0; }
if (_noll_pin(19, 5, -3) == 0) { _nok = 0; }
if (_noll_pin(20, 5, 5) == 0) { _nok = 0; }
if (_noll_pin(21, 5, -5) == 0) { _nok = 0; }
if (_noll_pin(22, 6, 0) == 0) { _nok = 0; }
if (_noll_pin(23, 6, -2) == 0) { _nok = 0; }
if (_noll_pin(24, 6, 2) == 0) { _nok = 0; }
if (_noll_pin(25, 6, -4) == 0) { _nok = 0; }
if (_noll_pin(26, 6, 4) == 0) { _nok = 0; }
if (_noll_pin(27, 6, -6) == 0) { _nok = 0; }
if (_noll_pin(28, 6, 6) == 0) { _nok = 0; }
assert_eq(_nok, 1, "Noll j = 1..28 both ways, against the published table");
var _nrt = 1;
for (var j = 1; j <= 5000; j = j + 1) {
    var rn = 0;
    var rm = 0;
    var _e = zernike_noll_to_nm(j, &rn, &rm);
    if (zernike_nm_to_noll(rn, rm) != j) { _nrt = 0; }
}
assert_eq(_nrt, 1, "Noll round trip j -> (n, m) -> j for j = 1..5000");
assert_eq(zernike_nm_to_noll(2, 1), 0, "(2, 1) is not a Zernike: 0 (was 5, astigmatism)");
assert_eq(zernike_nm_to_noll(1, 0), 0, "(1, 0) is not a Zernike: 0 (was 2, tilt)");
assert_eq(zernike_nm_to_noll(2, 4), 0, "|m| > n: 0");
assert_eq(zernike_nm_to_noll(0 - 2, 0), 0, "n < 0: 0");

# The named constructors against the textbook polynomials at rho = 0.6, theta = 0.7, c = 1/4
# (Noll 1976; Mahajan): defocus sqrt3(2r^2 - 1), spherical sqrt5(6r^4 - 6r^2 + 1), coma
# sqrt8(3r^3 - 2r) cos/sin, astigmatism sqrt6 r^2 cos/sin 2 theta. 50-digit references.
test_group("2.15.1 named aberrations");
var _nr = _fd(6, 10);
var _nt = _fd(7, 10);
_assert_near(zernike_wf_evaluate(zernike_defocus(_fd(1, 4)), _nr, _nt), 0xBFBF09D156257498, 0x3CD203AF9EE75616,
  "zernike_defocus at (0.6, 0.7)");
_assert_near(zernike_wf_evaluate(zernike_spherical(_fd(1, 4)), _nr, _nt), 0xBFCB5CC0C8500F69, 0x3CD203AF9EE75616,
  "zernike_spherical at (0.6, 0.7)");
_assert_near(zernike_wf_evaluate(zernike_coma_x(_fd(1, 4)), _nr, _nt), 0xBFD31B34728400B6, 0x3CD203AF9EE75616,
  "zernike_coma_x at (0.6, 0.7)");
_assert_near(zernike_wf_evaluate(zernike_coma_y(_fd(1, 4)), _nr, _nt), 0xBFD017CE1679F0D3, 0x3CD203AF9EE75616,
  "zernike_coma_y at (0.6, 0.7)");
_assert_near(zernike_wf_evaluate(zernike_astigmatism_0(_fd(1, 4)), _nr, _nt), 0x3FA32F42E0155998, 0x3CD203AF9EE75616,
  "zernike_astigmatism_0 at (0.6, 0.7)");
_assert_near(zernike_wf_evaluate(zernike_astigmatism_45(_fd(1, 4)), _nr, _nt), 0x3FCBCEBAFA269D2E, 0x3CD203AF9EE75616,
  "zernike_astigmatism_45 at (0.6, 0.7)");
# Grid of one: the pupil centre, Z4(0) = -sqrt 3 (2.15.1: 0/0 left the cell at 0).
var _g1 = zernike_wf_to_grid(zernike_defocus(F64_ONE), 1);
_assert_near(load64(_g1), 0xBFFBB67AE8584CAA, 0x3CD203AF9EE75616, "1 x 1 grid is the centre: -sqrt 3");
assert(f64_eq(zernike_wf_peak_to_valley(zernike_defocus(F64_ONE), 0),
    zernike_wf_peak_to_valley(zernike_defocus(F64_ONE), 0)) == 0,
  "PV of no samples is NaN (was 0, a perfect wavefront)");
assert_eq(zernike_wf_peak_to_valley(zernike_defocus(F64_ONE), 1), f64_from(0), "PV of one sample is 0");
var _ts = zernike_spherical(_fd(1, 10000000000000000));
assert(f64_eq(zernike_wf_evaluate(_ts, F64_ONE, f64_from(0)), f64_from(0)) == 0,
  "a 1e-16 coefficient still counts (was dropped below 1e-15)");
var _sr = zernike_wf_strehl_ratio(zernike_spherical(_fd(1, 10)), f64_from(0));
assert(f64_eq(_sr, _sr) == 0, "Strehl at lambda = 0 is NaN (was 0)");
var _sn = zernike_wf_strehl_ratio(zernike_spherical(_fd(1, 10)), f64_neg(F64_ONE));
assert(f64_eq(_sn, _sn) == 0, "Strehl at lambda < 0 is NaN (was a number)");

var r = assert_summary();
