# Either side of the 2.5625 seam between the two fits, and of the old seam at 1.
var _fb0 = _fr_pin(0x3FF99CCC999FFEFE, 0x3FD75B9629222554, 0x3FE46CD46F8C127B, "C, S at sqrt(2.5625) -2 ulp");
var _fb1 = _fr_pin(0x3FF99CCC999FFEFF, 0x3FD75B9629222551, 0x3FE46CD46F8C127A, "C, S at sqrt(2.5625) -1 ulp");
var _fb2 = _fr_pin(0x3FF99CCC999FFF00, 0x3FD75B962922254F, 0x3FE46CD46F8C1278, "C, S at sqrt(2.5625) +0 ulp");
var _fb3 = _fr_pin(0x3FF99CCC999FFF01, 0x3FD75B962922254C, 0x3FE46CD46F8C1277, "C, S at sqrt(2.5625) +1 ulp");
var _fb4 = _fr_pin(0x3FF99CCC999FFF02, 0x3FD75B962922254A, 0x3FE46CD46F8C1275, "C, S at sqrt(2.5625) +2 ulp");
var _fo0 = _fr_pin(0x3FEFFFFFFFFFFFFF, 0x3FE8F4E3011F8291, 0x3FDC0C70184DB902, "C, S at 1 -1 ulp");
var _fo1 = _fr_pin(0x3FF0000000000001, 0x3FE8F4E3011F8291, 0x3FDC0C70184DB908, "C, S at 1 +1 ulp");
# Far out: the phase x^2/4 cycles is reduced from an exact x^2, so these keep their digits.
var _fl0 = _fr_pin(0x4034000000000000, 0x3FDFFFCAE107B4E6, 0x3FDEFB3DB49348A6, "C, S at 20.0 (1e10 and 1e15 were NaN)");
var _fl1 = _fr_pin(0x4042C00000000000, 0x3FDFCACF03C8AC15, 0x3FE0403FAF363F02, "C, S at 37.5 (1e10 and 1e15 were NaN)");
var _fl2 = _fr_pin(0x40934A456D5CFAAD, 0x3FE001187E1A47B3, 0x3FE001CE44BA8D14,
  "C, S at 1234.5678 (1e10 and 1e15 were NaN)");
var _fl3 = _fr_pin(0x40F86A0000000000, 0x3FDFFFFFFFFFFFFE, 0x3FDFFFF2A62C7280,
  "C, S at 100000.0 (1e10 and 1e15 were NaN)");
var _fl4 = _fr_pin(0x417F78A400000000, 0x3FE0000000000000, 0x3FDFFFFFF5A49865,
  "C, S at 33000000.0 (1e10 and 1e15 were NaN)");
var _fl5 = _fr_pin(0x4202A05F20000000, 0x3FE0000000000000, 0x3FDFFFFFFFF74018,
  "C, S at 10000000000.0 (1e10 and 1e15 were NaN)");
var _fl6 = _fr_pin(0x430C6BF526340000, 0x3FE0000000000000, 0x3FDFFFFFFFFFFFFA,
  "C, S at 1000000000000000.0 (1e10 and 1e15 were NaN)");
assert_eq(fresnel_integral_c(0x4340000000000000), F64_HALF, "C(2^53) = 1/2: x^2/4 is whole cycles");
assert_eq(fresnel_integral_c(0x7FF0000000000000), F64_HALF, "C(+inf) = 1/2");
assert_eq(fresnel_integral_s(0x7FF0000000000000), F64_HALF, "S(+inf) = 1/2");
assert_eq(fresnel_integral_s(0xFFF0000000000000), f64_neg(F64_HALF), "S(-inf) = -1/2");
var _frn = fresnel_integral_c(0x7FF8000000000000);
assert(f64_eq(_frn, _frn) == 0, "C(NaN) is NaN");
# The invariants, separately from the values: C' = cos(pi x^2/2) and S' = sin(pi x^2/2), so C
# rises on [0, 1] and falls on [1, sqrt 3], and S rises on [0, sqrt 2]. Sampled at 1/256.
var _mono = 1;
var _prev_c = fresnel_integral_c(0);
var _prev_s = fresnel_integral_s(0);
for (var k = 1; k <= 256; k = k + 1) {
    var xk = f64_div(f64_from(k), f64_from(256));
    var ck = fresnel_integral_c(xk);
    var sk = fresnel_integral_s(xk);
    if (f64_gt(ck, _prev_c) == 0) { _mono = 0; }
    if (f64_gt(sk, _prev_s) == 0) { _mono = 0; }
    _prev_c = ck;
    _prev_s = sk;
}
assert_eq(_mono, 1, "C and S rise on (0, 1]");
for (var k = 257; k <= 443; k = k + 1) {
    var xk = f64_div(f64_from(k), f64_from(256));
    var ck = fresnel_integral_c(xk);
    if (f64_lt(ck, _prev_c) == 0) { _mono = 0; }
    _prev_c = ck;
}
assert_eq(_mono, 1, "C falls on [1, sqrt 3] (443/256 < 1.7321): the old seam at 1 made it jump");
var _oc = 0;
var _os = 0;
var _ocs = fresnel_integral_cs(f64_neg(_fd(13, 8)), &_oc, &_os);
assert_eq(_oc, f64_neg(fresnel_integral_c(_fd(13, 8))), "C is odd, bit for bit");
assert_eq(_os, f64_neg(fresnel_integral_s(_fd(13, 8))), "S is odd, bit for bit");
# The straight-edge intensity ((C + 1/2)^2 + (S + 1/2)^2)/2 at its first extrema, to 1e-15.
_assert_near(fresnel_edge_intensity(0x3FF3333333333333), 0x3FF5EA1FCEEF6918, 0x3CD203AF9EE75616,
  "edge intensity at u = 1.2");
_assert_near(fresnel_edge_intensity(0x4000000000000000), 0x3FEB0206D62AB00B, 0x3CD203AF9EE75616,
  "edge intensity at u = 2.0");
_assert_near(fresnel_edge_intensity(0x4008000000000000), 0x3FF1B8D9372EC551, 0x3CD203AF9EE75616,
  "edge intensity at u = 3.0");
_assert_near(fresnel_edge_intensity(0x4014000000000000), 0x3FF1099D6317A843, 0x3CD203AF9EE75616,
  "edge intensity at u = 5.0");
_assert_near(fresnel_edge_intensity(0xBFF8000000000000), 0x3F95819EC0CB1B55, 0x3CD203AF9EE75616,
  "edge intensity at u = -1.5");

# ── 2.15.1: multilayer_rt's angle domain and a layer at its critical angle ────────
test_group("2.15.1 multilayer_rt domain, critical layer");
# Past grazing cos(theta) < 0 made the incident admittance negative: R_s > 1 and T_s < 0 came back
# as a result. |angle| >= pi/2 and NaN are refused, as multilayer_rta refuses them.
assert_eq(multilayer_rt(W550, F64_TWO, F64_ONE, N152, lay_996, 1), 0, "angle 2 rad (past grazing) refused");
assert_eq(multilayer_rt(W550, f64_neg(F64_TWO), F64_ONE, N152, lay_996, 1), 0, "angle -2 rad refused");
assert_eq(multilayer_rt(W550, F64_PI_2, F64_ONE, N152, lay_996, 1), 0, "angle pi/2 refused");
assert_eq(multilayer_rt(W550, 0x7FF8000000000000, F64_ONE, N152, lay_996, 1), 0, "NaN angle refused");
var _mg = multilayer_rt(W550, 0x3FF921FB54442D17, F64_ONE, N152, lay_996, 1);
assert(_mg != 0, "one ulp below pi/2 is an incidence");
assert(f64_le(ThinFilmResult_r_s(_mg), F64_ONE), "near grazing R_s <= 1");
# A layer at EXACTLY its critical angle: n_layer = n0 sin(theta) to the bit, so cos = 0 in it. s
# evaluated sin(0)/0 = NaN and p turned the layer into the identity. The limit matrices are pinned
# against multilayer_rta, whose sinc form has no singularity there, and against the same stack
# with the layer index moved 1e-12 either side.
var _cq = _deg(f64_from(40));
var _cb = f64_mul(_fd(15, 10), _prk_sin(_cq));
fn _rt_lay(n, d) {
    var l = alloc(16);
    if (l == 0) { return 0; }
    store64(l, n);
    store64(l + 8, d);
    return l;
}
var _crt = multilayer_rt(W550, _cq, _fd(15, 10), _fd(15, 10), _rt_lay(_cb, f64_from(300)), 1);
var _cre = _rta(W550, _cq, _fd(15, 10), _fd(15, 10), Z, _lay1(_cb, Z, f64_from(300)), 1);
assert(f64_eq(ThinFilmResult_r_s(_crt), ThinFilmResult_r_s(_crt)) == 1, "critical layer: R_s is a number");
_assert_near(ThinFilmResult_r_s(_crt), AbsorbingFilmResult_r_s(AF), _fd(1, 10000000000000),
  "critical layer: R_s = multilayer_rta's");
_assert_near(ThinFilmResult_r_p(_crt), AbsorbingFilmResult_r_p(AF), _fd(1, 10000000000000),
  "critical layer: R_p = multilayer_rta's (not the bare interface)");
assert(f64_gt(ThinFilmResult_r_p(_crt), _fd(1, 1000)), "critical layer: R_p is not the matched-interface 0");
var _crs = ThinFilmResult_r_s(_crt);
var _crp = ThinFilmResult_r_p(_crt);
var _cup = multilayer_rt(W550, _cq, _fd(15, 10), _fd(15, 10),
  _rt_lay(f64_mul(_cb, _fd(1000000000001, 1000000000000)), f64_from(300)), 1);
var _cdn = multilayer_rt(W550, _cq, _fd(15, 10), _fd(15, 10),
  _rt_lay(f64_mul(_cb, _fd(999999999999, 1000000000000)), f64_from(300)), 1);
_assert_near(ThinFilmResult_r_s(_cup), _crs, _fd(1, 1000000), "critical layer continuous from above (R_s)");
_assert_near(ThinFilmResult_r_s(_cdn), _crs, _fd(1, 1000000), "critical layer continuous from below (R_s)");
_assert_near(ThinFilmResult_r_p(_cup), _crp, _fd(1, 1000000), "critical layer continuous from above (R_p)");
_assert_near(ThinFilmResult_r_p(_cdn), _crp, _fd(1, 1000000), "critical layer continuous from below (R_p)");

var r = assert_summary();
