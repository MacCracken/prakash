# wave_diffraction test suite (part 1) — Fraunhofer / Fresnel / Huygens tests
# from rust-old/src/wave/diffraction.rs (inline #[cfg(test)] mod).

include "src/error.cyr"
include "src/ray_core.cyr"
include "src/ray_fresnel.cyr"
include "src/wave_core.cyr"
include "src/wave_diffraction.cyr"

fn _fd(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }
fn _assert_near(a, b, tol, msg) { assert(_near(a, b, tol), msg); }
fn _is_finite(x) { return f64_lt(f64_abs(x), 0x7FF0000000000000); }

var EPS = f64_div(F64_ONE, f64_from(1000000));       # 1e-6
var Z = f64_from(0);
var WL = f64_div(f64_from(55), f64_from(100000000));  # 550e-9
var MM = f64_div(F64_ONE, f64_from(1000));           # 1e-3

alloc_init();

# ── Fraunhofer rectangular ────────
test_group("fraunhofer_rect");

_assert_near(fraunhofer_rect(WL, MM, MM, Z, Z, F64_ONE), F64_ONE, EPS, "central max = 1");

var i_center = fraunhofer_rect(WL, MM, MM, Z, Z, F64_ONE);
var i_off = fraunhofer_rect(WL, MM, MM, _fd(1, 1000), Z, F64_ONE);
assert(f64_lt(i_off, i_center), "decreases off axis");

# separable: rect pattern = product of two 1D patterns
var w2 = _fd(5, 10000);   # 0.5e-3
var ax_ss = single_slit_intensity(WL, MM, _fd(1, 1000), F64_ONE);
var ay_ss = single_slit_intensity(WL, w2, _fd(2, 1000), F64_ONE);
var i_rect = fraunhofer_rect(WL, MM, w2, _fd(1, 1000), _fd(2, 1000), F64_ONE);
_assert_near(i_rect, f64_mul(ax_ss, ay_ss), EPS, "rect separable into 1D patterns");

# ── Fraunhofer 1D ────────
test_group("fraunhofer_1d");

# uniform aperture, n=100: x = -width/2 + width*i/(n-1)
var ap100 = alloc(100 * 16);
for (var i = 0; i < 100; i = i + 1) {
    var x = f64_add(
      f64_neg(f64_div(MM, F64_TWO)),
      f64_div(f64_mul(MM, f64_from(i)), f64_from(99)));
    store64(ap100 + i * 16, x);
    store64(ap100 + i * 16 + 8, F64_ONE);
}
var u_center = fraunhofer_1d(ap100, 100, WL, Z);
var u_off = fraunhofer_1d(ap100, 100, WL, _fd(1, 1000));
assert(f64_gt(u_center, u_off), "central max brightest");
assert(f64_gt(u_center, Z), "central max positive");

# non-negative across angles; 50-pair aperture x = (i-25)*1e-5
var ap50 = alloc(50 * 16);
for (var j = 0; j < 50; j = j + 1) {
    store64(ap50 + j * 16, f64_mul(f64_sub(f64_from(j), f64_from(25)), _fd(1, 100000)));
    store64(ap50 + j * 16 + 8, F64_ONE);
}
for (var m = 0; m < 20; m = m + 1) {
    var ang = f64_mul(f64_from(m), _fd(1, 1000));
    assert(f64_ge(fraunhofer_1d(ap50, 50, WL, ang), Z), "1d non-negative");
}

# ── Fresnel number ────────
test_group("fresnel_number");

assert(f64_lt(fresnel_number(WL, _fd(1, 10000), F64_ONE), F64_ONE), "far field N_F < 1");
assert(f64_gt(fresnel_number(WL, _fd(5, 1000), _fd(1, 100)), F64_ONE), "near field N_F > 1");

# ── Fresnel integrals C, S ────────
test_group("fresnel_integrals");

assert(f64_lt(f64_abs(fresnel_integral_c(Z)), EPS), "C(0) = 0");
assert(f64_lt(f64_abs(fresnel_integral_s(Z)), EPS), "S(0) = 0");
_assert_near(fresnel_integral_c(f64_from(10)), F64_HALF, _fd(5, 100), "C(10) ~ 0.5");
_assert_near(fresnel_integral_s(f64_from(10)), F64_HALF, _fd(5, 100), "S(10) ~ 0.5");
assert(f64_lt(f64_abs(f64_add(fresnel_integral_c(f64_neg(F64_TWO)), fresnel_integral_c(F64_TWO))),
    _fd(1, 100)), "C odd function");
assert(f64_lt(f64_abs(f64_add(fresnel_integral_s(f64_neg(F64_TWO)), fresnel_integral_s(F64_TWO))),
    _fd(1, 100)), "S odd function");
_assert_near(fresnel_integral_c(F64_ONE), _fd(7799, 10000), _fd(1, 100), "C(1) ~ 0.7799");
_assert_near(fresnel_integral_s(F64_ONE), _fd(4383, 10000), _fd(1, 100), "S(1) ~ 0.4383");

# 2.2.6: the four samples above (0, 1, 10 and the +/-2 symmetry pair) were the
# WHOLE of the Fresnel coverage, and all four survive a badly wrong C and S.
# x = 0 and x = 10 are fixed points of any approximation (0 and the 0.5
# asymptote), and x = 1 sits exactly on the branch boundary where the two wrong
# forms happen to agree to 0.08%. The error lived at 0.5 < x < 5 and peaked at
# 15.5% (C(3)) — untested. These pin both branches against values computed by
# Simpson quadrature on the defining integrals, cross-checked with published
# Fresnel tables. Tolerance 1e-6 is those six-digit values' own rounding (2.15.1: it was
# A&S 7.3.32's 2e-3 bound, which the code then used; the dense table at the end pins 4e-16).
var _FR_TOL = _fd(1, 1000000);
_assert_near(fresnel_integral_c(_fd(2, 10)), _fd(199921, 1000000), _FR_TOL, "C(0.2) = 0.199921 (series branch)");
_assert_near(fresnel_integral_c(_fd(5, 10)), _fd(492344, 1000000), _FR_TOL, "C(0.5) = 0.492344 (series branch)");
_assert_near(fresnel_integral_c(_fd(9, 10)), _fd(764823, 1000000), _FR_TOL, "C(0.9) = 0.764823 (series, was +8.3%)");
_assert_near(fresnel_integral_c(_fd(15, 10)), _fd(445261, 1000000), _FR_TOL, "C(1.5) = 0.445261 (aux, was +4.8%)");
_assert_near(fresnel_integral_c(F64_TWO), _fd(488253, 1000000), _FR_TOL, "C(2.0) = 0.488253 (aux, was +2.4%)");
_assert_near(fresnel_integral_c(f64_from(3)), _fd(605721, 1000000), _FR_TOL, "C(3.0) = 0.605721 (aux, was -15.5%)");
_assert_near(fresnel_integral_c(f64_from(5)), _fd(563631, 1000000), _FR_TOL, "C(5.0) = 0.563631 (aux)");
_assert_near(fresnel_integral_s(_fd(5, 10)), _fd(64732, 1000000), _FR_TOL, "S(0.5) = 0.064732 (series branch)");
_assert_near(fresnel_integral_s(_fd(9, 10)), _fd(339776, 1000000), _FR_TOL, "S(0.9) = 0.339776 (series branch)");
_assert_near(fresnel_integral_s(_fd(15, 10)), _fd(697505, 1000000), _FR_TOL, "S(1.5) = 0.697505 (aux branch)");
_assert_near(fresnel_integral_s(f64_from(3)), _fd(496313, 1000000), _FR_TOL, "S(3.0) = 0.496313 (aux branch)");
_assert_near(fresnel_integral_s(f64_from(5)), _fd(499191, 1000000), _FR_TOL, "S(5.0) = 0.499191 (aux branch)");

# ── Fresnel straight-edge ────────
test_group("fresnel_edge");

_assert_near(fresnel_edge_intensity(Z), _fd(1, 4), _fd(1, 100), "edge boundary I ~ 0.25");
assert(f64_lt(fresnel_edge_intensity(f64_from(0 - 5)), _fd(1, 100)), "deep shadow ~ 0");

# ⚠ 2.2.6 CORRECTED A TEST THAT WAS PINNING THE BUG. This read
#   _assert_near(fresnel_edge_intensity(5), 1.0, 0.05, "illuminated ~ 1")
# and it passed only because C and S were wrong. The straight-edge intensity
# does NOT settle to 1 in the illuminated region — it oscillates about 1 with
# slowly decaying amplitude, and the true value at u = 5 is 1.0648, which the
# old assertion's 0.05 tolerance EXCLUDES. The physics is Fresnel's classic
# edge fringe pattern: first and largest maximum I = 1.3697 at u = 1.2, first
# minimum I = 0.8440 at u = 2.0. Reference values from Simpson quadrature on
# the defining integrals. Pinning the oscillation is the point — an
# approximation that merely converges to 1 would now fail.
_assert_near(fresnel_edge_intensity(_fd(12, 10)), _fd(1369659, 1000000), _fd(5, 1000),
  "first edge maximum I = 1.3697 at u = 1.2");
_assert_near(fresnel_edge_intensity(F64_TWO), _fd(843997, 1000000), _fd(5, 1000),
  "first edge minimum I = 0.8440 at u = 2.0");
_assert_near(fresnel_edge_intensity(f64_from(3)), _fd(1107629, 1000000), _fd(5, 1000),
  "second edge maximum I = 1.1076 at u = 3.0");
_assert_near(fresnel_edge_intensity(f64_from(5)), _fd(1064847, 1000000), _fd(5, 1000),
  "I = 1.0648 at u = 5 — NOT 1.0; the old assertion pinned the bug");
assert(f64_gt(fresnel_edge_intensity(_fd(12, 10)), fresnel_edge_intensity(F64_TWO)),
  "edge intensity oscillates: max at 1.2 exceeds min at 2.0");

# ── Fresnel parameter ────────
test_group("fresnel_parameter");

var up = fresnel_parameter(WL, MM, F64_ONE);
assert(f64_gt(up, Z), "parameter positive");
assert_eq(_is_finite(up), 1, "parameter finite");

# ── Huygens-Fresnel 1D ────────
test_group("huygens_fresnel");

assert(f64_gt(huygens_fresnel_1d(ap50, 50, WL, _fd(1, 10), Z), Z), "huygens positive");

var ap100b = alloc(100 * 16);
for (var h = 0; h < 100; h = h + 1) {
    store64(ap100b + h * 16, f64_mul(f64_sub(f64_from(h), f64_from(50)), _fd(1, 100000)));
    store64(ap100b + h * 16 + 8, F64_ONE);
}
var h_center = huygens_fresnel_1d(ap100b, 100, WL, _fd(1, 10), Z);
var h_off = huygens_fresnel_1d(ap100b, 100, WL, _fd(1, 10), MM);
assert(f64_gt(h_center, h_off), "on-axis brightest");

# ── AR coatings ────────
test_group("ar_coatings");

var N152 = _fd(152, 100);   # 1.52 glass
var N138 = _fd(138, 100);   # 1.38 MgF2
var N210 = _fd(21, 10);     # 2.1 ZrO2
var TOL3 = _fd(1, 1000);    # 0.001
var TOL6 = _fd(1, 1000000);  # 1e-6 (2.4.8: the coating-vs-TMM pins below)
var TOL4 = _fd(1, 10000);   # 1e-4 — 2.2.7 multilayer value pins

# air->glass: sqrt(1*1.52) ~ 1.233
_assert_near(ar_ideal_index(F64_ONE, N152), _fd(1233, 1000), TOL3, "ideal index ~ 1.233");
_assert_near(
  ar_quarter_wave_thickness(f64_from(550), N138),
  f64_div(f64_from(550), f64_mul(f64_from(4), N138)), EPS, "quarter-wave thickness");

# ideal V-coat (n2 = sqrt(n1*n3)) -> ~0 reflectance
var n2_ideal = f64_sqrt(f64_mul(F64_ONE, N152));
assert(f64_lt(vcoat_reflectance(F64_ONE, n2_ideal, N152), EPS), "ideal V-coat ~ 0");
# MgF2 on glass: small but nonzero
var r_mgf2 = vcoat_reflectance(F64_ONE, N138, N152);
assert(f64_gt(r_mgf2, Z), "MgF2 V-coat > 0");
assert(f64_lt(r_mgf2, _fd(2, 100)), "MgF2 V-coat < 0.02");

# quarter-wave coating at design wavelength matches V-coat
var d_qw = ar_quarter_wave_thickness(f64_from(550), N138);
var r_coat = coating_reflectance(f64_from(550), F64_ONE, N138, N152, d_qw);
var r_v = vcoat_reflectance(F64_ONE, N138, N152);
_assert_near(r_coat, r_v, TOL3, "coating at design lambda matches V-coat");

# reflectance varies with wavelength
var r_design = coating_reflectance(f64_from(550), F64_ONE, N138, N152, d_qw);
var r_off_wl = coating_reflectance(f64_from(450), F64_ONE, N138, N152, d_qw);
assert(f64_gt(f64_abs(f64_sub(r_design, r_off_wl)), TOL3), "reflectance varies with wavelength");

# reflectance in [0,1] across 400..700nm
for (var wl = 400; wl <= 700; wl = wl + 10) {
    var rc = coating_reflectance(f64_from(wl), F64_ONE, N138, N152, d_qw);
    assert(f64_ge(rc, Z), "coating R >= 0");
    assert(f64_le(rc, F64_ONE), "coating R <= 1");
}

# ── multilayer reflectance ────────
test_group("multilayer");

# single layer matches coating_reflectance
var lay1 = alloc(16);
store64(lay1, N138);
store64(lay1 + 8, d_qw);
var r_single = coating_reflectance(f64_from(550), F64_ONE, N138, N152, d_qw);
var r_multi = multilayer_reflectance(f64_from(550), F64_ONE, N152, lay1, 1);
_assert_near(r_single, r_multi, TOL3, "single layer matches coating");

# ⭐ ACROSS THE BAND, NOT AT ONE WAVELENGTH — this is the pin that finds the 2.4.8
# defect. `coating_reflectance` and the 1-layer TMM are two implementations of one
# quantity, so they must agree everywhere, not at the design point. The assertion
# above sampled **550 nm only**, which for a quarter-wave film is exactly where
# delta = pi/2 and cos(delta) = 0 — the one wavelength in the band at which the
# missing cos^2 numerator term vanishes. The pre-2.4.8 code was 61% low at 400 nm
# and exact at 550. (2.4.8)
for (var cw = 400; cw <= 700; cw = cw + 25) {
    var rc_c = coating_reflectance(f64_from(cw), F64_ONE, N138, N152, d_qw);
    var rc_m = multilayer_reflectance(f64_from(cw), F64_ONE, N152, lay1, 1);
    _assert_near(rc_c, rc_m, TOL6, "coating == 1-layer TMM across 400-700nm");
}
# ⭐ AND THE DEGENERATE CASES, which are the ones a percentage error hides. A film
# of zero thickness is not a film: R must be the bare-substrate Fresnel value, not
# zero. Same for every half-wave (absentee-layer) thickness. Pre-2.4.8 all three
# returned 0.0 — a coating that made the glass perfectly non-reflecting.
var r_bare_exp = f64_div(
  f64_mul(f64_sub(F64_ONE, N152), f64_sub(F64_ONE, N152)),
  f64_mul(f64_add(F64_ONE, N152), f64_add(F64_ONE, N152)));
_assert_near(coating_reflectance(f64_from(550), F64_ONE, N138, N152, Z), r_bare_exp, TOL6,
  "zero-thickness coating = bare substrate, not 0");
_assert_near(coating_reflectance(f64_from(550), F64_ONE, N138, N152, f64_mul(F64_TWO, d_qw)),
  r_bare_exp, TOL6, "half-wave (absentee) layer = bare substrate");
_assert_near(coating_reflectance(f64_from(550), F64_ONE, N138, N152, f64_mul(f64_from(4), d_qw)),
  r_bare_exp, TOL6, "full-wave layer = bare substrate");

# no layers = bare interface: ((1-1.52)/(1+1.52))^2
var frac_bare = f64_div(f64_sub(F64_ONE, N152), f64_add(F64_ONE, N152));
var r_bare = f64_mul(frac_bare, frac_bare);
_assert_near(multilayer_reflectance(f64_from(550), F64_ONE, N152, 0, 0), r_bare, TOL3, "no layers = bare");

# two-layer valid reflectance in [0,1]
var d_zro2 = ar_quarter_wave_thickness(f64_from(550), N210);
var lay2 = alloc(32);
store64(lay2, N138);
store64(lay2 + 8, d_qw);
store64(lay2 + 16, N210);
store64(lay2 + 24, d_zro2);
var r_two = multilayer_reflectance(f64_from(550), F64_ONE, N152, lay2, 2);
assert(f64_ge(r_two, Z), "two-layer R >= 0");
assert(f64_le(r_two, F64_ONE), "two-layer R <= 1");

# range across 400..700nm
for (var wl2 = 400; wl2 <= 700; wl2 = wl2 + 10) {
    var rm = multilayer_reflectance(f64_from(wl2), F64_ONE, N152, lay2, 2);
    assert(f64_ge(rm, Z), "multilayer R >= 0");
    assert(f64_le(rm, f64_add(F64_ONE, EPS)), "multilayer R <= 1");
}

# ⚠ 2.2.7: EVERYTHING ABOVE THIS LINE IS A BOUNDS CHECK. `R >= 0 && R <= 1` is
# satisfied by a value 4.75x wrong, and that is exactly what shipped: the
# transfer-matrix M12/M21 cross terms carried the wrong sign. Both flip
# TOGETHER and the reflectance squares them, so a SINGLE layer was bit-identical
# either way (the "single layer matches coating" assertion above can never see
# it), and at the 550 nm design wavelength cos(delta) = 0 kills the mixing term
# so quarter-wave stacks agreed too. It needed 2+ layers AND an off-design
# wavelength — the one combination nothing sampled.
# References below are an independent complex-arithmetic TMM (no real/imaginary
# splitting), same admittance formula, computed off-repo.
_assert_near(multilayer_reflectance(f64_from(450), F64_ONE, N152, lay2, 2), _fd(83770, 1000000), TOL4,
  "2-layer R(450nm) = 0.083770 (shipped 0.056 through 2.2.6)");
_assert_near(multilayer_reflectance(f64_from(500), F64_ONE, N152, lay2, 2), _fd(52768, 1000000), TOL4,
  "2-layer R(500nm) = 0.052768");
_assert_near(multilayer_reflectance(f64_from(550), F64_ONE, N152, lay2, 2), _fd(43033, 1000000), TOL4,
  "2-layer R(550nm) = 0.043033 (design wavelength — agreed even when wrong)");
_assert_near(multilayer_reflectance(f64_from(600), F64_ONE, N152, lay2, 2), _fd(49883, 1000000), TOL4,
  "2-layer R(600nm) = 0.049883");
_assert_near(multilayer_reflectance(f64_from(650), F64_ONE, N152, lay2, 2), _fd(64770, 1000000), TOL4,
  "2-layer R(650nm) = 0.064770");
_assert_near(multilayer_reflectance(f64_from(700), F64_ONE, N152, lay2, 2), _fd(81458, 1000000), TOL4,
  "2-layer R(700nm) = 0.081458");

# Three layers mixes the cross terms harder — this is where the old code was
# worst (0.039460 against a true 0.187549 on the 1.38/2.30 stack).
var lay3 = alloc(48);
store64(lay3, N138);
store64(lay3 + 8, d_qw);
store64(lay3 + 16, N210);
store64(lay3 + 24, d_zro2);
store64(lay3 + 32, N138);
store64(lay3 + 40, d_qw);
_assert_near(multilayer_reflectance(f64_from(450), F64_ONE, N152, lay3, 3), _fd(135478, 1000000), TOL4,
  "3-layer R(450nm) = 0.135478");
_assert_near(multilayer_reflectance(f64_from(650), F64_ONE, N152, lay3, 3), _fd(115324, 1000000), TOL4,
  "3-layer R(650nm) = 0.115324");

# ── full TMM (s/p split) ────────
test_group("multilayer_rt");

# TMM at normal incidence matches simple multilayer_reflectance (r_avg)
var r_simple = multilayer_reflectance(f64_from(550), F64_ONE, N152, lay1, 1);
var res_n = multilayer_rt(f64_from(550), Z, F64_ONE, N152, lay1, 1);
_assert_near(ThinFilmResult_r_avg(res_n), r_simple, _fd(1, 100), "TMM normal matches simple");

# s and p equal at normal incidence
var lay_996 = alloc(16);
store64(lay_996, N138);
store64(lay_996 + 8, _fd(996, 10));   # 99.6
var res_sp = multilayer_rt(f64_from(550), Z, F64_ONE, N152, lay_996, 1);
assert(f64_lt(f64_abs(f64_sub(ThinFilmResult_r_s(res_sp), ThinFilmResult_r_p(res_sp))), _fd(1, 100)),
  "s=p at normal");

# s and p differ at 45 degrees
var res_ob = multilayer_rt(f64_from(550), F64_PI_4, F64_ONE, N152, lay_996, 1);
assert(f64_gt(f64_abs(f64_sub(ThinFilmResult_r_s(res_ob), ThinFilmResult_r_p(res_ob))), TOL3),
  "s!=p at oblique");

# energy conservation R + T ~ 1
var lay_ec = alloc(32);
store64(lay_ec, N138);
store64(lay_ec + 8, _fd(996, 10));
store64(lay_ec + 16, N210);
store64(lay_ec + 24, _fd(655, 10));   # 65.5
var res_ec = multilayer_rt(f64_from(550), _fd(3, 10), F64_ONE, N152, lay_ec, 2);
assert(f64_lt(f64_abs(f64_sub(f64_add(ThinFilmResult_r_s(res_ec), ThinFilmResult_t_s(res_ec)), F64_ONE)),
    _fd(1, 100)), "R_s + T_s ~ 1");
assert(f64_lt(f64_abs(f64_sub(f64_add(ThinFilmResult_r_p(res_ec), ThinFilmResult_t_p(res_ec)), F64_ONE)),
    _fd(1, 100)), "R_p + T_p ~ 1");

# bare surface at angle: in range, s >= p - 0.01
var res_bare = multilayer_rt(f64_from(550), _fd(5, 10), F64_ONE, N152, 0, 0);
assert(f64_ge(ThinFilmResult_r_s(res_bare), Z), "bare R_s >= 0");
assert(f64_le(ThinFilmResult_r_s(res_bare), F64_ONE), "bare R_s <= 1");
assert(f64_ge(ThinFilmResult_r_p(res_bare), Z), "bare R_p >= 0");
assert(f64_le(ThinFilmResult_r_p(res_bare), F64_ONE), "bare R_p <= 1");
assert(f64_ge(ThinFilmResult_r_s(res_bare), f64_sub(ThinFilmResult_r_p(res_bare), _fd(1, 100))),
  "s >= p for dielectric at oblique");

# reflectance in range across incidence angles 0..80 deg
for (var ad = 0; ad <= 80; ad = ad + 10) {
    var ang = f64_div(f64_mul(f64_from(ad), F64_PI), f64_from(180));
    var res_a = multilayer_rt(f64_from(550), ang, F64_ONE, N152, lay_996, 1);
    assert(f64_ge(ThinFilmResult_r_s(res_a), Z), "range R_s >= 0");
    assert(f64_le(ThinFilmResult_r_s(res_a), f64_add(F64_ONE, _fd(1, 100))), "range R_s <= 1");
    assert(f64_ge(ThinFilmResult_r_p(res_a), Z), "range R_p >= 0");
    assert(f64_le(ThinFilmResult_r_p(res_a), f64_add(F64_ONE, _fd(1, 100))), "range R_p <= 1");
}

# ── 2.2.8: total internal reflection INSIDE a layer ────────
# ⚠ THE EVANESCENT CASE PRODUCED NaN, SILENTLY. _diff_cos_in_medium returns 0.0
# as its TIR sentinel and _diff_tmm_stack consumed it as a real cosine: for
# s-polarisation eta = n*0 = 0 and delta = 0, so `sin_d / eta` evaluated
# 0/0 = NaN on the first iteration and NaN reached r_s, t_s, r_avg and t_avg
# with no error signal. For p-polarisation the eta guard dodged the NaN but
# delta = 0 collapsed the layer to the identity matrix — the evanescent layer
# was DELETED from the stack, so r_p came out bit-identical for every thickness.
# Past the critical angle the layer matrix is carried with cosh/sinh instead,
# which is what produces frustrated-TIR tunnelling.
test_group("frustrated TIR through an evanescent layer");

fn _ftir(d_nm, ang_deg) {
    var L = alloc(16);
    store64(L, F64_ONE);
    store64(L + 8, f64_from(d_nm));
    return multilayer_rt(f64_from(550), f64_mul(_fd(ang_deg, 180), F64_PI), _fd(15, 10), _fd(15, 10), L, 1);
}
# Glass -> air gap -> glass at 50 deg; the critical angle is 41.8 deg, so the
# gap is evanescent. R must rise monotonically toward 1 as the gap widens, and
# T must decay — the defining behaviour of frustrated TIR.
var _g10 = _ftir(10, 50);
var _g100 = _ftir(100, 50);
var _g300 = _ftir(300, 50);
var _g1000 = _ftir(1000, 50);
assert(_g10 != 0, "evanescent stack returns a result");
assert(f64_lt(ThinFilmResult_r_s(_g10), _fd(1, 100)),
  "a 10nm gap tunnels almost perfectly: R_s < 0.01");
assert(f64_gt(ThinFilmResult_r_s(_g1000), _fd(999, 1000)),
  "a 1000nm gap is opaque: R_s > 0.999");
assert(f64_lt(ThinFilmResult_r_s(_g10), ThinFilmResult_r_s(_g100)), "R_s rises with gap width (10 -> 100nm)");
assert(f64_lt(ThinFilmResult_r_s(_g100), ThinFilmResult_r_s(_g300)), "R_s rises with gap width (100 -> 300nm)");
assert(f64_lt(ThinFilmResult_r_s(_g300), ThinFilmResult_r_s(_g1000)), "R_s rises with gap width (300 -> 1000nm)");
_assert_near(ThinFilmResult_r_s(_g100), _fd(386197, 1000000), TOL3, "R_s(100nm gap, 50deg) = 0.3862");
_assert_near(ThinFilmResult_r_p(_g100), _fd(341153, 1000000), TOL3, "R_p(100nm gap, 50deg) = 0.3412");

# ⚠ NaN IS THE THING THIS GUARDS. Every output must be finite — a NaN compares
# false to everything, so it is asserted as (x <= 1 AND x >= 0), which NaN fails.
assert(f64_ge(ThinFilmResult_r_s(_g100), Z), "r_s is finite, not NaN");
assert(f64_le(ThinFilmResult_r_s(_g100), F64_ONE), "r_s <= 1");
assert(f64_ge(ThinFilmResult_t_avg(_g100), Z), "t_avg is finite, not NaN");
assert(f64_le(ThinFilmResult_t_avg(_g100), F64_ONE), "t_avg <= 1");

# And the thickness dependence the old p-polarisation path lost entirely.
assert(f64_gt(f64_abs(f64_sub(ThinFilmResult_r_p(_g100), ThinFilmResult_r_p(_g300))), _fd(1, 100)),
  "r_p depends on gap thickness (it was bit-identical across thicknesses)");

# ── Absorbing multilayers: complex-index TMM (2.10.0) ────────
# Every value pin below is from an INDEPENDENT 50-digit implementation of the
# other TMM formalism — Byrnes' interface/propagation matrices (arXiv:1603.02720)
# in mpmath, not the characteristic-matrix/admittance form multilayer_rta uses —
# which in turn agrees with Byrnes' published `tmm` 0.2.0 package to 8e-16.
test_group("multilayer_rta");

fn _rel(a, b) { return f64_div(f64_abs(f64_sub(a, b)), f64_abs(b)); }
fn _assert_rel(a, b, rtol, msg) { assert(f64_le(_rel(a, b), rtol), msg); }
fn _deg(d) { return f64_div(f64_mul(F64_PI, d), f64_from(180)); }
var R13 = _fd(1, 10000000000000);   # 1e-13
var AF = alloc(sizeof(AbsorbingFilmResult));
fn _rta(lam, th, n0, ns, ks, lay, nl) {
    return multilayer_rta(lam, th, n0, ns, ks, lay, nl, AF);
}
fn _lay1(n, k, d) {
    var l = alloc(24);
    store64(l, n);
    store64(l + 8, k);
    store64(l + 16, d);
    return l;
}
fn _pin6(tag, rs, ts, as, rp, tp, ap) {
    _assert_rel(AbsorbingFilmResult_r_s(AF), rs, R13, tag);
    _assert_rel(AbsorbingFilmResult_t_s(AF), ts, R13, tag);
    _assert_rel(AbsorbingFilmResult_a_s(AF), as, R13, tag);
    _assert_rel(AbsorbingFilmResult_r_p(AF), rp, R13, tag);
    _assert_rel(AbsorbingFilmResult_t_p(AF), tp, R13, tag);
    _assert_rel(AbsorbingFilmResult_a_p(AF), ap, R13, tag);
    return 0;
}
# R + T + A = 1 for both polarizations, and the averages are the averages.
fn _energy(tag) {
    var one_s = f64_add(f64_add(AbsorbingFilmResult_r_s(AF), AbsorbingFilmResult_t_s(AF)), AbsorbingFilmResult_a_s(AF));
    var one_p = f64_add(f64_add(AbsorbingFilmResult_r_p(AF), AbsorbingFilmResult_t_p(AF)), AbsorbingFilmResult_a_p(AF));
    _assert_near(one_s, F64_ONE, _fd(1, 100000000000000), tag);
    _assert_near(one_p, F64_ONE, _fd(1, 100000000000000), tag);
    var ravg = f64_mul(F64_HALF, f64_add(AbsorbingFilmResult_r_s(AF), AbsorbingFilmResult_r_p(AF)));
    assert_eq(AbsorbingFilmResult_r_avg(AF), ravg, tag);
    var aavg = f64_mul(F64_HALF, f64_add(AbsorbingFilmResult_a_s(AF), AbsorbingFilmResult_a_p(AF)));
    assert_eq(AbsorbingFilmResult_a_avg(AF), aavg, tag);
    var tavg = f64_mul(F64_HALF, f64_add(AbsorbingFilmResult_t_s(AF), AbsorbingFilmResult_t_p(AF)));
    assert_eq(AbsorbingFilmResult_t_avg(AF), tavg, tag);
    return 0;
}
var AUN = _fd(43, 100);   # gold at 550 nm, the ComplexMedium preset
var AUK = _fd(246, 100);
var W550 = f64_from(550);

# Bare gold (no layers): T is the flux INTO the absorbing substrate.
assert_eq(_rta(W550, Z, F64_ONE, AUN, AUK, 0, 0), PK_ERR_NONE, "bare gold ok");
_assert_rel(AbsorbingFilmResult_r_s(AF), 0x3FE933B6542318BE, R13, "bare gold R at 0 deg = 0.78756");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3FCB3126AF739D09, R13, "bare gold T at 0 deg = 0.21244");
_assert_rel(AbsorbingFilmResult_r_p(AF), 0x3FE933B6542318BE, R13, "s = p at normal incidence");
_energy("bare gold 0 deg");
assert_eq(_rta(W550, _deg(f64_from(60)), F64_ONE, AUN, AUK, 0, 0), PK_ERR_NONE, "bare gold 60 ok");
_assert_rel(AbsorbingFilmResult_r_s(AF), 0x3FEC94A953B5ED92, R13, "bare gold R_s at 60 deg");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3FBB5AB56250936D, R13, "bare gold T_s at 60 deg");
_assert_rel(AbsorbingFilmResult_r_p(AF), 0x3FE5E490DD892132, R13, "bare gold R_p at 60 deg");
_assert_rel(AbsorbingFilmResult_t_p(AF), 0x3FD436DE44EDBD9C, R13, "bare gold T_p at 60 deg");

# 20 nm gold on glass, the semitransparent-mirror case.
var lau = _lay1(AUN, AUK, f64_from(20));
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, lau, 1), PK_ERR_NONE, "gold film ok");
_pin6("20nm gold on glass, 0 deg", 0x3FD5DC7752E2EE6A, 0x3FDECB870E7ACF31, 0x3FC6B0033D4484CA,
  0x3FD5DC7752E2EE6A, 0x3FDECB870E7ACF31, 0x3FC6B0033D4484CA);
_energy("gold film 0 deg");
assert_eq(_rta(W550, _deg(f64_from(45)), F64_ONE, N152, Z, lau, 1), PK_ERR_NONE, "gold film 45 ok");
_pin6("20nm gold on glass, 45 deg", 0x3FDD8A1F3681AF5A, 0x3FD8557A081BF842, 0x3FC440CD82C4B0C8,
  0x3FD141760AB32E87, 0x3FE13BCEC2CF39F3, 0x3FC88DD8DF5CBB23);
_energy("gold film 45 deg");

# Weakly absorbing high-index film (a-Si-like), 30 deg.
assert_eq(_rta(f64_from(600), _deg(f64_from(30)), F64_ONE, N152, Z, _lay1(f64_from(4), _fd(1, 10), f64_from(100)), 1),
  PK_ERR_NONE, "a-Si ok");
_pin6("100nm n=4+0.1i on glass, 30 deg", 0x3FE3432D00AA253B, 0x3FD271A9BD410D7C, 0x3FBC1FF105AAA039,
  0x3FDF925028F65316, 0x3FD7F5997C77A5DF, 0x3FC0F02CB5240E16);

# Five layers mixing lossless, weakly and strongly absorbing films, 50 deg.
var l5 = alloc(120);
store64(l5, N138);
store64(l5 + 8, Z);
store64(l5 + 16, _fd(996, 10));
store64(l5 + 24, _fd(23, 10));
store64(l5 + 32, _fd(2, 1000));
store64(l5 + 40, f64_from(60));
store64(l5 + 48, AUN);
store64(l5 + 56, AUK);
store64(l5 + 64, f64_from(8));
store64(l5 + 72, _fd(23, 10));
store64(l5 + 80, Z);
store64(l5 + 88, _fd(598, 10));
store64(l5 + 96, _fd(146, 100));
store64(l5 + 104, Z);
store64(l5 + 112, _fd(942, 10));
assert_eq(_rta(W550, _deg(f64_from(50)), F64_ONE, N152, Z, l5, 5), PK_ERR_NONE, "5-layer ok");
_pin6("5-layer mixed stack, 50 deg", 0x3FC10774E82FA75D, 0x3FEA4B089053873B, 0x3FA731A35A08EED4,
  0x3FA2F51B2ACE4E4E, 0x3FECB9C902982841, 0x3FB0B72A55D796D1);
_energy("5-layer");

# Absorbing SUBSTRATE (silicon) under a lossless oxide, 60 deg: the layers absorb
# nothing, so A = 0 and all of 1 - R crosses into the silicon.
var lox = _lay1(_fd(146, 100), Z, f64_from(100));
assert_eq(_rta(W550, _deg(f64_from(60)), F64_ONE, _fd(408, 100), _fd(4, 100), lox, 1),
  PK_ERR_NONE, "Si substrate ok");
_assert_rel(AbsorbingFilmResult_r_s(AF), 0x3FB8F59E317ED378, R13, "oxide on Si: R_s");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3FECE14C39D02591, R13, "oxide on Si: T_s into the silicon");
_assert_rel(AbsorbingFilmResult_r_p(AF), 0x3FC7D55E57D033F3, R13, "oxide on Si: R_p");
_assert_rel(AbsorbingFilmResult_t_p(AF), 0x3FEA0AA86A0BF303, R13, "oxide on Si: T_p (Re(n~ conj cos) flux)");
assert(f64_lt(f64_abs(AbsorbingFilmResult_a_s(AF)), _fd(1, 1000000000000000)), "lossless layer: A_s = 0");
assert(f64_lt(f64_abs(AbsorbingFilmResult_a_p(AF)), _fd(1, 1000000000000000)), "lossless layer: A_p = 0");

# Thick weak absorber: 10 um at 1550 nm, phase ~60 rad.
assert_eq(_rta(f64_from(1550), _deg(f64_from(10)), F64_ONE, _fd(145, 100), Z,
    _lay1(_fd(15, 10), _fd(1, 10000), f64_from(10000)), 1), PK_ERR_NONE, "thick weak ok");
_pin6("10um n=1.5+1e-4i, 10 deg", 0x3FA4F187B0B6594B, 0x3FEE70FB0C6A2B34, 0x3F7FF63C45379BA1,
  0x3FA34938252E5BC8, 0x3FEE8B498DB9CDAA, 0x3F8008BBFCD3266C);

# A VERY weak absorber, k = 1e-9: A = 1.1e-8. A is a difference of two O(1)
# fluxes (what enters the stack minus what reaches the substrate), so it is
# resolved to ~1e-16 of the INCIDENT power, like R and T — here 2.5e-16, i.e.
# 2e-8 relative. The pin is absolute for that reason, at 1e-15.
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, _lay1(_fd(15, 10), _fd(1, 1000000000), f64_from(500)), 1),
  PK_ERR_NONE, "k=1e-9 ok");
_assert_near(AbsorbingFilmResult_a_s(AF), 0x3E479452755FEDC8, _fd(1, 1000000000000000), "k = 1e-9: A = 1.09800059e-8");
assert(f64_gt(AbsorbingFilmResult_a_s(AF), Z), "k = 1e-9: A > 0");
_assert_rel(AbsorbingFilmResult_r_s(AF), 0x3FA4512ABE05FDA8, R13, "k = 1e-9: R");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3FEEBAED4E3A8B88, R13, "k = 1e-9: T");

# Kretschmann surface-plasmon geometry: glass prism (1.515) / 50 nm silver /
# air at 633 nm. The substrate (air) is past its critical angle, so T = 0
# EXACTLY and 1 - R is what the silver absorbs; p-polarization couples to the
# plasmon and its reflectance collapses at 42.806 deg, s does not.
var lag = _lay1(_fd(562, 10000), _fd(4276, 1000), f64_from(50));
var W633 = f64_from(633);
assert_eq(_rta(W633, _deg(f64_from(44)), _fd(1515, 1000), F64_ONE, Z, lag, 1), PK_ERR_NONE, "SPR 44 ok");
_assert_rel(AbsorbingFilmResult_r_s(AF), 0x3FEF9749ECD9441D, R13, "SPR 44 deg R_s");
_assert_rel(AbsorbingFilmResult_r_p(AF), 0x3FEE579B313B9B39, R13, "SPR 44 deg R_p");
_assert_rel(AbsorbingFilmResult_a_p(AF), 0x3FAA864CEC464C74, R13, "SPR 44 deg A_p");
assert_eq(AbsorbingFilmResult_t_s(AF), Z, "evanescent substrate: T_s = 0 exactly");
assert_eq(AbsorbingFilmResult_t_p(AF), Z, "evanescent substrate: T_p = 0 exactly");
var th_spr = 0x3FE7E84EA746A839;   # 42.806125 deg, the R_p minimum (golden section at 40 digits)
assert_eq(_rta(W633, th_spr, _fd(1515, 1000), F64_ONE, Z, lag, 1), PK_ERR_NONE, "SPR dip ok");
var rp_dip = AbsorbingFilmResult_r_p(AF);
_assert_rel(rp_dip, 0x3F9B4980A490F3A7, _fd(1, 1000000000000), "SPR dip R_p = 0.02665");
_assert_rel(AbsorbingFilmResult_r_s(AF), 0x3FEF948A7255B60F, R13, "s sees no plasmon at the dip: R_s = 0.987");
var _s1 = _rta(W633, f64_sub(th_spr, _deg(_fd(1, 10))), _fd(1515, 1000), F64_ONE, Z, lag, 1);
var rp_lo = AbsorbingFilmResult_r_p(AF);
var _s2 = _rta(W633, f64_add(th_spr, _deg(_fd(1, 10))), _fd(1515, 1000), F64_ONE, Z, lag, 1);
assert(f64_gt(rp_lo, rp_dip), "R_p rises below the dip");
assert(f64_gt(AbsorbingFilmResult_r_p(AF), rp_dip), "R_p rises above the dip");

# OPAQUE: a 10 um gold layer transmits 1.87e-249 — the exp(-Im delta) scaling
# carries it where the unscaled matrix would overflow at e^1124. 1 mm transmits 0
# exactly, and then R is the bare-gold reflectance.
assert_eq(_rta(W550, _deg(f64_from(30)), F64_ONE, N152, Z, _lay1(AUN, AUK, f64_from(10000)), 1), PK_ERR_NONE,
  "10um gold ok");
_assert_rel(AbsorbingFilmResult_r_s(AF), 0x3FEA1F785CACA5B4, R13, "10 um gold R_s");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x0C4ABC771EAF19CD, _fd(1, 1000000000000), "10 um gold T_s = 1.87e-249");
_assert_rel(AbsorbingFilmResult_t_p(AF), 0x0C5131DE11575A16, _fd(1, 1000000000000), "10 um gold T_p = 2.40e-249");
_assert_rel(AbsorbingFilmResult_a_p(AF), 0x3FCEFD91F4B509EB, R13, "10 um gold A_p");
assert_eq(_rta(W550, _deg(f64_from(30)), F64_ONE, N152, Z, _lay1(AUN, AUK, f64_from(1000000)), 1), PK_ERR_NONE,
  "1mm gold ok");
assert_eq(AbsorbingFilmResult_t_s(AF), Z, "1 mm of gold: T_s = 0");
assert_eq(AbsorbingFilmResult_t_p(AF), Z, "1 mm of gold: T_p = 0");
var rs_thick = AbsorbingFilmResult_r_s(AF);
var rp_thick = AbsorbingFilmResult_r_p(AF);
var _g0 = _rta(W550, _deg(f64_from(30)), F64_ONE, AUN, AUK, 0, 0);
_assert_near(rs_thick, AbsorbingFilmResult_r_s(AF), _fd(1, 1000000000000000),
  "opaque layer R_s = semi-infinite gold R_s");
_assert_near(rp_thick, AbsorbingFilmResult_r_p(AF), _fd(1, 1000000000000000),
  "opaque layer R_p = semi-infinite gold R_p");

# 800 lossless layers: a 400-pair quarter-wave mirror, T = 8.7e-178. The vector
# grows by ~(2.3/1.38)^400 (its admittance ratio by the 800th power) and passes
# through the exact 2^256 rescaling.
var lqw = alloc(800 * 24);
var iq = 0;
while (iq < 400) {
    var bq = lqw + iq * 48;
    store64(bq, _fd(23, 10));
    store64(bq + 8, Z);
    store64(bq + 16, f64_div(W550, f64_mul(f64_from(4), _fd(23, 10))));
    store64(bq + 24, N138);
    store64(bq + 32, Z);
    store64(bq + 40, f64_div(W550, f64_mul(f64_from(4), N138)));
    iq = iq + 1;
}
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, lqw, 800), PK_ERR_NONE, "800 layers ok");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x1B2C506EBE385285, _fd(1, 10000000000), "400-pair QW mirror T = 8.73e-178");
assert_eq(AbsorbingFilmResult_r_s(AF), F64_ONE, "400-pair QW mirror R = 1 to double precision");

# ── Cross-pins against the library's other implementations ────────
# Lossless layers: multilayer_rta must agree with multilayer_rt (real-index TMM,
# its own propagating/evanescent branches), including frustrated TIR.
fn _vs_rt(lam, th, n0, ns, lay16, lay24, nl, tag) {
    var rt = multilayer_rt(lam, th, n0, ns, lay16, nl);
    var e = _rta(lam, th, n0, ns, Z, lay24, nl);
    assert_eq(e, PK_ERR_NONE, tag);
    _assert_near(AbsorbingFilmResult_r_s(AF), ThinFilmResult_r_s(rt), _fd(1, 10000000000000), tag);
    _assert_near(AbsorbingFilmResult_r_p(AF), ThinFilmResult_r_p(rt), _fd(1, 10000000000000), tag);
    _assert_near(AbsorbingFilmResult_t_s(AF), ThinFilmResult_t_s(rt), _fd(1, 10000000000000), tag);
    _assert_near(AbsorbingFilmResult_t_p(AF), ThinFilmResult_t_p(rt), _fd(1, 10000000000000), tag);
    return 0;
}
var l16 = alloc(48);
var l24 = alloc(72);
store64(l16, N138);
store64(l16 + 8, _fd(996, 10));
store64(l16 + 16, _fd(23, 10));
store64(l16 + 24, _fd(598, 10));
store64(l16 + 32, _fd(146, 100));
store64(l16 + 40, _fd(942, 10));
var il = 0;
while (il < 3) {
    store64(l24 + il * 24, load64(l16 + il * 16));
    store64(l24 + il * 24 + 8, Z);
    store64(l24 + il * 24 + 16, load64(l16 + il * 16 + 8));
    il = il + 1;
}
_vs_rt(f64_from(450), Z, F64_ONE, N152, l16, l24, 3, "vs multilayer_rt: 3 layers, 450 nm, 0 deg");
_vs_rt(f64_from(450), _deg(f64_from(30)), F64_ONE, N152, l16, l24, 3, "vs multilayer_rt: 30 deg");
_vs_rt(f64_from(650), _deg(f64_from(70)), F64_ONE, N152, l16, l24, 3, "vs multilayer_rt: 70 deg");
var g16 = alloc(16);
store64(g16, F64_ONE);
store64(g16 + 8, f64_from(100));
var g24 = _lay1(F64_ONE, Z, f64_from(100));
_vs_rt(W550, _deg(f64_from(50)), _fd(15, 10), _fd(15, 10), g16, g24, 1, "vs multilayer_rt: frustrated TIR, 100 nm gap");
# ... and against the independent reference for the same gap class.
assert_eq(_rta(W550, _deg(f64_from(60)), _fd(15, 10), _fd(15, 10), Z, _lay1(F64_ONE, Z, f64_from(200)), 1), PK_ERR_NONE,
  "ftir ok");
_assert_rel(AbsorbingFilmResult_r_s(AF), 0x3FED41AF3018D950, R13, "FTIR 200 nm gap, 60 deg: R_s");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3FB5F2867F393580, R13, "FTIR: T_s");
_assert_rel(AbsorbingFilmResult_r_p(AF), 0x3FEE9C64CC9AECEE, R13, "FTIR: R_p");
_assert_rel(AbsorbingFilmResult_t_p(AF), 0x3FA639B33651311D, R13, "FTIR: T_p");
assert(f64_lt(f64_abs(AbsorbingFilmResult_a_s(AF)), _fd(1, 1000000000000000)), "evanescent but lossless: A_s = 0");

# No layers on an absorbing substrate: ray_fresnel's complex Fresnel equations.
# (Those carry up to ~1.2e-14 relative error here; multilayer_rta is within an
# ulp of the 40-digit reference at the same angles, so the tolerance is theirs.)
var gold = complex_gold_550nm();
var ia = 0;
while (ia <= 85) {
    var tha = _deg(f64_from(ia));
    var _e = _rta(W550, tha, F64_ONE, AUN, AUK, 0, 0);
    _assert_near(AbsorbingFilmResult_r_s(AF), fresnel_s_complex(F64_ONE, gold, tha), _fd(5, 100000000000000),
      "bare gold R_s = fresnel_s_complex");
    _assert_near(AbsorbingFilmResult_r_p(AF), fresnel_p_complex(F64_ONE, gold, tha), _fd(5, 100000000000000),
      "bare gold R_p = fresnel_p_complex");
    ia = ia + 17;
}

# ── Invariants ────────
test_group("multilayer_rta invariants");
# A zero-thickness layer is no layer, bit for bit (delta = 0: the series sinc
# gives S = 0 and cos(delta) = 1 exactly).
var _i1 = _rta(W550, _deg(f64_from(40)), F64_ONE, N152, Z, lau, 1);
var ref_s = AbsorbingFilmResult_r_s(AF);
var ref_tp = AbsorbingFilmResult_t_p(AF);
var l2z = alloc(48);
store64(l2z, AUN);
store64(l2z + 8, AUK);
store64(l2z + 16, f64_from(20));
store64(l2z + 24, f64_from(3));
store64(l2z + 32, _fd(1, 2));
store64(l2z + 40, Z);
var _i2 = _rta(W550, _deg(f64_from(40)), F64_ONE, N152, Z, l2z, 2);
assert_eq(AbsorbingFilmResult_r_s(AF), ref_s, "zero-thickness layer changes nothing (R_s)");
assert_eq(AbsorbingFilmResult_t_p(AF), ref_tp, "zero-thickness layer changes nothing (T_p)");
# The sign of the angle is irrelevant, bit for bit (only beta^2 and cos enter).
var _i3 = _rta(W550, f64_neg(_deg(f64_from(40))), F64_ONE, N152, Z, lau, 1);
assert_eq(AbsorbingFilmResult_r_s(AF), ref_s, "angle -> -angle: same R_s");
assert_eq(AbsorbingFilmResult_t_p(AF), ref_tp, "angle -> -angle: same T_p");
# Scale invariance: wavelength and thicknesses in um instead of nm.
var _i4 = _rta(_fd(55, 100), _deg(f64_from(40)), F64_ONE, N152, Z, _lay1(AUN, AUK, _fd(2, 100)), 1);
_assert_rel(AbsorbingFilmResult_r_s(AF), ref_s, R13, "unit-free: nm and um agree");
# A layer at EXACTLY its critical angle (q = 0: n = beta) — no branch, no
# singularity: continuous with its neighbours on both sides.
var thq = _deg(f64_from(40));
var bq = f64_mul(_fd(15, 10), _prk_sin(thq));
var _q0 = _rta(W550, thq, _fd(15, 10), _fd(15, 10), Z, _lay1(bq, Z, f64_from(300)), 1);
var rq0 = AbsorbingFilmResult_r_p(AF);
var rq0s = AbsorbingFilmResult_r_s(AF);
var lq1 = _lay1(f64_mul(bq, _fd(1000000000001, 1000000000000)), Z, f64_from(300));
var _q1 = _rta(W550, thq, _fd(15, 10), _fd(15, 10), Z, lq1, 1);
_assert_near(AbsorbingFilmResult_r_p(AF), rq0, _fd(1, 1000000), "q = 0 layer continuous from above (R_p)");
_assert_near(AbsorbingFilmResult_r_s(AF), rq0s, _fd(1, 1000000), "q = 0 layer continuous from above (R_s)");
var lq2 = _lay1(f64_mul(bq, _fd(999999999999, 1000000000000)), Z, f64_from(300));
var _q2 = _rta(W550, thq, _fd(15, 10), _fd(15, 10), Z, lq2, 1);
_assert_near(AbsorbingFilmResult_r_p(AF), rq0, _fd(1, 1000000), "q = 0 layer continuous from below (R_p)");
_energy("q = 0 layer");
# A SUBSTRATE at exactly its critical angle: p's admittance is infinite there,
# which is why p starts from [1/eta; 1]. Total reflection, no NaN.
var _c0 = _rta(W550, thq, _fd(15, 10), bq, Z, 0, 0);
assert_eq(AbsorbingFilmResult_r_s(AF), F64_ONE, "critical substrate: R_s = 1");
assert_eq(AbsorbingFilmResult_r_p(AF), F64_ONE, "critical substrate: R_p = 1");
assert_eq(AbsorbingFilmResult_t_p(AF), Z, "critical substrate: T_p = 0");
# Grazing incidence: R -> 1, finite.
var _gz = _rta(W550, _fd(15707963, 10000000), F64_ONE, N152, Z, lau, 1);
assert(f64_gt(AbsorbingFilmResult_r_p(AF), _fd(999, 1000)), "near-grazing R_p -> 1");
_energy("near grazing");

# ── Refusals: out untouched, a code returned ────────
test_group("multilayer_rta errors");
store64(AF, 0x4045000000000000);   # sentinel 42.0 in r_s
assert_eq(multilayer_rta(W550, Z, F64_ONE, N152, Z, lau, 1, 0), PK_ERR_INVALID_PARAMETER, "null out");
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, lau, 0 - 1), PK_ERR_INVALID_PARAMETER, "negative count");
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, 0, 2), PK_ERR_INVALID_PARAMETER, "null layers with a count");
assert_eq(_rta(Z, Z, F64_ONE, N152, Z, lau, 1), PK_ERR_INVALID_PARAMETER, "zero wavelength");
assert_eq(_rta(0x7FF0000000000000, Z, F64_ONE, N152, Z, lau, 1), PK_ERR_INVALID_PARAMETER, "infinite wavelength");
assert_eq(_rta(W550, F64_PI_2, F64_ONE, N152, Z, lau, 1), PK_ERR_INVALID_ANGLE, "90 deg");
assert_eq(_rta(W550, f64_from(4), F64_ONE, N152, Z, lau, 1), PK_ERR_INVALID_ANGLE, "4 rad");
assert_eq(_rta(W550, 0x7FF8000000000000, F64_ONE, N152, Z, lau, 1), PK_ERR_INVALID_ANGLE, "NaN angle");
assert_eq(_rta(W550, Z, Z, N152, Z, lau, 1), PK_ERR_INVALID_PARAMETER, "zero incident index");
assert_eq(_rta(W550, Z, F64_ONE, Z, Z, lau, 1), PK_ERR_INVALID_PARAMETER, "substrate n = k = 0");
assert_eq(_rta(W550, Z, F64_ONE, N152, f64_neg(_fd(1, 10)), lau, 1), PK_ERR_INVALID_PARAMETER,
  "negative substrate k (gain)");
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, _lay1(AUN, f64_neg(AUK), f64_from(20)), 1), PK_ERR_INVALID_PARAMETER,
  "negative layer k");
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, _lay1(f64_neg(AUN), AUK, f64_from(20)), 1), PK_ERR_INVALID_PARAMETER,
  "negative layer n");
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, _lay1(Z, Z, f64_from(20)), 1), PK_ERR_INVALID_PARAMETER, "layer n = k = 0");
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, _lay1(AUN, AUK, f64_from(0 - 20)), 1), PK_ERR_INVALID_PARAMETER,
  "negative thickness");
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, _lay1(AUN, AUK, 0x7FF0000000000000), 1), PK_ERR_INVALID_PARAMETER,
  "infinite thickness");
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, _lay1(0x7FF8000000000000, AUK, f64_from(20)), 1), PK_ERR_INVALID_PARAMETER,
  "NaN layer n");
# The phase guard, exactly at its edge: with lambda = 2 pi, n = 1 at normal
# incidence, delta = d. 2^42 radians is answered; one ulp more is refused.
assert_eq(_rta(F64_TAU, Z, F64_ONE, N152, Z, _lay1(F64_ONE, Z, 0x4290000000000000), 1), PK_ERR_NONE,
  "phase 2^42 answered");
assert_eq(_rta(F64_TAU, Z, F64_ONE, N152, Z, _lay1(F64_ONE, Z, 0x4290000000000001), 1), PK_ERR_INVALID_PARAMETER,
  "phase past 2^42 refused");
store64(AF, 0x4045000000000000);
var _ex = _rta(W550, Z, F64_ONE, N152, Z, _lay1(AUN, AUK, f64_from(0 - 20)), 1);
assert_eq(load64(AF), 0x4045000000000000, "a refused call leaves out untouched");

# ── Round-1 review regressions ────────
test_group("multilayer_rta review");
fn _stack(pairs, n1, k1, d1, n2, k2, d2) {
    var l = alloc(pairs * 48);
    var i = 0;
    while (i < pairs) {
        store64(l + i * 48, n1);
        store64(l + i * 48 + 8, k1);
        store64(l + i * 48 + 16, d1);
        store64(l + i * 48 + 24, n2);
        store64(l + i * 48 + 32, k2);
        store64(l + i * 48 + 40, d2);
        i = i + 1;
    }
    return l;
}
# 200 periods of dielectric (n 2) and lossless Drude metal (n 0, k 2): the stack
# absorbs nothing, sum Im delta = 182. The first cut restored e^(-2 sum) from a
# plain running sum: T 1.3e-12 relative off and A = +5.7e-13. The flux now rides
# in the scaled frame, and A is summed from lossy layers only — so it is exactly 0.
var ldr = _stack(200, F64_TWO, Z, f64_from(60), Z, F64_TWO, f64_from(40));
assert_eq(_rta(W550, Z, F64_ONE, _fd(15, 10), Z, ldr, 400), PK_ERR_NONE, "Drude stack ok");
_assert_rel(AbsorbingFilmResult_r_s(AF), 0x3FE23279E6E9F850, R13, "Drude stack R_s");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3FDB9B0C322C0F60, _fd(2, 10000000000000), "Drude stack T_s (2e-13)");
_assert_rel(AbsorbingFilmResult_t_p(AF), 0x3FDB9B0C322C0F60, _fd(2, 10000000000000), "Drude stack T_p");
assert_eq(AbsorbingFilmResult_a_s(AF), Z, "lossless Drude stack: A_s = 0 exactly (was 5.7e-13)");
assert_eq(AbsorbingFilmResult_a_p(AF), Z, "lossless Drude stack: A_p = 0 exactly");
# 30 periods of 10 nm silver and 60 nm dielectric, 20 deg.
var lag30 = _stack(30, _fd(562, 10000), _fd(4276, 1000), f64_from(10), _fd(23, 10), Z, f64_from(60));
assert_eq(_rta(W633, _deg(f64_from(20)), F64_ONE, N152, Z, lag30, 60), PK_ERR_NONE, "Ag stack ok");
_pin6("30 x (10 nm Ag, 60 nm n=2.3), 20 deg", 0x3FCB9FB795390997, 0x3FD4BF4397238AA3, 0x3FDD70E09E3FF091,
  0x3FB94382A0D9ECD8, 0x3FD8938A0F3BD046, 0x3FE08DCAA446DA42);
_energy("Ag stack");
# 700 quarter-wave pairs (1400 layers): T = 6.79e-311, subnormal. The vector
# passes 2^256 here, so without the downward rescaling the call is refused.
var lqw7 = _stack(700, _fd(23, 10), Z, f64_div(W550, f64_mul(f64_from(4), _fd(23, 10))),
  N138, Z, f64_div(W550, f64_mul(f64_from(4), N138)));
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, lqw7, 1400), PK_ERR_NONE, "1400 layers ok");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x00000C8088A934CB, _fd(1, 1000000000000), "700-pair mirror T = 6.7915e-311");
# The small-delta series (|delta|^2 < 2^-10): 1 nm of gold, and a film just under
# the switch. The A pins are what see the series' higher terms.
assert_eq(_rta(W550, _deg(f64_from(30)), F64_ONE, N152, Z, _lay1(AUN, AUK, F64_ONE), 1), PK_ERR_NONE, "1nm Au ok");
_pin6("1 nm gold, 30 deg (series branch)", 0x3FB0FFF8F0FB4459, 0x3FED6151A0BF8528, 0x3F8FABD04844933B,
  0x3F9F36AA77FECF64, 0x3FEE8EC44F107F17, 0x3F8DE1974BE29B85);
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, _lay1(_fd(15, 10), _fd(2, 10), 0x3FFCA21B16E7AF55), 1), PK_ERR_NONE,
  "dser ok");
_assert_rel(AbsorbingFilmResult_r_s(AF), 0x3FA69DD2071C2610, R13, "|delta| = 0.99 * 2^-5: R");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3FEE5773A28B0883, R13, "|delta| = 0.99 * 2^-5: T");
_assert_rel(AbsorbingFilmResult_a_s(AF), 0x3F7F579E819A8E21, R13, "|delta| = 0.99 * 2^-5: A");
var _ls = _rta(W550, _deg(f64_from(30)), F64_ONE, N152, Z, _lay1(F64_TWO, Z, _fd(13, 10)), 1);
assert(f64_lt(f64_abs(AbsorbingFilmResult_a_s(AF)), _fd(1, 1000000000000000)),
  "lossless 1.3 nm film (series): A_s = 0");
assert(f64_lt(f64_abs(AbsorbingFilmResult_a_p(AF)), _fd(1, 1000000000000000)),
  "lossless 1.3 nm film (series): A_p = 0");
# Grazing: cos theta_0 from sin(pi/2 - theta), not x87 fcos, f64_cos below cyrius
# 6.6.9 (2e-21 absolute near pi/2 — R_p was 2.7e-6 off on a 1e15 substrate at
# pi/2 - 1 ulp).
assert_eq(_rta(F64_ONE, 0x3FF921FB54442D17, F64_ONE, 0x430C6BF526340000, Z, 0, 0), PK_ERR_NONE, "graze ok");
_assert_rel(AbsorbingFilmResult_r_p(AF), 0x3FD3F6B7C4EAC7BE, _fd(1, 1000000000000000),
  "pi/2 - 1 ulp, 1e15 substrate: R_p");
_assert_rel(AbsorbingFilmResult_t_p(AF), 0x3FE604A41D8A9C21, _fd(1, 1000000000000000), "... and T_p");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x39B6FB6E9531E255, _fd(1, 1000000000000), "... and T_s = 1.1e-30");
# Magnitude bounds: every |n~| in [2^-100, 2^101]. Past them squares left the
# double range and wrong answers came back as success (n0 = 1e-161 on 1.3e-161:
# R_s 9.9% high).
store64(AF, 0x4045000000000000);
assert_eq(_rta(F64_ONE, Z, _fd(1, 1000000000), _fd(13, 10), Z, 0, 0), PK_ERR_NONE, "n = 1e-9 is in range");
_assert_near(AbsorbingFilmResult_r_s(AF), fresnel_normal(_fd(1, 1000000000), _fd(13, 10)), _fd(1, 1000000000000000),
  "tiny incident index still exact");
store64(AF, 0x4045000000000000);
assert_eq(_rta(F64_ONE, Z, 0x3970000000000000, 0x3970000000000000, Z, 0, 0), PK_ERR_INVALID_PARAMETER,
  "n0 = 2^-104 refused");
assert_eq(_rta(F64_ONE, Z, F64_ONE, 0x6974000000000000, Z, 0, 0), PK_ERR_INVALID_PARAMETER,
  "substrate n = 1e200 refused");
assert_eq(_rta(F64_ONE, Z, 0x6974000000000000, N152, Z, 0, 0), PK_ERR_INVALID_PARAMETER, "n0 = 1e200 refused");
assert_eq(load64(AF), 0x4045000000000000, "refused: out untouched");
assert_eq(_rta(F64_ONE, Z, F64_ONE, 0x4630000000000000, Z, 0, 0), PK_ERR_NONE, "n = 2^100 accepted");
assert_eq(_rta(F64_ONE, Z, F64_ONE, 0x4630000000000001, Z, 0, 0), PK_ERR_INVALID_PARAMETER,
  "n = 2^100 + 1 ulp refused");
assert_eq(_rta(F64_ONE, Z, F64_ONE, N152, Z, _lay1(0x39A0000000000000, 0x39A0000000000000, f64_from(5)), 1),
  PK_ERR_INVALID_PARAMETER, "layer with n, k both below 2^-100 refused");
assert_eq(_rta(F64_ONE, Z, F64_ONE, N152, Z, _lay1(Z, 0x39B0000000000000, f64_from(5)), 1), PK_ERR_NONE,
  "n = 0, k = 2^-100 accepted");
# Negative real parts: refused by the medium check itself, not by a later guard
# (the first cut's only test, n < 0 with k > 0, was also caught by Im q < 0).
assert_eq(_rta(W550, _deg(f64_from(30)), F64_ONE, f64_neg(N152), Z, 0, 0), PK_ERR_INVALID_PARAMETER,
  "substrate -1.52 + 0i refused");
assert_eq(_rta(W550, _deg(f64_from(30)), F64_ONE, f64_neg(N152), _fd(1, 10), 0, 0), PK_ERR_INVALID_PARAMETER,
  "substrate -1.52 + 0.1i refused");
assert_eq(_rta(W550, _deg(f64_from(30)), F64_ONE, N152, Z, _lay1(f64_neg(_fd(15, 10)), Z, f64_from(100)), 1),
  PK_ERR_INVALID_PARAMETER, "layer -1.5 + 0i refused");

# ── Round-2 review regressions ────────
test_group("multilayer_rta review 2");
# 400 periods of the Drude stack: the vector falls below 2^-256 and the flux below
# 2^-512, so deleting either upward rescaling refuses the call or returns T = 0.
var ldr4 = _stack(400, F64_TWO, Z, f64_from(60), Z, F64_TWO, f64_from(40));
assert_eq(_rta(W550, Z, F64_ONE, _fd(15, 10), Z, ldr4, 800), PK_ERR_NONE, "400-period Drude stack ok");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3FE6C5EA13D93067, _fd(5, 10000000000000), "400 periods: T_s (5e-13)");
_assert_rel(AbsorbingFilmResult_t_p(AF), 0x3FE6C5EA13D93067, _fd(5, 10000000000000), "400 periods: T_p");
assert_eq(AbsorbingFilmResult_a_s(AF), Z, "400 periods: A = 0 exactly");
# 800 x (60 nm n = 2, 35 nm Drude): sum Im delta = 640 drives the flux far below
# 2^-1074 without the 2^512 steps into its exponent.
var ldr8 = _stack(800, F64_TWO, Z, f64_from(60), Z, F64_TWO, f64_from(35));
assert_eq(_rta(W550, Z, F64_ONE, _fd(15, 10), Z, ldr8, 1600), PK_ERR_NONE, "1600-layer Drude stack ok");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3FDE32664CC241E1, _fd(5, 10000000000000), "1600 layers: T_s (5e-13)");
_assert_rel(AbsorbingFilmResult_t_p(AF), 0x3FDE32664CC241E1, _fd(5, 10000000000000), "1600 layers: T_p");
assert_eq(AbsorbingFilmResult_a_p(AF), Z, "1600 layers: A = 0 exactly (was -9e-14)");
# 6.5 um of gold: the flux has been rescaled into its exponent but T 2^512 is still
# O(1e-5), so A must take the exponent into account; everything entering is absorbed.
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, _lay1(AUN, AUK, f64_from(6500)), 1), PK_ERR_NONE, "6.5um gold ok");
_assert_rel(AbsorbingFilmResult_a_s(AF), 0x3FCB3126AF739D09, R13, "6.5 um gold: A = bare-gold transmittance 0.21244");
_assert_rel(AbsorbingFilmResult_r_s(AF), 0x3FE933B6542318BE, R13, "6.5 um gold: R = bare-gold R");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x1F0CEE2156A061CD, _fd(1, 1000000000000), "6.5 um gold: T = 6.9e-157");
_energy("6.5 um gold");
# A substrate index-matched to the incident medium near grazing: q^2 against n0
# keeps it exact (from beta it rounded to R = 1, T = 0).
var _mt = _rta(W550, 0x3FF921FB54442D17, _fd(15, 10), _fd(15, 10), Z, 0, 0);
assert_eq(AbsorbingFilmResult_r_s(AF), Z, "matched substrate at pi/2 - 1 ulp: R_s = 0");
assert_eq(AbsorbingFilmResult_t_s(AF), F64_ONE, "matched substrate at pi/2 - 1 ulp: T_s = 1");
assert(f64_lt(AbsorbingFilmResult_r_p(AF), _fd(1, 1000000000000000)), "matched substrate: R_p ~ 0");
_assert_near(AbsorbingFilmResult_t_p(AF), F64_ONE, _fd(1, 1000000000000000), "matched substrate: T_p = 1");
var lfg = _lay1(F64_TWO, Z, f64_from(5));
assert_eq(_rta(W550, 0x3FF921FB396C3A7D, _fd(15, 10), _fd(15, 10), Z, lfg, 1), PK_ERR_NONE, "grazing film ok");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3DA3D84A638A6FBD, _fd(1, 1000000000000),
  "5 nm film at pi/2 - 1e-7: T_s = 9.02e-12");
_assert_rel(AbsorbingFilmResult_t_p(AF), 0x3DBF5C1D0F1108BC, _fd(1, 1000000000000), "... T_p = 2.85e-11");
# The grazing cosine uses |theta|: -(pi/2 - 1 ulp) is the same incidence, bit for bit.
var _gn = _rta(F64_ONE, 0xBFF921FB54442D17, F64_ONE, 0x430C6BF526340000, Z, 0, 0);
assert_eq(AbsorbingFilmResult_r_p(AF), 0x3FD3F6B7C4EAC7BE, "-(pi/2 - 1 ulp), 1e15 substrate: R_p as for +theta");
var _g80a = _rta(W550, _deg(f64_from(80)), F64_ONE, N152, Z, lau, 1);
var r80 = AbsorbingFilmResult_r_p(AF);
var t80 = AbsorbingFilmResult_t_s(AF);
var _g80b = _rta(W550, f64_neg(_deg(f64_from(80))), F64_ONE, N152, Z, lau, 1);
assert_eq(AbsorbingFilmResult_r_p(AF), r80, "80 deg -> -80 deg: same R_p (grazing branch)");
assert_eq(AbsorbingFilmResult_t_s(AF), t80, "80 deg -> -80 deg: same T_s");
# The grazing branch reaches back to pi/4, not just to the last few ulps: at
# pi/2 - 1e-10 x87 cos is already 2e-11 off T.
var _g10 = _rta(F64_ONE, 0x3FF921FB543D4DE0, F64_ONE, 0x430C6BF526340000, Z, 0, 0);
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3ADEF2D25EC05059, _fd(1, 1000000000000000), "pi/2 - 1e-10: T_s");
# Each index bound on its own (every other check passes these).
assert_eq(_rta(F64_ONE, Z, 0x39A0000000000000, N152, Z, 0, 0), PK_ERR_INVALID_PARAMETER, "n0 = 2^-101 refused");
assert_eq(_rta(F64_ONE, Z, 0x4630000000000001, N152, Z, 0, 0), PK_ERR_INVALID_PARAMETER, "n0 = 2^100 + 1 ulp refused");
assert_eq(_rta(F64_ONE, Z, F64_ONE, N152, 0x4630000000000001, 0, 0), PK_ERR_INVALID_PARAMETER,
  "substrate k = 2^100 + 1 ulp refused");
assert_eq(_rta(F64_ONE, Z, F64_ONE, N152, Z, _lay1(F64_ONE, 0x4630000000000001, f64_from(5)), 1),
  PK_ERR_INVALID_PARAMETER, "layer k = 2^100 + 1 ulp refused");
assert_eq(_rta(F64_ONE, Z, F64_ONE, N152, 0x4630000000000000, 0, 0), PK_ERR_NONE, "substrate k = 2^100 accepted");

# The absorbed flux rides through the rescalings with the vector: an absorber at
# the BACK of a stack whose vector is later rescaled up (400 Drude periods in
# front) or down (a 400-pair mirror in front). References at 40 and 260 digits.
var lu = _stack(401, F64_TWO, Z, f64_from(60), Z, F64_TWO, f64_from(40));
store64(lu + 800 * 24, _fd(15, 10));
store64(lu + 800 * 24 + 8, _fd(1, 100));
store64(lu + 800 * 24 + 16, f64_from(100));
assert_eq(_rta(W550, Z, F64_ONE, _fd(15, 10), Z, lu, 801), PK_ERR_NONE, "absorber behind Drude stack ok");
_assert_rel(AbsorbingFilmResult_a_s(AF), 0x3F90537664E2EF2A, _fd(5, 10000000000000),
  "absorber behind 400 Drude periods: A = 0.0159");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x3FE628DDF943E58E, _fd(5, 10000000000000), "... T");
var ld = _stack(401, _fd(23, 10), Z, f64_div(W550, f64_mul(f64_from(4), _fd(23, 10))),
  N138, Z, f64_div(W550, f64_mul(f64_from(4), N138)));
store64(ld + 800 * 24, AUN);
store64(ld + 800 * 24 + 8, AUK);
store64(ld + 800 * 24 + 16, f64_from(20));
assert_eq(_rta(W550, Z, F64_ONE, N152, Z, ld, 801), PK_ERR_NONE, "gold behind mirror ok");
_assert_rel(AbsorbingFilmResult_a_s(AF), 0x1AFBA41B169C3637, _fd(5, 10000000000000),
  "gold behind a 400-pair mirror: A = 1.07e-178");
_assert_rel(AbsorbingFilmResult_t_s(AF), 0x1B12C263A6D925CE, _fd(5, 10000000000000), "... T = 1.29e-177");

# ── 2.15.1: Fresnel integrals to double precision ────────
# The A&S 7.3.32 fit these used was 2.2e-3 off, jumped 1.6e-3 at its x = 1 seam and went NaN
# from x = 1e10. The references below are a 120-digit evaluation (the Maclaurin series to
# x = 6, the asymptotic expansion truncated at its smallest term beyond, the two agreeing to
# 1e-26 at x = 6), correctly rounded. Every eighth from 0 to 12, both functions, 4e-16
# absolute and 1e-15 relative: the old fit fails all but a handful.
test_group("2.15.1 Fresnel integrals to double precision");
fn _fr_pin(x, c_ref, s_ref, name) {
    var c = fresnel_integral_c(x);
    var s = fresnel_integral_s(x);
    var ok_c = f64_le(f64_abs(f64_sub(c, c_ref)), 0x3CBCD2B297D889BC);     # 4e-16
    var ok_s = f64_le(f64_abs(f64_sub(s, s_ref)), 0x3CBCD2B297D889BC);
    var rel_c = f64_le(f64_abs(f64_sub(c, c_ref)), f64_mul(0x3CD203AF9EE75616, f64_abs(c_ref)));     # 1e-15
    var rel_s = f64_le(f64_abs(f64_sub(s, s_ref)), f64_mul(0x3CD203AF9EE75616, f64_abs(s_ref)));
    assert((ok_c & ok_s & rel_c & rel_s) == 1, name);
    return 0;
}
var _fp1 = _fr_pin(f64_div(f64_from(1), f64_from(8)), 0x3FBFFF81AC2EA61A, 0x3F50C122F9022C50, "C, S at 1/8");
var _fp2 = _fr_pin(f64_div(f64_from(2), f64_from(8)), 0x3FCFF81B9B543C9D, 0x3F80BE5E7D1A496C, "C, S at 2/8");
var _fp3 = _fr_pin(f64_div(f64_from(3), f64_from(8)), 0x3FD7E216B67C575D, 0x3F9C2D0A994A0A7E, "C, S at 3/8");
