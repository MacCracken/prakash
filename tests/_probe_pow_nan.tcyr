# _probe_pow_nan.tcyr — TEMPORARY measurement probe (delete after recording).
# Prints raw f64 bit patterns for the NaN-exponent corners of _prk_pow and the
# ganita builtin it delegates to. Same shape as the 2.2.4 bump probes.

include "src/error.cyr"

alloc_init();

fn _pr(label, bits) {
    syscall(1, 1, label, strlen(label));
    syscall(1, 1, " = ", 3);
    fmt_hex0x(bits);
    syscall(1, 1, "\n", 1);
    return 0;
}

var NAN  = 0x7FF8000000000000;
var PINF = 0x7FF0000000000000;
var NINF = 0xFFF0000000000000;
var ONE  = f64_from(1);
var ZERO = f64_from(0);

syscall(1, 1, "--- the two cases under review ---\n", 35);
_pr("_prk_pow(0.0, NaN)      ", _prk_pow(ZERO, NAN));
_pr("ganita_f64_pow(0.0, NaN)", ganita_f64_pow(ZERO, NAN));
_pr("_prk_pow(1.0, NaN)      ", _prk_pow(ONE, NAN));
_pr("ganita_f64_pow(1.0, NaN)", ganita_f64_pow(ONE, NAN));

syscall(1, 1, "--- intermediate: why 1.0 case lands where it does ---\n", 55);
_pr("f64_ln(1.0)             ", f64_ln(ONE));
_pr("f64_mul(NaN, ln(1.0))   ", f64_mul(NAN, f64_ln(ONE)));
_pr("f64_exp(NaN)            ", f64_exp(NAN));

syscall(1, 1, "--- neighbouring NaN corners ---\n", 33);
_pr("_prk_pow(NaN, 0.0)      ", _prk_pow(NAN, ZERO));
_pr("_prk_pow(NaN, 2.0)      ", _prk_pow(NAN, f64_from(2)));
_pr("_prk_pow(2.0, NaN)      ", _prk_pow(f64_from(2), NAN));
_pr("_prk_pow(-1.0, NaN)     ", _prk_pow(f64_neg(ONE), NAN));
_pr("_prk_pow(0.0, -NaN)     ", _prk_pow(ZERO, 0xFFF8000000000000));
_pr("_prk_pow(1.0, PINF)     ", _prk_pow(ONE, PINF));
_pr("_prk_pow(1.0, NINF)     ", _prk_pow(ONE, NINF));
_pr("_prk_pow(0.0, PINF)     ", _prk_pow(ZERO, PINF));
_pr("_prk_pow(0.0, NINF)     ", _prk_pow(ZERO, NINF));

syscall(1, 1, "--- controls (must be unchanged by any fix) ---\n", 47);
_pr("_prk_pow(0.0, 2.0)      ", _prk_pow(ZERO, f64_from(2)));
_pr("_prk_pow(0.0, 0.0)      ", _prk_pow(ZERO, ZERO));
_pr("_prk_pow(0.0, -2.0)     ", _prk_pow(ZERO, f64_neg(f64_from(2))));
_pr("_prk_pow(2.0, 3.0)      ", _prk_pow(f64_from(2), f64_from(3)));

var r = assert_summary();
