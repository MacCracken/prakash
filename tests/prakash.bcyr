# prakash benchmarks — hot-path functions across the ported optics modules.
# Run: cyrius bench tests/prakash.bcyr  (or ./scripts/bench-history.sh).
# Mirrors the intent of the Rust criterion benches for the Cyrius port.

include "src/error.cyr"
include "src/spectral_core.cyr"
include "src/ray_core.cyr"
include "src/ray_fresnel.cyr"
include "src/ray_trace.cyr"
include "src/ray_dispersion.cyr"
include "src/ray_fiber.cyr"
include "src/ray_system.cyr"
include "src/ray_simulate.cyr"
# 2.8.0: gradient-index ray tracing.
include "src/ray_grin.cyr"
include "src/spectral_cie.cyr"
include "src/spectral_photometry.cyr"
include "src/wave_core.cyr"
# 2.3.9: wave_polarization and wave_coherence were never included here, so the
# Mueller calculus and the coherence functions could not be benchmarked at all.
include "src/wave_polarization.cyr"
include "src/wave_coherence.cyr"
include "src/wave_airy.cyr"
include "src/wave_diffraction.cyr"
# 2.9.0: diffractive optics.
include "src/wave_doe.cyr"
include "src/wave_zernike.cyr"
include "src/wave_pattern.cyr"
# 2.6.0: Gaussian beam optics.
include "src/wave_beam.cyr"
include "src/pbr_core.cyr"
include "src/pbr_advanced.cyr"
include "src/lens.cyr"
include "src/atmosphere.cyr"
include "src/bridge.cyr"
include "src/serialize.cyr"

fn _bf(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# Run one benchmark: build a harness for `name`, drive `fp` for `n` iterations, report.
fn bench(name, fp, n) {
    var b = bench_new(name);
    bench_run(b, fp, n);
    bench_report(b);
    return 0;
}

