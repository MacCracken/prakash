# ── Ray ────────
# Unpolarized Fresnel reflectance at one incidence angle.
fn b_fresnel_unpolarized() { var r = fresnel_unpolarized(_n1, _n2, _ang, _err); return 0; }
# Numerical aperture of a step-index fiber from its core/cladding indices.
fn b_fiber_na() { var r = fiber_na(_n2, _n1, _err); return 0; }
# Fiber V-number (normalized frequency) from diameter, NA and wavelength.
fn b_v_number() { var r = v_number(_diam, _na, _wl_m); return 0; }
# Sellmeier dispersion: refractive index of BK7 at one wavelength.
fn b_sellmeier_n_at() { var r = sellmeier_n_at(_bk7, _rho); return 0; }

# ── Spectral ────────
# CIE 1931 wavelength -> sRGB conversion at one wavelength.
fn b_wavelength_to_rgb() { var r = wavelength_to_rgb(_wl_nm, _err); return 0; }
# Planck spectral radiance at one wavelength and temperature.
fn b_planck_radiance() { var r = planck_radiance(_wl_m, _temp); return 0; }
# Single-wavelength lookup into a tabulated SPD (D65).
fn b_spd_at() { var r = spd_at(_d65, _wl_nm); return 0; }

# ── Wave ────────
# Single-slit diffraction intensity at one angle.
fn b_single_slit() { var r = single_slit_intensity(_wl_m, _slit, _ang, _i0); return 0; }
# Malus's law: transmitted intensity through a polarizer at one angle.
fn b_malus_law() { var r = malus_law(_i0, _theta); return 0; }
# First-order Bessel function J1 — the Airy pattern kernel.
fn b_bessel_j1() { var r = bessel_j1(_x); return 0; }
# Airy diffraction intensity at one angle for a circular aperture.
fn b_airy_pattern() { var r = airy_pattern(_wl_m, _diam, _ang, _i0); return 0; }
# Fresnel cosine integral C(x) — the Cornu spiral coordinate.
fn b_fresnel_integral_c() { var r = fresnel_integral_c(_x); return 0; }
# Single-layer thin-film coating reflectance at one wavelength.
fn b_coating_reflectance() { var r = coating_reflectance(_wl_nm, _n1, _nc, _ns, _thick); return 0; }
# Full transfer-matrix s/p reflectance+transmittance through a layer stack — the
# function 2.3.7 took 480 -> 448 ns, which had no row to show it. Added so the
# row that was optimised is the row that is measured.
fn b_multilayer_rt() { var r = multilayer_rt(_wl_nm, _ang, _n1, _ns, _layers, 3); return 0; }
# Zernike polynomial Z(4,0) — spherical aberration — at one pupil point.
fn b_zernike_poly() { var r = zernike_poly(4, 0, _rho, _theta); return 0; }
# Composite: full 8x8 2D Fraunhofer diffraction, FFT path included.
fn b_diffraction_2d() { var r = diffraction_pattern_2d(_aperture, 8, 8); return 0; }

# ── PBR ────────
# Schlick approximation to the Fresnel term — the cheapest PBR row.
fn b_fresnel_schlick() { var r = pbr_fresnel_schlick(_f0, _ct); return 0; }
# GGX/Trowbridge-Reitz normal distribution term.
fn b_distribution_ggx() { var r = pbr_distribution_ggx(_ndh, _rough); return 0; }
# Full Cook-Torrance specular BRDF (D, G and F combined).
fn b_cook_torrance() { var r = pbr_cook_torrance(_ndh, _hdv, _ndv, _ndl, _rough, _f0); return 0; }
# Thin-film iridescent Fresnel reflectance at one wavelength.
fn b_iridescence() { var r = pbr_iridescence_fresnel(_n1, _nc, _ns, _film_th, _wl_nm, _ct); return 0; }
# Henyey-Greenstein phase function at one scattering angle.
fn b_henyey_greenstein() { var r = pbr_henyey_greenstein(_ct, _g); return 0; }

# ── Lens ────────
# Diffraction-limited MTF at one spatial frequency.
fn b_mtf() { var r = lens_mtf_diffraction_limited(_freq, _cutoff); return 0; }
# The five Seidel aberration coefficients for one singlet prescription.
fn b_seidel() { var r = lens_seidel_coefficients(_sn, _sf, _sp, _sp); return 0; }

# ── Atmosphere ────────
# Rayleigh scattering cross-section at one wavelength.
fn b_rayleigh_cross() { var r = atm_rayleigh_cross_section(_wl_m); return 0; }
# Cornette-Shanks approximation to the Mie phase function.
fn b_mie_phase() { var r = atm_mie_phase_cornette_shanks(_ct, _g); return 0; }
# Composite: full atmospheric sky colour — the worst scalar row, and the only one that allocates.
fn b_sky_color() { atm_sky_color_rgb(_sunz, _scat, _out3); return 0; }

# ── Bridge / serialize ────────
# Stellar blackbody temperature -> sRGB via the bridge layer.
fn b_stellar_rgb() { br_stellar_temperature_to_rgb(_temp, _out3); return 0; }
# Composite: serialize an RGB triple to JSON (bayan Grisu2 float rendering dominates).
fn b_rgb_to_json() { var r = rgb_to_json(_rgb); return 0; }
# Composite: serialize a 6-surface lens prescription to JSON. The only other
# serializer with a loop, and the second-heaviest; added in 2.3.5 when the
# str_builder rewrite took it 32.1 -> 21.0 us.
fn b_prescription_to_json() { var r = prescription_to_json(_presc); return 0; }
# Composite: serialize a full 81-sample SPD to JSON — the HEAVIEST serializer and
# the one the roadmap's serialize row was never actually about. rgb_to_json emits
# 3 floats; this emits 81 plus an array, allocating inside the loop. Added in
# 2.3.4 so the row that costs is the row that is measured.
fn b_spd_to_json() { var r = spd_to_json(_d65); return 0; }
# ── composites (2.1.1) ──
# Composite: integrate an SPD against the CIE CMFs to XYZ.
fn b_spd_to_xyz() { var r = spd_to_xyz(_d65); return 0; }
# Composite: build an 81-sample blackbody SPD at 5000 K (transcendental-bound).
fn b_spd_blackbody() { var r = spd_blackbody(f64_from(5000)); return 0; }
# Composite: photopic luminous flux of D65 over the tabulated CMFs.
fn b_luminous_flux() { var r = luminous_flux(_d65); return 0; }
# Composite: CIE 13.3 colour rendering index of D65 — the slowest row in the suite.
fn b_cri() { var r = color_rendering_index(_d65); return 0; }
# Single ray-surface intersection with refraction.
fn b_trace_surface() { var r = trace_surface(_ray0, _plane, _err); return 0; }
# Composite: trace one ray through a full sequential surface list.
fn b_trace_sequential() { var r = trace_sequential(_ray0, _surfaces, _err); return 0; }
# Composite: spot diagram over a ray fan — allocation- and branch-heavy.
fn b_spot_diagram() {
    var r = spot_diagram(_surfaces, _bf(5, 1), 3, 6, f64_from(0), f64_from(0), f64_from(50));
    return 0;
}
# Composite: normalize a 64x64 Pattern2D (the one SIMD path in prakash).
fn b_pattern_normalized() { var r = pattern2d_normalized(_bigpat); return 0; }
# Composite: 16x16 two-source interference field — the most expensive wave row.
fn b_interference_pattern() {
    var r = interference_pattern(_srcs, 3, _wl_m, F64_ONE,
      f64_neg(F64_ONE), F64_ONE, f64_neg(F64_ONE), F64_ONE, 16, 16);
    return 0;
}

# Wavelength (nm) -> frequency (Hz).
fn b_wavelength_to_frequency() { var r = wavelength_to_frequency(_wl_nm); return 0; }
# Frequency (Hz) -> wavelength (nm).
fn b_frequency_to_wavelength() { var r = frequency_to_wavelength(_freq_hz); return 0; }
# Photon energy in Joules at one wavelength.
fn b_photon_energy() { var r = photon_energy(_wl_nm); return 0; }
# Photon energy in electron-volts at one wavelength.
fn b_photon_energy_ev() { var r = photon_energy_ev(_wl_nm); return 0; }
# Wien's displacement law: blackbody peak wavelength at one temperature.
fn b_wien_peak() { var r = wien_peak(_temp); return 0; }
# Rec. 709 relative luminance of one RGB triple.
fn b_rgb_luminance() { var r = rgb_luminance(_rgb); return 0; }
# Clamp plus saturating cast of an RGB triple to 8-bit channels.
fn b_rgb_to_u8() { var r = rgb_to_u8(_rgb); return 0; }
# XYZ -> xyY chromaticity.
fn b_xyz_to_xyy() { var r = xyz_to_xyy(_xyz); return 0; }
# CIE xy chromaticity -> correlated colour temperature (McCamy's fit).
fn b_cct_from_xy() { var r = cct_from_xy(_cx, _cy); return 0; }
# Linear sRGB -> XYZ through the forward 3x3 matrix.
fn b_linear_srgb_to_xyz() { var r = linear_srgb_to_xyz(_rgb); return 0; }
# XYZ -> linear sRGB through the inverse 3x3 matrix.
fn b_xyz_to_linear_srgb() { var r = xyz_to_linear_srgb(_xyz); return 0; }
# Interpolated CIE 1931 colour-matching functions at one wavelength.
fn b_cie_cmf_at() { var r = cie_cmf_at(_wl_nm); return 0; }
# sRGB encoding gamma for one linear channel value (the pow branch).
fn b_linear_to_srgb_gamma() { var r = linear_to_srgb_gamma(_lin); return 0; }
# XYZ -> gamma-encoded, clamped sRGB — three allocations and three pow calls.
fn b_xyz_to_srgb() { var r = xyz_to_srgb(_xyz); return 0; }
# Composite: integrate D65 to XYZ, normalize to Y=1 and gamma-encode to sRGB.
fn b_spd_to_srgb() { var r = spd_to_srgb(_d65); return 0; }
# Composite: one CIE 13.3 special colour rendering index (R4) for D65 — the
# per-sample cost color_rendering_index pays eight times over one shared context.
fn b_cri_special() { var r = cri_special(_d65, 4); return 0; }

# ── PBR core (2.3.9) ────────
# Beckmann NDF at one half-vector angle — the exp-bound alternative to GGX.
fn b_distribution_beckmann() { var r = pbr_distribution_beckmann(_ndh, _rough); return 0; }
# Fresnel-Schlick per RGB channel into a 3-f64 buffer (copper F0).
fn b_fresnel_schlick_rgb() { var r = pbr_fresnel_schlick_rgb(_f0rgb, _ct, _out3); return 0; }
# Schlick-GGX geometry term for a single direction (direct-lighting k remap).
fn b_geometry_schlick_ggx() { var r = pbr_geometry_schlick_ggx(_ndv, _rough); return 0; }
# Smith geometry: the two-direction product of the Schlick-GGX term.
fn b_geometry_smith() { var r = pbr_geometry_smith(_ndv, _ndl, _rough); return 0; }
# Refractive index -> normal-incidence reflectance F0.
fn b_ior_to_f0() { var r = pbr_ior_to_f0(_n2); return 0; }
# Lambertian diffuse: albedo/pi — the cheapest function in the library.
fn b_lambert_diffuse() { var r = pbr_lambert_diffuse(_alb); return 0; }
# Lambertian diffuse per RGB channel into a 3-f64 buffer.
fn b_lambert_diffuse_rgb() { var r = pbr_lambert_diffuse_rgb(_alb3, _out3); return 0; }

# ── PBR advanced (2.3.9) ────────
# Energy-conserving blend of a base BRDF with a clearcoat lobe.
fn b_clearcoat_blend() { var r = pbr_clearcoat_blend(_bbrdf, _cbrdf, _cc, _hdv); return 0; }
# Full clearcoat BRDF: D*F*G at the fixed 1.5 coat IOR.
fn b_clearcoat_brdf() { var r = pbr_clearcoat_brdf(_ndh, _ndv, _ndl, _hdv, _ccr); return 0; }
# Anisotropic Smith geometry term for one direction (Heitz).
fn b_geometry_ggx_aniso() { var r = pbr_geometry_ggx_aniso(_ndv, _vdx, _vdy, _rx, _ry); return 0; }
# Thin-film iridescence at 650/550/450 nm — three Airy evaluations into an RGB buffer.
fn b_iridescence_rgb() { var r = pbr_iridescence_rgb(_n1, _nc, _ns, _film_th, _ct, _out3); return 0; }
# Rayleigh phase function at one scattering angle.
fn b_phase_rayleigh() { var r = pbr_phase_rayleigh(_ct); return 0; }
# PDF of a cosine-weighted hemisphere sample.
fn b_sample_cosine_pdf() { var r = pbr_sample_cosine_pdf(_ndl); return 0; }
# GGX importance-sampled half-vector into a 3-f64 buffer (sin+cos bound).
fn b_sample_ggx() { var r = pbr_sample_ggx(_rough, _xi1, _xi2, _out3); return 0; }
# PDF of the GGX-sampled half-vector: D*n.h / (4*h.v).
fn b_sample_ggx_pdf() { var r = pbr_sample_ggx_pdf(_ndh, _hdv, _rough); return 0; }
# Ashikhmin sheen lobe at one view angle.
fn b_sheen_ashikhmin() { var r = pbr_sheen_ashikhmin(_ct, _sheen); return 0; }
# Charlie sheen BRDF — the pow() inside the distribution dominates.
fn b_sheen_charlie() { var r = pbr_sheen_charlie(_ndh, _ndl, _ndv, _rough); return 0; }
# Single-scattering in-scattered radiance: sigma_s * phase * transmittance * L.
fn b_inscattering() {
    var r = pbr_single_scatter_inscattering(_sscat, _ct, _g, _sigt, _dist, _i0);
    return 0;
}
# Karis analytic split-sum (scale, bias) into a 2-f64 buffer.
fn b_split_sum_scale_bias() { var r = pbr_split_sum_scale_bias(_ndv, _rough, _out3); return 0; }
# Burley subsurface diffuse term.
fn b_subsurface_diffuse() { var r = pbr_subsurface_diffuse(_ndl, _ndv, _rough); return 0; }
# Beer-Lambert volume transmittance over one path length.
fn b_volume_transmittance() { var r = pbr_volume_transmittance(_sigt, _dist); return 0; }

# ── Lens (2.3.9 sweep) ────────
# Thin-lens magnification M = -di/do — one negate and one divide.
fn b_magnification() { var r = lens_magnification(_obj, _img); return 0; }
# Lensmaker's equation: focal length of an equiconvex singlet from n and both radii.
fn b_lensmaker_focal_length() { var r = lens_lensmaker_focal_length(_n2, _r1, _r2, _err); return 0; }
# Optical power in diopters from a focal length in metres.
fn b_optical_power() { var r = lens_optical_power(_fm, _err); return 0; }
# Mirror focal length f = R/2 — the cheapest row in the module.
fn b_mirror_focal_length() { var r = lens_mirror_focal_length(_r1); return 0; }
# Two thin lenses in contact: 1/f = 1/f1 + 1/f2.
fn b_combined_focal_length() { var r = lens_combined_focal_length(_sf, _f2, _err); return 0; }
# Depth of field: near/far limits written through the out pointer (finite-far branch).
fn b_depth_of_field() { lens_depth_of_field(_fmm, _fnum, _coc, _subj, _out3); return 0; }
# Composite: the five cardinal points of a thick lens — traces and allocates a struct.
fn b_cardinal_points() { var r = lens_cardinal_points(_n2, _r1, _r2, _lth, _err); return 0; }
# F-number N = f/D.
fn b_f_number() { var r = lens_f_number(_fmm, _apd); return 0; }
# Aperture diameter from focal length and f-number.
fn b_aperture_from_f_number() { var r = lens_aperture_from_f_number(_fmm, _fnum); return 0; }
# Numerical aperture NA = n*sin(half_angle) — one transcendental.
fn b_numerical_aperture() { var r = lens_numerical_aperture(_n2, _theta); return 0; }
# Paraxial NA from f-number: NA = 1/(2N).
fn b_na_from_f_number() { var r = lens_na_from_f_number(_fnum); return 0; }
# Rayleigh diffraction limit theta = 1.22*lambda/D.
fn b_diffraction_limit() { var r = lens_diffraction_limit(_wl_m, _diam); return 0; }
# Airy disk radius r = 1.22*lambda*N.
fn b_airy_disk_radius() { var r = lens_airy_disk_radius(_wl_m, _fnum); return 0; }
# Full-angle field of view across the 36 mm sensor dimension — one atan2.
fn b_field_of_view() { var r = lens_field_of_view(_sens_w, _fmm); return 0; }
# Diagonal field of view of a 36x24 mm sensor — a hypot on top of the atan2.
fn b_field_of_view_diagonal() { var r = lens_field_of_view_diagonal(_sens_w, _sens_h, _fmm); return 0; }
# Diffraction-limited MTF cutoff frequency 1/(lambda*N).
fn b_mtf_cutoff_frequency() { var r = lens_mtf_cutoff_frequency(_wl_m, _fnum); return 0; }
# Coddington shape factor q of the singlet.
fn b_shape_factor() { var r = lens_shape_factor(_r1, _r2); return 0; }
# Conjugate (position) factor p from the object/image distances.
fn b_conjugate_factor() { var r = lens_conjugate_factor(_obj, _img); return 0; }
# Longitudinal chromatic aberration LCA = f/V for BK7.
fn b_chromatic_aberration() { var r = lens_chromatic_aberration(_sf, _abbe); return 0; }
# Petzval sum over a 3-element (n, f) list — the module's only loop row.
fn b_petzval_sum() { var r = lens_petzval_sum(_elems, 3); return 0; }

# ── wave_core / polarization / diffraction / coherence (2.3.9) ────────
# Double-slit intensity: single-slit envelope times the two-slit cosine term.
fn b_double_slit() { var r = double_slit_intensity(_wl_m, _slit, _spacing, _ang, _i0); return 0; }
# Constructive-interference test for one path difference.
fn b_is_constructive() { var r = is_constructive(_pathd, _wl_m); return 0; }
# Destructive-interference test for one path difference.
fn b_is_destructive() { var r = is_destructive(_pathd, _wl_m); return 0; }
# Path difference -> phase difference (2*pi*path/lambda).
fn b_path_to_phase() { var r = path_to_phase(_wl_m, _pathd); return 0; }
# Thin-film reflectance at near-normal incidence (sin^2 of the half phase).
fn b_thin_film_reflectance() { var r = thin_film_reflectance(_wl_nm, _film_th, _n2); return 0; }
# Total intensity of a Jones polarization state (ex^2 + ey^2).
fn b_polarization_intensity() { var r = polarization_intensity(_pol); return 0; }
# Malus transmission of a Jones state through a linear polarizer (atan2-bound).
fn b_polarization_polarizer() { var r = polarization_through_polarizer(_pol, _theta); return 0; }
# Build the 4x4 Mueller matrix of a linear polarizer at one angle (allocates 128 B).
fn b_mueller_polarizer() { var r = mueller_polarizer(_theta); return 0; }
# Build the 4x4 Mueller matrix of a linear retarder (allocates 128 B).
fn b_mueller_retarder() { var r = mueller_retarder(F64_PI_2); return 0; }
# 4x4 Mueller matrix product — 64 multiply-adds through the bounds-checked getter.
fn b_mueller_multiply() { var r = mueller_multiply(_mm_pol, _mm_ret); return 0; }
# Apply a Mueller matrix to a Stokes vector (allocates the result Stokes vector).
fn b_mueller_apply() { var r = mueller_apply(_mm_pol, _stokes); return 0; }
# Fraunhofer intensity for a rectangular aperture — two single-slit sincs.
fn b_fraunhofer_rect() { var r = fraunhofer_rect(_wl_m, _slit, _slit, _ang, _ang, _i0); return 0; }
# Fresnel sine integral S(x) — the Cornu spiral's other coordinate.
fn b_fresnel_integral_s() { var r = fresnel_integral_s(_x); return 0; }
# Straight-edge diffraction intensity — both Fresnel integrals in one pass.
fn b_fresnel_edge_intensity() { var r = fresnel_edge_intensity(_x); return 0; }
# Temporal coherence length from centre wavelength and bandwidth.
fn b_coherence_length() { var r = coherence_length(_wl_m, _bw); return 0; }
# Temporal coherence time (coherence length over c).
fn b_coherence_time() { var r = coherence_time(_wl_m, _bw); return 0; }
# Beer-Lambert attenuation over a path (exp-bound).
fn b_beer_lambert() { var r = beer_lambert(_i0, _alpha, _dist); return 0; }
# Brewster's angle for an air/glass interface (atan2-bound).
fn b_brewster_angle() { var r = brewster_angle(_n1, _n2); return 0; }
# Fresnel reflectance at normal incidence.
fn b_fresnel_normal() { var r = fresnel_normal(_n1, _n2); return 0; }
# Fresnel reflectance for p-polarized light at 30 degrees incidence.
fn b_fresnel_p() { var r = fresnel_p(_n1, _n2, _cos_i, _cos_t); return 0; }
# Fresnel reflectance for s-polarized light at 30 degrees incidence.
fn b_fresnel_s() { var r = fresnel_s(_n1, _n2, _cos_i, _cos_t); return 0; }
# 3D Snell refraction plus unpolarized reflectance (boxes a RayVec3 per call).
fn b_snell_3d() { var r = ray_snell_3d(_dir, _norm, _n1, _n2, _out3, _err); return 0; }

# ── Atmosphere (2.3.9) ────────
# Kasten-Young relative air mass at one solar zenith angle.
fn b_air_mass() { var r = atm_air_mass(_sunz); return 0; }
# Total atmospheric transmittance (Rayleigh + Mie) along one slant path.
fn b_atm_transmittance() { var r = atm_atmospheric_transmittance(_wl_m, _sunz); return 0; }
# King depolarization correction factor at one wavelength.
fn b_king_factor() { var r = atm_king_factor(_wl_m); return 0; }
# Zenith Rayleigh optical depth at one wavelength.
fn b_optical_depth_rayleigh() { var r = atm_optical_depth_rayleigh(_wl_m); return 0; }
# Sea-level Rayleigh scattering coefficient at one wavelength.
fn b_rayleigh_beta() { var r = atm_rayleigh_scattering_coefficient(_wl_m); return 0; }
# Sun-to-view scattering angle from the two zenith angles and the azimuth difference.
fn b_scattering_angle() { var r = atm_scattering_angle(_sunz, _theta, _rho); return 0; }
# Composite: direct-sunlight RGB transmittance colour into a 3-f64 buffer.
fn b_sunlight_color() { atm_sunlight_color(_sunz, _out3); return 0; }
# Composite: sunset/sunrise sky gradient RGB into a 3-f64 buffer.
fn b_sunset_gradient() { atm_sunset_gradient(_sunz, _theta, _rho, _out3); return 0; }

# ── Ray: dispersion (2.3.9) ────────
# Abbe number of BK7 — three Sellmeier evaluations at the Fraunhofer d/F/C lines.
fn b_abbe_number() { var r = abbe_number(_bk7); return 0; }
# Cauchy two-term refractive index at one wavelength.
fn b_cauchy_n_at() { var r = cauchy_n_at(_cauchy, _wl_um); return 0; }
# Schott six-term refractive index at one wavelength.
fn b_schott_n_at() { var r = schott_n_at(_schott, _wl_um); return 0; }
# Minimum-deviation angle of a 60-degree prism at a fixed index.
fn b_prism_deviation() { var r = prism_deviation(_apex, _n2, _err); return 0; }
# Prism deviation with the index taken from the BK7 Sellmeier fit.
fn b_prism_dispersion() { var r = prism_dispersion(_apex, _bk7, _wl_um, _err); return 0; }
# Angular spread of a BK7 prism across the 450-650 nm band (two deviations).
fn b_prism_angular_spread() {
    var r = prism_angular_spread(_apex, _bk7, _wl_s_um, _wl_l_um, _err);
    return 0;
}

# ── Ray: core (2.3.9) ────────
# Critical angle for total internal reflection at a glass-to-air boundary.
fn b_critical_angle() { var r = ray_critical_angle(_n2, _n1, _err); return 0; }
# Specular reflection of a 2D direction about a surface normal.
fn b_reflect_2d() { var r = ray_reflect_2d(_dir2, _nrm2); return 0; }
# Specular reflection of a 3D direction about a surface normal.
fn b_reflect_3d() { var r = ray_reflect_3d(_dir3, _nrm3); return 0; }
# Vector-form Snell refraction of a 3D direction across an air-to-glass boundary.
fn b_refract_3d() { var r = ray_refract_3d(_dir3, _nrm3, _n1, _n2, _err); return 0; }

# ── Ray: system / simulate (2.3.9) ────────
# Composite: cardinal points (EFL/BFD/FFD) of a biconvex prescription — forward
# and reverse paraxial traces, both of which build vecs.
fn b_find_system_properties() { var r = find_system_properties(_presc_bx, _err); return 0; }
# Composite: optical path length of one ray through the surface list to the image plane.
fn b_optical_path_length() { var r = optical_path_length(_ray0, _surfaces, _img_z, _err); return 0; }
# Composite: wavefront aberration of a marginal ray against the axial chief ray —
# two traces plus the common-reference-point legs (reworked 2.5.0).
fn b_optical_path_difference() {
    var r = optical_path_difference(_ray_marg, _ray0, _surfaces, _img_z, _err);
    return 0;
}

# ── Gaussian beams (2.6.0) ────────
var _gb = 0;
var _gb_w0 = 0;
var _gb_wl = 0;
var _gb_z = 0;
var _gb_ref = 0;
var _gb_re = 0;
var _gb_im = 0;
var _gb_prof = 0;
var _gb_dx = 0;
var _gb_r60 = 0;

# TEM00 beam radius w(z) from the closed form.
fn b_gaussian_beam_radius() { var r = gaussian_beam_radius(_gb_w0, _gb_wl, _gb_z, _err); return 0; }
# TEM00 intensity at one (r, z) for a given power.
fn b_gaussian_intensity() { var r = gaussian_intensity(F64_ONE, _gb_w0, _gb_wl, _gb_w0, _gb_z, _err); return 0; }
# One thin-lens element on the q parameter. The state is reset first (two stores),
# so every iteration transforms the same q rather than walking it toward a focus.
fn b_beam_thin_lens() {
    GaussianBeam_set_q_re(_gb, _gb_z);
    GaussianBeam_set_q_im(_gb, _gb_w0);
    var r = beam_thin_lens(_gb, _bf(1, 2));
    return 0;
}
# One free-space step on the q parameter (Gouy phase included), state reset first.
fn b_beam_propagate() {
    GaussianBeam_set_q_re(_gb, _gb_z);
    GaussianBeam_set_q_im(_gb, _gb_w0);
    var r = beam_propagate(_gb, F64_ONE);
    return 0;
}
# TEM00 mode overlap between two beams with mismatched size and curvature.
fn b_beam_coupling() { var r = beam_coupling_efficiency(_gb, _gb_ref, _err); return 0; }
# Hermite polynomial H_20 by recurrence.
fn b_hermite_poly_20() { var r = hermite_poly(20, _gb_z); return 0; }
# Generalised Laguerre L_10^3 by recurrence.
fn b_laguerre_poly_10() { var r = laguerre_poly(10, 3, _gb_z); return 0; }
# Complex HG_32 field at one point (curvature + Gouy phase).
fn b_hg_mode_field() { var r = hg_mode_field(_gb_ref, 3, 2, _gb_dx, _gb_dx, &_gb_re, &_gb_im); return 0; }
# Complex LG_2,3 field at one point (helix + curvature + Gouy phase).
fn b_lg_mode_field() { var r = lg_mode_field(_gb_ref, 2, 3, _gb_dx, _gb_z, &_gb_re, &_gb_im); return 0; }
# A flat air -> glass interface on the q parameter (a B = 0 element), state reset
# first. 2.6.1 took the B = 0 elements from ~125 to ~45 ns; this row keeps it seen.
fn b_beam_interface() {
    GaussianBeam_set_q_re(_gb, _gb_z);
    GaussianBeam_set_q_im(_gb, _gb_w0);
    GaussianBeam_set_wavelength(_gb, _gb_wl);
    var r = beam_interface(_gb, F64_ONE, _bf(3, 2));
    return 0;
}
# Complex LG_60,60 field at one point — a high order, where 2.6.1's LG rework
# counts most (2.6 -> 1.1 us for the amplitude).
# r is on the mode's bright region (s = 2r^2/w^2 = 300), not in the far tail where
# the amplitude is an early 0.
fn b_lg_mode_field_60() { var r = lg_mode_field(_gb_ref, 60, 60, _gb_r60, _gb_z, &_gb_re, &_gb_im); return 0; }
# ── Aberrated OTF (2.7.0) ────────
var _otf_wc = 0;
var _otf_re = 0;
var _otf_im = 0;
# Aberrated OTF of a Seidel wavefront (0.5 waves coma + 1 wave defocus), tangential,
# at v = 0.3 with 64 Gauss-Legendre nodes per axis: 8192 wavefront evaluations.
fn b_lens_otf_seidel() { var r = lens_otf_seidel(_otf_wc, F64_ONE, _bf(3, 10), 1, 64, &_otf_re, &_otf_im); return 0; }
# ── GRIN ray tracing (2.8.0) ────────
var _grin_sf = 0;
var _grin_lu = 0;
var _grin_ray = 0;
var _grin_lray = 0;
var _grin_opl = 0;
# One index evaluation of a SELFOC rod (n^2 = n0^2 [1 - (g r)^2 + ...]).
fn b_grin_index() { var r = grin_index(_grin_sf, _bf(3, 10), _bf(1, 10), F64_TWO); return 0; }
# A skew ray through a quarter pitch (pi) of a SELFOC rod in 100 RKN steps.
fn b_grin_selfoc_100() {
    var r = grin_trace_to_plane(_grin_sf, _grin_ray, F64_PI, f64_div(F64_PI, f64_from(100)), 1000, &_grin_opl, _err);
    return 0;
}
# A collimated ray at h = 0.5 through a unit Luneburg ball: entry, ~97 RKN steps of arc
# 0.02 (arc 1.95), the Newton landing on the sphere, exit.
fn b_grin_luneburg() {
    var r = grin_ball_trace(_grin_lu, _grin_lray, 0, F64_ONE, F64_ONE, _bf(2, 100), 1000, &_grin_opl, _err);
    return 0;
}
# ── Diffractive optics (2.9.0) ────────
var _doe_dm = 0;
var _doe_g = 0;
# An 8-level kinoform's first order off design (sinc^2 times the Dirichlet kernel).
fn b_doe_multilevel() { var r = doe_multilevel_efficiency(1, 8, _bf(9, 10)); return 0; }
# A 1x7 Dammann grating's order 2 (three transitions).
fn b_doe_dammann() { var r = doe_dammann_efficiency(_doe_dm, 3, 2, _err); return 0; }
# Kogelnik: a slanted transmission hologram off Bragg, TE.
fn b_doe_kogelnik() { var r = hologram_efficiency(_doe_g, _bf(3, 100), _bf(532, 1000), 0, _err); return 0; }
var _doe_gr = 0;
# Kogelnik: an unslanted reflection hologram detuned inside its band, TM (the sinh branch).
fn b_doe_kogelnik_refl() { var r = hologram_efficiency(_doe_gr, 0, _bf(601, 1000), 1, _err); return 0; }
# ── Absorbing films + fiber dispersion (2.10.0) ────────
var _rta_l3 = 0;
var _rta_au = 0;
var _rta_out = 0;
var _fs = 0;
# The complex-index TMM on multilayer_rt's own 3-layer stack (k = 0): the price of
# the complex path, like for like.
fn b_multilayer_rta_3() { var r = multilayer_rta(_wl_nm, _ang, _n1, _ns, 0, _rta_l3, 3, _rta_out); return 0; }
# 20 nm of gold on glass at 45 deg.
fn b_multilayer_rta_gold() {
    var r = multilayer_rta(_wl_nm, _bf(7853981633974483, 10000000000000000), _n1, _ns, 0, _rta_au, 1, _rta_out);
    return 0;
}
# Analytic group index of fused silica at 1.55 um.
fn b_sellmeier_group_index() { var r = sellmeier_group_index(_fs, _bf(155, 100)); return 0; }
# Material dispersion D of fused silica at 1.55 um.
fn b_fiber_material_dispersion() { var r = fiber_material_dispersion(_fs, _bf(155, 100)); return 0; }
# The LP01 eigenvalue b at V = 2 (s-branch solve).
fn b_fiber_lp01_b() { var r = fiber_lp01_b(F64_TWO, _err); return 0; }
# Total dispersion of an SMF-like step-index fibre at 1.55 um (mode solve + chain rule).
fn b_fiber_dispersion() { var r = fiber_dispersion(_fs, _bf(36, 10000), _bf(41, 10), _bf(155, 100), _err); return 0; }
# Fused silica's material zero-dispersion wavelength (Illinois over [1, 2] um).
fn b_fiber_zero_material() {
    var r = fiber_zero_dispersion_wavelength(_fs, 0, F64_ONE, F64_ONE, F64_TWO, _err);
    return 0;
}
# ISO 11146 second-moment radius of a 256-sample profile (two passes).
fn b_second_moment_256() { var r = beam_second_moment_radius(_gb_prof, 256, 0, _bf(1, 100), _err); return 0; }

# Allocate the shared fixtures, then run every benchmark above in order.
fn main() {
    alloc_init();
    _err = alloc(8);
    _out3 = alloc(24);
    _bk7 = sellmeier_bk7();
    _d65 = illuminant_d65();
    _rgb = rgb_new(_bf(1, 10), _bf(2, 10), _bf(3, 10));
    _aperture = alloc(64 * 8);
    for (var i = 0; i < 64; i = i + 1) {
        store64(_aperture + i * 8, F64_ONE);
    }
    _presc = prescription_new("bench lens");
    for (var pk = 0; pk < 6; pk = pk + 1) {
        var _pa = prescription_add_surface(_presc, f64_from(50 + pk), f64_from(pk), F64_ONE, f64_from(12));
    }
    _layers = alloc(3 * 16);
    store64(_layers, _bf(138, 100));      store64(_layers + 8, f64_from(100));
    store64(_layers + 16, _bf(23, 10));   store64(_layers + 24, f64_from(55));
    store64(_layers + 32, _bf(152, 100)); store64(_layers + 40, f64_from(200));
    _wl_nm = f64_from(550);
    _wl_m = _bf(55, 100000000);
    _diam = _bf(1, 100);
    _ang = _bf(1, 1000);
    _i0 = F64_ONE;
    _n1 = F64_ONE;
    _n2 = _bf(15, 10);
    _nc = _bf(138, 100);
    _ns = _bf(152, 100);
    _thick = f64_from(100);
    _f0 = _bf(4, 100);
    _ct = _bf(7, 10);
    _ndh = _bf(9, 10);
    _rough = _bf(3, 10);
    _hdv = _bf(85, 100);
    _ndv = _bf(8, 10);
    _ndl = _bf(7, 10);
    _g = _bf(76, 100);
    _film_th = f64_from(300);
    _freq = f64_from(500);
    _cutoff = f64_from(649);
    _sn = _bf(15, 10);
    _sf = f64_from(100);
    _sp = f64_neg(F64_ONE);
    _temp = f64_from(5778);
    _sunz = _bf(3, 10);
    _scat = F64_PI_2;
    _rho = _bf(7, 10);
    _theta = _bf(5, 10);
    _na = _bf(22, 100);
    _x = _bf(15, 10);
    _slit = _bf(1, 1000);

    # ── ray ──
    # composite fixtures
    _plane = surface_plane(f64_from(10), F64_ONE, f64_from(5));
    _ray0 = trace_ray_new(ray_vec3(f64_from(0), f64_from(0), f64_from(0)),
      ray_vec3(f64_from(0), f64_from(0), F64_ONE), F64_ONE);
    _surfaces = vec_new();
    vec_push(_surfaces, surface_sphere(f64_from(50), f64_from(10), _bf(15, 10), f64_from(5)));
    vec_push(_surfaces, surface_sphere(f64_neg(f64_from(50)), f64_from(12), F64_ONE, f64_from(5)));
    # a realistic diffraction-sized pattern (64x64 = 4096 cells)
    _bigpat = pattern2d_new(64, 64);
    for (var by = 0; by < 64; by = by + 1) {
        for (var bx = 0; bx < 64; bx = bx + 1) {
            var _sv = pattern2d_set(_bigpat, bx, by, f64_from(bx * 64 + by + 1));
        }
    }
    _srcs = point_source_array_new(3);
    var _s0 = point_source_set(_srcs, 0, f64_neg(_bf(1, 1000)), f64_from(0), F64_ONE, f64_from(0));
    var _s1 = point_source_set(_srcs, 1, f64_from(0), f64_from(0), F64_ONE, f64_from(0));
    var _s2 = point_source_set(_srcs, 2, _bf(1, 1000), f64_from(0), F64_ONE, f64_from(0));

    # spectral_cie / spectral_core fixtures (2.3.9)
    _xyz = linear_srgb_to_xyz(_rgb);
    _cx = _bf(3127, 10000);
    _cy = _bf(329, 1000);
    _lin = _bf(5, 10);
    _freq_hz = wavelength_to_frequency(_wl_nm);
    # ── pbr fixtures (2.3.9) ──
    _f0rgb = alloc(24);
    if (_f0rgb == 0) { return 1; }
    store64(_f0rgb, _bf(95, 100));
    store64(_f0rgb + 8, _bf(64, 100));
    store64(_f0rgb + 16, _bf(54, 100));
    _alb3 = alloc(24);
    if (_alb3 == 0) { return 1; }
    store64(_alb3, _bf(8, 10));
    store64(_alb3 + 8, _bf(6, 10));
    store64(_alb3 + 16, _bf(4, 10));
    _alb = _bf(8, 10);
    _rx = _bf(3, 10);
    _ry = _bf(1, 10);
    _vdx = _bf(48, 100);
    _vdy = _bf(36, 100);
    _xi1 = F64_HALF;
    _xi2 = _bf(3, 10);
    _sigt = _bf(5, 10);
    _dist = F64_TWO;
    _sscat = _bf(3, 10);
    _cc = _bf(8, 10);
    _ccr = _bf(1, 10);
    _bbrdf = _bf(5, 10);
    _cbrdf = _bf(2, 10);
    _sheen = _bf(5, 10);
    # ── lens (2.3.9): a 50 mm f/2.8 equiconvex BK7 singlet, 35 mm format ──
    _r1 = f64_from(50);
    _r2 = f64_neg(f64_from(50));
    _lth = f64_from(5);
    _fnum = _bf(28, 10);
    _fmm = f64_from(50);
    _fm = _bf(5, 100);
    _apd = _bf(17857, 1000);
    _obj = f64_from(300);
    _img = f64_from(150);
    _coc = _bf(3, 100);
    _subj = f64_from(2000);
    _f2 = f64_from(200);
    _abbe = _bf(6417, 100);
    _sens_w = f64_from(36);
    _sens_h = f64_from(24);
    # three interleaved (n, f) elements: crown, flint, crown
    _elems = alloc(3 * 16);
    store64(_elems, _bf(15, 10));       store64(_elems + 8, f64_from(100));
    store64(_elems + 16, _bf(162, 100)); store64(_elems + 24, f64_neg(f64_from(150)));
    store64(_elems + 32, _bf(152, 100)); store64(_elems + 40, f64_from(200));
    # ── wave / polarization / coherence coverage fill (2.3.9) ──
    # Place AFTER `_theta = _bf(5, 10);` / `_slit = _bf(1, 1000);` — _mm_pol reads _theta.
    _spacing = _bf(5, 1000);
    _pathd = _bf(1375, 1000000000);
    _bw = _bf(1, 1000000000);
    _alpha = _bf(5, 10);
    _dist = F64_TWO;
    _cos_i = f64_div(f64_sqrt(f64_from(3)), F64_TWO);
    _cos_t = f64_sqrt(_bf(8, 9));
    _pol = polarization_new(_bf(6, 10), _bf(8, 10), F64_PI_4);
    _stokes = stokes_new(F64_ONE, _bf(5, 10), _bf(3, 10), _bf(2, 10));
    _mm_pol = mueller_polarizer(_theta);
    _mm_ret = mueller_retarder(F64_PI_2);
    _dir = ray_vec3(_bf(5, 10), f64_from(0), _cos_i);
    _norm = ray_vec3(f64_from(0), f64_from(0), f64_neg(F64_ONE));
    _cauchy = cauchy_bk7();
    _schott = schott_bk7();
    _apex = f64_div(F64_PI, f64_from(3));
    _wl_um = _bf(55, 100);
    _wl_s_um = _bf(45, 100);
    _wl_l_um = _bf(65, 100);
    _dir2 = ray_vec2(_bf(6, 10), f64_neg(_bf(8, 10)));
    _nrm2 = ray_vec2(f64_from(0), F64_ONE);
    _dir3 = ray_vec3(_bf(6, 10), f64_from(0), f64_neg(_bf(8, 10)));
    _nrm3 = ray_vec3(f64_from(0), f64_from(0), F64_ONE);
    _presc_bx = prescription_biconvex(f64_from(100), _bf(15, 10), f64_from(12), f64_from(5));
    _img_z = f64_from(50);
    _ray_marg = trace_ray_new(ray_vec3(f64_from(0), f64_from(3), f64_from(0)),
      ray_vec3(f64_from(0), f64_from(0), F64_ONE), F64_ONE);

    _gb_w0 = _bf(1, 1000);
    _gb_wl = _bf(1064, 1000000000);
    _gb_z = _bf(7, 10);
    _gb_dx = _bf(3, 10000);
    _gb = gaussian_beam_new(_gb_w0, _gb_wl, _err);
    _gb_ref = gaussian_beam_new(_bf(12, 10000), _gb_wl, _err);
    var _gp = beam_propagate(_gb_ref, F64_TWO);
    _gb_r60 = f64_mul(beam_radius(_gb_ref), f64_sqrt(f64_from(150)));
    _otf_wc = alloc(sizeof(WavefrontCoefficients));
    WavefrontCoefficients_set_w040(_otf_wc, 0);
    WavefrontCoefficients_set_w131(_otf_wc, F64_HALF);
    WavefrontCoefficients_set_w222(_otf_wc, 0);
    WavefrontCoefficients_set_w220(_otf_wc, F64_ONE);
    WavefrontCoefficients_set_w311(_otf_wc, 0);
    _grin_sf = grin_selfoc(_bf(16, 10), F64_HALF, 0, 0, _err);
    _grin_lu = grin_luneburg(F64_ONE, F64_ONE, 0, _err);
    _grin_ray = trace_ray_new(ray_vec3(_bf(3, 10), _bf(1, 10), 0), ray_vec3(_bf(1, 10), _bf(2, 10), F64_ONE), F64_ONE);
    _grin_lray = trace_ray_new(ray_vec3(0, F64_HALF, f64_from(0 - 1)), ray_vec3(0, 0, F64_ONE), F64_ONE);
    _doe_dm = alloc(24);
    store64(_doe_dm, 0x3FCDD02E524BCFEE);
    store64(_doe_dm + 8, 0x3FD8C5AF90AB6EBF);
    store64(_doe_dm + 16, 0x3FDEAD29F2BF25D9);
    _doe_g = volume_grating_new(_bf(152, 100), _bf(12, 1000), f64_from(30), _bf(8, 10), _bf(12, 10), _err);
    _doe_gr = volume_grating_new(_bf(3, 2), _bf(1, 100), f64_from(20), _bf(2, 10), 0, _err);
    _rta_l3 = alloc(3 * 24);
    for (var li = 0; li < 3; li = li + 1) {
        store64(_rta_l3 + li * 24, load64(_layers + li * 16));
        store64(_rta_l3 + li * 24 + 8, 0);
        store64(_rta_l3 + li * 24 + 16, load64(_layers + li * 16 + 8));
    }
    _rta_au = alloc(24);
    store64(_rta_au, _bf(43, 100));
    store64(_rta_au + 8, _bf(246, 100));
    store64(_rta_au + 16, f64_from(20));
    _rta_out = alloc(sizeof(AbsorbingFilmResult));
    _fs = sellmeier_fused_silica();
    _gb_prof = alloc(256 * 8);
    for (var gi = 0; gi < 256; gi = gi + 1) {
        var gx = f64_mul(_bf(1, 100), f64_from(gi - 128));
        store64(_gb_prof + gi * 8, _prk_exp(f64_neg(f64_mul(gx, gx))));
    }

    bench("ray/fresnel_unpolarized", &b_fresnel_unpolarized, 500000);
    bench("ray/fiber_na", &b_fiber_na, 500000);
    bench("ray/v_number", &b_v_number, 500000);
    bench("ray/sellmeier_n_at", &b_sellmeier_n_at, 200000);
