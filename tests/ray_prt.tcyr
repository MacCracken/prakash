# ray_prt test suite — three-dimensional polarization ray tracing.
#
# References, none of them this code:
# - Maxwell's tangential boundary conditions solved as a 6x6 linear system in 60-digit
#   arithmetic, with the surface in a generic orientation: no Fresnel formula, no s/p split.
# - Whole paths through that solver, geometry by Householder and Rodrigues, diattenuation and
#   retardance by numpy's SVD.
# - Lam's worked gold mirror (dissertation, Univ. Arizona 2015, pp. 121-122).
# - Born & Wolf's closed form for the phase of total internal reflection, and the Fresnel
#   rhomb. Lam's corner cube.
# - trace_sequential and trace_sequential_polarized, which name the same quantities.

include "src/error.cyr"
include "src/ray_core.cyr"
include "src/ray_fresnel.cyr"
include "src/ray_trace.cyr"
include "src/ray_prt.cyr"
include "src/wave_core.cyr"
include "src/wave_diffraction.cyr"

fn _fd(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _near(a, b, tol) { return f64_le(f64_abs(f64_sub(a, b)), tol); }
fn _assert_near(a, b, tol, msg) { assert(_near(a, b, tol), msg); }
fn _is_nan(x) { return (x & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000; }
fn _n3(x, y, z) {
    var l = f64_sqrt(f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(z, z)));
    return ray_vec3(f64_div(x, l), f64_div(y, l), f64_div(z, l));
}
fn _dot(a, b) {
    return f64_add(f64_add(f64_mul(RayVec3_x(a), RayVec3_x(b)), f64_mul(RayVec3_y(a), RayVec3_y(b))),
      f64_mul(RayVec3_z(a), RayVec3_z(b)));
}
fn _stepk(st) { return ray_vec3(PrtStep_kx(st), PrtStep_ky(st), PrtStep_kz(st)); }
fn _mirror(k, eta) {
    var t = f64_mul(F64_TWO, _dot(k, eta));
    return ray_vec3(f64_sub(RayVec3_x(k), f64_mul(t, RayVec3_x(eta))),
      f64_sub(RayVec3_y(k), f64_mul(t, RayVec3_y(eta))),
      f64_sub(RayVec3_z(k), f64_mul(t, RayVec3_z(eta))));
}
fn _sq(x) { return f64_mul(x, x); }
fn _rad(deg) { return f64_mul(f64_div(F64_PI, f64_from(180)), deg); }

var Z = f64_from(0);
var ONE = F64_ONE;
var TOL14 = _fd(1, 100000000000000);    # 1e-14
var TOL13 = _fd(1, 10000000000000);     # 1e-13
var TOL12 = _fd(1, 1000000000000);      # 1e-12
var TOL10 = _fd(1, 10000000000);        # 1e-10
var GLASS = f64_mul(_fd(3, 2), ONE);
var st = 0;
var e = 0;

alloc_init();
st = prt_step_new();
assert(st != 0, "prt_step_new");
assert_eq(sizeof(OpticalSurface), 40, "trace_sequential_prt's stack copy of a surface is 40 bytes");

# ── Matrices ────────
test_group("prt matrices");

var mi = prt_new();
assert(mi != 0, "prt_new");
assert_eq(prt_re(mi, 0, 0), ONE, "identity (0,0)");
assert_eq(prt_re(mi, 1, 1), ONE, "identity (1,1)");
assert_eq(prt_re(mi, 2, 2), ONE, "identity (2,2)");
assert_eq(prt_re(mi, 0, 1), 0, "identity off the diagonal");
assert_eq(prt_im(mi, 2, 2), 0, "identity is real");
assert_eq(_is_nan(prt_re(mi, 3, 0)), 1, "prt_re past the end is NaN");
assert_eq(_is_nan(prt_re(mi, 0, 0 - 1)), 1, "prt_re before the start is NaN");
assert_eq(_is_nan(prt_im(0, 0, 0)), 1, "prt_im of a null matrix is NaN");
assert_eq(prt_identity(0), 0, "prt_identity of null");
assert_eq(prt_multiply(0, mi, mi), PK_ERR_INVALID_PARAMETER, "prt_multiply null a");
assert_eq(prt_multiply(mi, 0, mi), PK_ERR_INVALID_PARAMETER, "prt_multiply null b");
assert_eq(prt_multiply(mi, mi, 0), PK_ERR_INVALID_PARAMETER, "prt_multiply null out");
assert_eq(prt_apply(0, mi, mi), PK_ERR_INVALID_PARAMETER, "prt_apply null m");

# (1+i) at (0,1) times (2-i) at (1,2) gives (3+i) at (0,2), aliased onto either operand.
fn _set(m, i, j, re, im) {
    store64(m + (i * 3 + j) * 8, re);
    store64(m + 72 + (i * 3 + j) * 8, im);
    return 0;
}
var ma = prt_new();
var mb = prt_new();
var _s = _set(ma, 0, 1, ONE, ONE);
_s = _set(mb, 1, 2, F64_TWO, f64_neg(ONE));
var mc = prt_new();
assert_eq(prt_multiply(ma, mb, mc), PK_ERR_NONE, "prt_multiply");
assert_eq(prt_re(mc, 0, 2), f64_from(3), "complex product, real part");
assert_eq(prt_im(mc, 0, 2), ONE, "complex product, imaginary part");
assert_eq(prt_re(mc, 0, 1), ONE, "the identity's terms survive");
assert_eq(prt_multiply(ma, mb, ma), PK_ERR_NONE, "out may be a");
assert_eq(prt_re(ma, 0, 2), f64_from(3), "aliased on a");
ma = prt_new();
_s = _set(ma, 0, 1, ONE, ONE);
assert_eq(prt_multiply(ma, mb, mb), PK_ERR_NONE, "out may be b");
assert_eq(prt_im(mb, 0, 2), ONE, "aliased on b");
var fe = prt_field_new(ONE, F64_TWO, f64_from(3), f64_from(4), f64_from(5), f64_from(6));
assert(fe != 0, "prt_field_new");
var fm = prt_new();
_s = _set(fm, 0, 1, Z, ONE);
assert_eq(prt_apply(fm, fe, fe), PK_ERR_NONE, "prt_apply aliased");
assert_eq(PrtField_x_re(fe), f64_sub(ONE, f64_from(4)), "row 0, real: 1 + i(3 + 4i)");
assert_eq(PrtField_x_im(fe), f64_add(F64_TWO, f64_from(3)), "row 0, imaginary");
assert_eq(PrtField_z_im(fe), f64_from(6), "row 2 untouched");

# ── Refusals ────────
test_group("prt refusals");

var kz = ray_vec3(Z, Z, ONE);
var nz = ray_vec3(Z, Z, ONE);
var bad = ray_vec3(Z, Z, F64_TWO);
var fa[80];
var sentinel = prt_step_new();
assert_eq(fresnel_amplitudes(ONE, GLASS, Z, ONE, 0), PK_ERR_INVALID_PARAMETER, "null out");
assert_eq(fresnel_amplitudes(Z, GLASS, Z, ONE, &fa), PK_ERR_INVALID_PARAMETER, "n1 = 0");
assert_eq(fresnel_amplitudes(f64_neg(ONE), GLASS, Z, ONE, &fa), PK_ERR_INVALID_PARAMETER, "n1 < 0");
assert_eq(fresnel_amplitudes(ONE, Z, Z, ONE, &fa), PK_ERR_INVALID_PARAMETER, "n~ = 0");
assert_eq(fresnel_amplitudes(ONE, GLASS, f64_neg(ONE), ONE, &fa), PK_ERR_INVALID_PARAMETER, "gain");
assert_eq(fresnel_amplitudes(ONE, 0x7FF8000000000000, Z, ONE, &fa), PK_ERR_INVALID_PARAMETER, "NaN n2");
assert_eq(fresnel_amplitudes(ONE, 0x7FF0000000000000, Z, ONE, &fa), PK_ERR_INVALID_PARAMETER, "+inf n2");
assert_eq(fresnel_amplitudes(ONE, GLASS, 0x7FF8000000000000, ONE, &fa), PK_ERR_INVALID_PARAMETER, "NaN k2");
assert_eq(fresnel_amplitudes(ONE, 0x4640000000000000, Z, ONE, &fa), PK_ERR_INVALID_PARAMETER, "n2 past 2^100");
assert_eq(fresnel_amplitudes(0x3990000000000000, GLASS, Z, ONE, &fa), PK_ERR_INVALID_PARAMETER, "n1 under 2^-100");
assert_eq(fresnel_amplitudes(ONE, GLASS, Z, Z, &fa), PK_ERR_INVALID_ANGLE, "cos_i = 0");
assert_eq(fresnel_amplitudes(ONE, GLASS, Z, f64_neg(F64_HALF), &fa), PK_ERR_INVALID_ANGLE, "cos_i < 0");
assert_eq(fresnel_amplitudes(ONE, GLASS, Z, _fd(11, 10), &fa), PK_ERR_INVALID_ANGLE, "cos_i > 1");
assert_eq(fresnel_amplitudes(ONE, GLASS, Z, 0x7FF8000000000000, &fa), PK_ERR_INVALID_ANGLE, "NaN cos_i");

assert_eq(prt_refract(0, nz, ONE, GLASS, st), PK_ERR_INVALID_PARAMETER, "refract: null k");
assert_eq(prt_refract(kz, 0, ONE, GLASS, st), PK_ERR_INVALID_PARAMETER, "refract: null normal");
assert_eq(prt_refract(kz, nz, ONE, GLASS, 0), PK_ERR_INVALID_PARAMETER, "refract: null step");
assert_eq(prt_refract(bad, nz, ONE, GLASS, st), PK_ERR_INVALID_PARAMETER, "refract: k not unit");
assert_eq(prt_refract(kz, bad, ONE, GLASS, st), PK_ERR_INVALID_PARAMETER, "refract: normal not unit");
assert_eq(prt_refract(ray_vec3(0x7FF8000000000000, Z, ONE), nz, ONE, GLASS, st), PK_ERR_INVALID_PARAMETER,
  "refract: NaN k");
assert_eq(prt_reflect(0, nz, ONE, GLASS, Z, st), PK_ERR_INVALID_PARAMETER, "reflect: null k");
assert_eq(prt_reflect(kz, nz, ONE, GLASS, Z, 0), PK_ERR_INVALID_PARAMETER, "reflect: null step");
assert_eq(prt_reflect(kz, bad, ONE, GLASS, Z, st), PK_ERR_INVALID_PARAMETER, "reflect: normal not unit");
assert_eq(prt_reflect(kz, nz, ONE, GLASS, f64_neg(ONE), st), PK_ERR_INVALID_PARAMETER, "reflect: gain");
# A ray in the plane of the surface meets nothing.
assert_eq(prt_reflect(ray_vec3(ONE, Z, Z), nz, ONE, GLASS, Z, st), PK_ERR_INVALID_ANGLE, "reflect: grazing");
assert_eq(prt_refract(ray_vec3(ONE, Z, Z), nz, ONE, GLASS, st), PK_ERR_INVALID_ANGLE, "refract: grazing");
assert_eq(prt_surface(0, nz, kz, ONE, Z, ONE, Z, 0, st), PK_ERR_INVALID_PARAMETER, "surface: null k_in");
assert_eq(prt_surface(kz, nz, 0, ONE, Z, ONE, Z, 0, st), PK_ERR_INVALID_PARAMETER, "surface: null k_out");
assert_eq(prt_surface(kz, nz, kz, ONE, Z, ONE, Z, 2, st), PK_ERR_INVALID_PARAMETER, "surface: unknown reflect");
assert_eq(prt_surface(kz, nz, kz, ONE, Z, ONE, Z, 0, 0), PK_ERR_INVALID_PARAMETER, "surface: null step");

# Total internal reflection has no refracted ray, and a refused step keeps what it held.
var tir_k = _n3(ONE, Z, _fd(1, 4));
assert_eq(prt_refract(kz, nz, ONE, GLASS, sentinel), PK_ERR_NONE, "a good step to compare with");
var kept = prt_re(PrtStep_p(sentinel), 0, 0);
assert_eq(prt_refract(tir_k, nz, GLASS, ONE, sentinel), PK_ERR_TIR, "refract: total internal reflection");
assert_eq(prt_re(PrtStep_p(sentinel), 0, 0), kept, "a refused step is untouched");

# ── Against Maxwell's boundary conditions ────────
test_group("prt against Maxwell's boundary conditions");

fn _vec_ok(lab, st_, e_in, re0, im0, re1, im1, re2, im2, kx, ky, kz_) {
    var o[48];
    assert_eq(prt_apply(PrtStep_p(st_), e_in, &o), PK_ERR_NONE, lab);
    var tol = _fd(1, 10000000000000);
    assert(_near(load64(&o), re0, tol) & _near(load64(&o + 8), im0, tol), "E_x");
    assert(_near(load64(&o + 16), re1, tol) & _near(load64(&o + 24), im1, tol), "E_y");
    assert(_near(load64(&o + 32), re2, tol) & _near(load64(&o + 40), im2, tol), "E_z");
    assert(_near(PrtStep_kx(st_), kx, tol) & _near(PrtStep_ky(st_), ky, tol) & _near(PrtStep_kz(st_), kz_,
        tol), "k'");
    return 0;
}
fn _refl_pin(lab, n1, n2, k2, k, eta, f, re0, im0, re1, im1, re2, im2, kx, ky, kz_) {
    assert_eq(prt_reflect(k, eta, n1, n2, k2, st), PK_ERR_NONE, lab);
    return _vec_ok(lab, st, f, re0, im0, re1, im1, re2, im2, kx, ky, kz_);
}
fn _refr_pin(lab, n1, n2, k, eta, f, re0, im0, re1, im1, re2, im2, kx, ky, kz_) {
    assert_eq(prt_refract(k, eta, n1, n2, st), PK_ERR_NONE, lab);
    return _vec_ok(lab, st, f, re0, im0, re1, im1, re2, im2, kx, ky, kz_);
}
