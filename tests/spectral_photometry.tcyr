# spectral photometry test suite — ported from rust-old/src/spectral/photometry.rs.
# Covers V(lambda) tables and luminous flux/efficacy (photopic + scotopic).

include "src/error.cyr"
include "src/spectral_core.cyr"
include "src/spectral_cie.cyr"
include "src/spectral_photometry.cyr"

fn _fd(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }
fn _assert_near(a, b, tol, msg) { assert(_near(a, b, tol), msg); }
fn _in_range(x, lo, hi) {
    if (f64_lt(x, lo) == 1) { return 0; }
    if (f64_gt(x, hi) == 1) { return 0; }
    return 1;
}

var TOL6 = f64_div(F64_ONE, f64_from(1000000));   # 1e-6
var Z = f64_from(0);

alloc_init();

# ── V(lambda) tables ────────
test_group("v_lambda");

var vp = _vlambda_photopic();
_assert_near(_vl(vp, 35), F64_ONE, TOL6, "photopic V peaks 1.0 at 555nm");
var pi = 0;
while (pi < 81) {
    assert(_in_range(_vl(vp, pi), Z, F64_ONE), "photopic V in [0,1]");
    pi = pi + 1;
}

# scotopic peak near 507nm (index ~25)
var vs = _vlambda_scotopic();
var best_i = 0;
var best_v = _vl(vs, 0);
var si = 1;
while (si < 81) {
    if (f64_gt(_vl(vs, si), best_v) == 1) {
        best_v = _vl(vs, si);
        best_i = si;
    }
    si = si + 1;
}
_assert_near(f64_from(380 + best_i * 5), f64_from(505), f64_from(10), "scotopic peak near 507nm");

# ⚠ 2.2.7: THE ASSERTION ABOVE HAS A +/-10 nm TOLERANCE, so a table peaking at
# 500 nm passed it — and one did. The shipped V'(lambda) was not the CIE 1951
# curve: its peak sat at 500 nm and the 445-525 nm block was inflated by up to
# +0.1174 at 475 nm (0.8514 against 0.7340, a 16% error on the steepest part of
# the curve). 30 of 81 entries were corrected. These pin VALUES against the
# published CIE 1951 table, and the shape invariants separately.
_assert_near(_vl(vs, 4), _fd(929, 100000), TOL6, "V'(400nm) = 0.00929");
_assert_near(_vl(vs, 14), _fd(455, 1000), TOL6, "V'(450nm) = 0.455 (was 0.4849)");
_assert_near(_vl(vs, 19), _fd(734, 1000), TOL6, "V'(475nm) = 0.734 (was 0.8514 — the worst point)");
_assert_near(_vl(vs, 24), _fd(982, 1000), TOL6, "V'(500nm) = 0.982");
_assert_near(_vl(vs, 25), _fd(998, 1000), TOL6, "V'(505nm) = 0.998 — the peak (was 0.9806)");
_assert_near(_vl(vs, 26), _fd(997, 1000), TOL6, "V'(510nm) = 0.997 (was 0.9706)");
_assert_near(_vl(vs, 34), _fd(481, 1000), TOL6, "V'(550nm) = 0.481");
_assert_near(_vl(vs, 44), _fd(3315, 100000), TOL6, "V'(600nm) = 0.03315 (was 0.0331)");
_assert_near(_vl(vs, 54), _fd(677, 1000000), TOL6, "V'(650nm) = 0.000677 (was 0.00042)");

# Shape invariants: the curve is unimodal about 505/510 on this grid. The old
# table satisfied "peak within 10nm" while being wrong at 30 points, so the
# monotonicity is asserted directly rather than inferred from the peak.
for (var mi = 0; mi < 25; mi = mi + 1) {
    assert(f64_le(_vl(vs, mi), _vl(vs, mi + 1)), "scotopic V' rises monotonically to 505nm");
}
for (var mj = 26; mj < 80; mj = mj + 1) {
    assert(f64_ge(_vl(vs, mj), _vl(vs, mj + 1)), "scotopic V' falls monotonically from 510nm");
}
# ⚠ 2.2.8: THE TAIL 2.2.7 DELIBERATELY LEFT ALONE WAS WRONG IN ALL 26 ENTRIES.
# 2.2.7 said it "could not be cross-checked to the same standard" — a claim
# about effort, not evidence. The seam was detectable from the corrected head
# alone: successive-value ratios run ~0.671, 0.674 through the repaired region
# and then collapsed to 0.369 at 650/655, in a curve that decays smoothly at
# ~0.68 per 5 nm. The old tail also hit EXACT ZERO above 710 nm.
_assert_near(_vl(vs, 55), _fd(459, 1000000), _fd(1, 100000), "V'(655nm) = 0.000459 (was 0.00025)");
_assert_near(_vl(vs, 64), _fd(178, 10000000), _fd(1, 1000000), "V'(700nm) = 1.78e-5 (was 2e-6)");
assert(f64_gt(_vl(vs, 80), Z), "V'(780nm) is nonzero — the old tail was exactly 0 above 710nm");
# The seam ratio is the check that found it, so it is the check that guards it.
var _sr = f64_div(_vl(vs, 55), _vl(vs, 54));
_assert_near(_sr, _fd(678, 1000), _fd(2, 100), "V' decays ~0.68 per 5nm across the 650/655 seam (was 0.369)");
for (var _zi = 0; _zi < 81; _zi = _zi + 1) {
    assert(f64_gt(_vl(vs, _zi), Z), "no V' entry is exactly zero");
}

# Scotopic vision is blue-shifted relative to photopic — the Purkinje shift.
assert(f64_gt(_vl(vs, 24), _vl(vp, 24)), "V' exceeds V at 500nm (Purkinje shift)");
assert(f64_lt(_vl(vs, 44), _vl(vp, 44)), "V' below V at 600nm (Purkinje shift)");

# ── luminous flux & efficacy ────────
test_group("luminous");

assert(f64_gt(luminous_flux(illuminant_d65()), Z), "D65 luminous flux positive");
assert(_in_range(luminous_efficacy(illuminant_d65()), f64_from(100), f64_from(400)), "D65 efficacy 100-400 lm/W");

# monochromatic 555nm source -> max efficacy 683 lm/W
var mono_vals = alloc(8);
store64(mono_vals, F64_ONE);
var mono = spd_new(f64_from(555), f64_from(5), mono_vals, 1);
_assert_near(luminous_efficacy(mono), f64_from(683), f64_from(10), "555nm efficacy ~683 lm/W");

assert(f64_gt(luminous_flux_scotopic(illuminant_d65()), Z), "D65 scotopic flux positive");

# scotopic weights blue (430nm) more than photopic
var blue_vals = alloc(648);
var bz = 0;
while (bz < 81) {
    store64(blue_vals + bz * 8, Z);
    bz = bz + 1;
}
store64(blue_vals + 10 * 8, F64_ONE);   # 430nm
var blue = spd_new(f64_from(380), f64_from(5), blue_vals, 81);
assert(
  f64_gt(luminous_flux_scotopic(blue), luminous_flux(blue)),
  "scotopic more sensitive to blue than photopic");

var r = assert_summary();
