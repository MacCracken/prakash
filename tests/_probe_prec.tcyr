include "src/error.cyr"
alloc_init();
fn _pr(l, v) { syscall(1,1,l,strlen(l)); syscall(1,1," = ",3); fmt_hex0x(v); syscall(1,1,"\n",1); return 0; }
var m = 0x7FFFFFFFFFFFFFFF;
var z = 0x8000000000000000;
_pr("z & m == 0            ", z & m == 0);
_pr("(z & m) == 0          ", (z & m) == 0);
_pr("z & (m == 0)          ", z & (m == 0));
var n = 0x7FF8000000000000;
_pr("n & m > 0x7FF00000..  ", n & m > 0x7FF0000000000000);
_pr("(n&m) > 0x7FF00000..  ", (n & m) > 0x7FF0000000000000);
_pr("F64_ONE               ", F64_ONE);
_pr("f64_floor(2.5)        ", f64_floor(f64_from(5) / 2));
