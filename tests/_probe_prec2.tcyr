include "src/error.cyr"
alloc_init();
fn _pr(l, v) { syscall(1,1,l,strlen(l)); syscall(1,1," = ",3); fmt_hex0x(v); syscall(1,1,"\n",1); return 0; }
_pr("f64_floor(2.5)   ", f64_floor(f64_div(f64_from(5), f64_from(2))));
_pr("f64_floor(3.0)   ", f64_floor(f64_from(3)));
_pr("f64_floor(-2.5)  ", f64_floor(f64_neg(f64_div(f64_from(5), f64_from(2)))));
_pr("f64_to(3.0)      ", f64_to(f64_from(3)));
_pr("f64_ge(1e300,2^53)", f64_ge(f64_from(1000000000000000000), f64_from(9007199254740992)));
var a = 1; var b = 0;
_pr("1 && 0           ", a && b);
_pr("1 || 0           ", a || b);
