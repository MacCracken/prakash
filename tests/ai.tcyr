# ai test suite — from rust-old/src/ai.rs (inline #[cfg(test)] mod).
# Config + serde tests. ⚠ 2.2.8: register_agent's HAPPY PATH still needs a live
# server and is not unit-tested, but "needs a server" was doing more work than it
# should — it left the function with NO test of any kind, which is why
# `cyrius coverage` reported it unreferenced and why it kept its null-dereference
# through three hardening passes. Its failure paths are testable offline and now
# are. bayan/sandhi resolve from [deps] stdlib.

include "src/error.cyr"
include "src/ai.cyr"

alloc_init();

# 2.1.0: *_from_json takes a trailing err_out.
var e = 0;

var ER = alloc(8);

# ── Config defaults ────────
test_group("config_defaults");

var dc = ai_daimon_config_default();
assert(streq(DaimonConfig_endpoint(dc), "http://localhost:8090") == 1, "daimon default endpoint");
assert_eq(DaimonConfig_api_key(dc), 0, "daimon default api_key none");

var hc = ai_hoosh_config_default();
assert(streq(HooshConfig_endpoint(hc), "http://localhost:8088") == 1, "hoosh default endpoint");

# ── Client ────────
test_group("client");

var client = ai_daimon_client_new(ai_daimon_config_default(), ER);
assert_eq(load64(ER), PK_ERR_NONE, "client_new ok");
assert(streq(DaimonConfig_endpoint(DaimonClient_config(client)), "http://localhost:8090") == 1,
  "client holds config");

# ── Config with api key ────────
test_group("config_api_key");

var dc2 = ai_daimon_config_new("https://custom.host:9090", "test-key");
assert(streq(DaimonConfig_api_key(dc2), "test-key") == 1, "api_key set");
assert(streq(DaimonConfig_endpoint(dc2), "https://custom.host:9090") == 1, "endpoint set");

# ── Serde roundtrip ────────
test_group("serde");

# daimon: endpoint + api_key
var d = ai_daimon_config_new("http://example.com", "key123");
var djs = ai_daimon_config_to_json(d);
var dback = ai_daimon_config_from_json(str_data(djs), str_len(djs), &e);
assert(streq(DaimonConfig_endpoint(dback), "http://example.com") == 1, "daimon roundtrip endpoint");
assert(streq(DaimonConfig_api_key(dback), "key123") == 1, "daimon roundtrip api_key");

# daimon: null api_key (default) roundtrips to None
var dnull = ai_daimon_config_default();
var dnjs = ai_daimon_config_to_json(dnull);
var dnback = ai_daimon_config_from_json(str_data(dnjs), str_len(dnjs), &e);
assert(streq(DaimonConfig_endpoint(dnback), "http://localhost:8090") == 1, "daimon null roundtrip endpoint");
assert_eq(DaimonConfig_api_key(dnback), 0, "daimon null roundtrip api_key none");

# hoosh: endpoint
var h = ai_hoosh_config_default();
var hjs = ai_hoosh_config_to_json(h);
var hback = ai_hoosh_config_from_json(str_data(hjs), str_len(hjs), &e);
assert(streq(HooshConfig_endpoint(hback), "http://localhost:8088") == 1, "hoosh roundtrip endpoint");

# ── malformed input (2.0.2 hardening) ────────
# Each of these aborted the process with SIGSEGV in 2.0.1: `endpoint` resolved
# to 0 through bayan's guarded accessors and `str_data(0)` is `load64(0)`.
# Reaching assert_summary() below is itself part of the assertion.
test_group("ai config: malformed JSON is rejected, not dereferenced");

var m_empty = "{}";
var m_nokey = "{\"api_key\":\"k\"}";
var m_wrongtype = "{\"endpoint\":42}";
var m_null = "{\"endpoint\":null}";
var m_notobj = "[1,2]";
var m_junk = "not json";

assert(ai_daimon_config_from_json(m_empty, strlen(m_empty), &e) == 0, "daimon: {} -> 0");
assert(ai_daimon_config_from_json(m_nokey, strlen(m_nokey), &e) == 0, "daimon: no endpoint key -> 0");
assert(ai_daimon_config_from_json(m_wrongtype, strlen(m_wrongtype), &e) == 0, "daimon: endpoint not a string -> 0");
assert(ai_daimon_config_from_json(m_null, strlen(m_null), &e) == 0, "daimon: endpoint null -> 0");
assert(ai_daimon_config_from_json(m_notobj, strlen(m_notobj), &e) == 0, "daimon: non-object document -> 0");
assert(ai_daimon_config_from_json(m_junk, strlen(m_junk), &e) == 0, "daimon: unparseable -> 0");

assert(ai_hoosh_config_from_json(m_empty, strlen(m_empty), &e) == 0, "hoosh: {} -> 0");
assert(ai_hoosh_config_from_json(m_nokey, strlen(m_nokey), &e) == 0, "hoosh: no endpoint key -> 0");
assert(ai_hoosh_config_from_json(m_wrongtype, strlen(m_wrongtype), &e) == 0, "hoosh: endpoint not a string -> 0");
assert(ai_hoosh_config_from_json(m_null, strlen(m_null), &e) == 0, "hoosh: endpoint null -> 0");
assert(ai_hoosh_config_from_json(m_notobj, strlen(m_notobj), &e) == 0, "hoosh: non-object document -> 0");
assert(ai_hoosh_config_from_json(m_junk, strlen(m_junk), &e) == 0, "hoosh: unparseable -> 0");

# ── 2.2.8: the two functions cyrius coverage reported unreferenced ────────
test_group("ai: the untested surface");

# ai_hoosh_config_new is a plain constructor and was simply never asserted.
var _hc = ai_hoosh_config_new("http://example.invalid:9999");
assert(_hc != 0, "ai_hoosh_config_new returns a config");
assert_eq(streq(HooshConfig_endpoint(_hc), "http://example.invalid:9999"), 1,
  "ai_hoosh_config_new stores the endpoint it was given");
var _hd = ai_hoosh_config_default();
assert(_hd != 0, "ai_hoosh_config_default returns a config");
assert_eq(streq(HooshConfig_endpoint(_hd), "http://localhost:8088"), 1,
  "ai_hoosh_config_default endpoint is localhost:8088");

# ai_register_agent: the null-client path. `ai_daimon_client_new` is documented
# to return 0 on allocation failure, and this dereferenced that 0 until 2.2.8.
# Reaching the network is not required to assert the contract.
var _re = 0;
var _rid = ai_register_agent(0, &_re);
assert_eq(_re, PK_ERR_INVALID_PARAMETER, "ai_register_agent(null) reports PK_ERR_INVALID_PARAMETER");
assert_eq(streq(_rid, "unknown"), 1, "ai_register_agent(null) returns the \"unknown\" sentinel");

# ── registration response (2.5.1) ────────
test_group("ai_register_response");
# ⛔ Through 2.5.0 ai_register_agent posted to /v1/agents/register, which daimon
# answers 405 {"error":"method not allowed"}, never read the status, and returned
# "unknown" with PK_ERR_NONE — reproduced against a live daimon 2.2.3. The null
# path above was its only test, so the fabricated success was invisible. These
# drive every branch of the response interpretation with the bytes daimon sends.
fn _rr(status, body, err) {
    var n = 0;
    if (body != 0) { n = strlen(body); }
    return _ai_register_response(status, body, n, err);
}
var _rre = 0;
var _rr405 = _rr(405, "{\"error\":\"method not allowed\"}", &_rre);
assert_eq(_rre, PK_ERR_INVALID_PARAMETER, "daimon's 405 JSON body is an error, not success (the 2.5.0 defect)");
assert_eq(streq(_rr405, "unknown"), 1, "405 returns the \"unknown\" sentinel");
var _rr404 = _rr(404, "{\"error\":\"not found\",\"code\":404}", &_rre);
assert_eq(_rre, PK_ERR_INVALID_PARAMETER, "404 is an error");
var _rr500 = _rr(500, "", &_rre);
assert_eq(_rre, PK_ERR_INVALID_PARAMETER, "500 with an empty body is an error");
var _rr201 = _rr(201, "{\"id\":7,\"name\":\"prakash\",\"status\":0}", &_rre);
assert_eq(_rre, PK_ERR_NONE, "daimon's 201 {\"id\":7,...} succeeds");
assert_eq(streq(_rr201, "7"), 1, "and returns the id as the cstring \"7\"");
var _rrbig = _rr(200, "{\"id\":12345678901}", &_rre);
assert_eq(_rre, PK_ERR_NONE, "200 is 2xx too");
assert_eq(streq(_rrbig, "12345678901"), 1, "an id past 2^32 formats in full");
var _rr299 = _rr(299, "{\"id\":3}", &_rre);
assert_eq(streq(_rr299, "3"), 1, "299 is the last 2xx");
# These two carry a VALID id, so they are the only cases that can tell a status
# check that returns from one that sets err_out and falls through to the id.
var _rr199 = _rr(199, "{\"id\":3}", &_rre);
assert_eq(_rre, PK_ERR_INVALID_PARAMETER, "199 is not 2xx, even with a valid id");
assert_eq(streq(_rr199, "unknown"), 1, "199 returns the sentinel, not the id in its body");
var _rr300 = _rr(300, "{\"id\":3}", &_rre);
assert_eq(_rre, PK_ERR_INVALID_PARAMETER, "300 is not 2xx, even with a valid id");
assert_eq(streq(_rr300, "unknown"), 1, "300 returns the sentinel, not the id in its body");
var _rrnoid = _rr(201, "{\"name\":\"prakash\"}", &_rre);
assert_eq(_rre, PK_ERR_INVALID_PARAMETER, "2xx without an id is the wrong schema, not success");
assert_eq(streq(_rrnoid, "unknown"), 1, "and returns the sentinel");
var _rrold = _rr(201, "{\"agent_id\":\"a-1\"}", &_rre);
assert_eq(_rre, PK_ERR_INVALID_PARAMETER, "the Rust-era \"agent_id\" field is not daimon's contract");
var _rrsid = _rr(201, "{\"id\":\"7\"}", &_rre);
assert_eq(_rre, PK_ERR_INVALID_PARAMETER, "a string id is the wrong schema");
# bayan_json_v_int truncates a float, so accepting one would turn 7.9 into "7".
var _rrfid = _rr(201, "{\"id\":7.9}", &_rre);
assert_eq(_rre, PK_ERR_INVALID_PARAMETER, "a float id is the wrong schema, not a truncated success");
assert_eq(streq(_rrfid, "unknown"), 1, "a float id returns the sentinel");
var _rrtxt = _rr(201, "created", &_rre);
assert_eq(_rre, PK_ERR_PARSE, "a 2xx body that is not JSON is PK_ERR_PARSE");
var _rrarr = _rr(201, "[1,2]", &_rre);
assert_eq(_rre, PK_ERR_PARSE, "a 2xx JSON array is PK_ERR_PARSE (not an object)");
var _rrnull = _rr(201, 0, &_rre);
assert_eq(_rre, PK_ERR_PARSE, "a 2xx with no body is PK_ERR_PARSE");
assert_eq(streq(_rrnull, "unknown"), 1, "and returns the sentinel");

# ── null handles (2.4.9) ────────
test_group("ai_null_handle_sweep");
# ⛔ All four exited 139 before 2.4.9. The two encoders were missed by the 2.2.7
# encode-side sweep because ai.cyr ships only in dist/prakash-ai.cyr; the two
# decoders read a null buffer inside bayan. Feeding the ENCODER the decoder's own
# documented 0 pins the chain a consumer would actually hit, not just a literal.
var _nb = alloc(4096);
var _ne = 0;
var _bad_d = ai_daimon_config_from_json("not json", 8, &_ne);
assert(_bad_d == 0, "the decoder's documented 0 ...");
assert(ai_daimon_config_to_json(_bad_d) == 0, "... fed to the encoder returns 0, not a SIGSEGV");
var _bad_h = ai_hoosh_config_from_json("not json", 8, &_ne);
assert(ai_hoosh_config_to_json(_bad_h) == 0, "hoosh: decoder 0 fed to the encoder returns 0");
assert(ai_daimon_config_to_json(0) == 0, "ai_daimon_config_to_json(null) returns its sentinel, not a SIGSEGV");
assert(ai_hoosh_config_to_json(0) == 0, "ai_hoosh_config_to_json(null) returns its sentinel, not a SIGSEGV");
_ne = 0;
assert(ai_daimon_config_from_json(0, 4, &_ne) == 0,
  "ai_daimon_config_from_json(null) returns its sentinel, not a SIGSEGV");
assert(prakash_is_err(_ne) == 1, "ai_daimon_config_from_json(null) reports through err_out");
_ne = 0;
assert(ai_hoosh_config_from_json(0, 4, &_ne) == 0,
  "ai_hoosh_config_from_json(null) returns its sentinel, not a SIGSEGV");
assert(prakash_is_err(_ne) == 1, "ai_hoosh_config_from_json(null) reports through err_out");

var r = assert_summary();
