# wave coherence test suite — ported from rust-old/src/wave/mod.rs coherence tests.
# (bessel_j1 tests ship with wave_airy, where the function is defined.)

include "src/error.cyr"
include "src/wave_coherence.cyr"

fn _fd(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }
fn _assert_near(a, b, tol, msg) { assert(_near(a, b, tol), msg); }
fn _in_range(x, lo, hi) {
    if (f64_lt(x, lo) == 1) { return 0; }
    if (f64_gt(x, hi) == 1) { return 0; }
    return 1;
}

var Z = f64_from(0);
var WL550NM = f64_div(f64_from(55), f64_from(100000000));   # 550e-9 m = 5.5e-7
var MM = f64_div(F64_ONE, f64_from(1000));                  # 1e-3

alloc_init();
test_group("coherence");

# HeNe laser: 632.8nm, 0.001nm bandwidth -> l_c = 632.8^2/0.001 = 400435840 nm
_assert_near(
  coherence_length(_fd(6328, 10), _fd(1, 1000)), f64_from(400435840), F64_ONE, "HeNe coherence length");

# white light: 550nm, 300nm -> ~1008 nm, in (500, 2000)
assert(
  _in_range(coherence_length(f64_from(550), f64_from(300)), f64_from(500), f64_from(2000)), "white light coherence");

# narrower bandwidth -> longer coherence
assert(f64_gt(coherence_length(f64_from(550), F64_ONE), coherence_length(f64_from(550), f64_from(10))),
  "narrower bandwidth longer coherence");

# coherence time positive and in (1e-12, 1e-6) s
var tc = coherence_time(WL550NM, _fd(1, 1000000000));   # bandwidth 1e-9 m
assert(f64_gt(tc, Z), "coherence time positive");
assert(_in_range(tc, _fd(1, 1000000000000), _fd(1, 1000000)), "coherence time ~ ns scale");

# spatial coherence angle positive and very small
var sca = spatial_coherence_angle(WL550NM, MM);
assert(f64_gt(sca, Z), "spatial coherence angle positive");
assert(f64_lt(sca, MM), "spatial coherence angle < 1e-3");

# coherence area increases with distance
assert(f64_gt(coherence_area(WL550NM, f64_from(10), MM), coherence_area(WL550NM, F64_ONE, MM)),
  "coherence area increases with distance");

# path difference = coherence length -> ratio 1
var lc = coherence_length(f64_from(550), F64_ONE);
_assert_near(
  coherence_ratio(lc, f64_from(550), F64_ONE), F64_ONE, f64_div(F64_ONE, f64_from(1000000)), "coherence ratio = 1");

var r = assert_summary();
