include "src/error.cyr"
alloc_init();
fn _pr(label, bits) {
    syscall(1, 1, label, strlen(label));
    syscall(1, 1, " = ", 3);
    fmt_hex0x(bits);
    syscall(1, 1, "\n", 1);
    return 0;
}
var NAN  = 0x7FF8000000000000;
var PINF = 0x7FF0000000000000;
var NINF = 0xFFF0000000000000;
var ONE  = f64_from(1);
var HALF = f64_div(f64_from(1), f64_from(2));
syscall(1, 1, "--- cyrius: infinite exponents ---\n", 35);
_pr("_prk_pow(-1.0, PINF)    ", _prk_pow(f64_neg(ONE), PINF));
_pr("_prk_pow(-1.0, NINF)    ", _prk_pow(f64_neg(ONE), NINF));
_pr("_prk_pow(2.0, PINF)     ", _prk_pow(f64_from(2), PINF));
_pr("_prk_pow(2.0, NINF)     ", _prk_pow(f64_from(2), NINF));
_pr("_prk_pow(0.5, PINF)     ", _prk_pow(HALF, PINF));
_pr("_prk_pow(0.5, NINF)     ", _prk_pow(HALF, NINF));
syscall(1, 1, "--- cyrius: NaN payload behaviour ---\n", 38);
_pr("_prk_pow(2.0, -NaN)     ", _prk_pow(f64_from(2), 0xFFF8000000000000));
_pr("_prk_pow(2.0, NaN:pay7) ", _prk_pow(f64_from(2), 0x7FF8000000000007));
_pr("_prk_pow(1.0, -NaN)     ", _prk_pow(ONE, 0xFFF8000000000000));
_pr("_prk_pow(NaN:pay7, 2.0) ", _prk_pow(0x7FF8000000000007, f64_from(2)));
syscall(1, 1, "--- cyrius: negative zero base ---\n", 35);
_pr("_prk_pow(-0.0, NaN)     ", _prk_pow(f64_neg(f64_from(0)), NAN));
_pr("_prk_pow(-0.0, 3.0)     ", _prk_pow(f64_neg(f64_from(0)), f64_from(3)));
_pr("_prk_pow(-0.0, -3.0)    ", _prk_pow(f64_neg(f64_from(0)), f64_neg(f64_from(3))));
_pr("f64_neg(f64_from(0))    ", f64_neg(f64_from(0)));
var r = assert_summary();
