  "doublet: eps_y (-0.3, 0.4, 0.7) order 5");

# ── immersed ────────
test_group("immersed");
var P_IMMERSED = _p_immersed();
var M_IMMERSED = paraxial_ray_new(0x4018000000000000, 0x3FC10FF972474539);
var C_IMMERSED = paraxial_ray_new(0x0000000000000000, 0xBFB6BFF74309B1A1);
var S3_IMMERSED = 0x401F777C8375ED87;   # largest third-order surface term
var S5_IMMERSED = 0x3FF1A4631E652FB8;   # largest fifth-order surface term
var SS_IMMERSED = 0x3FCB2FF0B31E35A9;   # largest Seidel surface term
var SR_IMMERSED = 0x4018000000000000;   # largest paraxial ray value
# The paraxial rays from the stop, against the 100-digit construction (the pins below use
# its doubles).
var hm_immersed = aberr_marginal_ray(P_IMMERSED, 0x404E000000000000, 0, 0x4018000000000000, &e);
assert(e == PK_ERR_NONE, "immersed: marginal ray");
var hc_immersed = aberr_chief_ray(P_IMMERSED, 0x404E000000000000, 0x4010000000000000, 0, &e);
assert(e == PK_ERR_NONE, "immersed: chief ray");
_assert_near(ParaxialRay_y(hm_immersed), 0x4018000000000000, f64_mul(FR, SR_IMMERSED), "immersed: marginal y");
_assert_near(ParaxialRay_nu(hm_immersed), 0x3FC10FF972474539, f64_mul(FR, SR_IMMERSED), "immersed: marginal nu");
_assert_near(ParaxialRay_y(hc_immersed), 0x0000000000000000, f64_mul(FR, SR_IMMERSED), "immersed: chief y");
_assert_near(ParaxialRay_nu(hc_immersed), 0xBFB6BFF74309B1A1, f64_mul(FR, SR_IMMERSED), "immersed: chief nu");
var AB_IMMERSED = aberr_sums(P_IMMERSED, M_IMMERSED, C_IMMERSED, &e);
assert(e == PK_ERR_NONE, "immersed: sums");
assert(AberrSums_count(AB_IMMERSED) == 1, "immersed: count");
_assert_near(AberrSums_lagrange(AB_IMMERSED), 0xBFE10FF972474539, f64_mul(F3, 0x3FE10FF972474539),
  "immersed: lagrange");
_assert_near(AberrSums_image_height(AB_IMMERSED), 0xC043BF86A314DBFA, f64_mul(F3, 0x4043BF86A314DBFA),
  "immersed: image_height");
_assert_near(AberrSums_image_distance(AB_IMMERSED), 0x40879C71C71C71C9, f64_mul(F3, 0x40879C71C71C71C9),
  "immersed: image_distance");
_assert_near(AberrSums_image_nu(AB_IMMERSED), 0xBF8BA5E353F7CED6, f64_mul(F3, 0x3F8BA5E353F7CED6),
  "immersed: image_nu");
# The system, against where the 100-digit rays meet the paraxial image plane.
_assert_near(aberr_third(AB_IMMERSED, ABERR_SYSTEM, ABERR3_B), 0xC01F777C8375ED87, f64_mul(F3, S3_IMMERSED),
  "immersed: B");
_assert_near(aberr_third(AB_IMMERSED, ABERR_SYSTEM, ABERR3_F), 0x3FF0C842683EE515, f64_mul(F3, S3_IMMERSED),
  "immersed: F");
_assert_near(aberr_third(AB_IMMERSED, ABERR_SYSTEM, ABERR3_C), 0xBFC1E6AD3BFED238, f64_mul(F3, S3_IMMERSED),
  "immersed: C");
_assert_near(aberr_third(AB_IMMERSED, ABERR_SYSTEM, ABERR3_PI), 0xBFBD1A9DB404D0F5, f64_mul(F3, S3_IMMERSED),
  "immersed: PI");
_assert_near(aberr_third(AB_IMMERSED, ABERR_SYSTEM, ABERR3_E), 0x3FA14EECD889305F, f64_mul(F3, S3_IMMERSED),
  "immersed: E");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_B5, ABERR_TOTAL), 0xBFF1A4631E652FB8,
  f64_mul(F5, S5_IMMERSED), "immersed: B5");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_F1, ABERR_TOTAL), 0x3FD817D2C7331C97,
  f64_mul(F5, S5_IMMERSED), "immersed: F1");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_F2, ABERR_TOTAL), 0x3FCD5E2AC34F9FE1,
  f64_mul(F5, S5_IMMERSED), "immersed: F2");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_M1, ABERR_TOTAL), 0xBFAF5360D054EECE,
  f64_mul(F5, S5_IMMERSED), "immersed: M1");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_M2, ABERR_TOTAL), 0xBFA0F5BE311CAB33,
  f64_mul(F5, S5_IMMERSED), "immersed: M2");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_M3, ABERR_TOTAL), 0xBF96191B4DC19E5A,
  f64_mul(F5, S5_IMMERSED), "immersed: M3");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_N1, ABERR_TOTAL), 0x3F7217314573E9CF,
  f64_mul(F5, S5_IMMERSED), "immersed: N1");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_N2, ABERR_TOTAL), 0x3F66DFD3935E9DC8,
  f64_mul(F5, S5_IMMERSED), "immersed: N2");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_N3, ABERR_TOTAL), 0xBF064D75D01F41F0,
  f64_mul(F5, S5_IMMERSED), "immersed: N3");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_C5, ABERR_TOTAL), 0x3EC7CA1744659BAB,
  f64_mul(F5, S5_IMMERSED), "immersed: C5");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_PI5, ABERR_TOTAL), 0x3F3525952F23EC5C,
  f64_mul(F5, S5_IMMERSED), "immersed: PI5");
_assert_near(aberr_fifth(AB_IMMERSED, ABERR_SYSTEM, ABERR5_E5, ABERR_TOTAL), 0xBF06C13D30B83B48,
  f64_mul(F5, S5_IMMERSED), "immersed: E5");
_assert_near(aberr_seidel(AB_IMMERSED, ABERR_SYSTEM, 0), 0x3FCB2FF0B31E35A9, f64_mul(F3, SS_IMMERSED),
  "immersed: system S_I");
_assert_near(aberr_seidel(AB_IMMERSED, ABERR_SYSTEM, 1), 0xBF9CFFEFADFE171B, f64_mul(F3, SS_IMMERSED),
  "immersed: system S_II");
_assert_near(aberr_seidel(AB_IMMERSED, ABERR_SYSTEM, 2), 0x3F6EEEDD86645CE9, f64_mul(F3, SS_IMMERSED),
  "immersed: system S_III");
_assert_near(aberr_seidel(AB_IMMERSED, ABERR_SYSTEM, 3), 0x3F6925550E3968C1, f64_mul(F3, SS_IMMERSED),
  "immersed: system S_IV");
_assert_near(aberr_seidel(AB_IMMERSED, ABERR_SYSTEM, 4), 0xBF4DE8A38276474A, f64_mul(F3, SS_IMMERSED),
  "immersed: system S_V");
# Each surface: its third order, Welford's Seidel sums, and its fifth order split.
_assert_near(aberr_third(AB_IMMERSED, 0, ABERR3_B), 0xC01F777C8375ED87, f64_mul(F3, S3_IMMERSED), "immersed 0: B");
_assert_near(aberr_third(AB_IMMERSED, 0, ABERR3_F), 0x3FF0C842683EE515, f64_mul(F3, S3_IMMERSED), "immersed 0: F");
_assert_near(aberr_third(AB_IMMERSED, 0, ABERR3_C), 0xBFC1E6AD3BFED238, f64_mul(F3, S3_IMMERSED), "immersed 0: C");
_assert_near(aberr_third(AB_IMMERSED, 0, ABERR3_PI), 0xBFBD1A9DB404D0F5, f64_mul(F3, S3_IMMERSED), "immersed 0: PI");
_assert_near(aberr_third(AB_IMMERSED, 0, ABERR3_E), 0x3FA14EECD889305F, f64_mul(F3, S3_IMMERSED), "immersed 0: E");
