# The expansion evaluated at three pupil and field points.
assert(aberr_transverse(AB_SINGLET, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 3, &tr) == PK_ERR_NONE,
  "singlet: transverse (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 0), 0xBFB2660F32D98158, f64_mul(F5, 0x3FBB710D092244A5),
  "singlet: eps_x (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 8), 0xBFBAB37BE7123C28, f64_mul(F5, 0x3FBB710D092244A5),
  "singlet: eps_y (0.6, 0.8, 1) order 3");
assert(aberr_transverse(AB_SINGLET, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 5, &tr) == PK_ERR_NONE,
  "singlet: transverse (0.6, 0.8, 1) order 5");
_assert_near(load64(&tr + 0), 0xBFB2E56ADF6AB0F9, f64_mul(F5, 0x3FBB710D092244A5),
  "singlet: eps_x (0.6, 0.8, 1) order 5");
_assert_near(load64(&tr + 8), 0xBFBB710D092244A5, f64_mul(F5, 0x3FBB710D092244A5),
  "singlet: eps_y (0.6, 0.8, 1) order 5");
assert(aberr_transverse(AB_SINGLET, 0x0000000000000000, 0x3FF0000000000000, 0x3FE0000000000000, 3, &tr) == PK_ERR_NONE,
  "singlet: transverse (0, 1, 0.5) order 3");
_assert_near(load64(&tr + 8), 0xBFBA91505F947C92, f64_mul(F5, 0x3FBB710D092244A5),
  "singlet: eps_y (0, 1, 0.5) order 3");
assert(aberr_transverse(AB_SINGLET, 0x0000000000000000, 0x3FF0000000000000, 0x3FE0000000000000, 5, &tr) == PK_ERR_NONE,
  "singlet: transverse (0, 1, 0.5) order 5");
_assert_near(load64(&tr + 8), 0xBFBB4C0D6B81D3AA, f64_mul(F5, 0x3FBB710D092244A5),
  "singlet: eps_y (0, 1, 0.5) order 5");
assert(aberr_transverse(AB_SINGLET, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 3, &tr) == PK_ERR_NONE,
  "singlet: transverse (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 0), 0x3F8651B0099486F0, f64_mul(F5, 0x3FBB710D092244A5),
  "singlet: eps_x (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 8), 0xBF909A4A871D51D7, f64_mul(F5, 0x3FBB710D092244A5),
  "singlet: eps_y (-0.3, 0.4, 0.7) order 3");
assert(aberr_transverse(AB_SINGLET, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 5, &tr) == PK_ERR_NONE,
  "singlet: transverse (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 0), 0x3F867850CB72033F, f64_mul(F5, 0x3FBB710D092244A5),
  "singlet: eps_x (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 8), 0xBF90B8D3D7F10ACD, f64_mul(F5, 0x3FBB710D092244A5),
  "singlet: eps_y (-0.3, 0.4, 0.7) order 5");

# ── doublet ────────
test_group("doublet");
var P_DOUBLET = _p_doublet();
var M_DOUBLET = paraxial_ray_new(0x4024000000000000, 0x0000000000000000);
var C_DOUBLET = paraxial_ray_new(0x8000000000000000, 0x3FAAD53144273E73);
var S3_DOUBLET = 0x3FC08368A55C7933;   # largest third-order surface term
var S5_DOUBLET = 0x3F7C857B314E7B77;   # largest fifth-order surface term
var SS_DOUBLET = 0x3F9CC21014F83955;   # largest Seidel surface term
var SR_DOUBLET = 0x4024000000000000;   # largest paraxial ray value
# The paraxial rays from the stop, against the 100-digit construction (the pins below use
# its doubles).
var hm_doublet = aberr_marginal_ray(P_DOUBLET, 0x7FF0000000000000, 0, 0x4024000000000000, &e);
assert(e == PK_ERR_NONE, "doublet: marginal ray");
var hc_doublet = aberr_chief_ray(P_DOUBLET, 0x7FF0000000000000, 0x3FAAD53144273E73, 0, &e);
assert(e == PK_ERR_NONE, "doublet: chief ray");
_assert_near(ParaxialRay_y(hm_doublet), 0x4024000000000000, f64_mul(FR, SR_DOUBLET), "doublet: marginal y");
_assert_near(ParaxialRay_nu(hm_doublet), 0x0000000000000000, f64_mul(FR, SR_DOUBLET), "doublet: marginal nu");
_assert_near(ParaxialRay_y(hc_doublet), 0x8000000000000000, f64_mul(FR, SR_DOUBLET), "doublet: chief y");
_assert_near(ParaxialRay_nu(hc_doublet), 0x3FAAD53144273E73, f64_mul(FR, SR_DOUBLET), "doublet: chief nu");
var AB_DOUBLET = aberr_sums(P_DOUBLET, M_DOUBLET, C_DOUBLET, &e);
assert(e == PK_ERR_NONE, "doublet: sums");
assert(AberrSums_count(AB_DOUBLET) == 3, "doublet: count");
_assert_near(AberrSums_lagrange(AB_DOUBLET), 0x3FE0C53ECA988708, f64_mul(F3, 0x3FE0C53ECA988708), "doublet: lagrange");
_assert_near(AberrSums_image_height(AB_DOUBLET), 0x4013427E6D77935C, f64_mul(F3, 0x4013427E6D77935C),
  "doublet: image_height");
_assert_near(AberrSums_image_distance(AB_DOUBLET), 0x40563C879B8DF787, f64_mul(F3, 0x40563C879B8DF787),
  "doublet: image_distance");
_assert_near(AberrSums_image_nu(AB_DOUBLET), 0xBFBBDD36A79E492D, f64_mul(F3, 0x3FBBDD36A79E492D), "doublet: image_nu");
# The system, against where the 100-digit rays meet the paraxial image plane.
_assert_near(aberr_third(AB_DOUBLET, ABERR_SYSTEM, ABERR3_B), 0xBFB22BBA6E5521ED, f64_mul(F3, S3_DOUBLET),
  "doublet: B");
_assert_near(aberr_third(AB_DOUBLET, ABERR_SYSTEM, ABERR3_F), 0x3F81AF88CD8C0361, f64_mul(F3, S3_DOUBLET),
  "doublet: F");
_assert_near(aberr_third(AB_DOUBLET, ABERR_SYSTEM, ABERR3_C), 0xBF8A1DDF49839D81, f64_mul(F3, S3_DOUBLET),
  "doublet: C");
_assert_near(aberr_third(AB_DOUBLET, ABERR_SYSTEM, ABERR3_PI), 0xBF83B41881D3AFCE, f64_mul(F3, S3_DOUBLET),
  "doublet: PI");
_assert_near(aberr_third(AB_DOUBLET, ABERR_SYSTEM, ABERR3_E), 0xBF3D344FDD908086, f64_mul(F3, S3_DOUBLET),
  "doublet: E");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_B5, ABERR_TOTAL), 0x3F6462A7A4C5CDCC,
  f64_mul(F5, S5_DOUBLET), "doublet: B5");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_F1, ABERR_TOTAL), 0xBF4AD46238C8D5ED,
  f64_mul(F5, S5_DOUBLET), "doublet: F1");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_F2, ABERR_TOTAL), 0xBF441B0ABDC12AEA,
  f64_mul(F5, S5_DOUBLET), "doublet: F2");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_M1, ABERR_TOTAL), 0xBF3537F2CCC617D7,
  f64_mul(F5, S5_DOUBLET), "doublet: M1");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_M2, ABERR_TOTAL), 0xBF3C71DBA8946B62,
  f64_mul(F5, S5_DOUBLET), "doublet: M2");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_M3, ABERR_TOTAL), 0xBF30D3078324CD89,
  f64_mul(F5, S5_DOUBLET), "doublet: M3");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_N1, ABERR_TOTAL), 0xBF00EF84E121160C,
  f64_mul(F5, S5_DOUBLET), "doublet: N1");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_N2, ABERR_TOTAL), 0x3F35C02864C7CFDF,
  f64_mul(F5, S5_DOUBLET), "doublet: N2");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_N3, ABERR_TOTAL), 0x3F1C84ECFF275FD5,
  f64_mul(F5, S5_DOUBLET), "doublet: N3");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_C5, ABERR_TOTAL), 0xBEEBB191CAD0480F,
  f64_mul(F5, S5_DOUBLET), "doublet: C5");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_PI5, ABERR_TOTAL), 0x3EF8DFDFC4649CA1,
  f64_mul(F5, S5_DOUBLET), "doublet: PI5");
_assert_near(aberr_fifth(AB_DOUBLET, ABERR_SYSTEM, ABERR5_E5, ABERR_TOTAL), 0x3E776E23E7BAD2E9,
  f64_mul(F5, S5_DOUBLET), "doublet: E5");
_assert_near(aberr_seidel(AB_DOUBLET, ABERR_SYSTEM, 0), 0x3F8FA504AB35024F, f64_mul(F3, SS_DOUBLET),
  "doublet: system S_I");
_assert_near(aberr_seidel(AB_DOUBLET, ABERR_SYSTEM, 1), 0xBF5ECCBBD6283385, f64_mul(F3, SS_DOUBLET),
  "doublet: system S_II");
_assert_near(aberr_seidel(AB_DOUBLET, ABERR_SYSTEM, 2), 0x3F66BDBF4F50A26A, f64_mul(F3, SS_DOUBLET),
  "doublet: system S_III");
_assert_near(aberr_seidel(AB_DOUBLET, ABERR_SYSTEM, 3), 0x3F61282A1DE9EB8E, f64_mul(F3, SS_DOUBLET),
  "doublet: system S_IV");
_assert_near(aberr_seidel(AB_DOUBLET, ABERR_SYSTEM, 4), 0x3F196E068BC4562C, f64_mul(F3, SS_DOUBLET),
  "doublet: system S_V");
# Each surface: its third order, Welford's Seidel sums, and its fifth order split.
_assert_near(aberr_third(AB_DOUBLET, 0, ABERR3_B), 0xBFA73239EE73547E, f64_mul(F3, S3_DOUBLET), "doublet 0: B");
_assert_near(aberr_third(AB_DOUBLET, 0, ABERR3_F), 0xBF8DB23839CC9FFF, f64_mul(F3, S3_DOUBLET), "doublet 0: F");
_assert_near(aberr_third(AB_DOUBLET, 0, ABERR3_C), 0xBF73023F0CC13E37, f64_mul(F3, S3_DOUBLET), "doublet 0: C");
