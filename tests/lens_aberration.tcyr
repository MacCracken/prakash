  "immersed: (0.6, -0.8, 0.5) eps_y: the real ray less order 3 is order 5 to 2%");

# ── Closed forms ────────
test_group("closed forms");
# The plate (d = 10, N = 1.5), in a beam converging with tangent u_m at the margin and u_c along
# the chief ray. A ray of direction tangent T (a vector) leaves it displaced, against the
# paraxial ray, by eps = (d/N) T ((1 + k|T|^2)^(-1/2) - 1), k = 1 - 1/N^2, with
# T = rho_vec u_m + H y-hat u_c. Expanded, with A3 = -(d/N)(k/2) and K = (d/N)(3k^2/8):
#   B = A3 u_m^3, F = A3 u_m^2 u_c, C = A3 u_m u_c^2, PI = 0, E = A3 u_c^3,
#   B5 = K u_m^5, F1 = 3K u_m^4 u_c, F2 = 2K u_m^4 u_c, M1 = M3 = 4K u_m^3 u_c^2,
#   M2 = 2K u_m^3 u_c^2, N1 = N3 = 2K u_m^2 u_c^3, N2 = 8K u_m^2 u_c^3, C5 = K u_m u_c^4,
#   PI5 = 0, E5 = K u_c^5.
# These are the only pins of the field terms that share nothing with the 100-digit oracle.
var pl_m = ParaxialRay_nu(M_PLATE);                     # n0 = 1, so the tangents are the nu
var pl_c = ParaxialRay_nu(C_PLATE);
var pl_dn = f64_div(f64_from(10), _fd(3, 2));
var pl_k = f64_sub(ONE, f64_div(ONE, _fd(9, 4)));
var pl_a3 = f64_neg(f64_mul(pl_dn, f64_mul(F64_HALF, pl_k)));
var pl_k5 = f64_mul(pl_dn, f64_mul(_fd(3, 8), _sq(pl_k)));
# u_m^i u_c^j
fn _pl_pow(i, j) {
    var v = ONE;
    for (var pi = 0; pi < i; pi = pi + 1) { v = f64_mul(v, pl_m); }
    for (var pj = 0; pj < j; pj = pj + 1) { v = f64_mul(v, pl_c); }
    return v;
}
var pl_t3 = f64_mul(F3, S3_PLATE);
var pl_t5 = f64_mul(F5, S5_PLATE);
_assert_near(aberr_third(AB_PLATE, ABERR_SYSTEM, ABERR3_B), f64_mul(pl_a3, _pl_pow(3, 0)), pl_t3, "plate: B");
_assert_near(aberr_third(AB_PLATE, ABERR_SYSTEM, ABERR3_F), f64_mul(pl_a3, _pl_pow(2, 1)), pl_t3, "plate: F");
_assert_near(aberr_third(AB_PLATE, ABERR_SYSTEM, ABERR3_C), f64_mul(pl_a3, _pl_pow(1, 2)), pl_t3, "plate: C");
_assert_near(aberr_third(AB_PLATE, ABERR_SYSTEM, ABERR3_PI), Z, pl_t3, "plate: PI = 0");
_assert_near(aberr_third(AB_PLATE, ABERR_SYSTEM, ABERR3_E), f64_mul(pl_a3, _pl_pow(0, 3)), pl_t3, "plate: E");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_B5, ABERR_TOTAL), f64_mul(pl_k5, _pl_pow(5, 0)), pl_t5,
  "plate: B5");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_F1, ABERR_TOTAL), f64_mul(f64_mul(f64_from(3), pl_k5),
    _pl_pow(4, 1)), pl_t5, "plate: F1");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_F2, ABERR_TOTAL), f64_mul(f64_mul(F64_TWO, pl_k5),
    _pl_pow(4, 1)), pl_t5, "plate: F2");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_M1, ABERR_TOTAL), f64_mul(f64_mul(f64_from(4), pl_k5),
    _pl_pow(3, 2)), pl_t5, "plate: M1");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_M2, ABERR_TOTAL), f64_mul(f64_mul(F64_TWO, pl_k5),
    _pl_pow(3, 2)), pl_t5, "plate: M2");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_M3, ABERR_TOTAL), f64_mul(f64_mul(f64_from(4), pl_k5),
    _pl_pow(3, 2)), pl_t5, "plate: M3");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_N1, ABERR_TOTAL), f64_mul(f64_mul(F64_TWO, pl_k5),
    _pl_pow(2, 3)), pl_t5, "plate: N1");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_N2, ABERR_TOTAL), f64_mul(f64_mul(f64_from(8), pl_k5),
    _pl_pow(2, 3)), pl_t5, "plate: N2");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_N3, ABERR_TOTAL), f64_mul(f64_mul(F64_TWO, pl_k5),
    _pl_pow(2, 3)), pl_t5, "plate: N3");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_C5, ABERR_TOTAL), f64_mul(pl_k5, _pl_pow(1, 4)), pl_t5,
  "plate: C5");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_PI5, ABERR_TOTAL), Z, pl_t5, "plate: PI5 = 0");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_E5, ABERR_TOTAL), f64_mul(pl_k5, _pl_pow(0, 5)), pl_t5,
  "plate: E5");
assert(f64_gt(aberr_third(AB_PLATE, ABERR_SYSTEM, ABERR3_B), Z) == 1, "plate: B > 0, the plate overcorrects");
# The aplanatic surface: B, F, B5, F1, F2 vanish against the terms that do not.
var ap3 = f64_abs(aberr_third(AB_APLANAT, ABERR_SYSTEM, ABERR3_PI));
var ap5 = f64_abs(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_M2, ABERR_TOTAL));
assert(f64_gt(ap3, Z) == 1, "aplanat: Petzval is not zero");
assert(f64_gt(ap5, Z) == 1, "aplanat: M2 is not zero");
_assert_near(aberr_third(AB_APLANAT, ABERR_SYSTEM, ABERR3_B), Z, f64_mul(F3, ap3), "aplanat: B = 0");
_assert_near(aberr_third(AB_APLANAT, ABERR_SYSTEM, ABERR3_F), Z, f64_mul(F3, ap3), "aplanat: F = 0");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_B5, ABERR_TOTAL), Z, f64_mul(F5, ap5), "aplanat: B5 = 0");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_F1, ABERR_TOTAL), Z, f64_mul(F5, ap5), "aplanat: F1 = 0");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_F2, ABERR_TOTAL), Z, f64_mul(F5, ap5), "aplanat: F2 = 0");
# A surface between equal indices refracts nothing: its row is exactly zero.
var dz_triplet_4 = 1;
for (var dz_triplet_4a = 0; dz_triplet_4a < 5; dz_triplet_4a = dz_triplet_4a + 1) {
    if ((aberr_third(AB_TRIPLET, 4, dz_triplet_4a) & AX) != 0) { dz_triplet_4 = 0; }
}
for (var dz_triplet_4b = 0; dz_triplet_4b < 12; dz_triplet_4b = dz_triplet_4b + 1) {
    if ((aberr_fifth(AB_TRIPLET, 4, dz_triplet_4b, ABERR_INTRINSIC) & AX) != 0) { dz_triplet_4 = 0; }
    if ((aberr_fifth(AB_TRIPLET, 4, dz_triplet_4b, ABERR_INDUCED) & AX) != 0) { dz_triplet_4 = 0; }
}
assert(dz_triplet_4 == 1, "triplet 4: a surface between equal indices contributes exactly 0");
var dz_singlet_0 = 1;
for (var dz_singlet_0a = 0; dz_singlet_0a < 5; dz_singlet_0a = dz_singlet_0a + 1) {
    if ((aberr_third(AB_SINGLET, 0, dz_singlet_0a) & AX) != 0) { dz_singlet_0 = 0; }
}
for (var dz_singlet_0b = 0; dz_singlet_0b < 12; dz_singlet_0b = dz_singlet_0b + 1) {
    if ((aberr_fifth(AB_SINGLET, 0, dz_singlet_0b, ABERR_INTRINSIC) & AX) != 0) { dz_singlet_0 = 0; }
    if ((aberr_fifth(AB_SINGLET, 0, dz_singlet_0b, ABERR_INDUCED) & AX) != 0) { dz_singlet_0 = 0; }
}
assert(dz_singlet_0 == 1, "singlet 0: a surface between equal indices contributes exactly 0");
var dz_remote_2 = 1;
for (var dz_remote_2a = 0; dz_remote_2a < 5; dz_remote_2a = dz_remote_2a + 1) {
    if ((aberr_third(AB_REMOTE, 2, dz_remote_2a) & AX) != 0) { dz_remote_2 = 0; }
}
for (var dz_remote_2b = 0; dz_remote_2b < 12; dz_remote_2b = dz_remote_2b + 1) {
    if ((aberr_fifth(AB_REMOTE, 2, dz_remote_2b, ABERR_INTRINSIC) & AX) != 0) { dz_remote_2 = 0; }
    if ((aberr_fifth(AB_REMOTE, 2, dz_remote_2b, ABERR_INDUCED) & AX) != 0) { dz_remote_2 = 0; }
}
assert(dz_remote_2 == 1, "remote 2: a surface between equal indices contributes exactly 0");
var tsurfs0 = Prescription_surfaces(P_TRIPLET);
# Curved, too: the triplet with its stop plane bent to R = 30 (still air on both sides) is the
# same system, coefficient for coefficient. Expanded rather than skipped, such a surface leaves
# rounding where the plane leaves none.
var cv = prescription_new("triplet, curved stop");
for (var ci = 0; ci < vec_len(tsurfs0); ci = ci + 1) {
    var cs = vec_get(tsurfs0, ci);
    var crad = PrescriptionSurface_radius(cs);
    if (ci == 4) { crad = f64_from(30); }
    cv = prescription_add_surface(cv, crad, PrescriptionSurface_thickness(cs), PrescriptionSurface_n_after(cs), BIG);
}
var ab_cv = aberr_sums(cv, M_TRIPLET, C_TRIPLET, &e);
assert(e == PK_ERR_NONE, "curved stop: sums");
var cv_ok = 1;
for (var ck = 0; ck < 12; ck = ck + 1) {
    for (var csf = 0; csf < 7; csf = csf + 1) {
        if (f64_eq(aberr_fifth(ab_cv, csf, ck, ABERR_TOTAL), aberr_fifth(AB_TRIPLET, csf, ck, ABERR_TOTAL)) == 0) {
            cv_ok = 0;
        }
        if ((ck < 5) & (f64_eq(aberr_third(ab_cv, csf, ck), aberr_third(AB_TRIPLET, csf, ck)) == 0)) { cv_ok = 0; }
    }
}
assert(cv_ok == 1, "a curved surface between equal indices changes no coefficient");

# ── Symmetries ────────
test_group("symmetries");
# Doubling every length (radii, thicknesses, ray heights; slopes stay) doubles every
# coefficient, exactly: every quantity scales by a power of 2.
var dbl = prescription_new("triplet x2");
var tsurfs = Prescription_surfaces(P_TRIPLET);
for (var di = 0; di < vec_len(tsurfs); di = di + 1) {
    var ds = vec_get(tsurfs, di);
    dbl = prescription_add_surface(dbl, f64_mul(F64_TWO, PrescriptionSurface_radius(ds)),
      f64_mul(F64_TWO, PrescriptionSurface_thickness(ds)), PrescriptionSurface_n_after(ds), BIG);
}
var ab_dbl = aberr_sums(dbl, paraxial_ray_new(f64_mul(F64_TWO, ParaxialRay_y(M_TRIPLET)), ParaxialRay_nu(M_TRIPLET)),
  paraxial_ray_new(f64_mul(F64_TWO, ParaxialRay_y(C_TRIPLET)), ParaxialRay_nu(C_TRIPLET)), &e);
assert(e == PK_ERR_NONE, "x2: sums");
var dbl_ok = 1;
for (var dk = 0; dk < 5; dk = dk + 1) {
    if (aberr_third(ab_dbl, ABERR_SYSTEM, dk) != f64_mul(F64_TWO,
        aberr_third(AB_TRIPLET, ABERR_SYSTEM, dk))) { dbl_ok = 0; }
}
for (var dk5 = 0; dk5 < 12; dk5 = dk5 + 1) {
    for (var dpart = 1; dpart < 3; dpart = dpart + 1) {
        for (var dsf = 0; dsf < 7; dsf = dsf + 1) {
            if (aberr_fifth(ab_dbl, dsf, dk5, dpart) != f64_mul(F64_TWO,
                aberr_fifth(AB_TRIPLET, dsf, dk5, dpart))) { dbl_ok = 0; }
        }
    }
}
assert(dbl_ok == 1, "x2: every third- and fifth-order term doubles exactly");
# Turning the chief ray around is H -> -H: terms odd in H flip (F, E; F1, F2, N1-N3, E5), the
# rest stay. Turning the marginal ray around is rho -> -rho: terms odd in rho flip (B, C, PI;
# B5, M1-M3, C5, PI5).
var ab_nc = aberr_sums(P_TRIPLET, M_TRIPLET,
  paraxial_ray_new(f64_neg(ParaxialRay_y(C_TRIPLET)), f64_neg(ParaxialRay_nu(C_TRIPLET))), &e);
assert(e == PK_ERR_NONE, "chief reversed: sums");
var ab_nm = aberr_sums(P_TRIPLET,
  paraxial_ray_new(f64_neg(ParaxialRay_y(M_TRIPLET)), f64_neg(ParaxialRay_nu(M_TRIPLET))), C_TRIPLET, &e);
assert(e == PK_ERR_NONE, "marginal reversed: sums");
var sym_ok = 1;
if (f64_eq(aberr_third(ab_nc, 0, 0), (aberr_third(AB_TRIPLET, 0, 0))) == 0) { sym_ok = 0; }
if (f64_eq(aberr_third(ab_nm, 0, 0), f64_neg(aberr_third(AB_TRIPLET, 0, 0))) == 0) { sym_ok = 0; }
