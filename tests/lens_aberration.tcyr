# The expansion evaluated at three pupil and field points.
assert(aberr_transverse(AB_REMOTE, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 3, &tr) == PK_ERR_NONE,
  "remote: transverse (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 0), 0xBF9FC31C811DBCE4, f64_mul(F5, 0x3FAA103DF6B3F248),
  "remote: eps_x (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 8), 0xBFA974DB1AA81A6E, f64_mul(F5, 0x3FAA103DF6B3F248),
  "remote: eps_y (0.6, 0.8, 1) order 3");
assert(aberr_transverse(AB_REMOTE, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 5, &tr) == PK_ERR_NONE,
  "remote: transverse (0.6, 0.8, 1) order 5");
_assert_near(load64(&tr + 0), 0xBFA045E23A6FCFF7, f64_mul(F5, 0x3FAA103DF6B3F248),
  "remote: eps_x (0.6, 0.8, 1) order 5");
_assert_near(load64(&tr + 8), 0xBFAA103DF6B3F248, f64_mul(F5, 0x3FAA103DF6B3F248),
  "remote: eps_y (0.6, 0.8, 1) order 5");
assert(aberr_transverse(AB_REMOTE, 0x0000000000000000, 0x3FF0000000000000, 0x3FE0000000000000, 3, &tr) == PK_ERR_NONE,
  "remote: transverse (0, 1, 0.5) order 3");
_assert_near(load64(&tr + 8), 0xBFA7876DFF41C79D, f64_mul(F5, 0x3FAA103DF6B3F248), "remote: eps_y (0, 1, 0.5) order 3");
assert(aberr_transverse(AB_REMOTE, 0x0000000000000000, 0x3FF0000000000000, 0x3FE0000000000000, 5, &tr) == PK_ERR_NONE,
  "remote: transverse (0, 1, 0.5) order 5");
_assert_near(load64(&tr + 8), 0xBFA81122027913A2, f64_mul(F5, 0x3FAA103DF6B3F248), "remote: eps_y (0, 1, 0.5) order 5");
assert(aberr_transverse(AB_REMOTE, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 3, &tr) == PK_ERR_NONE,
  "remote: transverse (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 0), 0x3F7331D39103916D, f64_mul(F5, 0x3FAA103DF6B3F248),
  "remote: eps_x (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 8), 0xBF80B7E632461532, f64_mul(F5, 0x3FAA103DF6B3F248),
  "remote: eps_y (-0.3, 0.4, 0.7) order 3");
assert(aberr_transverse(AB_REMOTE, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 5, &tr) == PK_ERR_NONE,
  "remote: transverse (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 0), 0x3F7352CFECBC8E51, f64_mul(F5, 0x3FAA103DF6B3F248),
  "remote: eps_x (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 8), 0xBF80D41DC851BFA0, f64_mul(F5, 0x3FAA103DF6B3F248),
  "remote: eps_y (-0.3, 0.4, 0.7) order 5");

# ── plate ────────
test_group("plate");
var P_PLATE = _p_plate();
var M_PLATE = paraxial_ray_new(0x4020000000000000, 0xBFC47AE147AE147B);
var C_PLATE = paraxial_ray_new(0x0000000000000000, 0x3FA47AE147AE147B);
var S3_PLATE = 0x3FAD208A5A912E32;   # largest third-order surface term
var S5_PLATE = 0x3F513B9EE813FEC0;   # largest fifth-order surface term
var SS_PLATE = 0x3F92A42F961F79BA;   # largest Seidel surface term
var SR_PLATE = 0x4020000000000000;   # largest paraxial ray value
# The paraxial rays from the stop, against the 100-digit construction (the pins below use
# its doubles).
var hm_plate = aberr_marginal_ray(P_PLATE, 0xC049000000000000, 0, 0x4020000000000000, &e);
assert(e == PK_ERR_NONE, "plate: marginal ray");
var hc_plate = aberr_chief_ray(P_PLATE, 0xC049000000000000, 0x4000000000000000, 0, &e);
assert(e == PK_ERR_NONE, "plate: chief ray");
_assert_near(ParaxialRay_y(hm_plate), 0x4020000000000000, f64_mul(FR, SR_PLATE), "plate: marginal y");
_assert_near(ParaxialRay_nu(hm_plate), 0xBFC47AE147AE147B, f64_mul(FR, SR_PLATE), "plate: marginal nu");
_assert_near(ParaxialRay_y(hc_plate), 0x0000000000000000, f64_mul(FR, SR_PLATE), "plate: chief y");
_assert_near(ParaxialRay_nu(hc_plate), 0x3FA47AE147AE147B, f64_mul(FR, SR_PLATE), "plate: chief nu");
var AB_PLATE = aberr_sums(P_PLATE, M_PLATE, C_PLATE, &e);
assert(e == PK_ERR_NONE, "plate: sums");
assert(AberrSums_count(AB_PLATE) == 2, "plate: count");
_assert_near(AberrSums_lagrange(AB_PLATE), 0x3FD47AE147AE147B, f64_mul(F3, 0x3FD47AE147AE147B), "plate: lagrange");
_assert_near(AberrSums_image_height(AB_PLATE), 0x4000000000000000, f64_mul(F3, 0x4000000000000000),
  "plate: image_height");
_assert_near(AberrSums_image_distance(AB_PLATE), 0x4045AAAAAAAAAAAB, f64_mul(F3, 0x4045AAAAAAAAAAAB),
  "plate: image_distance");
_assert_near(AberrSums_image_nu(AB_PLATE), 0xBFC47AE147AE147B, f64_mul(F3, 0x3FC47AE147AE147B), "plate: image_nu");
# The system, against where the 100-digit rays meet the paraxial image plane.
_assert_near(aberr_third(AB_PLATE, ABERR_SYSTEM, ABERR3_B), 0x3F7F11A4A4DF2035, f64_mul(F3, S3_PLATE), "plate: B");
_assert_near(aberr_third(AB_PLATE, ABERR_SYSTEM, ABERR3_F), 0xBF5F11A4A4DF2035, f64_mul(F3, S3_PLATE), "plate: F");
_assert_near(aberr_third(AB_PLATE, ABERR_SYSTEM, ABERR3_C), 0x3F3F11A4A4DF2035, f64_mul(F3, S3_PLATE), "plate: C");
_assert_near(aberr_third(AB_PLATE, ABERR_SYSTEM, ABERR3_PI), 0x3454B878B8484F4D, f64_mul(F3, S3_PLATE), "plate: PI");
_assert_near(aberr_third(AB_PLATE, ABERR_SYSTEM, ABERR3_E), 0xBF1F11A4A4DF2035, f64_mul(F3, S3_PLATE), "plate: E");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_B5, ABERR_TOTAL), 0xBF1535AFE28EC363, f64_mul(F5, S5_PLATE),
  "plate: B5");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_F1, ABERR_TOTAL), 0x3F0FD087D3D62514, f64_mul(F5, S5_PLATE),
  "plate: F1");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_F2, ABERR_TOTAL), 0x3F0535AFE28EC363, f64_mul(F5, S5_PLATE),
  "plate: F2");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_M1, ABERR_TOTAL), 0xBEF535AFE28EC363, f64_mul(F5, S5_PLATE),
  "plate: M1");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_M2, ABERR_TOTAL), 0xBEE535AFE28EC363, f64_mul(F5, S5_PLATE),
  "plate: M2");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_M3, ABERR_TOTAL), 0xBEF535AFE28EC363, f64_mul(F5, S5_PLATE),
  "plate: M3");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_N1, ABERR_TOTAL), 0x3EC535AFE28EC363, f64_mul(F5, S5_PLATE),
  "plate: N1");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_N2, ABERR_TOTAL), 0x3EE535AFE28EC363, f64_mul(F5, S5_PLATE),
  "plate: N2");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_N3, ABERR_TOTAL), 0x3EC535AFE28EC363, f64_mul(F5, S5_PLATE),
  "plate: N3");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_C5, ABERR_TOTAL), 0xBE9535AFE28EC363, f64_mul(F5, S5_PLATE),
  "plate: C5");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_PI5, ABERR_TOTAL), 0x355137A5A94C7C62, f64_mul(F5, S5_PLATE),
  "plate: PI5");
_assert_near(aberr_fifth(AB_PLATE, ABERR_SYSTEM, ABERR5_E5, ABERR_TOTAL), 0x3E7535AFE28EC363, f64_mul(F5, S5_PLATE),
  "plate: E5");
_assert_near(aberr_seidel(AB_PLATE, ABERR_SYSTEM, 0), 0xBF63E254E465D72D, f64_mul(F3, SS_PLATE), "plate: system S_I");
_assert_near(aberr_seidel(AB_PLATE, ABERR_SYSTEM, 1), 0x3F43E254E465D72D, f64_mul(F3, SS_PLATE), "plate: system S_II");
_assert_near(aberr_seidel(AB_PLATE, ABERR_SYSTEM, 2), 0xBF23E254E465D72D, f64_mul(F3, SS_PLATE), "plate: system S_III");
_assert_near(aberr_seidel(AB_PLATE, ABERR_SYSTEM, 3), 0x0000000000000000, f64_mul(F3, SS_PLATE), "plate: system S_IV");
_assert_near(aberr_seidel(AB_PLATE, ABERR_SYSTEM, 4), 0x3F03E254E465D72D, f64_mul(F3, SS_PLATE), "plate: system S_V");
# Each surface: its third order, Welford's Seidel sums, and its fifth order split.
_assert_near(aberr_third(AB_PLATE, 0, ABERR3_B), 0x3FAD208A5A912E32, f64_mul(F3, S3_PLATE), "plate 0: B");
_assert_near(aberr_third(AB_PLATE, 0, ABERR3_F), 0xBF8D208A5A912E32, f64_mul(F3, S3_PLATE), "plate 0: F");
