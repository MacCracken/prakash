  "immersed 0: E5 induced");
# The expansion evaluated at three pupil and field points.
assert(aberr_transverse(AB_IMMERSED, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 3, &tr) == PK_ERR_NONE,
  "immersed: transverse (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 0), 0xC00EEBEDB6C7B0A3, f64_mul(F5, 0x401D002D8838C685),
  "immersed: eps_x (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 8), 0xC0112DBCF3C445B0, f64_mul(F5, 0x401D002D8838C685),
  "immersed: eps_y (0.6, 0.8, 1) order 3");
assert(aberr_transverse(AB_IMMERSED, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 5, &tr) == PK_ERR_NONE,
  "immersed: transverse (0.6, 0.8, 1) order 5");
_assert_near(load64(&tr + 0), 0xC011568E877C6522, f64_mul(F5, 0x401D002D8838C685),
  "immersed: eps_x (0.6, 0.8, 1) order 5");
_assert_near(load64(&tr + 8), 0xC01343BACF6DC5B5, f64_mul(F5, 0x401D002D8838C685),
  "immersed: eps_y (0.6, 0.8, 1) order 5");
assert(aberr_transverse(AB_IMMERSED, 0x0000000000000000, 0x3FF0000000000000, 0x3FE0000000000000, 3, &tr) == PK_ERR_NONE,
  "immersed: transverse (0, 1, 0.5) order 3");
_assert_near(load64(&tr + 8), 0xC019B0928E443311, f64_mul(F5, 0x401D002D8838C685),
  "immersed: eps_y (0, 1, 0.5) order 3");
assert(aberr_transverse(AB_IMMERSED, 0x0000000000000000, 0x3FF0000000000000, 0x3FE0000000000000, 5, &tr) == PK_ERR_NONE,
  "immersed: transverse (0, 1, 0.5) order 5");
_assert_near(load64(&tr + 8), 0xC01D002D8838C685, f64_mul(F5, 0x401D002D8838C685),
  "immersed: eps_y (0, 1, 0.5) order 5");
assert(aberr_transverse(AB_IMMERSED, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 3, &tr) == PK_ERR_NONE,
  "immersed: transverse (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 0), 0x3FDCDE225BE085BE, f64_mul(F5, 0x401D002D8838C685),
  "immersed: eps_x (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 8), 0xBFDD825C02E58306, f64_mul(F5, 0x401D002D8838C685),
  "immersed: eps_y (-0.3, 0.4, 0.7) order 3");
assert(aberr_transverse(AB_IMMERSED, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 5, &tr) == PK_ERR_NONE,
  "immersed: transverse (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 0), 0x3FDDAEEA71CF2A64, f64_mul(F5, 0x401D002D8838C685),
  "immersed: eps_x (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 8), 0xBFDE57C7D50CA87D, f64_mul(F5, 0x401D002D8838C685),
  "immersed: eps_y (-0.3, 0.4, 0.7) order 5");

# ── aplanat ────────
test_group("aplanat");
var P_APLANAT = _p_aplanat();
var M_APLANAT = paraxial_ray_new(0x4008000000000000, 0xBFBEB851EB851EB8);
var C_APLANAT = paraxial_ray_new(0x0000000000000000, 0x3FA47AE147AE147B);
var S3_APLANAT = 0x3F4D208A5A912E32;   # largest third-order surface term
var S5_APLANAT = 0x3EF92A737110E455;   # largest fifth-order surface term
var SS_APLANAT = 0x3F3F75104D551D69;   # largest Seidel surface term
var SR_APLANAT = 0x4008000000000000;   # largest paraxial ray value
# The paraxial rays from the stop, against the 100-digit construction (the pins below use
# its doubles).
var hm_aplanat = aberr_marginal_ray(P_APLANAT, 0xC039000000000000, 0, 0x4008000000000000, &e);
assert(e == PK_ERR_NONE, "aplanat: marginal ray");
var hc_aplanat = aberr_chief_ray(P_APLANAT, 0xC039000000000000, 0x3FF0000000000000, 0, &e);
assert(e == PK_ERR_NONE, "aplanat: chief ray");
_assert_near(ParaxialRay_y(hm_aplanat), 0x4008000000000000, f64_mul(FR, SR_APLANAT), "aplanat: marginal y");
_assert_near(ParaxialRay_nu(hm_aplanat), 0xBFBEB851EB851EB8, f64_mul(FR, SR_APLANAT), "aplanat: marginal nu");
_assert_near(ParaxialRay_y(hc_aplanat), 0x0000000000000000, f64_mul(FR, SR_APLANAT), "aplanat: chief y");
_assert_near(ParaxialRay_nu(hc_aplanat), 0x3FA47AE147AE147B, f64_mul(FR, SR_APLANAT), "aplanat: chief nu");
var AB_APLANAT = aberr_sums(P_APLANAT, M_APLANAT, C_APLANAT, &e);
assert(e == PK_ERR_NONE, "aplanat: sums");
assert(AberrSums_count(AB_APLANAT) == 1, "aplanat: count");
_assert_near(AberrSums_lagrange(AB_APLANAT), 0x3FBEB851EB851EB8, f64_mul(F3, 0x3FBEB851EB851EB8), "aplanat: lagrange");
_assert_near(AberrSums_image_height(AB_APLANAT), 0x3FDC71C71C71C71D, f64_mul(F3, 0x3FDC71C71C71C71D),
  "aplanat: image_height");
_assert_near(AberrSums_image_distance(AB_APLANAT), 0x4030AAAAAAAAAAAB, f64_mul(F3, 0x4030AAAAAAAAAAAB),
  "aplanat: image_distance");
_assert_near(AberrSums_image_nu(AB_APLANAT), 0xBFD147AE147AE148, f64_mul(F3, 0x3FD147AE147AE148), "aplanat: image_nu");
# The system, against where the 100-digit rays meet the paraxial image plane.
_assert_near(aberr_third(AB_APLANAT, ABERR_SYSTEM, ABERR3_B), 0xBC20624DD2F1A9FC, f64_mul(F3, S3_APLANAT),
  "aplanat: B");
_assert_near(aberr_third(AB_APLANAT, ABERR_SYSTEM, ABERR3_F), 0xBBFD208A5A912E32, f64_mul(F3, S3_APLANAT),
  "aplanat: F");
_assert_near(aberr_third(AB_APLANAT, ABERR_SYSTEM, ABERR3_C), 0xBBD9E409340F4582, f64_mul(F3, S3_APLANAT),
  "aplanat: C");
_assert_near(aberr_third(AB_APLANAT, ABERR_SYSTEM, ABERR3_PI), 0xBF4D208A5A912E32, f64_mul(F3, S3_APLANAT),
  "aplanat: PI");
_assert_near(aberr_third(AB_APLANAT, ABERR_SYSTEM, ABERR3_E), 0xBF29E409340F4582, f64_mul(F3, S3_APLANAT),
  "aplanat: E");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_B5, ABERR_TOTAL), 0xBBBC4FC1DF3300E0,
  f64_mul(F5, S5_APLANAT), "aplanat: B5");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_F1, ABERR_TOTAL), 0xBBBF75104D551D6A,
  f64_mul(F5, S5_APLANAT), "aplanat: F1");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_F2, ABERR_TOTAL), 0xBBB92A737110E454,
  f64_mul(F5, S5_APLANAT), "aplanat: F2");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_M1, ABERR_TOTAL), 0xBBA65E9F80F29212,
  f64_mul(F5, S5_APLANAT), "aplanat: M1");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_M2, ABERR_TOTAL), 0xBEF92A737110E455,
  f64_mul(F5, S5_APLANAT), "aplanat: M2");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_M3, ABERR_TOTAL), 0xBB9DD37F5698C2C3,
  f64_mul(F5, S5_APLANAT), "aplanat: M3");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_N1, ABERR_TOTAL), 0xBED65E9F80F29212,
  f64_mul(F5, S5_APLANAT), "aplanat: N1");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_N2, ABERR_TOTAL), 0xBEDDD37F5698C2C3,
  f64_mul(F5, S5_APLANAT), "aplanat: N2");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_N3, ABERR_TOTAL), 0xBECDD37F5698C2C3,
  f64_mul(F5, S5_APLANAT), "aplanat: N3");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_C5, ABERR_TOTAL), 0xBE9A831BDB32743B,
  f64_mul(F5, S5_APLANAT), "aplanat: C5");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_PI5, ABERR_TOTAL), 0x3EB091F168FF88A5,
  f64_mul(F5, S5_APLANAT), "aplanat: PI5");
_assert_near(aberr_fifth(AB_APLANAT, ABERR_SYSTEM, ABERR5_E5, ABERR_TOTAL), 0x3E81ACBD3CCC4D7D,
  f64_mul(F5, S5_APLANAT), "aplanat: E5");
_assert_near(aberr_seidel(AB_APLANAT, ABERR_SYSTEM, 0), 0x3C11B1D92B7FE08B, f64_mul(F3, SS_APLANAT),
  "aplanat: system S_I");
_assert_near(aberr_seidel(AB_APLANAT, ABERR_SYSTEM, 1), 0x3BEF75104D551D69, f64_mul(F3, SS_APLANAT),
  "aplanat: system S_II");
_assert_near(aberr_seidel(AB_APLANAT, ABERR_SYSTEM, 2), 0x3BCBF647612F3696, f64_mul(F3, SS_APLANAT),
  "aplanat: system S_III");
_assert_near(aberr_seidel(AB_APLANAT, ABERR_SYSTEM, 3), 0x3F3F75104D551D69, f64_mul(F3, SS_APLANAT),
  "aplanat: system S_IV");
_assert_near(aberr_seidel(AB_APLANAT, ABERR_SYSTEM, 4), 0x3F1BF647612F3697, f64_mul(F3, SS_APLANAT),
  "aplanat: system S_V");
# Each surface: its third order, Welford's Seidel sums, and its fifth order split.
_assert_near(aberr_third(AB_APLANAT, 0, ABERR3_B), 0xBC20624DD2F1A9FC, f64_mul(F3, S3_APLANAT), "aplanat 0: B");
_assert_near(aberr_third(AB_APLANAT, 0, ABERR3_F), 0xBBFD208A5A912E32, f64_mul(F3, S3_APLANAT), "aplanat 0: F");
_assert_near(aberr_third(AB_APLANAT, 0, ABERR3_C), 0xBBD9E409340F4582, f64_mul(F3, S3_APLANAT), "aplanat 0: C");
_assert_near(aberr_third(AB_APLANAT, 0, ABERR3_PI), 0xBF4D208A5A912E32, f64_mul(F3, S3_APLANAT), "aplanat 0: PI");
_assert_near(aberr_third(AB_APLANAT, 0, ABERR3_E), 0xBF29E409340F4582, f64_mul(F3, S3_APLANAT), "aplanat 0: E");
_assert_near(aberr_seidel(AB_APLANAT, 0, 0), 0x3C11B1D92B7FE08B, f64_mul(F3, SS_APLANAT), "aplanat 0: S_I");
_assert_near(aberr_seidel(AB_APLANAT, 0, 1), 0x3BEF75104D551D69, f64_mul(F3, SS_APLANAT), "aplanat 0: S_II");
_assert_near(aberr_seidel(AB_APLANAT, 0, 2), 0x3BCBF647612F3696, f64_mul(F3, SS_APLANAT), "aplanat 0: S_III");
_assert_near(aberr_seidel(AB_APLANAT, 0, 3), 0x3F3F75104D551D69, f64_mul(F3, SS_APLANAT), "aplanat 0: S_IV");
_assert_near(aberr_seidel(AB_APLANAT, 0, 4), 0x3F1BF647612F3697, f64_mul(F3, SS_APLANAT), "aplanat 0: S_V");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_B5, ABERR_INTRINSIC), 0xBBBC4FC1DF3300E0, f64_mul(F5, S5_APLANAT),
  "aplanat 0: B5 intrinsic");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_B5, ABERR_INDUCED), 0xAD55DDB9ACB8A9FD, f64_mul(F5, S5_APLANAT),
  "aplanat 0: B5 induced");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_F1, ABERR_INTRINSIC), 0xBBBF75104D551D6A, f64_mul(F5, S5_APLANAT),
  "aplanat 0: F1 intrinsic");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_F1, ABERR_INDUCED), 0x2D3EA92FCA44E1EC, f64_mul(F5, S5_APLANAT),
  "aplanat 0: F1 induced");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_F2, ABERR_INTRINSIC), 0xBBB92A737110E454, f64_mul(F5, S5_APLANAT),
  "aplanat 0: F2 intrinsic");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_F2, ABERR_INDUCED), 0x2D3322B2FCADCC12, f64_mul(F5, S5_APLANAT),
  "aplanat 0: F2 induced");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_M1, ABERR_INTRINSIC), 0xBBA65E9F80F29212, f64_mul(F5, S5_APLANAT),
  "aplanat 0: M1 intrinsic");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_M1, ABERR_INDUCED), 0xAD65AD09831B719F, f64_mul(F5, S5_APLANAT),
  "aplanat 0: M1 induced");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_M2, ABERR_INTRINSIC), 0xBEF92A737110E455, f64_mul(F5, S5_APLANAT),
  "aplanat 0: M2 intrinsic");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_M2, ABERR_INDUCED), 0x2D5F5240C1F65A86, f64_mul(F5, S5_APLANAT),
  "aplanat 0: M2 induced");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_M3, ABERR_INTRINSIC), 0xBB9DD37F5698C2C3, f64_mul(F5, S5_APLANAT),
  "aplanat 0: M3 intrinsic");
