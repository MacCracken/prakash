  "immersed 0: N2 intrinsic");
_assert_near(aberr_fifth(AB_IMMERSED, 0, ABERR5_N2, ABERR_INDUCED), 0xADD9FAA239C351DC, f64_mul(F5, S5_IMMERSED),
