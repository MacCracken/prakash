assert(aberr_transverse(AB_DOUBLET, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 3, &tr) == PK_ERR_NONE,
  "doublet: transverse (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 0), 0xBFA86EF5F93FBB2D, f64_mul(F5, 0x3FB36A692F4EBD6F),
  "doublet: eps_x (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 8), 0xBFB36A692F4EBD6F, f64_mul(F5, 0x3FB36A692F4EBD6F),
  "doublet: eps_y (0.6, 0.8, 1) order 3");
assert(aberr_transverse(AB_DOUBLET, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 5, &tr) == PK_ERR_NONE,
  "doublet: transverse (0.6, 0.8, 1) order 5");
