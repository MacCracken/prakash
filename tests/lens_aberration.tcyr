  "aplanat 0: N3 induced");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_C5, ABERR_INTRINSIC), 0xBE9A831BDB32743B, f64_mul(F5, S5_APLANAT),
  "aplanat 0: C5 intrinsic");
