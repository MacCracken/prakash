  "aplanat: eps_y (0.6, 0.8, 1) order 5");
assert(aberr_transverse(AB_APLANAT, 0x0000000000000000, 0x3FF0000000000000, 0x3FE0000000000000, 3, &tr) == PK_ERR_NONE,
  "aplanat: transverse (0, 1, 0.5) order 3");
_assert_near(load64(&tr + 8), 0xBF302E85C0898B7C, f64_mul(F5, 0x3F4EBFBE223B7BA0),
  "aplanat: eps_y (0, 1, 0.5) order 3");
assert(aberr_transverse(AB_APLANAT, 0x0000000000000000, 0x3FF0000000000000, 0x3FE0000000000000, 5, &tr) == PK_ERR_NONE,
  "aplanat: transverse (0, 1, 0.5) order 5");
_assert_near(load64(&tr + 8), 0xBF30AE401012E7E5, f64_mul(F5, 0x3F4EBFBE223B7BA0),
  "aplanat: eps_y (0, 1, 0.5) order 5");
assert(aberr_transverse(AB_APLANAT, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 3, &tr) == PK_ERR_NONE,
  "aplanat: transverse (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 0), 0x3F2120721EB9B7D8, f64_mul(F5, 0x3F4EBFBE223B7BA0),
  "aplanat: eps_x (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 8), 0xBF2FB75812F91B8F, f64_mul(F5, 0x3F4EBFBE223B7BA0),
  "aplanat: eps_y (-0.3, 0.4, 0.7) order 3");
assert(aberr_transverse(AB_APLANAT, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 5, &tr) == PK_ERR_NONE,
  "aplanat: transverse (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 0), 0x3F21466E0098FD9B, f64_mul(F5, 0x3F4EBFBE223B7BA0),
  "aplanat: eps_x (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 8), 0xBF2FFDAF437A217E, f64_mul(F5, 0x3F4EBFBE223B7BA0),
  "aplanat: eps_y (-0.3, 0.4, 0.7) order 5");

# ── remote ────────
test_group("remote");
var P_REMOTE = _p_remote();
var M_REMOTE = paraxial_ray_new(0x4001834A54C5A835, 0x3FA8E6A4200F9F06);
var C_REMOTE = paraxial_ray_new(0x3FE10019467413A1, 0xBFAC14EC3AB827B7);
var S3_REMOTE = 0x3F9DFFD1D9A61FA0;   # largest third-order surface term
var S5_REMOTE = 0x3F41E957910CF0F2;   # largest fifth-order surface term
var SS_REMOTE = 0x3F6ED51C15DDB33F;   # largest Seidel surface term
var SR_REMOTE = 0x4001834A54C5A835;   # largest paraxial ray value
# The paraxial rays from the stop, against the 100-digit construction (the pins below use
# its doubles).
var hm_remote = aberr_marginal_ray(P_REMOTE, 0x404E000000000000, 2, 0x4000000000000000, &e);
assert(e == PK_ERR_NONE, "remote: marginal ray");
var hc_remote = aberr_chief_ray(P_REMOTE, 0x404E000000000000, 0x4008000000000000, 2, &e);
assert(e == PK_ERR_NONE, "remote: chief ray");
_assert_near(ParaxialRay_y(hm_remote), 0x4001834A54C5A835, f64_mul(FR, SR_REMOTE), "remote: marginal y");
_assert_near(ParaxialRay_nu(hm_remote), 0x3FA8E6A4200F9F06, f64_mul(FR, SR_REMOTE), "remote: marginal nu");
_assert_near(ParaxialRay_y(hc_remote), 0x3FE10019467413A1, f64_mul(FR, SR_REMOTE), "remote: chief y");
_assert_near(ParaxialRay_nu(hc_remote), 0xBFAC14EC3AB827B7, f64_mul(FR, SR_REMOTE), "remote: chief nu");
var AB_REMOTE = aberr_sums(P_REMOTE, M_REMOTE, C_REMOTE, &e);
assert(e == PK_ERR_NONE, "remote: sums");
assert(AberrSums_count(AB_REMOTE) == 5, "remote: count");
_assert_near(AberrSums_lagrange(AB_REMOTE), 0xBFC2ACFB180BB744, f64_mul(F3, 0x3FC2ACFB180BB744), "remote: lagrange");
_assert_near(AberrSums_image_height(AB_REMOTE), 0xC0022BC9A9087DEE, f64_mul(F3, 0x40022BC9A9087DEE),
  "remote: image_height");
_assert_near(AberrSums_image_distance(AB_REMOTE), 0x40217FBB34BFC970, f64_mul(F3, 0x40217FBB34BFC970),
  "remote: image_distance");
_assert_near(AberrSums_image_nu(AB_REMOTE), 0xBFB071C1E02DAC96, f64_mul(F3, 0x3FB071C1E02DAC96), "remote: image_nu");
# The system, against where the 100-digit rays meet the paraxial image plane.
_assert_near(aberr_third(AB_REMOTE, ABERR_SYSTEM, ABERR3_B), 0xBFA2D32851DD66F9, f64_mul(F3, S3_REMOTE), "remote: B");
_assert_near(aberr_third(AB_REMOTE, ABERR_SYSTEM, ABERR3_F), 0xBF703539C7AE46A4, f64_mul(F3, S3_REMOTE), "remote: F");
_assert_near(aberr_third(AB_REMOTE, ABERR_SYSTEM, ABERR3_C), 0xBF5E2866DABB8657, f64_mul(F3, S3_REMOTE), "remote: C");
_assert_near(aberr_third(AB_REMOTE, ABERR_SYSTEM, ABERR3_PI), 0xBF7BAD49936AA524, f64_mul(F3, S3_REMOTE), "remote: PI");
_assert_near(aberr_third(AB_REMOTE, ABERR_SYSTEM, ABERR3_E), 0xBF57EE2237F915F9, f64_mul(F3, S3_REMOTE), "remote: E");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_B5, ABERR_TOTAL), 0xBF48DD7984455E3F, f64_mul(F5, S5_REMOTE),
  "remote: B5");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_F1, ABERR_TOTAL), 0xBF2ED72E878DE260, f64_mul(F5, S5_REMOTE),
  "remote: F1");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_F2, ABERR_TOTAL), 0xBF29FAC6F290F977, f64_mul(F5, S5_REMOTE),
  "remote: F2");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_M1, ABERR_TOTAL), 0xBF191E2A4ACCB861, f64_mul(F5, S5_REMOTE),
  "remote: M1");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_M2, ABERR_TOTAL), 0xBF18FD966D5A8622, f64_mul(F5, S5_REMOTE),
  "remote: M2");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_M3, ABERR_TOTAL), 0xBF0624CB25FE82AF, f64_mul(F5, S5_REMOTE),
  "remote: M3");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_N1, ABERR_TOTAL), 0xBEE60DDBAE78A4C4, f64_mul(F5, S5_REMOTE),
  "remote: N1");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_N2, ABERR_TOTAL), 0xBF1B69A56D0872EA, f64_mul(F5, S5_REMOTE),
  "remote: N2");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_N3, ABERR_TOTAL), 0xBF0299A35E4DF8E6, f64_mul(F5, S5_REMOTE),
  "remote: N3");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_C5, ABERR_TOTAL), 0xBEC61D336ADD4ECE, f64_mul(F5, S5_REMOTE),
  "remote: C5");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_PI5, ABERR_TOTAL), 0xBEF2E49444DDC7E5, f64_mul(F5, S5_REMOTE),
  "remote: PI5");
_assert_near(aberr_fifth(AB_REMOTE, ABERR_SYSTEM, ABERR5_E5, ABERR_TOTAL), 0xBEE673D18B0A56F0, f64_mul(F5, S5_REMOTE),
  "remote: E5");
_assert_near(aberr_seidel(AB_REMOTE, ABERR_SYSTEM, 0), 0x3F7358FFB977DF89, f64_mul(F3, SS_REMOTE),
  "remote: system S_I");
_assert_near(aberr_seidel(AB_REMOTE, ABERR_SYSTEM, 1), 0x3F40A87614E0EB8F, f64_mul(F3, SS_REMOTE),
  "remote: system S_II");
