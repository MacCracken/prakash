_assert_near(aberr_seidel(AB_PLATE, 0, 3), 0x0000000000000000, f64_mul(F3, SS_PLATE), "plate 0: S_IV");
_assert_near(aberr_seidel(AB_PLATE, 0, 4), 0x3F32A42F961F79BA, f64_mul(F3, SS_PLATE), "plate 0: S_V");
_assert_near(aberr_fifth(AB_PLATE, 0, ABERR5_B5, ABERR_INTRINSIC), 0xBF43E254E465D72D, f64_mul(F5, S5_PLATE),
  "plate 0: B5 intrinsic");
