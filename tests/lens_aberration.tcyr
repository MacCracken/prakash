_assert_near(aberr_seidel(AB_DOUBLET, 0, 4), 0x3F4AAA6670C7511F, f64_mul(F3, SS_DOUBLET), "doublet 0: S_V");
_assert_near(aberr_fifth(AB_DOUBLET, 0, ABERR5_B5, ABERR_INTRINSIC), 0xBF4725DD31995E58, f64_mul(F5, S5_DOUBLET),
  "doublet 0: B5 intrinsic");
_assert_near(aberr_fifth(AB_DOUBLET, 0, ABERR5_B5, ABERR_INDUCED), 0x0000000000000000, f64_mul(F5, S5_DOUBLET),
