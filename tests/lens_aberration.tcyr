# The expansion evaluated at three pupil and field points.
assert(aberr_transverse(AB_TRIPLET, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 3, &tr) == PK_ERR_NONE,
  "triplet: transverse (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 0), 0xBF60817EC08FAD5B, f64_mul(F5, 0x3FC01752F4814B6F),
  "triplet: eps_x (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 8), 0xBFC01752F4814B6F, f64_mul(F5, 0x3FC01752F4814B6F),
  "triplet: eps_y (0.6, 0.8, 1) order 3");
assert(aberr_transverse(AB_TRIPLET, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 5, &tr) == PK_ERR_NONE,
  "triplet: transverse (0.6, 0.8, 1) order 5");
_assert_near(load64(&tr + 0), 0x3FA4238100BB341E, f64_mul(F5, 0x3FC01752F4814B6F),
  "triplet: eps_x (0.6, 0.8, 1) order 5");
_assert_near(load64(&tr + 8), 0xBFBBDBF1CB53974F, f64_mul(F5, 0x3FC01752F4814B6F),
  "triplet: eps_y (0.6, 0.8, 1) order 5");
assert(aberr_transverse(AB_TRIPLET, 0x0000000000000000, 0x3FF0000000000000, 0x3FE0000000000000, 3, &tr) == PK_ERR_NONE,
  "triplet: transverse (0, 1, 0.5) order 3");
_assert_near(load64(&tr + 8), 0x3FA7356D6CAFA3DB, f64_mul(F5, 0x3FC01752F4814B6F),
  "triplet: eps_y (0, 1, 0.5) order 3");
assert(aberr_transverse(AB_TRIPLET, 0x0000000000000000, 0x3FF0000000000000, 0x3FE0000000000000, 5, &tr) == PK_ERR_NONE,
  "triplet: transverse (0, 1, 0.5) order 5");
_assert_near(load64(&tr + 8), 0x3FB2E75CC1B69A10, f64_mul(F5, 0x3FC01752F4814B6F),
  "triplet: eps_y (0, 1, 0.5) order 5");
assert(aberr_transverse(AB_TRIPLET, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 3, &tr) == PK_ERR_NONE,
  "triplet: transverse (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 0), 0x3F72E0B7AE714887, f64_mul(F5, 0x3FC01752F4814B6F),
  "triplet: eps_x (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 8), 0xBFADFCAE2863F090, f64_mul(F5, 0x3FC01752F4814B6F),
  "triplet: eps_y (-0.3, 0.4, 0.7) order 3");
assert(aberr_transverse(AB_TRIPLET, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 5, &tr) == PK_ERR_NONE,
  "triplet: transverse (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 0), 0x3F54801F7C219BFA, f64_mul(F5, 0x3FC01752F4814B6F),
  "triplet: eps_x (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 8), 0xBFAE690F21DB1A28, f64_mul(F5, 0x3FC01752F4814B6F),
  "triplet: eps_y (-0.3, 0.4, 0.7) order 5");

# ── singlet ────────
test_group("singlet");
var P_SINGLET = _p_singlet();
var M_SINGLET = paraxial_ray_new(0x4014000000000000, 0x3FA1111111111111);
var C_SINGLET = paraxial_ray_new(0x0000000000000000, 0xBFB47AE147AE147B);
var S3_SINGLET = 0x3FAE3EAB974129EB;   # largest third-order surface term
var S5_SINGLET = 0x3F630EC195B7AA0C;   # largest fifth-order surface term
var SS_SINGLET = 0x3F837A589DDC8469;   # largest Seidel surface term
var SR_SINGLET = 0x4014000000000000;   # largest paraxial ray value
# The paraxial rays from the stop, against the 100-digit construction (the pins below use
# its doubles).
var hm_singlet = aberr_marginal_ray(P_SINGLET, 0x4062C00000000000, 0, 0x4014000000000000, &e);
assert(e == PK_ERR_NONE, "singlet: marginal ray");
var hc_singlet = aberr_chief_ray(P_SINGLET, 0x4062C00000000000, 0x4028000000000000, 0, &e);
assert(e == PK_ERR_NONE, "singlet: chief ray");
_assert_near(ParaxialRay_y(hm_singlet), 0x4014000000000000, f64_mul(FR, SR_SINGLET), "singlet: marginal y");
_assert_near(ParaxialRay_nu(hm_singlet), 0x3FA1111111111111, f64_mul(FR, SR_SINGLET), "singlet: marginal nu");
_assert_near(ParaxialRay_y(hc_singlet), 0x0000000000000000, f64_mul(FR, SR_SINGLET), "singlet: chief y");
_assert_near(ParaxialRay_nu(hc_singlet), 0xBFB47AE147AE147B, f64_mul(FR, SR_SINGLET), "singlet: chief nu");
var AB_SINGLET = aberr_sums(P_SINGLET, M_SINGLET, C_SINGLET, &e);
assert(e == PK_ERR_NONE, "singlet: sums");
assert(AberrSums_count(AB_SINGLET) == 3, "singlet: count");
_assert_near(AberrSums_lagrange(AB_SINGLET), 0xBFD999999999999A, f64_mul(F3, 0x3FD999999999999A), "singlet: lagrange");
_assert_near(AberrSums_image_height(AB_SINGLET), 0xC013E0218295F926, f64_mul(F3, 0x4013E0218295F926),
  "singlet: image_height");
_assert_near(AberrSums_image_distance(AB_SINGLET), 0x405032E1A836B317, f64_mul(F3, 0x405032E1A836B317),
  "singlet: image_distance");
_assert_near(AberrSums_image_nu(AB_SINGLET), 0xBFB49BB7E66D6CC6, f64_mul(F3, 0x3FB49BB7E66D6CC6), "singlet: image_nu");
# The system, against where the 100-digit rays meet the paraxial image plane.
_assert_near(aberr_third(AB_SINGLET, ABERR_SYSTEM, ABERR3_B), 0xBFBA9DE1F94B5CD7, f64_mul(F3, S3_SINGLET),
  "singlet: B");
_assert_near(aberr_third(AB_SINGLET, ABERR_SYSTEM, ABERR3_F), 0x3F87A517531D3D4C, f64_mul(F3, S3_SINGLET),
  "singlet: F");
_assert_near(aberr_third(AB_SINGLET, ABERR_SYSTEM, ABERR3_C), 0xBF94A8F5F9E64CBD, f64_mul(F3, S3_SINGLET),
  "singlet: C");
_assert_near(aberr_third(AB_SINGLET, ABERR_SYSTEM, ABERR3_PI), 0xBF8CE4C1066C6B46, f64_mul(F3, S3_SINGLET),
  "singlet: PI");
_assert_near(aberr_third(AB_SINGLET, ABERR_SYSTEM, ABERR3_E), 0x3F891C584BFDA118, f64_mul(F3, S3_SINGLET),
  "singlet: E");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_B5, ABERR_TOTAL), 0xBF682BA7C3FAE589,
  f64_mul(F5, S5_SINGLET), "singlet: B5");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_F1, ABERR_TOTAL), 0x3F463F4FB5C14857,
  f64_mul(F5, S5_SINGLET), "singlet: F1");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_F2, ABERR_TOTAL), 0x3F415AEFB333766D,
  f64_mul(F5, S5_SINGLET), "singlet: F2");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_M1, ABERR_TOTAL), 0xBF4A9E15F8B88F4B,
  f64_mul(F5, S5_SINGLET), "singlet: M1");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_M2, ABERR_TOTAL), 0xBF49E5E4D41189F2,
  f64_mul(F5, S5_SINGLET), "singlet: M2");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_M3, ABERR_TOTAL), 0xBF3DFC2EA2CFE13E,
  f64_mul(F5, S5_SINGLET), "singlet: M3");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_N1, ABERR_TOTAL), 0x3F303DD5FD5D9B33,
  f64_mul(F5, S5_SINGLET), "singlet: N1");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_N2, ABERR_TOTAL), 0xBF24C61853C2B8D1,
  f64_mul(F5, S5_SINGLET), "singlet: N2");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_N3, ABERR_TOTAL), 0xBF17DDB922174316,
  f64_mul(F5, S5_SINGLET), "singlet: N3");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_C5, ABERR_TOTAL), 0xBEF5DA9B30C17326,
  f64_mul(F5, S5_SINGLET), "singlet: C5");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_PI5, ABERR_TOTAL), 0x3F1DD9F1BE154729,
  f64_mul(F5, S5_SINGLET), "singlet: PI5");
_assert_near(aberr_fifth(AB_SINGLET, ABERR_SYSTEM, ABERR5_E5, ABERR_TOTAL), 0x3EC7FDF3044C6E28,
  f64_mul(F5, S5_SINGLET), "singlet: E5");
_assert_near(aberr_seidel(AB_SINGLET, ABERR_SYSTEM, 0), 0x3F912432F0ECB52A, f64_mul(F3, SS_SINGLET),
  "singlet: system S_I");
_assert_near(aberr_seidel(AB_SINGLET, ABERR_SYSTEM, 1), 0xBF5E747C3E9B6339, f64_mul(F3, SS_SINGLET),
  "singlet: system S_II");
_assert_near(aberr_seidel(AB_SINGLET, ABERR_SYSTEM, 2), 0x3F6A9C45BD4C3C96, f64_mul(F3, SS_SINGLET),
  "singlet: system S_III");
_assert_near(aberr_seidel(AB_SINGLET, ABERR_SYSTEM, 3), 0x3F629B92B739B5B6, f64_mul(F3, SS_SINGLET),
  "singlet: system S_IV");
_assert_near(aberr_seidel(AB_SINGLET, ABERR_SYSTEM, 4), 0xBF602BE8CA192450, f64_mul(F3, SS_SINGLET),
  "singlet: system S_V");
# Each surface: its third order, Welford's Seidel sums, and its fifth order split.
