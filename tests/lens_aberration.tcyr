  "remote: system S_IV");
_assert_near(aberr_seidel(AB_REMOTE, ABERR_SYSTEM, 4), 0x3F289846016B5740, f64_mul(F3, SS_REMOTE),
  "remote: system S_V");
# Each surface: its third order, Welford's Seidel sums, and its fifth order split.
_assert_near(aberr_third(AB_REMOTE, 0, ABERR3_B), 0xBF9DFFD1D9A61FA0, f64_mul(F3, S3_REMOTE), "remote 0: B");
