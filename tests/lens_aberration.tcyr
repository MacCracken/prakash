# ── Refusals ────────
test_group("refusals");
# One spherical surface of radius r from n0 into n, with a stop on it.
fn _one(r, n, n0) {
    var p = prescription_new("one");
    p = prescription_with_initial_medium(p, n0);
    return prescription_add_surface(p, r, Z, n, BIG);
}
var rm = paraxial_ray_new(f64_from(3), _fd(1, 10));
var rc = paraxial_ray_new(Z, _fd(1, 20));
var n15 = _fd(3, 2);
var rf = aberr_sums(_one(f64_from(10), n15, ONE), rm, rc, &e);
assert((rf != 0) & (e == PK_ERR_NONE), "control: one surface is accepted");
rf = aberr_sums(_one(INF, n15, ONE), rm, rc, &e);
assert((rf != 0) & (e == PK_ERR_NONE), "control: an infinite radius is a plane");
rf = aberr_sums(_one(f64_neg(INF), n15, ONE), rm, rc, &e);
assert((rf != 0) & (e == PK_ERR_NONE), "control: so is -inf");
# Null handles and an empty prescription.
rf = aberr_sums(0, rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: null prescription");
rf = aberr_sums(P_TRIPLET, 0, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: null marginal ray");
rf = aberr_sums(P_TRIPLET, rm, 0, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: null chief ray");
rf = aberr_sums(prescription_new("empty"), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: empty prescription");
# Media: n_initial and n_after must be finite and positive.
rf = aberr_sums(_one(f64_from(10), n15, Z), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: n_initial 0");
rf = aberr_sums(_one(f64_from(10), n15, f64_neg(ONE)), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: n_initial -1");
rf = aberr_sums(_one(f64_from(10), n15, NAN), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: n_initial NaN");
rf = aberr_sums(_one(f64_from(10), n15, INF), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: n_initial inf");
rf = aberr_sums(_one(f64_from(10), Z, ONE), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: n_after 0");
rf = aberr_sums(_one(f64_from(10), NAN, ONE), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: n_after NaN");
rf = aberr_sums(_one(f64_from(10), INF, ONE), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: n_after inf");
# Radii: 0 and -0 have no curvature to take, NaN none at all.
rf = aberr_sums(_one(Z, n15, ONE), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: radius 0");
rf = aberr_sums(_one(0x8000000000000000, n15, ONE), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: radius -0");
rf = aberr_sums(_one(NAN, n15, ONE), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: radius NaN");
# A thickness is read only between surfaces: NaN there is refused, on the last it is ignored.
var th2 = prescription_add_surface(prescription_add_surface(prescription_new("t"), f64_from(20), NAN, n15, BIG),
  f64_from(0 - 20), Z, ONE, BIG);
rf = aberr_sums(th2, rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: thickness NaN between surfaces");
var th3 = prescription_add_surface(prescription_add_surface(prescription_new("t"), f64_from(20), F64_TWO, n15, BIG),
  f64_from(0 - 20), NAN, ONE, BIG);
rf = aberr_sums(th3, rm, rc, &e);
assert((rf != 0) & (e == PK_ERR_NONE), "sums: the last surface's thickness is not read");
# Rays.
rf = aberr_sums(P_TRIPLET, paraxial_ray_new(NAN, Z), rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: marginal y NaN");
rf = aberr_sums(P_TRIPLET, rm, paraxial_ray_new(Z, INF), &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: chief nu inf");
rf = aberr_sums(P_TRIPLET, rm, rm, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: chief = marginal, Lagrange invariant 0");
rf = aberr_sums(P_TRIPLET, paraxial_ray_new(Z, Z), rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: no aperture");
var tiny = 0x1ED0000000000000;                 # 2^-530: the Lagrange invariant 2^-1060 is subnormal
rf = aberr_sums(P_TRIPLET, paraxial_ray_new(tiny, Z), paraxial_ray_new(Z, tiny), &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: 1/H_L overflows");
rf = aberr_sums(P_TRIPLET, paraxial_ray_new(0x6974E718D7D7625A, Z), C_TRIPLET, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: a ray height of 1e200 overflows the series");
# An image at infinity: the plate leaves a parallel marginal ray parallel.
rf = aberr_sums(P_PLATE, paraxial_ray_new(f64_from(8), Z), C_PLATE, &e);
assert((rf == 0) & (e == PK_ERR_DIVISION_BY_ZERO), "sums: afocal image space");

# Accessors answer NaN for what they cannot name.
assert(_is_nan(aberr_third(0, ABERR_SYSTEM, 0)), "third: null handle");
assert(_is_nan(aberr_third(AB_TRIPLET, 7, 0)), "third: surface = count");
assert(_is_nan(aberr_third(AB_TRIPLET, 0 - 2, 0)), "third: surface -2");
assert(_is_nan(aberr_third(AB_TRIPLET, 0, 0 - 1)), "third: k = -1");
assert(_is_nan(aberr_third(AB_TRIPLET, 0, 5)), "third: k = 5");
assert(_is_nan(aberr_seidel(0, 0, 0)), "seidel: null handle");
assert(_is_nan(aberr_seidel(AB_TRIPLET, 0, 5)), "seidel: k = 5");
assert(_is_nan(aberr_fifth(0, ABERR_SYSTEM, 0, ABERR_TOTAL)), "fifth: null handle");
assert(_is_nan(aberr_fifth(AB_TRIPLET, 7, 0, ABERR_TOTAL)), "fifth: surface = count");
assert(_is_nan(aberr_fifth(AB_TRIPLET, 0, 12, ABERR_TOTAL)), "fifth: k = 12");
assert(_is_nan(aberr_fifth(AB_TRIPLET, 0, 0 - 1, ABERR_TOTAL)), "fifth: k = -1");
assert(_is_nan(aberr_fifth(AB_TRIPLET, 0, 0, 3)), "fifth: part 3");
assert(_is_nan(aberr_fifth(AB_TRIPLET, 0, 0, 0 - 1)), "fifth: part -1");
assert(aberr_fifth(AB_TRIPLET, 6, 0, ABERR_TOTAL) == f64_add(aberr_fifth(AB_TRIPLET, 6, 0, ABERR_INTRINSIC),
    aberr_fifth(AB_TRIPLET, 6, 0, ABERR_INDUCED)), "fifth: total = intrinsic + induced");

# aberr_transverse: NaN out and an error, never a value.
assert(aberr_transverse(AB_TRIPLET, Z, ONE, ONE, 5, 0) == PK_ERR_INVALID_PARAMETER, "transverse: null out");
store64(&tr, Z);
store64(&tr + 8, Z);
assert(aberr_transverse(0, Z, ONE, ONE, 5, &tr) == PK_ERR_INVALID_PARAMETER, "transverse: null handle");
assert(_is_nan(load64(&tr)) & _is_nan(load64(&tr + 8)), "transverse: null handle writes NaN");
assert(aberr_transverse(AB_TRIPLET, Z, ONE, ONE, 4, &tr) == PK_ERR_INVALID_PARAMETER, "transverse: order 4");
assert(_is_nan(load64(&tr + 8)), "transverse: order 4 writes NaN");
assert(aberr_transverse(AB_TRIPLET, NAN, ONE, ONE, 3, &tr) == PK_ERR_INVALID_PARAMETER, "transverse: px NaN");
assert(aberr_transverse(AB_TRIPLET, Z, ONE, INF, 5, &tr) == PK_ERR_INVALID_PARAMETER, "transverse: h inf");
assert(aberr_transverse(AB_TRIPLET, 0x7E37E43C8800759C, ONE, ONE, 5, &tr) == PK_ERR_INVALID_PARAMETER,
  "transverse: px = 1e300 overflows");
assert(aberr_transverse(AB_TRIPLET, Z, Z, Z, 5, &tr) == PK_ERR_NONE, "transverse: the paraxial image point");
assert((load64(&tr) == 0) & (load64(&tr + 8) == 0), "transverse: is no error at all");

# The ray helpers.
var hm = aberr_marginal_ray(P_TRIPLET, f64_neg(INF), 4, f64_from(4), &e);
assert((hm != 0) & (e == PK_ERR_NONE), "marginal: -inf is also infinity");
assert(ParaxialRay_y(hm) == ParaxialRay_y(M_TRIPLET), "marginal: -inf gives the +inf ray");
rf = aberr_marginal_ray(0, INF, 0, ONE, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "marginal: null prescription");
rf = aberr_marginal_ray(P_TRIPLET, INF, 0 - 1, ONE, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "marginal: stop -1");
rf = aberr_marginal_ray(P_TRIPLET, INF, 7, ONE, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "marginal: stop = count");
rf = aberr_marginal_ray(P_TRIPLET, INF, 4, Z, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "marginal: stop radius 0");
rf = aberr_marginal_ray(P_TRIPLET, INF, 4, f64_neg(ONE), &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "marginal: stop radius -1");
rf = aberr_marginal_ray(P_TRIPLET, INF, 4, NAN, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "marginal: stop radius NaN");
rf = aberr_marginal_ray(P_TRIPLET, INF, 4, INF, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "marginal: stop radius inf");
rf = aberr_marginal_ray(P_TRIPLET, NAN, 4, ONE, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "marginal: object distance NaN");
rf = aberr_marginal_ray(_one(Z, n15, ONE), INF, 0, ONE, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "marginal: an invalid prescription");
# A stop at the back focus of R = 50 into n = 1.5 (f' = 150 in the glass): an axial pencil
# from infinity has no edge there.
var bf = prescription_add_surface(prescription_add_surface(prescription_new("focus"), f64_from(50),
    f64_from(150), n15, BIG), INF, Z, n15, BIG);
rf = aberr_marginal_ray(bf, INF, 1, ONE, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "marginal: stop on the image of the object");
rf = aberr_chief_ray(bf, INF, _fd(1, 10), 1, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "chief: stop on the image of the object");
rf = aberr_chief_ray(P_TRIPLET, INF, Z, 4, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "chief: field 0");
rf = aberr_chief_ray(P_TRIPLET, INF, NAN, 4, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "chief: field NaN");
rf = aberr_chief_ray(P_TRIPLET, INF, INF, 4, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "chief: field inf");
rf = aberr_chief_ray(P_TRIPLET, INF, ONE, 7, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "chief: stop = count");
rf = aberr_chief_ray(0, INF, ONE, 0, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "chief: null prescription");
rf = aberr_chief_ray(P_TRIPLET, NAN, ONE, 4, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "chief: object distance NaN");
rf = aberr_sums(_one(f64_from(10), f64_neg(n15), ONE), rm, rc, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "sums: n_after -1.5");

# ── 2.14.0 review: what rounding and cancellation must not get past ────────
# R 30 into n = 1.6 focuses parallel light 80 behind it, and R -30 at 160 collimates it again:
# afocal. A thickness 1 ulp short of 160 leaves n'u' at -3.5e-18 rather than 0, and the first
# cut answered with an image 2.9e17 away and B = -2.5e12.
var n16 = _fd(8, 5);
var af = prescription_add_surface(prescription_add_surface(prescription_new("afocal"), f64_from(30),
    0x4063FFFFFFFFFFFF, n16, BIG), f64_from(0 - 30), Z, ONE, BIG);
rf = aberr_sums(af, paraxial_ray_new(ONE, Z), paraxial_ray_new(Z, _fd(1, 10)), &e);
assert((rf == 0) & (e == PK_ERR_DIVISION_BY_ZERO), "sums: afocal to within rounding is afocal");
# A stop 2 ulps short of that focus: the parallel marginal ray reaches it at -2.2e-16, and the
# first cut scaled that to a marginal ray 1.35e16 high.
var sf = prescription_add_surface(prescription_add_surface(prescription_new("stop near focus"), f64_from(30),
    0x4053FFFFFFFFFFFE, n16, BIG), INF, Z, n16, BIG);
rf = aberr_marginal_ray(sf, INF, 1, ONE, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "marginal: a stop on the focus to within rounding");
rf = aberr_chief_ray(sf, INF, _fd(1, 10), 1, &e);
assert((rf == 0) & (e == PK_ERR_INVALID_PARAMETER), "chief: a stop on the focus to within rounding");
# A distant finite object: the chief ray's height was field + d ub, two nearly equal terms, and
# came out 3.9% wrong at d = 1e15. Pinned to the exact ray (60 digits) for R 50/-50, t 5,
# n 1.5168, the stop on the rear vertex.
var dl = prescription_add_surface(prescription_add_surface(prescription_new("distant"), f64_from(50),
    f64_from(5), _fd(15168, 10000), BIG), f64_from(0 - 50), Z, ONE, BIG);
var dl1 = aberr_chief_ray(dl, 0x4197D78400000000, 0x416312D000000000, 1, &e);
_assert_near(ParaxialRay_y(dl1), 0x3FD5D759C6B53F5C, _fd(1, 100000000000000), "chief: d = 1e8, height");
var dl2 = aberr_chief_ray(dl, 0x426D1A94A2000000, 0x42374876E8000000, 1, &e);
_assert_near(ParaxialRay_y(dl2), 0x3FD5D759D3364787, _fd(1, 100000000000000), "chief: d = 1e12, height");
var dl3 = aberr_chief_ray(dl, 0x430C6BF526340000, 0x42D6BCC41E900000, 1, &e);
_assert_near(ParaxialRay_y(dl3), 0x3FD5D759D3369967, _fd(1, 100000000000000), "chief: d = 1e15, height");
_assert_near(ParaxialRay_nu(dl3), 0xBFB9999999999981, _fd(1, 1000000000000000), "chief: d = 1e15, slope");
# A stop at the back focus of the front surface, with a finite object, is telecentric in object
# space: the chief ray leaves the object parallel to the axis. It is accepted.
var tc = prescription_add_surface(prescription_add_surface(prescription_new("telecentric"), f64_from(50),
    f64_from(150), n15, BIG), INF, Z, n15, BIG);
var tcc = aberr_chief_ray(tc, f64_from(100), f64_from(5), 1, &e);
assert((tcc != 0) & (e == PK_ERR_NONE), "chief: object-space telecentric with a finite object is accepted");
assert(f64_eq(ParaxialRay_y(tcc), f64_from(5)) & f64_eq(ParaxialRay_nu(tcc), Z),
  "chief: telecentric: parallel to the axis at the object height");
# A zero is +0. The singlet's stop plane refracts nothing, and its image height is negative, so
# the first cut scaled its row to -0; the triplet's stop plane gave Seidel sums of -0.
var z_ok = 1;
for (var zk = 0; zk < 5; zk = zk + 1) {
    if (aberr_third(AB_SINGLET, 0, zk) != 0) { z_ok = 0; }
    if (aberr_seidel(AB_TRIPLET, 4, zk) != 0) { z_ok = 0; }
}
for (var zk5 = 0; zk5 < 12; zk5 = zk5 + 1) {
    if (aberr_fifth(AB_SINGLET, 0, zk5, ABERR_INTRINSIC) != 0) { z_ok = 0; }
    if (aberr_fifth(AB_SINGLET, 0, zk5, ABERR_INDUCED) != 0) { z_ok = 0; }
}
assert(z_ok == 1, "a row that refracts nothing is +0, and so are its Seidel sums");
assert(aberr_transverse(AB_SINGLET, Z, Z, Z, 3, &tr) == PK_ERR_NONE, "transverse: singlet image point");
assert((load64(&tr) == 0) & (load64(&tr + 8) == 0), "transverse: +0 at the paraxial image point");

var r = assert_summary();

