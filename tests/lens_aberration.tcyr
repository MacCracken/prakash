# lens_aberration test suite — the third- and fifth-order sums of a surface sequence (2.14.0).
#
# References, none of them this code:
# - A 100-digit real-ray trace: 3D vector refraction at each sphere (the vertex cap of the full
#   sphere, Snell in vector form), not the tangent-plane expansion the module uses. From it, by
#   Richardson extrapolation in the scale s of (rho, H): the system's coefficients, from where
#   rays meet the paraxial image plane; each surface's whole contribution, from the change in
#   the ray's coordinates across it; and its intrinsic part, from that surface alone fed the
#   paraxial line rho m + H c. The induced part is the difference. Every input is the exact
#   value of the double passed here.
# - Welford's closed-form per-surface Seidel sums, in the same 100 digits.
# - Closed forms that share nothing with either: a plane-parallel plate in a converging beam,
#   whose transverse spherical aberration is -(d/N) T (1 - (1 + (1 - 1/N^2) T^2)^(-1/2)) at
#   direction tangent T, and an aplanatic surface, where spherical aberration and the coma
#   linear in the field vanish to every order.
# - The library's own real-ray trace (ray_trace's trace_sequential): what is left of a real
#   ray's error after the third and fifth order are taken away halves 2^7 times when the ray's
#   pupil and field coordinates halve. A fifth order that is wrong leaves 2^5.
# - Symmetries: doubling every length doubles every coefficient exactly, and turning the chief
#   or the marginal ray around flips the terms odd in H or rho.

include "src/error.cyr"
include "src/ray_core.cyr"
include "src/ray_fresnel.cyr"
include "src/ray_trace.cyr"
include "src/ray_system.cyr"
include "src/lens_aberration.cyr"

fn _fd(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _near(a, b, tol) { return f64_le(f64_abs(f64_sub(a, b)), tol); }
fn _assert_near(a, b, tol, msg) { assert(_near(a, b, tol), msg); }
fn _is_nan(x) { return (x & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000; }
fn _sq(x) { return f64_mul(x, x); }

var Z = f64_from(0);
var ONE = F64_ONE;
var INF = 0x7FF0000000000000;
var NAN = 0x7FF8000000000000;
var BIG = f64_from(100);                       # every aperture: no test ray is clipped
var AX = 0x7FFFFFFFFFFFFFFF;                   # clears the sign bit: a zero of either sign
# Tolerances are a factor times the largest coefficient of that order in the system, since a
# small coefficient is a cancellation of large surface terms. Measured worst, over the six
# systems, as a fraction of that size: third 1.3e-15,
# fifth 1.2e-14, Seidel sums 1.3e-15, transverse values 1.4e-14, paraxial rays 1.5e-16, image data 8e-16.
var F3 = _fd(4, 1000000000000000);             # 4e-15: third order and the Seidel sums
var F5 = _fd(4, 100000000000000);              # 4e-14: fifth order and the transverse values
var FR = _fd(1, 1000000000000000);             # 1e-15: the paraxial rays and image data

alloc_init();

# triplet: n0 = 1.0, object at infinity, field 0.36397023426620234, stop on surface 4, radius 4.0
fn _p_triplet() {
    var p = prescription_new("triplet");
    # R 22.0, t 3.5, n 1.6204
    p = prescription_add_surface(p, 0x4036000000000000, 0x400C000000000000, 0x3FF9ED288CE703B0, BIG);
    # R -435.0, t 4.0, n 1.0
    p = prescription_add_surface(p, 0xC07B300000000000, 0x4010000000000000, 0x3FF0000000000000, BIG);
    # R -22.0, t 1.0, n 1.6475
    p = prescription_add_surface(p, 0xC036000000000000, 0x3FF0000000000000, 0x3FFA5C28F5C28F5C, BIG);
    # R 20.0, t 2.0, n 1.0
    p = prescription_add_surface(p, 0x4034000000000000, 0x4000000000000000, 0x3FF0000000000000, BIG);
    # R plane, t 2.0, n 1.0
    p = prescription_add_surface(p, 0x7FF0000000000000, 0x4000000000000000, 0x3FF0000000000000, BIG);
    # R 79.0, t 3.0, n 1.6204
    p = prescription_add_surface(p, 0x4053C00000000000, 0x4008000000000000, 0x3FF9ED288CE703B0, BIG);
    # R -18.0, t 0.0, n 1.0
    p = prescription_add_surface(p, 0xC032000000000000, 0x0000000000000000, 0x3FF0000000000000, BIG);
    return p;
}

# singlet: n0 = 1.0, object 150.0, field 12.0, stop on surface 0, radius 5.0
fn _p_singlet() {
    var p = prescription_new("singlet");
    # R plane, t 10.0, n 1.0
    p = prescription_add_surface(p, 0x7FF0000000000000, 0x4024000000000000, 0x3FF0000000000000, BIG);
    # R 40.0, t 5.0, n 1.5168
    p = prescription_add_surface(p, 0x4044000000000000, 0x4014000000000000, 0x3FF844D013A92A30, BIG);
    # R -60.0, t 0.0, n 1.0
    p = prescription_add_surface(p, 0xC04E000000000000, 0x0000000000000000, 0x3FF0000000000000, BIG);
    return p;
}

# doublet: n0 = 1.0, object at infinity, field 0.05240777928304121, stop on surface 0, radius 10.0
fn _p_doublet() {
    var p = prescription_new("doublet");
    # R 61.07, t 4.0, n 1.5168
    p = prescription_add_surface(p, 0x404E88F5C28F5C29, 0x4010000000000000, 0x3FF844D013A92A30, BIG);
    # R -44.5, t 2.5, n 1.62
    p = prescription_add_surface(p, 0xC046400000000000, 0x4004000000000000, 0x3FF9EB851EB851EC, BIG);
    # R -128.0, t 0.0, n 1.0
    p = prescription_add_surface(p, 0xC060000000000000, 0x0000000000000000, 0x3FF0000000000000, BIG);
    return p;
}

# immersed: n0 = 1.333, object 60.0, field 4.0, stop on surface 0, radius 6.0
fn _p_immersed() {
    var p = prescription_new("immersed");
    p = prescription_with_initial_medium(p, 0x3FF553F7CED91687);
    # R 15.0, t 0.0, n 1.7
    p = prescription_add_surface(p, 0x402E000000000000, 0x0000000000000000, 0x3FFB333333333333, BIG);
    return p;
}

# aplanat: n0 = 1.0, object -25.0, field 1.0, stop on surface 0, radius 3.0
fn _p_aplanat() {
    var p = prescription_new("aplanat");
    # R 10.0, t 0.0, n 1.5
    p = prescription_add_surface(p, 0x4024000000000000, 0x0000000000000000, 0x3FF8000000000000, BIG);
    return p;
}

# remote: n0 = 1.333, object 60.0, field 3.0, stop on surface 2, radius 2.0
fn _p_remote() {
    var p = prescription_new("remote");
    p = prescription_with_initial_medium(p, 0x3FF553F7CED91687);
    # R 15.0, t 6.0, n 1.7
    p = prescription_add_surface(p, 0x402E000000000000, 0x4018000000000000, 0x3FFB333333333333, BIG);
    # R -40.0, t 4.0, n 1.0
    p = prescription_add_surface(p, 0xC044000000000000, 0x4010000000000000, 0x3FF0000000000000, BIG);
    # R plane, t 30.0, n 1.0
    p = prescription_add_surface(p, 0x7FF0000000000000, 0x403E000000000000, 0x3FF0000000000000, BIG);
    # R 25.0, t 4.0, n 1.6
    p = prescription_add_surface(p, 0x4039000000000000, 0x4010000000000000, 0x3FF999999999999A, BIG);
    # R -80.0, t 0.0, n 1.0
    p = prescription_add_surface(p, 0xC054000000000000, 0x0000000000000000, 0x3FF0000000000000, BIG);
    return p;
}

# plate: n0 = 1.0, object -50.0, field 2.0, stop on surface 0, radius 8.0
fn _p_plate() {
    var p = prescription_new("plate");
    # R plane, t 10.0, n 1.5
    p = prescription_add_surface(p, 0x7FF0000000000000, 0x4024000000000000, 0x3FF8000000000000, BIG);
    # R plane, t 0.0, n 1.0
    p = prescription_add_surface(p, 0x7FF0000000000000, 0x0000000000000000, 0x3FF0000000000000, BIG);
    return p;
}

# eps (2 f64) at the paraxial image plane for the real ray rho_vec m + h c, rho_vec = (px, py),
# traced by trace_sequential from one unit in front of the first vertex. Returns its error code.
fn _real_eps(p, ab, m, c, px, py, h, out) {
    var n0 = Prescription_n_initial(p);
    var u0 = f64_div(ParaxialRay_nu(m), n0);
    var ub = f64_div(ParaxialRay_nu(c), n0);
    var x = f64_mul(px, ParaxialRay_y(m));
    var y = f64_add(f64_mul(py, ParaxialRay_y(m)), f64_mul(h, ParaxialRay_y(c)));
    var tx = f64_mul(px, u0);
    var ty = f64_add(f64_mul(py, u0), f64_mul(h, ub));
    var nrm = f64_sqrt(f64_add(ONE, f64_add(_sq(tx), _sq(ty))));
    var ray = trace_ray_new(ray_vec3(f64_sub(x, tx), f64_sub(y, ty), f64_neg(ONE)),
      ray_vec3(f64_div(tx, nrm), f64_div(ty, nrm), f64_div(ONE, nrm)), n0);
    var e = 0;
    var hits = trace_sequential(ray, prescription_to_trace_surfaces(p), &e);
    if (e != PK_ERR_NONE) { return e; }
    var last = TraceHit_ray_after(vec_get(hits, vec_len(hits) - 1));
    var pos = TraceRay_pos(last);
    var dir = TraceRay_dir(last);
    var surfs = Prescription_surfaces(p);
    var z = Z;
    for (var j = 0; j + 1 < vec_len(surfs); j = j + 1) {
        z = f64_add(z, PrescriptionSurface_thickness(vec_get(surfs, j)));
    }
    z = f64_add(z, AberrSums_image_distance(ab));
    var t = f64_div(f64_sub(z, RayVec3_z(pos)), RayVec3_z(dir));
    store64(out, f64_add(RayVec3_x(pos), f64_mul(t, RayVec3_x(dir))));
    store64(out + 8, f64_sub(f64_add(RayVec3_y(pos), f64_mul(t, RayVec3_y(dir))),
        f64_mul(h, AberrSums_image_height(ab))));
    return e;
}

# The real ray's error at scale s, less the expansion to `order` (3 or 5), component comp.
fn _resid(p, ab, m, c, px, py, h, s, order, comp) {
    var re[16];
    var ex[16];
    var sx = f64_mul(s, px);
    var sy = f64_mul(s, py);
    var sh = f64_mul(s, h);
    if (_real_eps(p, ab, m, c, sx, sy, sh, &re) != PK_ERR_NONE) { return NAN; }
    if (aberr_transverse(ab, sx, sy, sh, order, &ex) != PK_ERR_NONE) { return NAN; }
    return f64_sub(load64(&re + comp * 8), load64(&ex + comp * 8));
}

# How much the residual after the fifth order shrinks when (rho, H) halves from s: 2^7 if the
# fifth order is right.
fn _ratio7(p, ab, m, c, px, py, h, s, comp) {
    return f64_div(_resid(p, ab, m, c, px, py, h, s, 5, comp),
      _resid(p, ab, m, c, px, py, h, f64_mul(F64_HALF, s), 5, comp));
}

# 1 if, at s = 1/10, the real ray's error less the third order is the fifth order to 2%.
fn _fifth_ok(p, ab, m, c, px, py, h, comp) {
    var s = _fd(1, 10);
    var r3 = _resid(p, ab, m, c, px, py, h, s, 3, comp);
    var e5 = f64_sub(r3, _resid(p, ab, m, c, px, py, h, s, 5, comp));
    return _near(r3, e5, f64_mul(_fd(2, 100), f64_abs(e5)));
}

var e = 0;
var tr[16];

# ── triplet ────────
test_group("triplet");
var P_TRIPLET = _p_triplet();
var M_TRIPLET = paraxial_ray_new(0x40129B96CA52E45D, 0x0000000000000000);
var C_TRIPLET = paraxial_ray_new(0xC0105C47E5BEA1AC, 0x3FD74B49CF3902D4);
var S3_TRIPLET = 0x3FFF6EB944E188A8;   # largest third-order surface term
var S5_TRIPLET = 0x3FDAFE1B7BABAF53;   # largest fifth-order surface term
var SS_TRIPLET = 0x3FD5069CE8E3000E;   # largest Seidel surface term
var SR_TRIPLET = 0x40129B96CA52E45D;   # largest paraxial ray value
# The paraxial rays from the stop, against the 100-digit construction (the pins below use
# its doubles).
var hm_triplet = aberr_marginal_ray(P_TRIPLET, 0x7FF0000000000000, 4, 0x4010000000000000, &e);
assert(e == PK_ERR_NONE, "triplet: marginal ray");
var hc_triplet = aberr_chief_ray(P_TRIPLET, 0x7FF0000000000000, 0x3FD74B49CF3902D4, 4, &e);
assert(e == PK_ERR_NONE, "triplet: chief ray");
_assert_near(ParaxialRay_y(hm_triplet), 0x40129B96CA52E45D, f64_mul(FR, SR_TRIPLET), "triplet: marginal y");
_assert_near(ParaxialRay_nu(hm_triplet), 0x0000000000000000, f64_mul(FR, SR_TRIPLET), "triplet: marginal nu");
_assert_near(ParaxialRay_y(hc_triplet), 0xC0105C47E5BEA1AC, f64_mul(FR, SR_TRIPLET), "triplet: chief y");
_assert_near(ParaxialRay_nu(hc_triplet), 0x3FD74B49CF3902D4, f64_mul(FR, SR_TRIPLET), "triplet: chief nu");
var AB_TRIPLET = aberr_sums(P_TRIPLET, M_TRIPLET, C_TRIPLET, &e);
assert(e == PK_ERR_NONE, "triplet: sums");
assert(AberrSums_count(AB_TRIPLET) == 7, "triplet: count");
_assert_near(AberrSums_lagrange(AB_TRIPLET), 0x3FFB1737EC8AC45B, f64_mul(F3, 0x3FFB1737EC8AC45B), "triplet: lagrange");
_assert_near(AberrSums_image_height(AB_TRIPLET), 0x40343FE4CAFEDFC2, f64_mul(F3, 0x40343FE4CAFEDFC2),
  "triplet: image_height");
_assert_near(AberrSums_image_distance(AB_TRIPLET), 0x4049D07532C468E1, f64_mul(F3, 0x4049D07532C468E1),
  "triplet: image_distance");
_assert_near(AberrSums_image_nu(AB_TRIPLET), 0xBFB567CA86CBBAB8, f64_mul(F3, 0x3FB567CA86CBBAB8), "triplet: image_nu");
# The system, against where the 100-digit rays meet the paraxial image plane.
_assert_near(aberr_third(AB_TRIPLET, ABERR_SYSTEM, ABERR3_B), 0x3FA42ADE2C04493C, f64_mul(F3, S3_TRIPLET),
  "triplet: B");
_assert_near(aberr_third(AB_TRIPLET, ABERR_SYSTEM, ABERR3_F), 0x3F937DE3DF4571FB, f64_mul(F3, S3_TRIPLET),
  "triplet: F");
_assert_near(aberr_third(AB_TRIPLET, ABERR_SYSTEM, ABERR3_C), 0x3FA6F2A28DA235F6, f64_mul(F3, S3_TRIPLET),
  "triplet: C");
_assert_near(aberr_third(AB_TRIPLET, ABERR_SYSTEM, ABERR3_PI), 0xBFBE36C90BE5716B, f64_mul(F3, S3_TRIPLET),
  "triplet: PI");
_assert_near(aberr_third(AB_TRIPLET, ABERR_SYSTEM, ABERR3_E), 0xBFCB5CE2161F5541, f64_mul(F3, S3_TRIPLET),
  "triplet: E");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_B5, ABERR_TOTAL), 0x3F94392F1E7B3B45,
  f64_mul(F5, S5_TRIPLET), "triplet: B5");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_F1, ABERR_TOTAL), 0x3F6A5F667E4853C1,
  f64_mul(F5, S5_TRIPLET), "triplet: F1");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_F2, ABERR_TOTAL), 0x3F60939203EDE7D0,
  f64_mul(F5, S5_TRIPLET), "triplet: F2");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_M1, ABERR_TOTAL), 0x3F9664E5D770F2BC,
  f64_mul(F5, S5_TRIPLET), "triplet: M1");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_M2, ABERR_TOTAL), 0x3F985EBFCD72CAD2,
  f64_mul(F5, S5_TRIPLET), "triplet: M2");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_M3, ABERR_TOTAL), 0x3F9188C6062B2B09,
  f64_mul(F5, S5_TRIPLET), "triplet: M3");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_N1, ABERR_TOTAL), 0xBF9772F3CCEA369B,
  f64_mul(F5, S5_TRIPLET), "triplet: N1");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_N2, ABERR_TOTAL), 0xBFB345BAAFE02D5E,
  f64_mul(F5, S5_TRIPLET), "triplet: N2");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_N3, ABERR_TOTAL), 0xBF9983BB35DE0F08,
  f64_mul(F5, S5_TRIPLET), "triplet: N3");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_C5, ABERR_TOTAL), 0x3F41FBFD26EFB0EB,
  f64_mul(F5, S5_TRIPLET), "triplet: C5");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_PI5, ABERR_TOTAL), 0x3FA9D960F6D826B8,
  f64_mul(F5, S5_TRIPLET), "triplet: PI5");
_assert_near(aberr_fifth(AB_TRIPLET, ABERR_SYSTEM, ABERR5_E5, ABERR_TOTAL), 0xBF93F8F542C6E503,
  f64_mul(F5, S5_TRIPLET), "triplet: E5");
_assert_near(aberr_seidel(AB_TRIPLET, ABERR_SYSTEM, 0), 0xBF7AFB16D71DB75A, f64_mul(F3, SS_TRIPLET),
  "triplet: system S_I");
_assert_near(aberr_seidel(AB_TRIPLET, ABERR_SYSTEM, 1), 0xBF6A13AC398BDC95, f64_mul(F3, SS_TRIPLET),
  "triplet: system S_II");
_assert_near(aberr_seidel(AB_TRIPLET, ABERR_SYSTEM, 2), 0xBF7EB351C8ED2ACB, f64_mul(F3, SS_TRIPLET),
  "triplet: system S_III");
_assert_near(aberr_seidel(AB_TRIPLET, ABERR_SYSTEM, 3), 0x3F9435F38007BDC5, f64_mul(F3, SS_TRIPLET),
  "triplet: system S_IV");
_assert_near(aberr_seidel(AB_TRIPLET, ABERR_SYSTEM, 4), 0x3FA24DB483D21813, f64_mul(F3, SS_TRIPLET),
  "triplet: system S_V");
# Each surface: its third order, Welford's Seidel sums, and its fifth order split.
_assert_near(aberr_third(AB_TRIPLET, 0, ABERR3_B), 0xBFAFD1068BC0E6C8, f64_mul(F3, S3_TRIPLET), "triplet 0: B");
_assert_near(aberr_third(AB_TRIPLET, 0, ABERR3_F), 0xBFAACA9F44AA8181, f64_mul(F3, S3_TRIPLET), "triplet 0: F");
_assert_near(aberr_third(AB_TRIPLET, 0, ABERR3_C), 0xBFA68F63CA98AFC9, f64_mul(F3, S3_TRIPLET), "triplet 0: C");
_assert_near(aberr_third(AB_TRIPLET, 0, ABERR3_PI), 0xBFD318059839287A, f64_mul(F3, S3_TRIPLET), "triplet 0: PI");
_assert_near(aberr_third(AB_TRIPLET, 0, ABERR3_E), 0xBFD273ED058E52F0, f64_mul(F3, S3_TRIPLET), "triplet 0: E");
_assert_near(aberr_seidel(AB_TRIPLET, 0, 0), 0x3F85485E7647999C, f64_mul(F3, SS_TRIPLET), "triplet 0: S_I");
_assert_near(aberr_seidel(AB_TRIPLET, 0, 1), 0x3F81EBDE459D57E7, f64_mul(F3, SS_TRIPLET), "triplet 0: S_II");
_assert_near(aberr_seidel(AB_TRIPLET, 0, 2), 0x3F7E2E8B9CACA1B5, f64_mul(F3, SS_TRIPLET), "triplet 0: S_III");
_assert_near(aberr_seidel(AB_TRIPLET, 0, 3), 0x3FA98B63ABF1E55B, f64_mul(F3, SS_TRIPLET), "triplet 0: S_IV");
_assert_near(aberr_seidel(AB_TRIPLET, 0, 4), 0x3FA8AFDAF024CE6B, f64_mul(F3, SS_TRIPLET), "triplet 0: S_V");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_B5, ABERR_INTRINSIC), 0xBF5A13267515A2A8, f64_mul(F5, S5_TRIPLET),
  "triplet 0: B5 intrinsic");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_B5, ABERR_INDUCED), 0x0000000000000000, f64_mul(F5, S5_TRIPLET),
  "triplet 0: B5 induced");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_F1, ABERR_INTRINSIC), 0xBF696F4E4A0B71F1, f64_mul(F5, S5_TRIPLET),
  "triplet 0: F1 intrinsic");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_F1, ABERR_INDUCED), 0x2C417C53D9A9C65A, f64_mul(F5, S5_TRIPLET),
  "triplet 0: F1 induced");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_F2, ABERR_INTRINSIC), 0xBF5CE9B77865E890, f64_mul(F5, S5_TRIPLET),
  "triplet 0: F2 intrinsic");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_F2, ABERR_INDUCED), 0x0000000000000000, f64_mul(F5, S5_TRIPLET),
  "triplet 0: F2 induced");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_M1, ABERR_INTRINSIC), 0xBF6858B59F18A89D, f64_mul(F5, S5_TRIPLET),
  "triplet 0: M1 intrinsic");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_M1, ABERR_INDUCED), 0xAC625307A4239610, f64_mul(F5, S5_TRIPLET),
  "triplet 0: M1 induced");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_M2, ABERR_INTRINSIC), 0xBF77CB007486D613, f64_mul(F5, S5_TRIPLET),
  "triplet 0: M2 intrinsic");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_M2, ABERR_INDUCED), 0x0000000000000000, f64_mul(F5, S5_TRIPLET),
  "triplet 0: M2 induced");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_M3, ABERR_INTRINSIC), 0x3F7BDC7DB23F7E35, f64_mul(F5, S5_TRIPLET),
  "triplet 0: M3 intrinsic");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_M3, ABERR_INDUCED), 0x0000000000000000, f64_mul(F5, S5_TRIPLET),
  "triplet 0: M3 induced");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_N1, ABERR_INTRINSIC), 0xBF7409015E179855, f64_mul(F5, S5_TRIPLET),
  "triplet 0: N1 intrinsic");
_assert_near(aberr_fifth(AB_TRIPLET, 0, ABERR5_N1, ABERR_INDUCED), 0x2C3E6B240B8D7258, f64_mul(F5, S5_TRIPLET),
  "triplet 0: N1 induced");
