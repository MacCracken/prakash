  "aplanat 0: N1 intrinsic");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_N1, ABERR_INDUCED), 0x2D45EC63668D916D, f64_mul(F5, S5_APLANAT),
  "aplanat 0: N1 induced");
_assert_near(aberr_fifth(AB_APLANAT, 0, ABERR5_N2, ABERR_INTRINSIC), 0xBEDDD37F5698C2C3, f64_mul(F5, S5_APLANAT),
