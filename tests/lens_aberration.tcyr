assert(aberr_transverse(AB_PLATE, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 3, &tr) == PK_ERR_NONE,
  "plate: transverse (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 0), 0xBF34F8B588E368F1, f64_mul(F5, 0x3F74D051CC737A14),
  "plate: eps_x (-0.3, 0.4, 0.7) order 3");
_assert_near(load64(&tr + 8), 0x3F2F75104D551D69, f64_mul(F5, 0x3F74D051CC737A14),
  "plate: eps_y (-0.3, 0.4, 0.7) order 3");
assert(aberr_transverse(AB_PLATE, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 5, &tr) == PK_ERR_NONE,
  "plate: transverse (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 0), 0xBF34F0A7F34E96BC, f64_mul(F5, 0x3F74D051CC737A14),
  "plate: eps_x (-0.3, 0.4, 0.7) order 5");
_assert_near(load64(&tr + 8), 0x3F2F68FBECF5E21A, f64_mul(F5, 0x3F74D051CC737A14),
  "plate: eps_y (-0.3, 0.4, 0.7) order 5");

# ── The roadmap's pin: the real-ray residual ────────
test_group("real rays");
var rr_triplet_0_x = _ratio7(P_TRIPLET, AB_TRIPLET, M_TRIPLET, C_TRIPLET, 0x3FE3333333333333, 0x3FE999999999999A,
  0x3FF0000000000000, _fd(1, 5), 0);
_assert_near(rr_triplet_0_x, f64_from(128), f64_from(8),
  "triplet: (0.6, 0.8, 1) eps_x less orders 3 and 5 is of order 7: x128 a halving");
var rr_triplet_0_y = _ratio7(P_TRIPLET, AB_TRIPLET, M_TRIPLET, C_TRIPLET, 0x3FE3333333333333, 0x3FE999999999999A,
  0x3FF0000000000000, _fd(1, 5), 1);
_assert_near(rr_triplet_0_y, f64_from(128), f64_from(8),
  "triplet: (0.6, 0.8, 1) eps_y less orders 3 and 5 is of order 7: x128 a halving");
