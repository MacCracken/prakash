  "doublet: eps_y (0, 1, 0.5) order 5");
assert(aberr_transverse(AB_DOUBLET, 0xBFD3333333333333, 0x3FD999999999999A, 0x3FE6666666666666, 3, &tr) == PK_ERR_NONE,
  "doublet: transverse (-0.3, 0.4, 0.7) order 3");
