  "aplanat 0: E5 induced");
# The expansion evaluated at three pupil and field points.
assert(aberr_transverse(AB_APLANAT, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 3, &tr) == PK_ERR_NONE,
  "aplanat: transverse (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 0), 0xBF4179EC9CBD8222, f64_mul(F5, 0x3F4EBFBE223B7BA0),
  "aplanat: eps_x (0.6, 0.8, 1) order 3");
_assert_near(load64(&tr + 8), 0xBF4DC63DC8AB298E, f64_mul(F5, 0x3F4EBFBE223B7BA0),
  "aplanat: eps_y (0.6, 0.8, 1) order 3");
assert(aberr_transverse(AB_APLANAT, 0x3FE3333333333333, 0x3FE999999999999A, 0x3FF0000000000000, 5, &tr) == PK_ERR_NONE,
  "aplanat: transverse (0.6, 0.8, 1) order 5");
_assert_near(load64(&tr + 0), 0xBF420C5EE79237DE, f64_mul(F5, 0x3F4EBFBE223B7BA0),
  "aplanat: eps_x (0.6, 0.8, 1) order 5");
