# serialize test suite — serde roundtrips for the 7 types that had serde_json
# roundtrip tests in Rust (Rgb, Medium, SellmeierCoefficients, LensType,
# Polarization, Prescription, Spd). Roundtrips are checked to ~1e-5, not
# serde's bit-exact.
#
# ⚠ THE STATED REASON FOR THAT TOLERANCE IS OBSOLETE. It read "bayan renders
# floats to 6 decimals", which stopped being true at bayan 1.2.1 — that release
# replaced the 6-decimal renderer with round-trip-correct Grisu2 and fixed a
# real data-loss bug (the old encoder flushed any |x| < 5e-7 to zero). The
# encoder is bit-exact now, so ~1e-5 is a LOOSE tolerance that would not catch a
# renderer regression, not a tight one forced by the encoder. Verified unchanged
# by the 2.2.4 bump: the 6.5.20 -> 6.5.33 bayan diff has no hunk in the Grisu2
# region, so no JSON byte moves. Tightening these to bit-exact is worth doing;
# it is a test change, not a bump change.

include "src/error.cyr"
include "src/spectral_core.cyr"
include "src/ray_core.cyr"
include "src/ray_fresnel.cyr"
include "src/ray_trace.cyr"
include "src/ray_dispersion.cyr"
include "src/ray_system.cyr"
include "src/wave_core.cyr"
include "src/spectral_cie.cyr"
include "src/lens.cyr"
include "src/serialize.cyr"

fn _fd(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }
fn _assert_near(a, b, tol, msg) { assert(_near(a, b, tol), msg); }

var TOL = f64_div(F64_ONE, f64_from(100000));   # 1e-5
# 2.1.0: every *_from_json takes a trailing err_out. Reuse one slot and assert
# PK_ERR_NONE after each decode, so a silent failure cannot pass as a roundtrip.
var e = 0;

alloc_init();

# ── Rgb ────────
test_group("rgb");

var c = rgb_new(_fd(1, 10), _fd(2, 10), _fd(3, 10));
var cjs = rgb_to_json(c);
var cback = rgb_from_json(str_data(cjs), str_len(cjs), &e);
assert_eq(e, PK_ERR_NONE, "rgb decode reports PK_ERR_NONE");
_assert_near(Rgb_r(cback), _fd(1, 10), TOL, "rgb r roundtrip");
_assert_near(Rgb_g(cback), _fd(2, 10), TOL, "rgb g roundtrip");
_assert_near(Rgb_b(cback), _fd(3, 10), TOL, "rgb b roundtrip");

# ── Medium ────────
test_group("medium");

var m = medium_glass();
var mjs = medium_to_json(m);
var mback = medium_from_json(str_data(mjs), str_len(mjs), &e);
assert_eq(e, PK_ERR_NONE, "medium decode reports PK_ERR_NONE");
_assert_near(Medium_n(mback), _fd(152, 100), TOL, "medium n roundtrip = 1.52");
assert(streq(Medium_name(mback), "glass") == 1, "medium name roundtrip = glass");

# ── SellmeierCoefficients ────────
test_group("sellmeier");

var s = sellmeier_bk7();
var sjs = sellmeier_to_json(s);
var sback = sellmeier_from_json(str_data(sjs), str_len(sjs), &e);
assert_eq(e, PK_ERR_NONE, "sellmeier decode reports PK_ERR_NONE");
_assert_near(SellmeierCoefficients_b1(sback), SellmeierCoefficients_b1(s), TOL, "sellmeier b1");
_assert_near(SellmeierCoefficients_c1(sback), SellmeierCoefficients_c1(s), TOL, "sellmeier c1");
_assert_near(SellmeierCoefficients_b2(sback), SellmeierCoefficients_b2(s), TOL, "sellmeier b2");
_assert_near(SellmeierCoefficients_c2(sback), SellmeierCoefficients_c2(s), TOL, "sellmeier c2");
_assert_near(SellmeierCoefficients_b3(sback), SellmeierCoefficients_b3(s), TOL, "sellmeier b3");
_assert_near(SellmeierCoefficients_c3(sback), SellmeierCoefficients_c3(s), TOL, "sellmeier c3");

# ── LensType ────────
test_group("lens_type");

var conv_js = lens_type_to_json(LENS_CONVERGING);
assert_eq(lens_type_from_json(str_data(conv_js), str_len(conv_js), &e), LENS_CONVERGING, "converging roundtrip");
var div_js = lens_type_to_json(LENS_DIVERGING);
assert_eq(lens_type_from_json(str_data(div_js), str_len(div_js), &e), LENS_DIVERGING, "diverging roundtrip");
assert_eq(e, PK_ERR_NONE, "lens_type decode reports PK_ERR_NONE");
# wire format check: serializes to the bare variant string
assert(streq(str_data(conv_js), "\"Converging\"") == 1, "converging wire format");

# ── Polarization ────────
test_group("polarization");

var p = polarization_circular_right();
var pjs = polarization_to_json(p);
var pback = polarization_from_json(str_data(pjs), str_len(pjs), &e);
assert_eq(e, PK_ERR_NONE, "polarization decode reports PK_ERR_NONE");
_assert_near(Polarization_ex(pback), Polarization_ex(p), TOL, "polarization ex roundtrip");
_assert_near(Polarization_ey(pback), Polarization_ey(p), TOL, "polarization ey roundtrip");
_assert_near(Polarization_phase(pback), Polarization_phase(p), TOL, "polarization phase roundtrip");

# ── Prescription ────────
test_group("prescription");

var pr = prescription_new("test lens");
var _s1 = prescription_add_surface(pr, f64_from(50), f64_from(3), _fd(152, 100), _fd(125, 10));
var _s2 = prescription_add_surface(pr, f64_neg(f64_from(50)), f64_from(0), F64_ONE, _fd(125, 10));
var prjs = prescription_to_json(pr);
var prback = prescription_from_json(str_data(prjs), str_len(prjs), &e);
assert_eq(e, PK_ERR_NONE, "prescription decode reports PK_ERR_NONE");
assert(streq(Prescription_name(prback), "test lens") == 1, "prescription name roundtrip");
assert_eq(prescription_len(prback), 2, "prescription surfaces len = 2");
_assert_near(PrescriptionSurface_radius(vec_get(Prescription_surfaces(prback), 0)), f64_from(50), TOL,
  "prescription surface[0] radius = 50");
_assert_near(PrescriptionSurface_n_after(vec_get(Prescription_surfaces(prback), 0)), _fd(152, 100), TOL,
  "prescription surface[0] n_after = 1.52");

# ── Spd ────────
test_group("spd");

var d65 = illuminant_d65();
var djs = spd_to_json(d65);
var dback = spd_from_json(str_data(djs), str_len(djs), &e);
assert_eq(e, PK_ERR_NONE, "spd decode reports PK_ERR_NONE");
# ⚠ Guard the handle before dereferencing it. `spd_from_json` documents 0 as its
# failure return, and the four accessors below would read straight off address 0 —
# so a decode regression used to take the whole suite down with SIGSEGV instead of
# reporting, and the surviving assertions never ran. Found while mutation-testing
# the wire-format pins in 2.3.4: both mutants failed correctly AND then crashed,
# which is a much worse diagnostic than a named assertion.
assert(dback != 0, "spd decode returns a handle");
if (dback != 0) {
    assert_eq(Spd_len(dback), 81, "spd values len = 81");
    _assert_near(load64(Spd_values(dback)), load64(Spd_values(d65)), TOL, "spd values[0] roundtrip");
    _assert_near(Spd_start_nm(dback), Spd_start_nm(d65), TOL, "spd start_nm roundtrip");
}

# ── Every wire format, pinned to exact bytes ────────
#
# ⚠ 2.3.5 rewrote the remaining six *_to_json functions off bayan's value tree
# onto a str_builder (2.3.4 did spd). Byte-identity was verified against faithful
# clones of the tree forms across 20 fixtures — ordinary values, non-finite
# floats, every JSON escape class, empty names, empty/one/six-surface
# prescriptions and all five null sentinels, 0 mismatches — but that harness was a
# throwaway. THESE assertions are what survives to guard the format from here on.
#
# The wire format is a published contract: consumers and other languages parse it.
# A round-trip test cannot guard it, because prakash's own decoder would happily
# accept a format only prakash emits.
assert_eq(streq(str_data(rgb_to_json(rgb_new(_fd(1, 10), _fd(2, 10), _fd(3, 10)))),
    "{\"r\":0.1,\"g\":0.2,\"b\":0.3}"), 1, "rgb wire format");
assert_eq(streq(str_data(medium_to_json(medium_glass())),
    "{\"n\":1.52,\"name\":\"glass\"}"), 1, "medium wire format");
var w_sell = str_builder_new();
str_builder_add_cstr(w_sell, "{\"b1\":1.03961212,\"c1\":0.00600069867,");
str_builder_add_cstr(w_sell, "\"b2\":0.231792344,\"c2\":0.0200179144,");
str_builder_add_cstr(w_sell, "\"b3\":1.01046945,\"c3\":103.560653}");
assert_eq(streq(str_data(sellmeier_to_json(sellmeier_bk7())),
    str_data(str_builder_build(w_sell))), 1, "sellmeier wire format");
assert_eq(streq(str_data(lens_type_to_json(LENS_DIVERGING)), "\"Diverging\""), 1,
  "lens_type diverging wire format");
assert_eq(streq(str_data(polarization_to_json(polarization_new(F64_ONE, f64_from(0), f64_div(F64_PI, f64_from(2))))),
    "{\"ex\":1.0,\"ey\":0.0,\"phase\":1.5707963267948966}"), 1, "polarization wire format");

var wpr = prescription_new("test lens");
var _wa = prescription_add_surface(wpr, f64_from(50), f64_from(3), _fd(152, 100), _fd(125, 10));
var w_pre = str_builder_new();
str_builder_add_cstr(w_pre, "{\"name\":\"test lens\",\"surfaces\":[");
str_builder_add_cstr(w_pre, "{\"radius\":50.0,\"thickness\":3.0,");
str_builder_add_cstr(w_pre, "\"n_after\":1.52,\"aperture_radius\":12.5}");
str_builder_add_cstr(w_pre, "],\"n_initial\":1.0}");
assert_eq(streq(str_data(prescription_to_json(wpr)),
    str_data(str_builder_build(w_pre))), 1, "prescription wire format");
# An empty surfaces array still emits [] and keeps the trailing key.
assert_eq(streq(str_data(prescription_to_json(prescription_new("empty"))),
    "{\"name\":\"empty\",\"surfaces\":[],\"n_initial\":1.0}"), 1,
  "prescription with no surfaces emits an empty array");

# Escaping goes through the stdlib's str_builder_add_json_str rather than bayan's
# per-character appender. Verified byte-identical across all 255 reachable byte
# values before the swap; this pins the classes that actually appear in a name.
var escn = alloc(16);
store8(escn, 34); store8(escn + 1, 92); store8(escn + 2, 10); store8(escn + 3, 9);
store8(escn + 4, 1); store8(escn + 5, 65); store8(escn + 6, 0);
assert_eq(streq(str_data(medium_to_json(_medium_mk(F64_ONE, escn))),
    "{\"n\":1.0,\"name\":\"\\\"\\\\\\n\\t\\u0001A\"}"), 1,
  "medium name escapes quote, backslash, newline, tab and a control char");

# Null handles keep their 0 sentinel through the rewrite.
assert_eq(rgb_to_json(0), 0, "rgb_to_json(null) = 0");
assert_eq(medium_to_json(0), 0, "medium_to_json(null) = 0");
assert_eq(sellmeier_to_json(0), 0, "sellmeier_to_json(null) = 0");
assert_eq(polarization_to_json(0), 0, "polarization_to_json(null) = 0");
assert_eq(prescription_to_json(0), 0, "prescription_to_json(null) = 0");

# ── The Spd wire format, pinned to exact bytes ────────
#
# ⚠ 2.3.4 rewrote spd_to_json off bayan's value tree and onto a str_builder. Up
# to that point the ONLY coverage was the round-trip above — which a rewrite that
# changed the emitted bytes would still pass, as long as prakash's own decoder
# accepted whatever it now produced. The wire format is a published contract
# (consumers and other languages read it), so pin the bytes themselves.
#
# Grisu2 is what makes these exact: "380.0" not "380", "0.3333333333333333" not a
# 6-decimal truncation. No spaces; keys in insertion order start_nm, step_nm,
# values.
var wvals = alloc(4 * 8);
store64(wvals,      f64_div(f64_from(1), f64_from(10)));
store64(wvals + 8,  f64_from(2));
store64(wvals + 16, f64_div(f64_from(1), f64_from(3)));
store64(wvals + 24, f64_from(0));
var wspd = spd_from_static(f64_from(380), f64_from(5), wvals, 4);
var wjs = spd_to_json(wspd);
assert_eq(streq(str_data(wjs),
    "{\"start_nm\":380.0,\"step_nm\":5.0,\"values\":[0.1,2.0,0.3333333333333333,0.0]}"), 1,
  "spd_to_json emits the exact documented wire format");

# A single sample: no separator comma, and the array still closes correctly.
var w1 = alloc(8);
store64(w1, f64_from(7));
var wspd1 = spd_from_static(f64_from(400), f64_div(f64_from(25), f64_from(10)), w1, 1);
assert_eq(streq(str_data(spd_to_json(wspd1)),
    "{\"start_nm\":400.0,\"step_nm\":2.5,\"values\":[7.0]}"), 1,
  "spd_to_json single sample emits no trailing comma");

# Negative values survive the hand-assembled path.
#
# ⛔ AND NEGATIVE ZERO DOES NOT — the wire format loses its sign. bayan's Grisu2
# renders -0.0 as "0.0", so a round-trip turns -0.0 into +0.0. This is upstream
# bayan behaviour and it is PRE-EXISTING, not a 2.3.4 regression: the value-tree
# path this function replaced emitted the identical bytes (verified by a
# byte-for-byte A/B of both implementations before the swap). It is pinned here
# because the encoder is documented as bit-exact everywhere else, and this is the
# one exception — worth knowing before someone relies on round-tripping a signed
# zero. Not worth working around in prakash: a signed zero in a spectral power
# distribution has no physical meaning, and the fix belongs upstream.
var wneg = alloc(2 * 8);
store64(wneg,     f64_neg(f64_div(f64_from(1), f64_from(4))));
store64(wneg + 8, f64_neg(f64_from(0)));
var wspdn = spd_from_static(f64_from(380), f64_from(5), wneg, 2);
assert_eq(streq(str_data(spd_to_json(wspdn)),
    "{\"start_nm\":380.0,\"step_nm\":5.0,\"values\":[-0.25,0.0]}"), 1,
  "spd_to_json keeps a negative value and DROPS negative zero's sign");

assert_eq(spd_to_json(0), 0, "spd_to_json(null) keeps the 0 sentinel");

var r = assert_summary();
