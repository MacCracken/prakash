# ray Fresnel test suite — ported from rust-old/src/ray/mod.rs (#[cfg(test)]).
# Covers fresnel_s/p/normal/unpolarized, Brewster, Beer-Lambert, snell_3d, and
# the complex-index (absorbing-media) Fresnel functions.

include "src/error.cyr"
include "src/ray_core.cyr"
include "src/ray_fresnel.cyr"

fn _fd(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }
fn _assert_near(a, b, tol, msg) { assert(_near(a, b, tol), msg); }
fn _n3(x, y, z) {
    var l = f64_sqrt(f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(z, z)));
    return ray_vec3(f64_div(x, l), f64_div(y, l), f64_div(z, l));
}
fn _in01(r) {
    if (f64_lt(r, f64_from(0)) == 1) { return 0; }
    if (f64_gt(r, F64_ONE) == 1) { return 0; }
    return 1;
}

var TOL6 = f64_div(F64_ONE, f64_from(1000000));   # 1e-6
var TOL_HALF = f64_div(F64_ONE, F64_TWO);         # 0.5
var TOL_01 = f64_div(F64_ONE, f64_from(100));     # 0.01
var TOL_02 = f64_div(F64_ONE, f64_from(50));      # 0.02
var TOL_001 = f64_div(F64_ONE, f64_from(1000));   # 0.001
var TOL_05 = f64_div(F64_ONE, f64_from(20));      # 0.05

alloc_init();

# ── fresnel_normal ────────
test_group("fresnel_normal");

_assert_near(fresnel_normal(Medium_n(medium_air()), Medium_n(medium_glass())), _fd(4, 100), TOL_01,
  "air-glass ~0.04");
_assert_near(fresnel_normal(F64_ONE, _fd(15, 10)), fresnel_normal(_fd(15, 10), F64_ONE), TOL6, "symmetric");
_assert_near(fresnel_normal(_fd(15, 10), _fd(15, 10)), f64_from(0), TOL6, "same medium 0");

# range [0,1] for several pairs
assert(_in01(fresnel_normal(F64_ONE, _fd(15, 10))), "range 1-1.5");
assert(_in01(fresnel_normal(F64_ONE, _fd(2417, 1000))), "range 1-2.417");
assert(_in01(fresnel_normal(_fd(1333, 1000), _fd(152, 100))), "range 1.333-1.52");
assert(_in01(fresnel_normal(F64_ONE, f64_from(4))), "range 1-4");

# diamond high reflectance ~0.17
_assert_near(fresnel_normal(Medium_n(medium_air()), Medium_n(medium_diamond())), _fd(17, 100), TOL_02,
  "diamond ~0.17");

# higher index contrast -> more reflection
var r_water = fresnel_normal(F64_ONE, Medium_n(medium_water()));
var r_glass = fresnel_normal(F64_ONE, Medium_n(medium_glass()));
var r_diamond = fresnel_normal(F64_ONE, Medium_n(medium_diamond()));
assert(f64_lt(r_water, r_glass), "water < glass reflectance");
assert(f64_lt(r_glass, r_diamond), "glass < diamond reflectance");

# ── fresnel_s / fresnel_p at Brewster ────────
test_group("fresnel_brewster");

var ba = brewster_angle(F64_ONE, _fd(15, 10));
var eb = 0;
var t_at_ba = ray_snell(F64_ONE, _fd(15, 10), ba, &eb);
var cos_i_ba = f64_cos(ba);
var cos_t_ba = f64_cos(t_at_ba);
var rp_ba = fresnel_p(F64_ONE, _fd(15, 10), cos_i_ba, cos_t_ba);
# ⚠ WAS `< 1e-3`, NINE ORDERS LOOSER THAN THE QUANTITY. R_p at Brewster is not
# "small", it is zero — that is the definition of the angle — and the shipped code
# delivers 0.000000000000. A 1e-3 bound would pass a Brewster angle wrong by a
# degree, or an R_p formula with a sign slip in a small term. (2.4.7)
assert(f64_lt(rp_ba, _fd(1, 1000000000000)), "p-pol is ZERO at Brewster, not merely small");
var rs_ba = fresnel_s(F64_ONE, _fd(15, 10), cos_i_ba, cos_t_ba);
assert(f64_gt(rs_ba, rp_ba), "s-pol > p-pol at Brewster");

# ── fresnel_unpolarized ────────
test_group("fresnel_unpolarized");

var eu = 0;
var ru_low = fresnel_unpolarized(F64_ONE, _fd(15, 10), ray_deg_to_rad(f64_from(10)), &eu);
assert_eq(eu, 0, "unpol low ok");
_assert_near(ru_low, fresnel_normal(F64_ONE, _fd(15, 10)), TOL_01, "unpol low ~ normal");

var ru_high = fresnel_unpolarized(F64_ONE, _fd(15, 10), ray_deg_to_rad(f64_from(80)), &eu);
assert_eq(eu, 0, "unpol high ok");
assert(f64_gt(ru_high, _fd(3, 10)), "unpol high > 0.3");

# monotonic increase in reflectance with angle (air->glass)
var prev = f64_from(0);
for (var deg = 0; deg <= 85; deg = deg + 5) {
    var em = 0;
    var rm = fresnel_unpolarized(F64_ONE, _fd(15, 10), ray_deg_to_rad(f64_from(deg)), &em);
    assert(f64_ge(rm, f64_sub(prev, TOL6)), "unpol monotonic increasing");
    prev = rm;
}

# ── Brewster's angle ────────
test_group("brewster");

_assert_near(ray_rad_to_deg(brewster_angle(F64_ONE, _fd(15, 10))), _fd(563, 10), TOL_HALF, "brewster ~56.3deg");
var b1 = brewster_angle(F64_ONE, _fd(15, 10));
var b2 = brewster_angle(_fd(15, 10), F64_ONE);
_assert_near(f64_add(b1, b2), F64_PI_2, TOL6, "brewster complementary sum pi/2");

# ── Beer-Lambert ────────
test_group("beer_lambert");

_assert_near(beer_lambert(F64_ONE, f64_from(0), f64_from(10)), F64_ONE, TOL6, "no absorption");
_assert_near(beer_lambert(F64_ONE, F64_ONE, F64_ONE), f64_exp(f64_neg(F64_ONE)), TOL6, "exp(-1)");
var i1 = beer_lambert(F64_ONE, _fd(5, 10), F64_ONE);
var i2 = beer_lambert(F64_ONE, _fd(5, 10), F64_TWO);
_assert_near(i2, f64_mul(i1, i1), TOL6, "double distance squares attenuation");
_assert_near(beer_lambert(f64_from(5), f64_from(100), f64_from(0)), f64_from(5), TOL6, "zero distance");
assert(f64_ge(beer_lambert(F64_ONE, f64_from(10), f64_from(100)), f64_from(0)), "always non-negative");

# ── 3D Snell's law ────────
test_group("snell_3d");

var refl = 0;
var e_s3 = 0;
var dir_s3 = _n3(_fd(5, 10), f64_from(0), f64_neg(_fd(866, 1000)));
var refr_s3 = ray_snell_3d(dir_s3, ray_vec3(f64_from(0), f64_from(0), F64_ONE), F64_ONE, _fd(15, 10), &refl, &e_s3);
assert_eq(e_s3, 0, "snell_3d ok");
assert(_in01(refl), "snell_3d reflectance in [0,1]");
assert(f64_lt(RayVec3_z(refr_s3), f64_from(0)), "snell_3d still forward (-z)");

# normal incidence reflectance matches fresnel_normal
var refl_n = 0;
var e_n = 0;
var _rn3 = ray_snell_3d(
  ray_vec3(f64_from(0), f64_from(0), f64_neg(F64_ONE)),
  ray_vec3(f64_from(0), f64_from(0), F64_ONE), F64_ONE, _fd(15, 10), &refl_n, &e_n);
assert_eq(e_n, 0, "snell_3d normal ok");
_assert_near(refl_n, fresnel_normal(F64_ONE, _fd(15, 10)), TOL_01, "snell_3d normal ~ fresnel_normal");

# TIR
var refl_t = 0;
var e_t3 = 0;
var dir_tir = _n3(_fd(8, 10), f64_from(0), f64_neg(_fd(6, 10)));
var _rt3 = ray_snell_3d(dir_tir, ray_vec3(f64_from(0), f64_from(0), F64_ONE), _fd(15, 10), F64_ONE, &refl_t, &e_t3);
assert_eq(e_t3, PK_ERR_TIR, "snell_3d TIR");

# grazing -> high reflectance
var refl_g = 0;
var e_g = 0;
var dir_g = _n3(_fd(98, 100), f64_from(0), f64_neg(_fd(2, 10)));
var _rg = ray_snell_3d(dir_g, ray_vec3(f64_from(0), f64_from(0), F64_ONE), F64_ONE, _fd(15, 10), &refl_g, &e_g);
assert(f64_gt(refl_g, _fd(3, 10)), "snell_3d grazing high reflectance");

# ── Complex Fresnel ────────
test_group("fresnel_complex");

# dielectric medium: n=1.52, k=0
var die = complex_dielectric(_fd(152, 100), "glass");
_assert_near(ComplexMedium_n(die), _fd(152, 100), TOL6, "dielectric n=1.52");
_assert_near(ComplexMedium_k(die), f64_from(0), TOL6, "dielectric k=0");

# complex normal for dielectric matches real
_assert_near(
  fresnel_normal_complex(F64_ONE, die),
  fresnel_normal(F64_ONE, _fd(152, 100)), TOL_001, "complex dielectric ~ real");

# gold ~0.82
_assert_near(fresnel_normal_complex(F64_ONE, complex_gold_550nm()), _fd(82, 100), TOL_05, "gold ~0.82");
# silver & aluminum highly reflective
assert(f64_gt(fresnel_normal_complex(F64_ONE, complex_silver_550nm()), _fd(9, 10)), "silver > 0.9");
assert(f64_gt(fresnel_normal_complex(F64_ONE, complex_aluminum_550nm()), _fd(9, 10)), "aluminum > 0.9");

# s and p at normal incidence match fresnel_normal_complex
var gold = complex_gold_550nm();
var r_normal_g = fresnel_normal_complex(F64_ONE, gold);
_assert_near(fresnel_s_complex(F64_ONE, gold, f64_from(0)), r_normal_g, TOL_01, "s at 0 ~ normal");
_assert_near(fresnel_p_complex(F64_ONE, gold, f64_from(0)), r_normal_g, TOL_01, "p at 0 ~ normal");

# unpolarized complex for dielectric matches real at 30deg
var ang30 = ray_deg_to_rad(f64_from(30));
var eu2 = 0;
var ru_real = fresnel_unpolarized(F64_ONE, _fd(152, 100), ang30, &eu2);
_assert_near(
  fresnel_unpolarized_complex(F64_ONE, die, ang30), ru_real, TOL_01,
  "complex unpol dielectric ~ real at 30deg");

# grazing dielectric high reflectance
assert(
  f64_gt(fresnel_unpolarized_complex(F64_ONE, die, ray_deg_to_rad(f64_from(85))), TOL_HALF),
  "complex grazing > 0.5");

# range valid: metals, all angles r_s,r_p in [0, 1.001]
var au = complex_gold_550nm();
var ag = complex_silver_550nm();
var cu = complex_copper_550nm();
var al = complex_aluminum_550nm();
var one_plus = f64_add(F64_ONE, TOL_001);
for (var degc = 0; degc <= 85; degc = degc + 5) {
    var ang = ray_deg_to_rad(f64_from(degc));
    assert(f64_ge(fresnel_s_complex(F64_ONE, au, ang), f64_from(0)), "gold s >= 0");
    assert(f64_le(fresnel_s_complex(F64_ONE, au, ang), one_plus), "gold s <= 1");
    assert(f64_ge(fresnel_p_complex(F64_ONE, ag, ang), f64_from(0)), "silver p >= 0");
    assert(f64_le(fresnel_p_complex(F64_ONE, ag, ang), one_plus), "silver p <= 1");
    assert(f64_le(fresnel_s_complex(F64_ONE, cu, ang), one_plus), "copper s <= 1");
    assert(f64_le(fresnel_p_complex(F64_ONE, al, ang), one_plus), "aluminum p <= 1");
}

# aluminum always highly reflective
for (var dega = 0; dega <= 80; dega = dega + 10) {
    var ra = fresnel_unpolarized_complex(F64_ONE, al, ray_deg_to_rad(f64_from(dega)));
    assert(f64_gt(ra, _fd(8, 10)), "aluminum reflectance > 0.8");
}

# ── fresnel_amplitudes (2.12.0) ────────
# Every value below is the 60-digit solution of Maxwell's tangential boundary conditions at
# the interface, as a 6x6 linear system in the lab frame, with the interface turned to a
# generic orientation: no Fresnel formula and no s/p split went into them.
test_group("fresnel_amplitudes against Maxwell's boundary conditions");

var _FA_FLOOR = 0;
fn _cnear(lab, re, im, xr, xi) {
    var m = f64_add(f64_abs(xr), f64_abs(xi));
    var tol = f64_add(_FA_FLOOR, f64_mul(f64_from(8), f64_mul(0x3CB0000000000000, f64_add(m, 0x3CB0000000000000))));
    if ((f64_le(f64_abs(f64_sub(re, xr)), tol) & f64_le(f64_abs(f64_sub(im, xi)), tol)) == 1) { return 1; }
    syscall(1, 2, lab, strlen(lab));
    syscall(1, 2, " off\n", 5);
    return 0;
}
fn _fa_pin(lab, n1, n2, k2, c, rsr, rsi, rpr, rpi, tsr, tsi, tpr, tpi) {
    var o[80];
    assert_eq(fresnel_amplitudes(n1, n2, k2, c, &o), PK_ERR_NONE, lab);
    assert_eq(_cnear(lab, FresnelAmplitudes_rs_re(&o), FresnelAmplitudes_rs_im(&o), rsr, rsi), 1, "r_s");
    assert_eq(_cnear(lab, FresnelAmplitudes_rp_re(&o), FresnelAmplitudes_rp_im(&o), rpr, rpi), 1, "r_p");
    assert_eq(_cnear(lab, FresnelAmplitudes_ts_re(&o), FresnelAmplitudes_ts_im(&o), tsr, tsi), 1, "t_s");
    assert_eq(_cnear(lab, FresnelAmplitudes_tp_re(&o), FresnelAmplitudes_tp_im(&o), tpr, tpi), 1, "t_p");
    return 0;
}
_fa_pin("air to glass 37 deg", 0x3FF0000000000000, 0x3FF8000000000000, 0x0000000000000000, 0x3FE999999999999A,
  0xBFD0EA24849CF6A8, 0x0000000000000000, 0x3FC124ED7DE35915, 0x0000000000000000,
  0x3FE78AEDBDB184AC, 0x0000000000000000, 0x3FE830D23FA5E42E, 0x0000000000000000);
_fa_pin("air to glass normal", 0x3FF0000000000000, 0x3FF8000000000000, 0x0000000000000000, 0x3FF0000000000000,
  0xBFC999999999999A, 0x0000000000000000, 0x3FC999999999999A, 0x0000000000000000,
  0x3FE999999999999A, 0x0000000000000000, 0x3FE999999999999A, 0x0000000000000000);
_fa_pin("air to glass grazing", 0x3FF0000000000000, 0x3FF8000000000000, 0x0000000000000000, 0x3EB0C6F7A0B5ED8D,
  0xBFEFFFFC3F9DF21B, 0x0000000000000000, 0xBFEFFFF78F23FF11, 0x0000000000000000,
  0x3EBE03106F270370, 0x0000000000000000, 0x3EC6824AAD272EE7, 0x0000000000000000);
_fa_pin("glass to air below critical", 0x3FF8000000000000, 0x3FF0000000000000, 0x0000000000000000, 0x3FE999999999999A,
  0x3FDDE4D356DC3F91, 0x0000000000000000, 0x3FB9BCD619E3F603, 0x0000000000000000,
  0x3FF77934D5B70FE4, 0x0000000000000000, 0x3FFA69B4126D5F10, 0x0000000000000000);
_fa_pin("glass to air TIR", 0x3FF8000000000000, 0x3FF0000000000000, 0x0000000000000000, 0x3FE0000000000000,
  0xBFB999999999999A, 0xBFEFD6EFE4C9B8A5, 0xBFE7187CA92EBF72, 0xBFE626379406C33B,
  0x3FECCCCCCCCCCCCD, 0xBFEFD6EFE4C9B8A5, 0x3FDAB68A0473C1AB, 0xBFF09CA9AF05126C);
# At the critical angle q is the square root of something small, so these two are as sharp
# as the input allows: one ulp of cos_i moves q by 3.3e-13 here, on any algorithm, and the
# measured errors are 2.5e-13 and 9.4e-13. The floor below is that bound, not a loosening.
_FA_FLOOR = _fd(2, 1000000000000);
_fa_pin("glass to air just past critical", 0x3FF8000000000000, 0x3FF0000000000000, 0x0000000000000000,
  0x3FE7D9F49DCC2E41,
  0x3FEFFFFEF57E6284, 0xBF50533470D360B0, 0x3FEFFFFABAD02BE4, 0xBF625D99C83D4528,
  0x3FFFFFFF7ABF3142, 0xBF50533470D360B0, 0x4007FFFE060E1075, 0xBF6B8C66AC5BE7BC);
_fa_pin("glass to air just before critical", 0x3FF8000000000000, 0x3FF0000000000000, 0x0000000000000000,
  0x3FE7D9F5092BF8AC,
  0x3FEFF7348A546AE3, 0x0000000000000000, 0x3FEFEC399CD27574, 0x0000000000000000,
  0x3FFFFB9A452A3572, 0x0000000000000000, 0x4007F8959ACEEC0C, 0x0000000000000000);
_FA_FLOOR = 0;
_fa_pin("near-identical media", 0x3FF0000000000000, 0x3FF000000044B830, 0x0000000000000000, 0x3FE0000000000000,
  0xBE212E0BFEFDBEDC, 0x0000000000000000, 0xBE112E0BFE206274, 0x0000000000000000,
  0x3FEFFFFFFEED1F40, 0x0000000000000000, 0x3FEFFFFFFEED1F40, 0x0000000000000000);
_fa_pin("air to gold 550 nm", 0x3FF0000000000000, 0x3FDB851EB851EB85, 0x4003AE147AE147AE, 0x3FC999999999999A,
  0xBFEEF450F475BE56, 0xBFC26B9788CFE382, 0xBFE1E41FD79E01C0, 0x3FE4EE9489EA1890,
  0x3FA0BAF0B8A41A9A, 0xBFC26B9788CFE382, 0x3FD27579B84BDE05, 0xBFC07CF9160C19B0);
_fa_pin("air to Lam's gold", 0x3FF0000000000000, 0x3FC604189374BC6A, 0x4012FEF9DB22D0E5, 0x3FE156191148FDA0,
  0xBFEEF662C3F567E5, 0xBFCC2552DFCD8DBF, 0x3FE6CD8949A28064, 0x3FE549C613960BD8,
  0x3FA099D3C0A981AE, 0xBFCC2552DFCD8DBF, 0x3FC393A8C9FBBE9D, 0xBFD6B9A9187EF287);
_fa_pin("water to aluminum", 0x3FF547AE147AE148, 0x3FEEB851EB851EB8, 0x401AC28F5C28F5C3, 0x3FEE666666666666,
  0xBFEC659A4C9BB8C8, 0xBFD5BD8E5A85E00D, 0x3FEBC81A0035FF5C, 0x3FD7DA4BB97AB55C,
  0x3FBCD32D9B2239BF, 0xBFD5BD8E5A85E00D, 0x3FBFF424E2DF6D25, 0xBFD69F94AF9F3F8F);
_fa_pin("metal with n = k", 0x3FF0000000000000, 0x4000000000000000, 0x4000000000000000, 0x3FE3333333333333,
  0xBFE6F1725CF27EF5, 0xBFCDE780C2E606F3, 0x3FD2D2E6B5F623AE, 0x3FD720E31F253A9C,
  0x3FD21D1B461B0215, 0xBFCDE780C2E606F3, 0x3FDA7CF27546D793, 0xBFCDD901CB687489);
_fa_pin("pure imaginary index", 0x3FF0000000000000, 0x39B4484BFEEBC2A0, 0x4008000000000000, 0x3FE6666666666666,
  0xBFECDD2F1A9FBE77, 0xBFDBA19028D5FF32, 0x3FE3A117BA117BA1, 0x3FE945B8ED27A19C,
  0x3FB916872B020C49, 0xBFDBA19028D5FF32, 0x3FD0D925F36FC113, 0xBFE135B2935B2936);
_fa_pin("weak absorber", 0x3FF8000000000000, 0x3FF8000000000000, 0x3EB0C6F7A0B5ED8D, 0x3FD3333333333333,
  0xBDBCCEB8BB85B97F, 0xBECF11A4A4D6A1EC, 0xBDBC902BEF0F3028, 0xBEC979FCC499B83E,
  0x3FEFFFFFFFFC6629, 0xBECF11A4A4D6A1EC, 0x3FEFFFFFFFFC171B, 0xBECF11A4A4D5ADD7);

# Between equal media nothing happens, at any angle. sin(theta_i) rounds to exactly 1 below
# c ~ 1e-8, and a q formed from it came out 0, which made t_s = 2.
test_group("fresnel_amplitudes between equal media");
fn _same(c) {
    var o[80];
    assert_eq(fresnel_amplitudes(F64_ONE, F64_ONE, 0, c, &o), PK_ERR_NONE, "equal media");
    assert_eq(FresnelAmplitudes_rs_re(&o), 0, "r_s = 0");
    assert_eq(FresnelAmplitudes_rp_re(&o), 0, "r_p = 0");
    assert_eq(FresnelAmplitudes_ts_re(&o), F64_ONE, "t_s = 1");
    assert_eq(FresnelAmplitudes_tp_re(&o), F64_ONE, "t_p = 1");
    assert_eq(FresnelAmplitudes_flux_s(&o), F64_ONE, "flux 1");
    return 0;
}
var _s1 = _same(F64_ONE);
var _s2 = _same(_fd(1, 2));
var _s3 = _same(0x3B7A36E2EB1C432D);       # 1e-22
var _s4 = _same(0x20C0000000000000);       # 2^-499, just above the floor below
# Below n1 cos_i = 2^-500 the flux factor and |t|^2 leave the double range, so R + T = 1 could
# not hold: flux came back +inf at cos_i = 1e-310. That ray is in the plane of the surface.
var _uo[80];
assert_eq(fresnel_amplitudes(F64_ONE, F64_ONE, 0, 0x0000000000000001, &_uo), PK_ERR_INVALID_ANGLE, "cos_i = 2^-1074");
assert_eq(fresnel_amplitudes(F64_ONE, 0x3FF8000000000000, 0, 0x000012688B70E62B, &_uo), PK_ERR_INVALID_ANGLE,
  "cos_i = 1e-310");
assert_eq(fresnel_amplitudes(0x3FF0000000000000, 0x3FF8000000000000, 0, 0x20A0000000000000, &_uo), PK_ERR_INVALID_ANGLE,
  "n1 cos_i under 2^-500");
assert_eq(fresnel_amplitudes(0x39B0000000000000, F64_ONE, 0, 0x0000000000000001, &_uo), PK_ERR_INVALID_ANGLE,
  "n1 cos_i underflowing to 0");

var r = assert_summary();
