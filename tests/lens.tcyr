# lens test suite (part 1) — thin/thick lens, f-number/NA, FOV
# from rust-old/src/lens.rs (inline #[cfg(test)] mod).

include "src/error.cyr"
include "src/lens.cyr"

fn _fd(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }
fn _assert_near(a, b, tol, msg) { assert(_near(a, b, tol), msg); }

var EPS = f64_div(F64_ONE, f64_from(1000000));   # 1e-6
var Z = f64_from(0);
var INF = 0x7FF0000000000000;
var N15 = _fd(15, 10);

alloc_init();

var ER = alloc(8);
var DOF = alloc(16);

# ── Thin lens ────────
test_group("thin_lens");

_assert_near(lens_thin_image_distance(f64_from(50), f64_from(100), ER), f64_from(100), EPS, "real image di=100");
assert_eq(load64(ER), PK_ERR_NONE, "real image ok");
assert(f64_lt(lens_thin_image_distance(f64_from(50), f64_from(30), ER), Z), "virtual image di<0");
var _e0 = lens_thin_image_distance(f64_from(50), f64_from(50), ER);
assert_eq(prakash_is_err(load64(ER)), 1, "object at focus is err");
_assert_near(lens_thin_image_distance(f64_from(50), f64_from(1000000), ER), f64_from(50), _fd(1, 100),
  "far object di~f");
assert(f64_lt(lens_thin_image_distance(f64_neg(f64_from(50)), f64_from(100), ER), Z), "diverging virtual");
var di_eq = lens_thin_image_distance(f64_from(75), f64_from(200), ER);
_assert_near(f64_div(F64_ONE, f64_from(75)),
  f64_add(f64_div(F64_ONE, f64_from(200)), f64_div(F64_ONE, di_eq)), EPS, "satisfies 1/f=1/do+1/di");

# ── Magnification ────────
test_group("magnification");

_assert_near(lens_magnification(f64_from(100), f64_from(100)), f64_neg(F64_ONE), EPS, "M at 2f = -1");
var m_mag = lens_magnification(f64_from(60), f64_from(120));
assert(f64_gt(f64_abs(m_mag), F64_ONE), "magnified |M|>1");
assert(f64_lt(m_mag, Z), "magnified inverted");
assert(f64_lt(f64_abs(lens_magnification(f64_from(200), f64_from(50))), F64_ONE), "diminished |M|<1");
assert(f64_gt(lens_magnification(f64_from(30), f64_neg(f64_from(60))), Z), "virtual upright M>0");

# ── Lensmaker ────────
test_group("lensmaker");

_assert_near(lens_lensmaker_focal_length(N15, f64_from(100), f64_neg(f64_from(100)), ER), f64_from(100),
  EPS, "lensmaker f=100");
_assert_near(lens_lensmaker_focal_length(N15, f64_from(100), INF, ER), f64_from(200), EPS,
  "planoconvex f=200");
var _e1 = lens_lensmaker_focal_length(N15, INF, INF, ER);
assert_eq(prakash_is_err(load64(ER)), 1, "flat surfaces err");
assert(f64_lt(lens_lensmaker_focal_length(N15, f64_neg(f64_from(100)), f64_from(100), ER), Z),
  "biconcave f<0");

# ── Optical power ────────
test_group("optical_power");

_assert_near(lens_optical_power(F64_HALF, ER), F64_TWO, EPS, "power(0.5)=2");
_assert_near(lens_optical_power(f64_neg(F64_HALF), ER), f64_neg(F64_TWO), EPS, "power(-0.5)=-2");
var _e2 = lens_optical_power(Z, ER);
assert_eq(prakash_is_err(load64(ER)), 1, "power(0) err");
var pw = lens_optical_power(_fd(1, 4), ER);
_assert_near(f64_div(F64_ONE, pw), _fd(1, 4), EPS, "power roundtrip");

# ── Mirror ────────
test_group("mirror");

_assert_near(lens_mirror_focal_length(f64_from(200)), f64_from(100), EPS, "mirror focal 100");
assert(f64_gt(lens_mirror_focal_length(f64_from(100)), Z), "concave f>0");
assert(f64_lt(lens_mirror_focal_length(f64_neg(f64_from(100))), Z), "convex f<0");
_assert_near(lens_mirror_image_distance(f64_from(100), f64_from(200), ER), f64_from(200), EPS,
  "mirror image real 200");
var _e3 = lens_mirror_image_distance(f64_from(100), f64_from(100), ER);
assert_eq(prakash_is_err(load64(ER)), 1, "mirror at focus err");

# ── Classify ────────
test_group("classify");

assert_eq(lens_classify(f64_from(50)), LENS_CONVERGING, "positive converging");
assert_eq(lens_classify(f64_neg(f64_from(50))), LENS_DIVERGING, "negative diverging");
assert_eq(lens_classify(Z), LENS_DIVERGING, "zero diverging");

# ── Combined ────────
test_group("combined");

_assert_near(lens_combined_focal_length(f64_from(100), f64_from(100), ER), f64_from(50), EPS,
  "combined 100+100 = 50");
_assert_near(lens_combined_focal_length(f64_from(50), f64_neg(f64_from(100)), ER), f64_from(100), EPS,
  "combined 50-100 = 100");
var _e4 = lens_combined_focal_length(f64_from(100), f64_neg(f64_from(100)), ER);
assert_eq(prakash_is_err(load64(ER)), 1, "equal opposite err");

# ── Depth of field ────────
test_group("depth_of_field");

lens_depth_of_field(f64_from(50), _fd(28, 10), _fd(3, 100), f64_from(2000), DOF);
assert(f64_lt(load64(DOF), f64_from(2000)), "dof near < subject");
assert(f64_gt(load64(DOF + 8), f64_from(2000)), "dof far > subject");
assert(f64_gt(load64(DOF), Z), "dof near > 0");

lens_depth_of_field(f64_from(50), _fd(14, 10), _fd(3, 100), f64_from(2000), DOF);
var dof1 = f64_sub(load64(DOF + 8), load64(DOF));
lens_depth_of_field(f64_from(50), f64_from(8), _fd(3, 100), f64_from(2000), DOF);
var dof2 = f64_sub(load64(DOF + 8), load64(DOF));
assert(f64_lt(dof1, dof2), "wider aperture shallower DoF");

lens_depth_of_field(f64_from(85), _fd(28, 10), _fd(3, 100), f64_from(2000), DOF);
var dofl1 = f64_sub(load64(DOF + 8), load64(DOF));
lens_depth_of_field(f64_from(35), _fd(28, 10), _fd(3, 100), f64_from(2000), DOF);
var dofl2 = f64_sub(load64(DOF + 8), load64(DOF));
assert(f64_lt(dofl1, dofl2), "longer lens shallower DoF");

lens_depth_of_field(f64_from(50), _fd(56, 10), _fd(3, 100), f64_from(5000), DOF);
assert(f64_lt(load64(DOF), f64_from(5000)), "dof near < 5000");
assert(f64_gt(load64(DOF + 8), f64_from(5000)), "dof far > 5000");

# ── Thick lens ────────
test_group("thick_lens");

var f_thin0 = lens_lensmaker_focal_length(N15, f64_from(100), f64_neg(f64_from(100)), ER);
var f_thick0 = lens_thick_focal_length(N15, f64_from(100), f64_neg(f64_from(100)), Z, ER);
_assert_near(f_thin0, f_thick0, EPS, "thick@0 = thin");
var f_thick = lens_thick_focal_length(N15, f64_from(100), f64_neg(f64_from(100)), f64_from(10), ER);
assert(f64_gt(f_thick, Z), "biconvex thick converging");
assert(f64_gt(f64_abs(f64_sub(f_thick, f_thin0)), _fd(1, 100)), "thick differs from thin");
var _e5 = lens_thick_focal_length(N15, INF, INF, f64_from(10), ER);
assert_eq(prakash_is_err(load64(ER)), 1, "thick zero power err");

var cp = lens_cardinal_points(N15, f64_from(100), f64_neg(f64_from(100)), f64_from(10), ER);
assert(f64_gt(CardinalPoints_focal_length(cp), Z), "cardinal f>0");
assert(f64_gt(CardinalPoints_bfd(cp), Z), "cardinal bfd>0");
assert(f64_lt(CardinalPoints_ffd(cp), Z), "cardinal ffd<0");
assert(f64_lt(f64_abs(f64_sub(f64_abs(CardinalPoints_front_principal(cp)),
        f64_abs(CardinalPoints_back_principal(cp)))), _fd(1, 10)), "symmetric principal planes");

# ── F-number / NA ────────
test_group("f_number_na");

_assert_near(lens_f_number(f64_from(50), f64_from(25)), F64_TWO, EPS, "f_number 50/25 = 2");
_assert_near(lens_f_number(f64_from(100), f64_from(50)), F64_TWO, EPS, "f_number 100/50 = 2");
_assert_near(lens_aperture_from_f_number(f64_from(50), F64_TWO), f64_from(25), EPS, "aperture 50/2 = 25");
var d357 = _fd(30357, 1000);
var nfr = lens_f_number(f64_from(85), d357);
_assert_near(lens_aperture_from_f_number(f64_from(85), nfr), d357, EPS, "f/aperture roundtrip");
_assert_near(lens_numerical_aperture(F64_ONE, f64_div(F64_PI, f64_from(6))), F64_HALF, EPS, "NA sin30 = 0.5");
_assert_near(lens_na_from_f_number(F64_TWO), _fd(1, 4), EPS, "NA from f/2 = 0.25");
assert(f64_gt(lens_numerical_aperture(_fd(1515, 1000), f64_div(F64_PI, f64_from(3))), F64_ONE),
  "oil immersion NA > 1");
var theta_s = lens_diffraction_limit(_fd(55, 100000), f64_from(10));
assert(f64_gt(theta_s, Z), "diffraction limit > 0");
assert(f64_lt(theta_s, _fd(1, 1000)), "diffraction limit small");
assert(f64_lt(lens_diffraction_limit(_fd(55, 100000), f64_from(50)), theta_s), "larger aperture better");
var airy = lens_airy_disk_radius(_fd(55, 100000), _fd(28, 10));
assert(f64_gt(airy, Z), "airy radius > 0");
_assert_near(airy, _fd(188, 100000), _fd(1, 1000), "airy ~ 0.00188mm");

# ── Field of view ────────
test_group("field_of_view");

var fov50 = lens_field_of_view(f64_from(36), f64_from(50));
var fov_deg = f64_div(f64_mul(fov50, f64_from(180)), F64_PI);
_assert_near(fov_deg, _fd(396, 10), F64_ONE, "50mm FF ~ 39.6 deg");
assert(f64_lt(lens_field_of_view(f64_from(36), f64_from(200)), fov50), "longer lens narrower");
assert(f64_gt(lens_field_of_view_diagonal(f64_from(36), f64_from(24), f64_from(50)), fov50),
  "diagonal > horizontal");

var PR = alloc(8);
var TF = alloc(4 * 16);
var WL = alloc(3 * 8);
var WT = alloc(3 * 8);
var EL = alloc(2 * 16);
var MG = alloc(3 * 8);

# ── MTF ────────
test_group("mtf");

_assert_near(lens_mtf_cutoff_frequency(_fd(55, 100000), _fd(28, 10)), f64_from(649), f64_from(5),
  "cutoff ~ 649 cy/mm");
_assert_near(lens_mtf_diffraction_limited(Z, f64_from(1000)), F64_ONE, EPS, "MTF(0) = 1");
assert(f64_lt(f64_abs(lens_mtf_diffraction_limited(f64_from(1000), f64_from(1000))), EPS), "MTF at cutoff = 0");
assert(f64_lt(f64_abs(lens_mtf_diffraction_limited(f64_from(1500), f64_from(1000))), EPS), "MTF above cutoff = 0");
var mtf_prev = F64_ONE;
for (var mi = 1; mi <= 10; mi = mi + 1) {
    var freq = f64_div(f64_mul(f64_from(1000), f64_from(mi)), f64_from(10));
    var mm = lens_mtf_diffraction_limited(freq, f64_from(1000));
    assert(f64_le(mm, f64_add(mtf_prev, EPS)), "MTF monotonic decrease");
    mtf_prev = mm;
}
for (var mj = 0; mj <= 20; mj = mj + 1) {
    var freq2 = f64_div(f64_mul(f64_from(1000), f64_from(mj)), f64_from(20));
    var mm2 = lens_mtf_diffraction_limited(freq2, f64_from(1000));
    assert(f64_ge(mm2, Z), "MTF range lo");
    assert(f64_le(mm2, F64_ONE), "MTF range hi");
}
store64(WL, _fd(55, 100000));
store64(WT, F64_ONE);
var mono_cut = lens_mtf_cutoff_frequency(_fd(55, 100000), _fd(28, 10));
_assert_near(lens_mtf_polychromatic(WL, 1, WT, 1, _fd(28, 10), f64_from(200)),
  lens_mtf_diffraction_limited(f64_from(200), mono_cut), EPS, "polychromatic single = mono");
store64(WL + 8, _fd(45, 100000));
assert(f64_ge(lens_mtf_polychromatic(WL, 2, WT, 0, _fd(28, 10), f64_from(200)), Z),
  "polychromatic default weights");
var tf_def = alloc(2 * 8);
store64(tf_def, Z);
store64(tf_def + 8, _fd(1, 100));
lens_mtf_through_focus(_fd(55, 100000), _fd(28, 10), f64_from(200), tf_def, 2, TF);
_assert_near(load64(TF + 8), lens_mtf_diffraction_limited(f64_from(200), mono_cut), EPS,
  "through-focus at 0 = mono");
assert(f64_le(load64(TF + 24), load64(TF + 8)), "through-focus defocus attenuates");

# ── Seidel aberrations ────────
test_group("seidel");

assert(f64_lt(f64_abs(lens_shape_factor(f64_from(100), f64_neg(f64_from(100)))), EPS), "equiconvex q=0");
_assert_near(lens_shape_factor(f64_from(100), f64_from(1000000000000000)), F64_ONE, _fd(1, 100),
  "planoconvex q~1");
_assert_near(lens_conjugate_factor(f64_from(10000000000), f64_from(50)), f64_neg(F64_ONE), _fd(1, 1000),
  "object at infinity p~-1");
assert(f64_lt(f64_abs(lens_conjugate_factor(f64_from(100), f64_from(100))), EPS), "symmetric p=0");

var sc_eq = lens_seidel_coefficients(N15, f64_from(100), Z, f64_neg(F64_ONE));
assert(f64_gt(f64_abs(SeidelCoefficients_spherical(sc_eq)), EPS), "spherical nonzero");

# ⚠ 2.2.6: EVERY SEIDEL ASSERTION IN THIS BLOCK WRAPS THE VALUE IN f64_abs,
# WHICH IS WHY A SIGN ERROR SURVIVED THEM ALL. The bracket was missing its
# n^2/(n-1)^2 constant term and mis-scaled the p^2 one, so the quadratic in q
# crossed zero and spherical came out NEGATIVE for q >= 0.5 at n = 1.5 — the
# wrong aberration DIRECTION, not merely a wrong magnitude. A positive singlet
# in air with the object at infinity is always undercorrected, so the sign is
# invariant; these assert it directly. Measured minimum over q in [-4,4], p=-1:
# n=1.5 was -7.353 (bracket units), now +3.813.
for (var _sqi = 0 - 40; _sqi <= 40; _sqi = _sqi + 1) {
    var _sq = f64_mul(f64_from(_sqi), _fd(1, 10));
    assert(f64_gt(SeidelCoefficients_spherical(
          lens_seidel_coefficients(N15, f64_from(100), _sq, f64_neg(F64_ONE))), Z),
      "spherical is POSITIVE for every shape factor (n=1.5, object at infinity)");
}
# ⚠ 2.2.8: THE 2.2.6 SEIDEL FIX WAS INCOMPLETE AND ITS CHECK WAS CIRCULAR.
# The q^2 term kept a factor of (n-1) too much — three of the four bracket terms
# followed the stated scheme and that one did not — and 2.2.6 "verified" the
# argmin against a formula derived from the same bracket, so it agreed by
# construction. These pin the INDEPENDENT textbook results instead:
# best-form singlet argmin q = 2(n^2-1)/(n+2) at p = -1, and the aplanatic
# (coma-free) shape at q = 0.80 for n = 1.5. The shipped code put the argmin at
# 1.4286 and the coma zero at 0.55.
var _bq = Z;
var _bs = f64_div(F64_ONE, Z);
for (var _bi = 0 - 300; _bi <= 300; _bi = _bi + 1) {
    var _q = _fd(_bi, 100);
    var _sp = SeidelCoefficients_spherical(lens_seidel_coefficients(N15, f64_from(100), _q, f64_neg(F64_ONE)));
    if (f64_lt(_sp, _bs) == 1) { _bs = _sp; _bq = _q; }
}
_assert_near(_bq, _fd(7143, 10000), _fd(2, 100),
  "best-form singlet argmin q = 0.7143 at n=1.5 (shipped 1.4286 through 2.2.7)");
assert(f64_gt(_bs, Z), "and the spherical minimum is still positive there");

# Coma must cross zero at the aplanatic shape, q = 0.80 for n = 1.5.
assert(f64_lt(f64_mul(
      SeidelCoefficients_coma(lens_seidel_coefficients(N15, f64_from(100), _fd(79, 100), f64_neg(F64_ONE))),
      SeidelCoefficients_coma(lens_seidel_coefficients(N15, f64_from(100), _fd(81, 100), f64_neg(F64_ONE)))), Z),
  "coma changes sign between q = 0.79 and q = 0.81 — the aplanatic singlet");
assert(f64_lt(SeidelCoefficients_coma(lens_seidel_coefficients(N15, f64_from(100), _fd(55, 100), f64_neg(F64_ONE))), Z),
  "coma is strictly negative at q = 0.55, where the old bracket reported zero");

# Same invariant must hold across ordinary glasses, not just n = 1.5.
for (var _sni = 15; _sni <= 18; _sni = _sni + 1) {
    var _sn = _fd(_sni, 10);
    assert(f64_gt(SeidelCoefficients_spherical(
          lens_seidel_coefficients(_sn, f64_from(100), _fd(15, 10), f64_neg(F64_ONE))), Z),
      "spherical stays positive at the worst-case q for n = 1.5..1.8");
}
assert(f64_gt(f64_abs(SeidelCoefficients_coma(sc_eq)), EPS), "coma nonzero");
assert(f64_gt(SeidelCoefficients_field_curvature(sc_eq), Z), "field curvature > 0");

var min_sa = INF;
var best_q = Z;
for (var qi = 0 - 20; qi <= 20; qi = qi + 1) {
    var qv = f64_mul(f64_from(qi), _fd(1, 10));
    var scq = lens_seidel_coefficients(N15, f64_from(100), qv, f64_neg(F64_ONE));
    var absp = f64_abs(SeidelCoefficients_spherical(scq));
    if (f64_lt(absp, min_sa) == 1) {
        min_sa = absp;
        best_q = qv;
    }
}
var sc_best = lens_seidel_coefficients(N15, f64_from(100), best_q, f64_neg(F64_ONE));
assert(f64_le(f64_abs(SeidelCoefficients_spherical(sc_best)),
    f64_abs(SeidelCoefficients_spherical(sc_eq))), "best-form <= equiconvex spherical");

assert(f64_gt(f64_abs(lens_longitudinal_spherical_aberration(f64_from(10), f64_from(100), N15)),
    f64_abs(lens_longitudinal_spherical_aberration(f64_from(5), f64_from(100), N15))),
  "LSA increases with ray height");

var tca = lens_chromatic_aberration(f64_from(100), f64_from(64));
assert(f64_gt(tca, Z), "chromatic > 0");
_assert_near(tca, _fd(15625, 10000), EPS, "TCA = 1.5625");
assert(f64_lt(lens_chromatic_aberration(f64_from(100), f64_from(64)),
    lens_chromatic_aberration(f64_from(100), f64_from(26))), "crown less TCA than flint");

# ── Petzval ────────
test_group("petzval");

store64(EL, N15);
store64(EL + 8, f64_from(100));
_assert_near(lens_petzval_sum(EL, 1), f64_div(F64_ONE, f64_from(150)), EPS, "petzval single = 1/150");
store64(EL, N15);
store64(EL + 8, f64_from(60));
store64(EL + 16, _fd(17, 10));
store64(EL + 24, f64_neg(f64_from(90)));
var ps_doublet = lens_petzval_sum(EL, 2);
assert(f64_gt(ps_doublet, Z), "doublet petzval > 0");
assert(f64_lt(ps_doublet, _fd(1, 100)), "doublet petzval < 0.01");
assert_eq(lens_petzval_radius(_fd(1, 100), PR), 1, "petzval radius has value");
_assert_near(load64(PR), f64_neg(f64_from(100)), EPS, "petzval radius = -100");
assert_eq(lens_petzval_radius(Z, PR), 0, "flat field -> none");

# ── Multi-element system ────────
test_group("multi_element");

var f_sep = lens_separated_focal_length(f64_from(100), f64_from(100), Z, ER);
var f_contact = lens_combined_focal_length(f64_from(100), f64_from(100), ER);
_assert_near(f_sep, f_contact, EPS, "separated d=0 = combined");
assert(f64_gt(lens_separated_focal_length(f64_from(50), f64_neg(f64_from(80)), f64_from(30), ER),
    f64_from(50)), "telephoto longer EFL");
var bfd_tele = lens_separated_bfd(f64_from(50), f64_neg(f64_from(80)), f64_from(30), ER);
var f_tele = lens_separated_focal_length(f64_from(50), f64_neg(f64_from(80)), f64_from(30), ER);
assert(f64_lt(bfd_tele, f_tele), "telephoto BFD < EFL");
store64(MG, f64_neg(F64_HALF));
store64(MG + 8, f64_neg(F64_TWO));
store64(MG + 16, f64_neg(_fd(3, 10)));
_assert_near(lens_system_magnification(MG, 3), f64_neg(_fd(3, 10)), EPS, "system mag product");
store64(MG, f64_neg(F64_ONE));
_assert_near(lens_system_magnification(MG, 1), f64_neg(F64_ONE), EPS, "system mag single");
_assert_near(lens_system_magnification(MG, 0), F64_ONE, EPS, "system mag empty = 1");

var r = assert_summary();
