# At NA 0.001 the integrals span eight decades, I00 ~ 1e-6 down to I02 ~ 1e-14, and every one
# is positive at the focal plane inside the first zero of J0. Each is pinned to TOLR of ITSELF:
# 1 - cos(theta) is 5e-7 here, and formed by subtraction it would cost I02 ten digits.
var TOLR = f64_mul(f64_from(2), TOL15);
fn _pinr(i, re, msg) {
    _assert_near(load64(&IB + i * 16), re, f64_mul(TOLR, re), msg);
    assert_eq(load64(&IB + i * 16 + 8), Z, msg);
    return 0;
}
var LH = focus_new(0x3F50624DD2F1A9FC, ONE, ONE, 0x3EA53BB5EA8666CF, 0x3F847AE147AE147B, FOCUS_PUPIL_UNIFORM, 0, &err);
assert_eq(err, PK_ERR_NONE, "LH");
_at(LH, 0x3F1C6A827475DDFD, Z);    # rho 171.3 lambda0: k rho NA = 1.076
_pinr(0, 0x3EACECAD85F9B0C6, "LH I00 (171.3, 0)");
_pinr(1, 0x3DE0C4EA5171A183, "LH I01 (171.3, 0)");
_pinr(2, 0x3D0942EC2DAA6D6E, "LH I02 (171.3, 0)");
_pinr(3, 0x3E860E397E650461, "LH Irho (171.3, 0)");
_pinr(4, 0x3DF3207BE60267F3, "LH Iz (171.3, 0)");
_pinr(5, 0x3E860E39EB80EBDB, "LH Iphi (171.3, 0)");
_at(LH, 0x3F29DA66FF40A4FA, Z);    # rho 311.7 lambda0: k rho NA = 1.958
_pinr(0, 0x3EA3D788A7057DE0, "LH I00 (311.7, 0)");
_pinr(1, 0x3DE81A04F0EC9817, "LH I01 (311.7, 0)");
_pinr(2, 0x3D21973654C4DA2C, "LH I02 (311.7, 0)");
_pinr(3, 0x3E9047AE0094E225, "LH Irho (311.7, 0)");
_pinr(4, 0x3DE79CAE45F231C1, "LH Iz (311.7, 0)");
_pinr(5, 0x3E9047AE4D798C77, "LH Iphi (311.7, 0)");
# The closed form at the focus of a uniform pupil, c = cos(alpha):
#   I00(0, 0) = int sqrt(c) sin (1 + c) = (2/3)(1 - c^(3/2)) + (2/5)(1 - c^(5/2)).
var cf_c = f64_sqrt(f64_mul(f64_sub(ONE, NA9), f64_add(ONE, NA9)));
var cf_h = f64_mul(cf_c, f64_sqrt(cf_c));
var cf = f64_add(f64_mul(_fd(2, 3), f64_sub(ONE, cf_h)), f64_mul(_fd(2, 5), f64_sub(ONE, f64_mul(cf_h, cf_c))));
_at(lc, Z, Z);
_assert_near(load64(&IB), cf, TOL15, "I00(0, 0) = (2/3)(1 - c^1.5) + (2/5)(1 - c^2.5)");
assert_eq(load64(&IB + 8), Z, "and real");
# On the axis J1 and J2 vanish, so do the integrals that carry them: exactly.
var AX = 0x7FFFFFFFFFFFFFFF;            # |x| as bits: -0 is 0 too
assert_eq((load64(&IB + 16) | load64(&IB + 32) | load64(&IB + 48) | load64(&IB + 80)) & AX, Z,
  "I01 = I02 = Irho = Iphi = 0 on the axis");
# A real pupil makes the field symmetric through the focus: I(rho, -z) = conj I(rho, z).
var sy_r = f64_mul(_fd(83, 100), LAM);
var sy_z = f64_mul(_fd(61, 100), LAM);
var SY[96];
assert_eq(focus_integrals(LB, sy_r, sy_z, &SY), PK_ERR_NONE, "z");
_at(LB, sy_r, f64_neg(sy_z));
var sy_bad = 0;
for (var sy_i = 0; sy_i < 6; sy_i = sy_i + 1) {
    if (_near(load64(&IB + sy_i * 16), load64(&SY + sy_i * 16), f64_mul(TOL15, S_LB)) == 0) { sy_bad = sy_bad + 1; }
    if (_near(load64(&IB + sy_i * 16 + 8), f64_neg(load64(&SY + sy_i * 16 + 8)), f64_mul(TOL15, S_LB)) == 0) {
        sy_bad = sy_bad + 1;
    }
}
assert_eq(sy_bad, 0, "I(rho, -z) = conj I(rho, z)");

# ── The fields ────────
test_group("focus fields");

# Pins: the 60-digit integrals through the formulas the brute-force sum checked, to TOLF of
# A |I00(0, 0)|, the size of the field at a focus, plus TOLZ per wavelength of z as above.
var TOLF = f64_mul(f64_from(2), TOL15);
fn _fj(l, ar, ai, br, bi, rho, phi, z) {
    assert_eq(focus_jones(l, ar, ai, br, bi, rho, phi, z, EF), PK_ERR_NONE, "focus_jones");
    AT_Z = f64_abs(f64_mul(FocusLens_cyc(l), z));
    return 0;
}
fn _fr(l, rho, phi, z) {
    assert_eq(focus_radial(l, rho, phi, z, EF), PK_ERR_NONE, "focus_radial");
    AT_Z = f64_abs(f64_mul(FocusLens_cyc(l), z));
    return 0;
}
fn _fa(l, rho, phi, z) {
    assert_eq(focus_azimuthal(l, rho, phi, z, EF), PK_ERR_NONE, "focus_azimuthal");
    AT_Z = f64_abs(f64_mul(FocusLens_cyc(l), z));
    return 0;
}
fn _fp(xr, xi, yr, yi, zr, zi, l, s, msg) {
    var t = f64_mul(f64_mul(f64_add(TOLF, f64_mul(TOLZ, AT_Z)), FocusLens_pref(l)), s);
    _assert_near(PrtField_x_re(EF), xr, t, msg);
    _assert_near(PrtField_x_im(EF), xi, t, msg);
    _assert_near(PrtField_y_re(EF), yr, t, msg);
    _assert_near(PrtField_y_im(EF), yi, t, msg);
    _assert_near(PrtField_z_re(EF), zr, t, msg);
    _assert_near(PrtField_z_im(EF), zi, t, msg);
    return 0;
}
