# wave_focus test suite — vectorial focusing by an aplanatic lens (Richards-Wolf).
#
# References, none of them this code:
# - The six integrals in 60-digit arithmetic: Bessel functions from their power series, and
#   tanh-sinh quadrature directly in theta, where the library substitutes theta = theta_top -
#   psi^2 and uses Gauss-Legendre. Every input is the exact value of the double passed here.
# - The field formulas, against a brute-force sum over the plane waves leaving the lens, each
#   field vector turned by the lens ray by ray, with no Bessel function and no closed phi
#   integral: x, y, radial, azimuthal and a curved pupil agree to 1e-14 (numpy).
# - Bessel functions: the power series in 50 digits below 50, Hankel's integral above.
# - Closed forms: I00(0, 0) for a uniform pupil, Fraunhofer's peak A/(lambda f) and its phase
#   -i, the Airy pattern and the on-axis sinc^2 at low NA, the paraxial Gaussian beam through
#   the focus (overall phase and Gouy shift included), Parseval's theorem for the power in the
#   focal plane, and the lens equation for where a curved beam focuses.
# - Maxwell: div E = 0, by finite differences, which no formula in the header can satisfy by
#   construction. A wrong sign on E_z, made in the header and the code alike, breaks it.
# - Literature: Dorn, Quabis & Leuchs, arXiv:physics/0310007 (2003), half-maximum spot areas
#   at NA 0.9: 0.31 lambda^2 for uniformly lit linear polarization, 0.2 lambda^2 for the axial
#   field of radial polarization.
# - wave_airy's airy_pattern, which names the low-NA limit.

include "src/error.cyr"
include "src/ray_core.cyr"
include "src/ray_fresnel.cyr"
include "src/ray_trace.cyr"
include "src/ray_prt.cyr"
include "src/ray_dispersion.cyr"
include "src/ray_fiber.cyr"
include "src/wave_core.cyr"
include "src/wave_airy.cyr"
include "src/wave_zernike.cyr"
include "src/lens.cyr"
include "src/wave_beam.cyr"
include "src/wave_focus.cyr"

fn _fd(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _near(a, b, tol) { return f64_le(f64_abs(f64_sub(a, b)), tol); }
fn _assert_near(a, b, tol, msg) { assert(_near(a, b, tol), msg); }
fn _is_nan(x) { return (x & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000; }
fn _sq(x) { return f64_mul(x, x); }

var Z = f64_from(0);
var ONE = F64_ONE;
var TOL15 = _fd(1, 1000000000000000);   # 1e-15
var TOL14 = _fd(1, 100000000000000);    # 1e-14
var TOL13 = _fd(1, 10000000000000);     # 1e-13
var err = 0;
var IB[96];
var BJ[24];
var EF = 0;

alloc_init();
EF = prt_field_new(0, 0, 0, 0, 0, 0);
assert(EF != 0, "prt_field_new");

# Every NaN in a buffer: 1 if all n f64 at p are NaN.
fn _all_nan(p, n) {
    var bad = 0;
    for (var i = 0; i < n; i = i + 1) {
        if (_is_nan(load64(p + i * 8)) == 0) { bad = bad + 1; }
    }
    if (bad == 0) { return 1; }
    return 0;
}

# ── Bessel functions ────────
test_group("focus bessel");

# J0, J1, J2 against the 50-digit references, absolute. ~6e-16 is the Chebyshev sums' rounding.
# 6e-16: the module's stated bound. The first cut's Chebyshev J0 was 1.2e-15 out below 2, at
# the first four points here; a 2500-point sweep below 8 now peaks at 5.4e-16.
var TOLB = _fd(6, 10000000000000000);   # 6e-16
fn _bj(x, j0, j1, j2, msg) {
    _focus_bessel012(x, &BJ);
    _assert_near(load64(&BJ), j0, TOLB, msg);
    _assert_near(load64(&BJ + 8), j1, TOLB, msg);
    _assert_near(load64(&BJ + 16), j2, TOLB, msg);
    return 0;
}
_bj(0x3FC13B5393250B53, 0x3FEFDAECE6C12949, 0x3FB131572B524F05, 0x3F6287C1C138394B, "x = 0.13462300000000002");
_bj(0x3FE00A859BE36688, 0x3FEE056478BB56F9, 0x3FCF15C0BD38FEA7, 0x3F9F7F101EDBBF32, "x = 0.5012844128315956");
_bj(0x3FF0321224DD4A58, 0x3FE8503BDADA352C, 0x3FDC6A82DF4E7790, 0x3FBE1366FC0E8AC7, "x = 1.0122243347183453");
_bj(0x3FF16FFCD9ABAE04, 0x3FE72E35E3881DCE, 0x3FDDF2728DD17CC9, 0x3FC1310571599FA1, "x = 1.0898407461889983");
_bj(0x3E2FC862D3E17360, 0x3FF0000000000000, 0x3E1FC862D3E17360, 0x3C3F91264F0E88EC, "x = 3.7e-09");
_bj(0x3F3ADEA897635E74, 0x3FEFFFFFE97020C7, 0x3F2ADEA88DEA6D47, 0x3E568FDF3760C157, "x = 0.00041");
_bj(0x3FD7AE147AE147AE, 0x3FEEEA04C479D484, 0x3FC746EEC5D72BE5, 0x3F9152FB058CD9B9, "x = 0.37");
_bj(0x3FF2147AE147AE14, 0x3FE6925A4DC2F55A, 0x3FDEAFFC615B2106, 0x3FC2576375665279, "x = 1.13");
_bj(0x3FFFFFFFFFFFFFFF, 0x3FCCA873FB24CEFC, 0x3FE27487958371F0, 0x3FD694D52D747C63, "x = 1.9999999999999998");
_bj(0x4000000000000000, 0x3FCCA873FB24CEF8, 0x3FE27487958371F0, 0x3FD694D52D747C64, "x = 2.0");
_bj(0x4000000000000001, 0x3FCCA873FB24CEEF, 0x3FE27487958371F0, 0x3FD694D52D747C66, "x = 2.0000000000000004");
_bj(0x40033D152E971B40, 0xBC919B7921F03C8E, 0x3FE09CDB36551280, 0x3FDBA1DEEA029494, "x = 2.404825557695773");
_bj(0x4008E147AE147AE1, 0xBFD2E22A803CEA50, 0x3FD3026B326BB2F0, 0x3FDF1BB21CF56A8E, "x = 3.11");
_bj(0x4016147AE147AE14, 0xBEFBDE93A4A69C0A, 0xBFD5C6FA3ADE75C6, 0xBFBF8DEF860F8916, "x = 5.52");
_bj(0x401FFFFFFFFFFFFF, 0x3FC5F8A7557E702D, 0x3FCE08905618617E, 0xBFBCED067FF0AF9A, "x = 7.999999999999999");
_bj(0x4020000000000000, 0x3FC5F8A7557E7025, 0x3FCE089056186183, 0xBFBCED067FF0AF89, "x = 8.0");
_bj(0x4020000000000001, 0x3FC5F8A7557E7016, 0x3FCE08905618618C, 0xBFBCED067FF0AF67, "x = 8.000000000000002");
_bj(0x4023DC28F5C28F5C, 0xBFCF030E4895D710, 0x3FAF32C84376D153, 0x3FD04A9AE0E64622, "x = 9.93");
_bj(0x402B666666666666, 0x3FCA0323E70327E8, 0x3FB442B343D1EBA7, 0xBFC8888C8A3CB58A, "x = 13.7");
_bj(0x403819999999999A, 0xBFA4C9FD0316FDCE, 0xBFC440FEC9FEBD04, 0x3F9C21A7F92BA23D, "x = 24.1");
_bj(0x404CA66666666666, 0x3FBAF72D814CCE6E, 0xBF67C369B6F91FB8, 0xBFBAFDD0307768E1, "x = 57.3");
_bj(0x4060B66666666666, 0x3FA410DC5DD17063, 0x3FAD27628E0B3E82, 0xBFA3A13790BB405A, "x = 133.7");
_bj(0x408C79999999999A, 0x3F9596F5E272B278, 0xBF904FFFF9CB6215, 0xBF95A0205D271013, "x = 911.2");
_bj(0x40B0004CCCCCCCCD, 0x3F7624CAB8BC48EE, 0xBF870120B427CFA5, 0xBF762A8AE54EE355, "x = 4096.3");
_bj(0x40C770599999999A, 0x3F70E1744B8DFED1, 0xBF7898D8838F4D38, 0xBF70E280F1E3DD25, "x = 12000.7");
_focus_bessel012(Z, &BJ);
_assert_near(load64(&BJ), ONE, 0x3CB0000000000000, "J0(0) = 1 to an ulp");
assert_eq(load64(&BJ + 8), Z, "J1(0) = 0");
assert_eq(load64(&BJ + 16), Z, "J2(0) = 0");
# Small arguments keep their RELATIVE accuracy: J1 ~ x/2, J2 ~ x^2/8, to the next term.
var bs_x = 0x3E2FC862D3E17360;           # 3.7e-9
_focus_bessel012(bs_x, &BJ);
_assert_near(f64_div(load64(&BJ + 8), f64_mul(bs_x, F64_HALF)), ONE, TOL15, "J1(3.7e-9) = x/2 relatively");
_assert_near(f64_div(load64(&BJ + 16), f64_div(_sq(bs_x), f64_from(8))), ONE, TOL15, "J2(3.7e-9) = x^2/8 relatively");
# J2 = 2 J1/x - J0 cancels at small x, so below 2 it is its own series. Near 0.37 the
# recurrence leaves up to 1.4e-14 relative even from correctly rounded J0 and J1.
_focus_bessel012(_fd(37, 100), &BJ);
_assert_near(f64_div(load64(&BJ + 16), 0x3F9152FB058CD9B9), ONE, f64_mul(f64_from(2), TOL15), "J2(0.37) relatively");

# ── Refusals ────────
test_group("focus refusals");

var U = FOCUS_PUPIL_UNIFORM;
var GA = FOCUS_PUPIL_GAUSSIAN;
var LAM = _fd(55, 100000000);            # 0.55 um
var FL = _fd(3, 1000);                   # 3 mm
var NAN = 0x7FF8000000000000;
var INF = 0x7FF0000000000000;
fn _refused(na, n1, n2, lambda0, f, pupil, fill, msg) {
    var l = focus_new(na, n1, n2, lambda0, f, pupil, fill, &err);
    assert(l == 0, msg);
    assert_eq(err, PK_ERR_INVALID_PARAMETER, msg);
    return 0;
}
var NA9 = _fd(9, 10);
var _r = _refused(Z, ONE, ONE, LAM, FL, U, 0, "NA 0");
_r = _refused(f64_neg(NA9), ONE, ONE, LAM, FL, U, 0, "NA < 0");
_r = _refused(0x3FF0000000000001, ONE, ONE, LAM, FL, U, 0, "NA one ulp past n2");
_r = _refused(NAN, ONE, ONE, LAM, FL, U, 0, "NA NaN");
_r = _refused(NA9, Z, ONE, LAM, FL, U, 0, "n1 0");
_r = _refused(NA9, ONE, INF, LAM, FL, U, 0, "n2 inf");
_r = _refused(NA9, ONE, ONE, Z, FL, U, 0, "lambda0 0");
_r = _refused(NA9, ONE, ONE, LAM, f64_neg(FL), U, 0, "f < 0");
_r = _refused(NA9, ONE, ONE, LAM, FL, 3, FL, "pupil 3");
_r = _refused(NA9, ONE, ONE, LAM, FL, 0 - 1, FL, "pupil -1");
_r = _refused(NA9, ONE, ONE, LAM, FL, GA, 0, "Gaussian of radius 0");
_r = _refused(NA9, ONE, ONE, LAM, FL, FOCUS_PUPIL_DOUGHNUT, NAN, "doughnut of radius NaN");
_r = _refused(NA9, ONE, ONE, LAM, FL, GA, 0x0000000000000001, "f/w overflows");
var E300 = 0x7E37E43C8800759C;          # 1e300
_r = _refused(0x0000000000000001, ONE, E300, E300, FL, U, 0, "NA/n2 underflows to 0");
_r = _refused(NA9, ONE, 0x7FEFFFFFFFFFFFFF, 0x0010000000000000, FL, U, 0, "n2/lambda0 overflows");
# A uniform pupil does not read fill, so nothing there can refuse it.
var lu = focus_new(NA9, ONE, ONE, LAM, FL, U, NAN, &err);
assert_eq(err, PK_ERR_NONE, "a uniform pupil ignores fill");
assert(lu != 0, "and is made");
assert_eq(FocusLens_fill(lu), Z, "its fill reads 0");
# NA = n2 is a 90-degree half-angle, and allowed.
var l90 = focus_new(_fd(133, 100), ONE, _fd(133, 100), LAM, FL, U, 0, &err);
assert_eq(err, PK_ERR_NONE, "NA = n2");
assert_eq(FocusLens_s_top(l90), ONE, "sin(alpha) = 1 exactly");

# focus_integrals and the fields: refused points write NaN, never a number.
assert_eq(focus_integrals(lu, f64_neg(LAM), Z, &IB), PK_ERR_INVALID_PARAMETER, "rho < 0");
assert(_all_nan(&IB, 12), "and the integrals are NaN");
assert_eq(focus_integrals(lu, INF, Z, &IB), PK_ERR_INVALID_PARAMETER, "rho inf");
assert_eq(focus_integrals(lu, NAN, Z, &IB), PK_ERR_INVALID_PARAMETER, "rho NaN");
assert_eq(focus_integrals(lu, LAM, NAN, &IB), PK_ERR_INVALID_PARAMETER, "z NaN");
assert_eq(focus_integrals(lu, LAM, f64_neg(INF), &IB), PK_ERR_INVALID_PARAMETER, "z -inf");
assert_eq(focus_integrals(0, LAM, Z, &IB), PK_ERR_INVALID_PARAMETER, "null lens");
assert(_all_nan(&IB, 12), "and the integrals are NaN");
assert_eq(focus_integrals(lu, LAM, Z, 0), PK_ERR_INVALID_PARAMETER, "null out");
assert_eq(focus_integrals(lu, 0x8000000000000000, Z, &IB), PK_ERR_NONE, "rho = -0 is the axis");
assert_eq(focus_linear(lu, LAM, NAN, Z, EF), PK_ERR_INVALID_PARAMETER, "phi NaN");
assert(_all_nan(EF, 6), "and the field is NaN");
assert_eq(focus_jones(lu, ONE, INF, Z, Z, LAM, Z, Z, EF), PK_ERR_INVALID_PARAMETER, "a Jones component inf");
assert_eq(focus_radial(lu, f64_neg(LAM), Z, Z, EF), PK_ERR_INVALID_PARAMETER, "radial, rho < 0");
assert(_all_nan(EF, 6), "and the field is NaN");
assert_eq(focus_azimuthal(lu, LAM, INF, Z, EF), PK_ERR_INVALID_PARAMETER, "azimuthal, phi inf");
assert_eq(focus_radial(lu, LAM, Z, Z, 0), PK_ERR_INVALID_PARAMETER, "null field");
assert(_is_nan(focus_intensity(0)), "the intensity of a null field is NaN");

# The panel cap. At NA 0.9 in air the integrand turns through 2 asin(0.9) k rho, 12 rad a
# panel and 2048 panels, so the edge is at rho = 1744.8 wavelengths.
var lc = focus_new(NA9, ONE, ONE, LAM, FL, U, 0, &err);
assert_eq(focus_integrals(lc, f64_mul(f64_from(1740), LAM), Z, &IB), PK_ERR_NONE, "1740 wavelengths off axis");
assert_eq(focus_integrals(lc, f64_mul(f64_from(1750), LAM), Z, &IB), PK_ERR_INVALID_PARAMETER, "1750 refused");
assert(_all_nan(&IB, 12), "and NaN");
# Along the axis it is 2 asin(0.9) 0.9 k z: 1938.7 wavelengths.
assert_eq(focus_integrals(lc, Z, f64_mul(f64_from(1930), LAM), &IB), PK_ERR_NONE, "z 1930 wavelengths");
assert_eq(focus_integrals(lc, Z, f64_mul(f64_from(0 - 1945), LAM), &IB), PK_ERR_INVALID_PARAMETER, "z -1945 refused");
# Past 2^52 wavelengths a double does not resolve the phase k z. A focal length of 2^54
# wavelengths and a Gaussian cut to a 1e-8 rad cone need almost no panels there, so this is the
# guard that refuses it.
var lt_f = f64_mul(0x4350000000000000, LAM);
var lt = focus_new(NA9, ONE, ONE, LAM, lt_f, GA, f64_div(lt_f, f64_from(700000000)), &err);
assert_eq(err, PK_ERR_NONE, "a 1e-8 rad Gaussian cone");
assert_eq(focus_integrals(lt, Z, f64_mul(0x4320000000000000, LAM), &IB), PK_ERR_NONE, "2^51 wavelengths");
assert_eq(focus_integrals(lt, Z, f64_mul(0x4340000000000000, LAM), &IB), PK_ERR_INVALID_PARAMETER, "2^53 refused");
# A point at |z| >= f is at or behind the lens, and one at rho >= f is as far off the axis as
# the lens is from the focus: no field there is this one. f = 100 wavelengths and a 0.01 rad
# cone keep the panel count small, so this is that guard and not the cap.
var ld_f = f64_mul(f64_from(100), LAM);
var ld = focus_new(NA9, ONE, ONE, LAM, ld_f, GA, f64_div(ld_f, f64_from(700)), &err);
assert_eq(err, PK_ERR_NONE, "a short lens");
assert_eq(focus_integrals(ld, Z, f64_mul(_fd(99, 100), ld_f), &IB), PK_ERR_NONE, "z = 0.99 f");
assert_eq(focus_integrals(ld, Z, f64_mul(_fd(0 - 99, 100), ld_f), &IB), PK_ERR_NONE, "z = -0.99 f");
assert_eq(focus_integrals(ld, Z, f64_neg(ld_f), &IB), PK_ERR_INVALID_PARAMETER, "z = -f, the lens, refused");
assert(_all_nan(&IB, 12), "and NaN");
assert_eq(focus_integrals(ld, Z, f64_mul(_fd(0 - 3, 2), ld_f), &IB), PK_ERR_INVALID_PARAMETER,
  "behind the lens refused");
assert_eq(focus_integrals(ld, Z, ld_f, &IB), PK_ERR_INVALID_PARAMETER, "z = f refused");
assert_eq(focus_integrals(ld, f64_mul(_fd(99, 100), ld_f), Z, &IB), PK_ERR_NONE, "rho = 0.99 f");
assert_eq(focus_integrals(ld, ld_f, Z, &IB), PK_ERR_INVALID_PARAMETER, "rho = f refused");
# An azimuth of 2^63 or more has no resolved sine; the field was NaN with PK_ERR_NONE.
assert_eq(focus_linear(lu, LAM, 0x43D0000000000000, Z, EF), PK_ERR_NONE, "phi = 2^62");
assert_eq(focus_linear(lu, LAM, 0x43E0000000000000, Z, EF), PK_ERR_INVALID_PARAMETER, "phi = 2^63 refused");
assert_eq(focus_radial(lu, LAM, f64_neg(0x43E0000000000000), Z, EF), PK_ERR_INVALID_PARAMETER, "radial, phi = -2^63");
assert(_all_nan(EF, 6), "and NaN, all six, where E_z was a number");
assert_eq(focus_azimuthal(lu, LAM, 0x43E0000000000000, Z, EF), PK_ERR_INVALID_PARAMETER, "azimuthal, phi = 2^63");
# The floors. Below 2^-200 the integrands' fifth powers of sin(theta) underflow: NA 1e-200
# gave a field of exactly 0 where pi f NA^2/lambda was 3e-100.
_r = _refused(0x3360000000000000, ONE, ONE, LAM, FL, U, 0, "NA/n2 = 2^-201");
_r = _refused(NA9, ONE, ONE, LAM, FL, GA, f64_mul(FL, 0x32D0000000000000), "a Gaussian cut below 2^-200");
_r = _refused(NA9, ONE, ONE, LAM, 0x01A56E1FC2F8F359, U, 0, "A = pi f/lambda under 2^-200 (f = 1e-300)");
var lf_s = 0x3380000000000000;          # NA = 2^-199, just over
var lfl = focus_new(lf_s, ONE, ONE, LAM, FL, U, 0, &err);
assert_eq(err, PK_ERR_NONE, "NA = 2^-199");
assert_eq(focus_linear(lfl, Z, Z, Z, EF), PK_ERR_NONE, "its field");
_assert_near(f64_div(f64_neg(PrtField_x_im(EF)), f64_mul(FocusLens_pref(lfl), _sq(lf_s))), ONE, TOL14,
  "is -i A NA^2, every digit there");
# A field that overflows is refused, not handed back: 2A from an A near 1e308 was inf and NaN.
var lo = focus_new(NA9, ONE, ONE, ONE, 0x7FD0000000000000, U, 0, &err);       # f = 2^1022
assert_eq(err, PK_ERR_NONE, "A = 1.4e308 is a double");
assert_eq(focus_radial(lo, Z, Z, Z, EF), PK_ERR_INVALID_PARAMETER, "but 2A is not");
assert(_all_nan(EF, 6), "and the field is NaN");
var DMAX = 0x7FEFFFFFFFFFFFFF;
assert_eq(focus_jones(lu, DMAX, Z, DMAX, Z, LAM, _fd(3, 10), Z, EF), PK_ERR_INVALID_PARAMETER, "Jones (1e308, 1e308)");
assert(_all_nan(EF, 6), "and NaN");

# focus_from_beam.
var bm0 = gaussian_beam_new(_fd(2, 10000), _fd(5, 10000000), &err);
var lfb = focus_from_beam(0, NA9, ONE, ONE, FL, GA, &err);
assert(lfb == 0, "null beam");
assert_eq(err, PK_ERR_INVALID_PARAMETER, "null beam refused");
lfb = focus_from_beam(bm0, NA9, ONE, ONE, FL, U, &err);
assert_eq(err, PK_ERR_INVALID_PARAMETER, "a beam is not a uniform pupil");
lfb = focus_from_beam(bm0, _fd(14, 10), ONE, ONE, FL, GA, &err);
assert_eq(err, PK_ERR_INVALID_PARAMETER, "focus_new's refusals hold");
lfb = focus_from_beam(bm0, NA9, _fd(3, 2), ONE, FL, FOCUS_PUPIL_DOUGHNUT, &err);
assert_eq(err, PK_ERR_NONE, "a beam at its waist");
assert_eq(FocusLens_fill(lfb), beam_radius(bm0), "w is the beam's radius");
assert_eq(FocusLens_lambda0(lfb), f64_mul(_fd(5, 10000000), _fd(3, 2)), "lambda0 is n1 times the beam's wavelength");
assert_eq(FocusLens_qc(lfb), Z, "a waist has a flat wavefront");
assert_eq(FocusLens_pupil(lfb), FOCUS_PUPIL_DOUGHNUT, "and keeps its pupil");
# The pupil phase f^2/(2 R lambda_b) cycles, where f^2 alone underflows: f = 1e-170 with
# lambda_b = 1e-200 and q = (1 + i) 1e-180 is 2.5e39 cycles, and the first cut said 0.
var bmu = gaussian_beam_from_q(0x1A90991A9BFA58C8, 0x1A90991A9BFA58C8, 0x16687E92154EF7AC, &err);
assert_eq(err, PK_ERR_NONE, "a beam of 1e-180 m");
var fu = 0x1CA3529BA7D19EAF;              # 1e-170
lfb = focus_from_beam(bmu, NA9, ONE, ONE, fu, GA, &err);
assert_eq(err, PK_ERR_NONE, "focus_from_beam");
var qu = f64_div(f64_mul(fu, f64_mul(fu, beam_curvature(bmu))), f64_add(0x16687E92154EF7AC, 0x16687E92154EF7AC));
_assert_near(f64_div(FocusLens_qc(lfb), qu), ONE, TOL14, "qc = f^2/(2 R lambda_b), not 0");

# ── The integrals ────────
test_group("focus integrals");

# Pins from the 60-digit route, each to TOLI of the lens's |I00(0, 0)|, plus what the input
# the phase k z = 2 pi n2 z/lambda0 allows: formed in doubles it carries the two roundings of
# n2/lambda0 and its product with z, up to 1.4e-15 rad per wavelength of z, and that error is
# common to every node, so nothing averages it away. Measured: 1.25e-15 and 3.8e-16 per
# wavelength, against the module's stated 1.3e-15 and 4e-16.
var TOLI = f64_mul(f64_from(2), TOL15);
var TOLZ = TOL15;                        # per wavelength
var AT_Z = Z;                            # |n2 z/lambda0| at the last point
fn _at(l, rho, z) {
    assert_eq(focus_integrals(l, rho, z, &IB), PK_ERR_NONE, "focus_integrals");
    AT_Z = f64_abs(f64_mul(FocusLens_cyc(l), z));
    return 0;
}
fn _pin(i, re, im, s, msg) {
    var t = f64_mul(f64_add(TOLI, f64_mul(TOLZ, AT_Z)), s);
    _assert_near(load64(&IB + i * 16), re, t, msg);
    _assert_near(load64(&IB + i * 16 + 8), im, t, msg);
    return 0;
}
var LA = focus_new(0x3FECCCCCCCCCCCCD, 0x3FF0000000000000, 0x3FF0000000000000, 0x3EA53BB5EA8666CF, 0x3F661E4F765FD8AE,
  FOCUS_PUPIL_UNIFORM,
  0, &err);    # NA 0.9, n 1.0 -> 1.0, 6.328e-07 m, f 0.0027 m, w None
assert_eq(err, PK_ERR_NONE, "LA");
var LB = focus_new(0x3FF4CCCCCCCCCCCD, 0x3FF0000000000000, 0x3FF849BA5E353F7D, 0x3EA05FE359450486, 0x3F5D7DBF487FCB92,
  FOCUS_PUPIL_GAUSSIAN,
