_fr(LD, 0x3E8CFDB417C18A1B, 0x3FD999999999999A, 0x3E93DD3DC46CE81C);
_fp(0x401FD9D9DFAF403A, 0xC001E4A733140C78, 0x400AEEC92F446BCD, 0xBFEE42AD22BEE4C2, 0x4006E388628F2BF8,
  0x40246B8497D9A03E,
  LD, S_LD, "LD radial (0.27, 0.4, 0.37)");
_fa(LD, 0x3E8CFDB417C18A1B, 0x3FD999999999999A, 0x3E93DD3DC46CE81C);
_fp(0xC00B19D8D265A31F, 0x3FEE3284A8B76007, 0x40200663467E30D3, 0xC001DB19471610A3, 0x0000000000000000,
  0x0000000000000000,
  LD, S_LD, "LD azimuthal (0.27, 0.4, 0.37)");
_fj(LA, 0x3FF0000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x3EFB6776C9157649,
  0x4004CCCCCCCCCCCD, 0xBEE4D5CA8153E1AE);
_fp(0x401D7012219882C5, 0x400760070857CFAA, 0x40096524593780A4, 0x3FECF884D08334C9, 0xC025693C11C76E48,
  0xC01920F4B1974692,
  LA, S_LA, "LA x (41.3, 2.6, -15.7)");
_fj(LA, 0x3FE6A09E667F3BCD, 0x0000000000000000, 0x0000000000000000, 0x3FE6A09E667F3BCD, 0x3EFB6776C9157649,
  0x4004CCCCCCCCCCCD, 0xBEE4D5CA8153E1AE);
_fp(0x40124145DF7BA3B8, 0x40113E2C8ADB74B5, 0xBFE003B2BCCA565E, 0x4020731E7A5252E6, 0xC0247C15E4C55483,
  0x3FBCA493618AE83B,
  LA, S_LA, "LA circular (41.3, 2.6, -15.7)");
_fj(LA, 0x3FE3333333333333, 0x3FC999999999999A, 0xBFD3333333333333, 0x3FE6666666666666, 0x3EFB6776C9157649,
  0x4004CCCCCCCCCCCD, 0xBEE4D5CA8153E1AE);
_fp(0x4001F63F00FDD6C3, 0x4014B3B3E0A0F37F, 0xC010D8EA57065C40, 0x401E16684DC368BF, 0xC0237D355AEE6886,
  0xC00449954E6999FA,
  LA, S_LA, "LA elliptical (41.3, 2.6, -15.7)");
_fr(LA, 0x3EFB6776C9157649, 0x4004CCCCCCCCCCCD, 0xBEE4D5CA8153E1AE);
_fp(0xC01515F8766E262F, 0xC00918ADEB6AB773, 0x40095ECD36466C94, 0x3FFE322175B7C474, 0x4026C30424A08BEE,
  0x400E85A765D47296,
  LA, S_LA, "LA radial (41.3, 2.6, -15.7)");
_fa(LA, 0x3EFB6776C9157649, 0x4004CCCCCCCCCCCD, 0xBEE4D5CA8153E1AE);
_fp(0xC01CD5A00C13CCB3, 0xC01076F0D77BE061, 0xC027F7076452B850, 0xC01B5E41EC20F8E5, 0x0000000000000000,
  0x0000000000000000,
  LA, S_LA, "LA azimuthal (41.3, 2.6, -15.7)");
# focus_linear is the x-polarized Jones vector.
var fl_r = f64_mul(_fd(47, 100), LAM);
var fl_p = _fd(0 - 113, 100);
var fl_z = f64_mul(_fd(19, 100), LAM);
var FX = prt_field_new(0, 0, 0, 0, 0, 0);
assert_eq(focus_linear(LB, fl_r, fl_p, fl_z, FX), PK_ERR_NONE, "focus_linear");
_fj(LB, ONE, Z, Z, Z, fl_r, fl_p, fl_z);
var fl_bad = 0;
for (var fl_i = 0; fl_i < 6; fl_i = fl_i + 1) {
    if (load64(FX + fl_i * 8) != load64(EF + fl_i * 8)) { fl_bad = fl_bad + 1; }
}
assert_eq(fl_bad, 0, "focus_linear = focus_jones(1, 0)");
# y-polarized light is x-polarized light turned 90 degrees: E_y(rho, phi) = R E_x(rho, phi - 90).
_fj(LB, Z, Z, ONE, Z, fl_r, fl_p, fl_z);
assert_eq(focus_linear(LB, fl_r, f64_sub(fl_p, F64_PI_2), fl_z, FX), PK_ERR_NONE, "x-polarized, turned");
var ty = f64_mul(TOL14, f64_mul(FocusLens_pref(LB), S_LB));
_assert_near(PrtField_x_re(EF), f64_neg(PrtField_y_re(FX)), ty, "y-pol E_x = -(x-pol E_y), turned");
_assert_near(PrtField_x_im(EF), f64_neg(PrtField_y_im(FX)), ty, "y-pol E_x im");
_assert_near(PrtField_y_re(EF), PrtField_x_re(FX), ty, "y-pol E_y = x-pol E_x, turned");
_assert_near(PrtField_y_im(EF), PrtField_x_im(FX), ty, "y-pol E_y im");
_assert_near(PrtField_z_re(EF), PrtField_z_re(FX), ty, "y-pol E_z = x-pol E_z, turned");
_assert_near(PrtField_z_im(EF), PrtField_z_im(FX), ty, "y-pol E_z im");
# Circular light focuses to a spot with no preferred direction: |E|^2 the same at every phi.
var R2 = 0x3FE6A09E667F3BCD;            # 1/sqrt(2)
_fj(LB, R2, Z, Z, R2, fl_r, Z, fl_z);
var ci0 = focus_intensity(EF);
var ci_bad = 0;
for (var ci_k = 1; ci_k < 9; ci_k = ci_k + 1) {
    _fj(LB, R2, Z, Z, R2, fl_r, f64_mul(_fd(7 * ci_k, 10), ONE), fl_z);
    if (_near(focus_intensity(EF), ci0, f64_mul(TOL14, ci0)) == 0) { ci_bad = ci_bad + 1; }
}
assert_eq(ci_bad, 0, "circular: |E|^2 independent of phi");
# Linear light focuses to a spot longer along its polarization (Richards & Wolf).
_fj(LA, ONE, Z, Z, Z, f64_mul(_fd(1, 4), FocusLens_lambda0(LA)), Z, Z);
var el_x = focus_intensity(EF);
_fj(LA, ONE, Z, Z, Z, f64_mul(_fd(1, 4), FocusLens_lambda0(LA)), F64_PI_2, Z);
assert(f64_gt(el_x, f64_mul(_fd(6, 5), focus_intensity(EF))), "x-polarized: brighter along x than y at 0.25 lambda");
# On the axis: x-polarized light has no E_y or E_z; radial has only E_z; azimuthal is dark.
_fj(LA, ONE, Z, Z, Z, Z, _fd(7, 10), Z);
assert_eq((PrtField_y_re(EF) | PrtField_y_im(EF) | PrtField_z_re(EF) | PrtField_z_im(EF)) & AX, Z,
  "x-pol on axis: E_y = E_z = 0");
_fr(LA, Z, _fd(7, 10), Z);
assert_eq((PrtField_x_re(EF) | PrtField_x_im(EF) | PrtField_y_re(EF) | PrtField_y_im(EF)) & AX, Z,
  "radial on axis: only E_z");
assert(f64_gt(f64_abs(PrtField_z_im(EF)), Z), "and E_z is there");
_fa(LA, Z, _fd(7, 10), Z);
assert_eq(focus_intensity(EF), Z, "azimuthal on axis: dark");
# Off it, radial light has no phi component and azimuthal light only that.
var rp = _fd(0 - 23, 10);
_fr(LC, fl_r, rp, fl_z);
var rp_t = f64_mul(TOL15, f64_mul(FocusLens_pref(LC), S_LC));
_assert_near(f64_sub(f64_mul(PrtField_x_re(EF), _prk_sin(rp)), f64_mul(PrtField_y_re(EF), _prk_cos(rp))), Z, rp_t,
  "radial: E . phi-hat = 0");
_fa(LC, fl_r, rp, fl_z);
_assert_near(f64_add(f64_mul(PrtField_x_re(EF), _prk_cos(rp)), f64_mul(PrtField_y_re(EF), _prk_sin(rp))), Z, rp_t,
  "azimuthal: E . rho-hat = 0");
assert_eq((PrtField_z_re(EF) | PrtField_z_im(EF)) & AX, Z, "azimuthal: E_z = 0");

# ── Limits and closed forms ────────
test_group("focus limits");

# Low NA: the scalar theory. At NA 0.001 its corrections are O(NA^2), ~2e-7 here. f = 10 m
# makes the aperture 1 cm and its Fresnel number 18, a lens for which Debye holds; the sinc^2
# below reaches 2 m from the focus, inside f.
var LL_F = f64_from(10);
var LL = focus_new(_fd(1, 1000), ONE, ONE, LAM, LL_F, U, 0, &err);
assert_eq(err, PK_ERR_NONE, "NA 0.001");
var ll_k = f64_mul(F64_TAU, f64_div(ONE, LAM));
var ll_a = f64_mul(LL_F, _fd(1, 1000));                  # a = f NA
# Fraunhofer, by Kirchhoff in this time convention: E(0) = -i pi a^2/(lambda f) for E0 = 1,
# with e^(i k f) dropped. The size, and the phase: exactly -i.
_fj(LL, ONE, Z, Z, Z, Z, Z, Z);
var ll_0 = focus_intensity(EF);
var ll_f = f64_div(f64_mul(F64_PI, _sq(ll_a)), f64_mul(LAM, LL_F));
_assert_near(f64_div(f64_neg(PrtField_x_im(EF)), ll_f), ONE, TOL13, "E_x(0) = -i pi a^2/(lambda f)");
assert_eq(PrtField_x_re(EF) & AX, Z, "with no real part");
# Airy: |E(rho)|^2/|E(0)|^2 = (2 J1(v)/v)^2, v = k rho sin(alpha), as airy_pattern gives it for
# an aperture of diameter 2a at the angle asin(rho/f). bessel_j1 there is good to 1e-7.
var TOLL = _fd(5, 10000000);            # 5e-7
var ai_bad = 0;
for (var ai_k = 1; ai_k < 26; ai_k = ai_k + 1) {
    var ai_v = f64_mul(_fd(ai_k, 2), _fd(4, 5));                  # v to 10, past the third ring
    var ai_r = f64_div(ai_v, f64_mul(ll_k, _fd(1, 1000)));
    _fj(LL, ONE, Z, Z, Z, ai_r, _fd(3, 10), Z);
    var ai_y = airy_pattern(LAM, f64_add(ll_a, ll_a), ganita_f64_asin(f64_div(ai_r, LL_F)), ONE);
    if (_near(f64_div(focus_intensity(EF), ll_0), ai_y, TOLL) == 0) { ai_bad = ai_bad + 1; }
}
assert_eq(ai_bad, 0, "NA 0.001 is the Airy pattern to 5e-7");
# The first dark ring, at the first zero of J1, 3.8317059702075123.
_fj(LL, ONE, Z, Z, Z, f64_div(0x400EA75575AF6F09, f64_mul(ll_k, _fd(1, 1000))), Z, Z);
assert(f64_lt(f64_div(focus_intensity(EF), ll_0), TOLL), "dark at the first zero of J1");
# Along the axis: sinc^2(u/4), u = k z sin^2(alpha) (Born & Wolf 8.8).
var sc_bad = 0;
for (var sc_k = 1; sc_k < 30; sc_k = sc_k + 1) {
    var sc_u = f64_mul(f64_from(sc_k), _fd(4, 5));
    var sc_z = f64_div(sc_u, f64_mul(ll_k, _fd(1, 1000000)));
    _fj(LL, ONE, Z, Z, Z, Z, Z, sc_z);
    var sc_q = f64_mul(sc_u, _fd(1, 4));
    var sc_s = _sq(f64_div(_prk_sin(sc_q), sc_q));
    if (_near(f64_div(focus_intensity(EF), ll_0), sc_s, TOLL) == 0) { sc_bad = sc_bad + 1; }
}
assert_eq(sc_bad, 0, "NA 0.001 on the axis is sinc^2(u/4) to 5e-7");

# The overall phase, through the focus. A Gaussian of w = f NA/3 focused at NA 0.05 is a
# paraxial Gaussian beam, and on the axis that is closed: the lens leaves E0 e^(i k h^2/(2 q_L)),
# 1/q_L = -1/f + 2i/(k w^2), and the field at z is E0 q_L/(q_L + f + z) e^(i k z), e^(i k f)
# dropped. Before the focus it is the converging wave +E0 f/|z|; at it, -i in phase; after it,
# negated: the Gouy shift. The first cut was the negative of all of it. Debye against Fresnel
# differs by ~1/(Fresnel number), 5.7e-3 at worst here.
var gp_f = _fd(1, 10);
var gp_l = 0x3EA0C6F7A0B5ED8D;          # 500 nm
var gp_w = 0x3F5B4E81B4E81B50;          # f NA/3
var GP = focus_new(_fd(5, 100), ONE, ONE, gp_l, gp_f, GA, gp_w, &err);
assert_eq(err, PK_ERR_NONE, "the paraxial Gaussian lens");
var gp_k = f64_div(F64_TAU, gp_l);
var gp_dr = f64_neg(f64_div(ONE, gp_f));                         # 1/q_L
var gp_di = f64_div(F64_TWO, f64_mul(gp_k, _sq(gp_w)));
var gp_d2 = f64_add(_sq(gp_dr), _sq(gp_di));
var gp_qr = f64_div(gp_dr, gp_d2);                               # q_L
var gp_qi = f64_neg(f64_div(gp_di, gp_d2));
var gp_bad = 0;
for (var gp_j = 0; gp_j < 6; gp_j = gp_j + 1) {
    var gp_z = f64_mul(f64_from(0 - 10), _fd(1, 1000));                       # -10 mm
    if (gp_j == 1) { gp_z = f64_mul(f64_from(0 - 1), _fd(1, 1000)); }
    if (gp_j == 2) { gp_z = f64_mul(f64_from(0 - 2), _fd(1, 10000)); }
    if (gp_j == 3) { gp_z = Z; }
    if (gp_j == 4) { gp_z = f64_mul(f64_from(3), _fd(1, 10000)); }
    if (gp_j == 5) { gp_z = f64_mul(f64_from(3), _fd(1, 1000)); }
    # q_L/(q_L + f + z) e^(i k z)
    var dr = f64_add(f64_add(gp_qr, gp_f), gp_z);
    var dd = f64_add(_sq(dr), _sq(gp_qi));
    var rr = f64_div(f64_add(f64_mul(gp_qr, dr), _sq(gp_qi)), dd);
    var ri = f64_div(f64_sub(f64_mul(gp_qi, dr), f64_mul(gp_qr, gp_qi)), dd);
    var ph = _prk_cycles_phase(f64_div(gp_z, gp_l));
    var er = f64_sub(f64_mul(rr, _prk_cos(ph)), f64_mul(ri, _prk_sin(ph)));
    var ei = f64_add(f64_mul(rr, _prk_sin(ph)), f64_mul(ri, _prk_cos(ph)));
    _fj(GP, ONE, Z, Z, Z, Z, Z, gp_z);
    var dif = f64_sqrt(f64_add(_sq(f64_sub(PrtField_x_re(EF), er)), _sq(f64_sub(PrtField_x_im(EF), ei))));
    if (f64_lt(dif, f64_mul(_fd(1, 100), f64_sqrt(f64_add(_sq(er), _sq(ei))))) == 0) { gp_bad = gp_bad + 1; }
}
assert_eq(gp_bad, 0, "on axis through the focus, the paraxial Gaussian beam to 1%");

# Maxwell: div E = 0 in a homogeneous medium. Fourth-order central differences at k h = 0.009,
# truncation ~2e-10 of the terms. Nothing here is the header's formulas, so a sign on E_z made
# in both the formulas and the code would read ~1; the module reads ~1e-9.
var DQ[16];
fn _fxyz(l, mode, x, y, z) {
    var r = f64_sqrt(f64_add(_sq(x), _sq(y)));
    var p = ganita_f64_atan2(y, x);
    if (mode == 0) { _fj(l, ONE, Z, Z, Z, r, p, z); }
    if (mode == 1) { _fj(l, _fd(6, 10), _fd(2, 10), _fd(0 - 3, 10), _fd(7, 10), r, p, z); }
    if (mode == 2) { _fr(l, r, p, z); }
    if (mode == 3) { _fa(l, r, p, z); }
    return 0;
}
# d E_ax / d ax, re and im into DQ.
fn _dq(l, mode, x, y, z, ax, h) {
    var sr = Z;
    var si = Z;
    for (var j = 0; j < 4; j = j + 1) {
        var o = f64_from(0 - 2);
        var w = f64_from(1);
        if (j == 1) { o = f64_from(0 - 1); w = f64_from(0 - 8); }
        if (j == 2) { o = ONE; w = f64_from(8); }
        if (j == 3) { o = F64_TWO; w = f64_from(0 - 1); }
        var d = f64_mul(o, h);
        if (ax == 0) { _fxyz(l, mode, f64_add(x, d), y, z); }
        if (ax == 1) { _fxyz(l, mode, x, f64_add(y, d), z); }
        if (ax == 2) { _fxyz(l, mode, x, y, f64_add(z, d)); }
        sr = f64_add(sr, f64_mul(w, load64(EF + ax * 16)));
        si = f64_add(si, f64_mul(w, load64(EF + ax * 16 + 8)));
    }
    store64(&DQ, f64_div(sr, f64_mul(f64_from(12), h)));
    store64(&DQ + 8, f64_div(si, f64_mul(f64_from(12), h)));
    return 0;
}
# |div E| / sum |d E_i/d x_i|.
fn _div(l, mode, x, y, z) {
    var h = f64_div(FocusLens_lambda0(l), f64_from(700));
    var dr = Z;
    var di = Z;
    var sc = Z;
    for (var ax = 0; ax < 3; ax = ax + 1) {
        _dq(l, mode, x, y, z, ax, h);
        dr = f64_add(dr, load64(&DQ));
        di = f64_add(di, load64(&DQ + 8));
        sc = f64_add(sc, f64_sqrt(f64_add(_sq(load64(&DQ)), _sq(load64(&DQ + 8)))));
    }
    return f64_div(f64_sqrt(f64_add(_sq(dr), _sq(di))), sc);
}
# _div at (x, y, z) given in hundredths of the lens's lambda0.
fn _divh(l, mode, x, y, z) {
    var u = f64_mul(_fd(1, 100), FocusLens_lambda0(l));
    return _div(l, mode, f64_mul(f64_from(x), u), f64_mul(f64_from(y), u), f64_mul(f64_from(z), u));
}
var dv_bad = 0;
for (var dv_m = 0; dv_m < 4; dv_m = dv_m + 1) {
    if (f64_lt(_divh(LB, dv_m, 31, 0 - 17, 23), _fd(1, 10000000)) == 0) { dv_bad = dv_bad + 1; }
    if (f64_lt(_divh(LC, dv_m, 0 - 44, 29, 0 - 37), _fd(1, 10000000)) == 0) { dv_bad = dv_bad + 1; }
}
assert_eq(dv_bad, 0, "div E = 0 to 1e-7: x, elliptical, radial, azimuthal; oil and NA = n2");

# Parseval: the plane waves leaving the lens carry the pupil's power, so whatever the
# polarization, int |E|^2 dA over the focal plane = (n1/n2) 2 pi f^2 int |g|^2 sin dtheta.
# Smooth pupils only, so that the focal field dies fast: x-polarized with a Gaussian, radial and
# azimuthal with a doughnut. Both are cut at h = 7w, theta_top = asin(0.6), inside NA 0.95 n2.
var pv_n2 = _fd(133, 100);
var pv_f = _fd(2, 1000);
var pv_w = f64_div(f64_mul(pv_f, _fd(6, 10)), f64_from(7));
var GX[512];
var GW[512];
_lens_gauss(16, &GX, &GW);
var HX[512];
var HW[512];
_lens_gauss(64, &HX, &HW);
# (n1/n2) 2 pi f^2 int_0^theta_top |g|^2 sin dtheta, by 64-point Gauss-Legendre.
fn _pv_rhs(l, doughnut) {
    var th = FocusLens_theta(l);
    var beta = FocusLens_beta(l);
    var s = Z;
    for (var i = 0; i < 64; i = i + 1) {
        var t = f64_mul(f64_mul(f64_add(load64(&HX + i * 8), ONE), F64_HALF), th);
        var sn = _prk_sin(t);
        var u = f64_mul(beta, sn);
        var g2 = f64_exp(f64_neg(f64_mul(F64_TWO, _sq(u))));
        if (doughnut == 1) { g2 = f64_mul(g2, _sq(u)); }
        s = f64_add(s, f64_mul(load64(&HW + i * 8), f64_mul(g2, sn)));
    }
    s = f64_mul(s, f64_mul(th, F64_HALF));
    var r = f64_div(FocusLens_n1(l), FocusLens_n2(l));
    return f64_mul(f64_mul(r, f64_mul(F64_TAU, _sq(FocusLens_focal(l)))), s);
}
# 2 pi A^2 int_0^R rho (sum over the phi-averaged |E|^2) drho, R = 15 lambda0 in 6 panels.
# x-polarized: |I00|^2 + |I02|^2 + 2|I01|^2; radial 4(|Irho|^2 + |Iz|^2); azimuthal 4|Iphi|^2.
var PV[24];
fn _pv_lhs(l) {
    for (var j = 0; j < 3; j = j + 1) { store64(&PV + j * 8, Z); }
    var rmax = f64_mul(f64_from(15), FocusLens_lambda0(l));
    var hp = f64_div(rmax, f64_from(6));
    for (var p = 0; p < 6; p = p + 1) {
        for (var i = 0; i < 16; i = i + 1) {
            var r = f64_mul(hp, f64_add(f64_from(p), f64_mul(f64_add(load64(&GX + i * 8), ONE), F64_HALF)));
            var w = f64_mul(f64_mul(load64(&GW + i * 8), f64_mul(hp, F64_HALF)), r);
            _at(l, r, Z);
            var m2[48];
            for (var q = 0; q < 6; q = q + 1) {
                store64(&m2 + q * 8, f64_add(_sq(load64(&IB + q * 16)), _sq(load64(&IB + q * 16 + 8))));
            }
            var lin = f64_add(f64_add(load64(&m2), load64(&m2 + 16)), f64_mul(F64_TWO, load64(&m2 + 8)));
            var rad = f64_mul(f64_from(4), f64_add(load64(&m2 + 24), load64(&m2 + 32)));
            var azi = f64_mul(f64_from(4), load64(&m2 + 40));
            store64(&PV, f64_add(load64(&PV), f64_mul(w, lin)));
            store64(&PV + 8, f64_add(load64(&PV + 8), f64_mul(w, rad)));
            store64(&PV + 16, f64_add(load64(&PV + 16), f64_mul(w, azi)));
        }
    }
    var a2 = f64_mul(F64_TAU, _sq(FocusLens_pref(l)));
    for (var k = 0; k < 3; k = k + 1) { store64(&PV + k * 8, f64_mul(a2, load64(&PV + k * 8))); }
    return 0;
}
var PG = focus_new(f64_mul(_fd(95, 100), pv_n2), ONE, pv_n2, LAM, pv_f, GA, pv_w, &err);
assert_eq(err, PK_ERR_NONE, "Parseval's Gaussian lens");
_assert_near(FocusLens_s_top(PG), _fd(6, 10), TOL15, "cut at sin = 0.6");
var _p = _pv_lhs(PG);
_assert_near(f64_div(load64(&PV), _pv_rhs(PG, 0)), ONE, TOL14, "x-polarized, Gaussian: focal power = pupil power");
var PD = focus_new(f64_mul(_fd(95, 100), pv_n2), ONE, pv_n2, LAM, pv_f, FOCUS_PUPIL_DOUGHNUT, pv_w, &err);
assert_eq(err, PK_ERR_NONE, "Parseval's doughnut lens");
_p = _pv_lhs(PD);
var pv_d = _pv_rhs(PD, 1);
_assert_near(f64_div(load64(&PV + 8), pv_d), ONE, TOL14, "radial, doughnut: focal power = pupil power");
_assert_near(f64_div(load64(&PV + 16), pv_d), ONE, TOL14, "azimuthal, doughnut: focal power = pupil power");

# A curved beam focuses where the lens equation says: past the geometric focus by
# (n1/n2) f^2/R for a diverging beam, before it for a converging one, at low NA to O(NA^2).
# Here the parabola through three on-axis points has its vertex within 1% of that. n1 = 1.2,
# so a lambda0 that was not n1 times the beam's wavelength would put it 20% off.
fn _shift(zb) {
    var w0 = _fd(2, 10000);
    var lb = _fd(5, 10000000);
    var bm = gaussian_beam_new(w0, lb, &err);
    assert_eq(beam_propagate(bm, zb), PK_ERR_NONE, "beam_propagate");
    var l = focus_from_beam(bm, _fd(133, 1000), _fd(6, 5), _fd(133, 100), _fd(1, 100), GA, &err);
    assert_eq(err, PK_ERR_NONE, "focus_from_beam");
    var ze = f64_mul(f64_mul(_fd(120, 133), _sq(_fd(1, 100))), beam_curvature(bm));
    var d = _fd(25, 800000);
    var iv[24];
    for (var j = 0; j < 3; j = j + 1) {
        var z = f64_add(ze, f64_mul(f64_from(j - 1), d));
        assert_eq(focus_linear(l, Z, Z, z, EF), PK_ERR_NONE, "on axis");
        store64(&iv + j * 8, focus_intensity(EF));
    }
    var im = load64(&iv);
    var i0 = load64(&iv + 8);
    var ip = load64(&iv + 16);
    var off = f64_div(f64_mul(d, f64_sub(im, ip)), f64_mul(F64_TWO, f64_add(f64_sub(im, f64_mul(F64_TWO, i0)), ip)));
    assert(f64_lt(f64_abs(off), f64_mul(_fd(1, 100), f64_abs(ze))), "the focus moves by (n1/n2) f^2/R");
    assert(f64_gt(i0, im) & f64_gt(i0, ip), "and is a maximum there");
    return ze;
}
assert(f64_gt(_shift(_fd(1, 2)), Z), "a diverging beam focuses past f");
assert(f64_lt(_shift(_fd(0 - 1, 2)), Z), "a converging beam before it");

# Dorn, Quabis & Leuchs at NA 0.9, the area inside the half-maximum contour of |E|^2: 0.31
# lambda^2 for linear polarization and a uniform pupil (here 0.3139), 0.2 lambda^2 for the axial
# field of radial polarization alone (here 0.2013).
var dn_l = FocusLens_lambda0(lc);
fn _dn_lin(r, phi) {
    _fj(lc, ONE, Z, Z, Z, r, phi, Z);
    return focus_intensity(EF);
}
fn _dn_half(phi, peak, radial) {
    var lo = Z;
    var hi = dn_l;
    for (var i = 0; i < 48; i = i + 1) {
        var m = f64_mul(f64_add(lo, hi), F64_HALF);
        var v = Z;
        if (radial == 1) {
            _fr(lc, m, Z, Z);
            v = f64_add(_sq(PrtField_z_re(EF)), _sq(PrtField_z_im(EF)));
        } else {
            v = _dn_lin(m, phi);
        }
        if (f64_gt(v, f64_mul(peak, F64_HALF)) == 1) { lo = m; } else { hi = m; }
    }
    return f64_mul(f64_add(lo, hi), F64_HALF);
}
var dn_pk = _dn_lin(Z, Z);
var dn_a = Z;
_lens_gauss(12, &GX, &GW);
for (var dn_i = 0; dn_i < 12; dn_i = dn_i + 1) {
    var dn_phi = f64_mul(f64_add(load64(&GX + dn_i * 8), ONE), f64_mul(F64_PI, _fd(1, 4)));
    var dn_r = _dn_half(dn_phi, dn_pk, 0);
    dn_a = f64_add(dn_a, f64_mul(load64(&GW + dn_i * 8), _sq(dn_r)));
}
dn_a = f64_div(f64_mul(dn_a, F64_PI_2), _sq(dn_l));     # 4 quadrants x (pi/4) x r^2/2
_assert_near(dn_a, _fd(31, 100), _fd(5, 1000), "linear, uniform: 0.31 lambda^2 (Dorn et al.)");
_fr(lc, Z, Z, Z);
var dz_r = _dn_half(Z, f64_add(_sq(PrtField_z_re(EF)), _sq(PrtField_z_im(EF))), 1);
var dz_a = f64_div(f64_mul(F64_PI, _sq(dz_r)), _sq(dn_l));
_assert_near(dz_a, _fd(2, 10), _fd(5, 1000), "radial, |E_z|^2 alone: 0.2 lambda^2 (Dorn et al.)");

var r = assert_summary();
