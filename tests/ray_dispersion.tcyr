# ray dispersion test suite — ported from rust-old/src/ray/dispersion.rs.
# Covers Cauchy/Sellmeier/Herzberger/Schott/Conrady, prisms, Abbe, chromatic ab.
# (SellmeierCoefficients' serde roundtrip lives in tests/serialize.tcyr)

include "src/error.cyr"
include "src/ray_core.cyr"
include "src/ray_fresnel.cyr"
include "src/ray_trace.cyr"
include "src/ray_dispersion.cyr"

fn _fd(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _near(a, b, tol) { return f64_lt(f64_abs(f64_sub(a, b)), tol); }
fn _assert_near(a, b, tol, msg) { assert(_near(a, b, tol), msg); }
fn _between(x, lo, hi) {
    if (f64_lt(x, lo) == 1) { return 0; }
    if (f64_gt(x, hi) == 1) { return 0; }
    return 1;
}
fn _is_finite(x) { return f64_lt(f64_abs(x), 0x7FF0000000000000); }
fn _n3(x, y, z) {
    var l = f64_sqrt(f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(z, z)));
    return ray_vec3(f64_div(x, l), f64_div(y, l), f64_div(z, l));
}

var TOL6 = f64_div(F64_ONE, f64_from(1000000));    # 1e-6
var TOL3 = f64_div(F64_ONE, f64_from(1000));       # 0.001
var TOL4 = f64_div(F64_ONE, f64_from(10000));      # 1e-4
var TOL5 = f64_div(F64_ONE, f64_from(100000));     # 1e-5
var TOL8 = f64_div(F64_ONE, f64_from(100000000));  # 1e-8
var TOL_002 = f64_div(F64_ONE, f64_from(500));     # 0.002
var TOL_005 = f64_div(F64_ONE, f64_from(200));     # 0.005
var TOL_02 = f64_div(F64_ONE, f64_from(50));       # 0.02
var TOL_05 = f64_div(F64_ONE, f64_from(20));       # 0.05
var TOL1 = F64_ONE;                                # 1.0
var Z = f64_from(0);
var N15 = f64_div(f64_from(15), f64_from(10));      # 1.5

alloc_init();

# ── Cauchy ────────
test_group("cauchy");

var cb = cauchy_bk7();
var cn_blue = cauchy_n_at(cb, _fd(486, 1000));
var cn_d = cauchy_n_at(cb, _fd(5876, 10000));
var cn_red = cauchy_n_at(cb, _fd(656, 1000));
assert(f64_gt(cn_blue, cn_d), "cauchy blue > yellow");
assert(f64_gt(cn_d, cn_red), "cauchy yellow > red");
_assert_near(cn_d, _fd(1517, 1000), TOL_02, "cauchy BK7 n_d ~ 1.517");

assert(f64_gt(cauchy_n_at(cb, _fd(4, 10)), cauchy_n_at(cb, _fd(5, 10))), "cauchy dispersion 0.4>0.5");
assert(f64_gt(cauchy_n_at(cb, _fd(5, 10)), cauchy_n_at(cb, _fd(6, 10))), "cauchy dispersion 0.5>0.6");
assert(f64_gt(cauchy_n_at(cb, _fd(6, 10)), cauchy_n_at(cb, _fd(7, 10))), "cauchy dispersion 0.6>0.7");

# Cauchy fused silica (2.4.4). Was pinned at 1.458 +/- TOL_02, and the pre-2.4.4
# coefficients answered 1.46825 — an 0.0098 miss inside a 0.02 tolerance. TOL3 is
# right for a two-term Cauchy (the model's own error against Malitson is 1.7e-4
# across 400-700 nm) and is 10x tighter than the miss it now has to catch.
_assert_near(
  cauchy_n_at(cauchy_fused_silica(), _fd(5876, 10000)), _fd(145846, 100000), TOL3, "cauchy FS n_d = 1.45846");
# The two-term model against this file's verified Sellmeier set for the same glass.
var cfs = cauchy_fused_silica();
var sfs = sellmeier_fused_silica();
_assert_near(
  cauchy_n_at(cfs, fraunhofer_f()), sellmeier_n_at(sfs, fraunhofer_f()), TOL3, "cauchy FS ~ sellmeier at F");
_assert_near(
  cauchy_n_at(cfs, fraunhofer_c()), sellmeier_n_at(sfs, fraunhofer_c()), TOL3, "cauchy FS ~ sellmeier at C");

# ── Sellmeier ────────
test_group("sellmeier");

_assert_near(sellmeier_n_at(sellmeier_bk7(), fraunhofer_d()), _fd(15168, 10000), TOL3, "BK7 n_d ~ 1.5168");
var sb = sellmeier_bk7();
assert(f64_gt(sellmeier_n_at(sb, fraunhofer_f()), sellmeier_n_at(sb, fraunhofer_d())), "BK7 n_F > n_d");
assert(f64_gt(sellmeier_n_at(sb, fraunhofer_d()), sellmeier_n_at(sb, fraunhofer_c())), "BK7 n_d > n_C");
_assert_near(sellmeier_n_at(sellmeier_sf11(), fraunhofer_d()), _fd(17847, 10000), TOL3, "SF11 n_d ~ 1.7847");
_assert_near(sellmeier_n_at(sellmeier_fused_silica(), fraunhofer_d()), _fd(14585, 10000), TOL3, "FS n_d ~ 1.4585");
# Water — Daimon & Masumura (2007) at 20 C, three-term merge (2.4.3). Pinned at
# three wavelengths at TOL4, 11x tighter than the 0.0011 miss the pre-2.4.3
# coefficients carried; the old single TOL_005 assertion was 4x WIDER than that
# miss and passed it for six releases. The Abbe pin in the group below is the one
# that really bites: dropping the IR term cost 17% of the dispersion, not 0.1% of n.
var swat = sellmeier_water();
_assert_near(sellmeier_n_at(swat, fraunhofer_d()), _fd(133304, 100000), TOL4, "Water n_d = 1.33304");
_assert_near(sellmeier_n_at(swat, fraunhofer_f()), _fd(133712, 100000), TOL4, "Water n_F = 1.33712");
_assert_near(sellmeier_n_at(swat, fraunhofer_c()), _fd(133114, 100000), TOL4, "Water n_C = 1.33114");
assert(f64_gt(sellmeier_n_at(swat, fraunhofer_f()), sellmeier_n_at(swat, fraunhofer_d())), "Water n_F > n_d");
assert(f64_gt(sellmeier_n_at(swat, fraunhofer_d()), sellmeier_n_at(swat, fraunhofer_c())), "Water n_d > n_C");
# The IR term puts a resonance at 3.27 um, outside the fit's 0.182-1.129 um validity.
# These two pin that it stays outside: n must be finite, above 1 and falling across
# prakash's whole visible band, both edges included.
assert(_between(sellmeier_n_at(swat, _fd(38, 100)), _fd(132, 100), _fd(135, 100)), "Water n(380nm) sane");
assert(_between(sellmeier_n_at(swat, _fd(78, 100)), _fd(132, 100), _fd(135, 100)), "Water n(780nm) sane");
assert(f64_gt(sellmeier_n_at(swat, _fd(38, 100)), sellmeier_n_at(swat, _fd(78, 100))), "Water n(380) > n(780)");

# Diamond — Peter (1923), pinned at three wavelengths against published values
# rather than at n_d alone (2.4.2). The pre-2.4.2 coefficients miss n_d by 0.0096,
# n_F by 0.0128 and n_C by 0.0090 — every one of them 9x or more past TOL3 — and
# miss the Abbe pin in the group below by 8.9. The old single assertion sampled n_d
# only, at a tolerance of 0.02, and passed the defect for six releases.
# ⚠ The two monotonicity lines at the end do NOT discriminate here: wrong resonance
# constants still sit below the visible, so n still falls across it. They are pinned
# for the sign/ordering class, not this one — mutation-checked and stated, because a
# reader could otherwise take four green invariants for four independent checks.
var sdia = sellmeier_diamond();
_assert_near(sellmeier_n_at(sdia, fraunhofer_d()), _fd(241749, 100000), TOL3, "Diamond n_d = 2.41749");
_assert_near(sellmeier_n_at(sdia, fraunhofer_f()), _fd(243554, 100000), TOL3, "Diamond n_F = 2.43554");
_assert_near(sellmeier_n_at(sdia, fraunhofer_c()), _fd(240991, 100000), TOL3, "Diamond n_C = 2.40991");
# Invariants, pinned apart from the values: normal dispersion across the visible.
assert(f64_gt(sellmeier_n_at(sdia, fraunhofer_f()), sellmeier_n_at(sdia, fraunhofer_d())), "Diamond n_F > n_d");
assert(f64_gt(sellmeier_n_at(sdia, fraunhofer_d()), sellmeier_n_at(sdia, fraunhofer_c())), "Diamond n_d > n_C");
# Both resonances are below the visible, so n must fall monotonically right across it.
assert(f64_gt(sellmeier_n_at(sdia, _fd(3, 10)), sellmeier_n_at(sdia, _fd(45, 100))), "Diamond n(0.30) > n(0.45)");
assert(f64_gt(sellmeier_n_at(sdia, _fd(45, 100)), sellmeier_n_at(sdia, _fd(6, 10))), "Diamond n(0.45) > n(0.60)");

assert(_between(sellmeier_n_at(sellmeier_bk7(), fraunhofer_d()), TOL1, f64_from(3)), "BK7 reasonable");
assert(_between(sellmeier_n_at(sellmeier_sf11(), fraunhofer_d()), TOL1, f64_from(3)), "SF11 reasonable");
assert(_between(sellmeier_n_at(sellmeier_fused_silica(), fraunhofer_d()), TOL1, f64_from(3)), "FS reasonable");
assert(_between(sellmeier_n_at(sellmeier_sapphire(), fraunhofer_d()), TOL1, f64_from(3)), "Sapphire reasonable");
assert(_between(sellmeier_n_at(sellmeier_water(), fraunhofer_d()), TOL1, f64_from(3)), "Water reasonable");
assert(_between(sellmeier_n_at(sellmeier_diamond(), fraunhofer_d()), TOL1, f64_from(3)), "Diamond reasonable");

# ⚠ REGRESSION PINS ON THE LITERALS, NOT PHYSICS CHECKS — and they are here because
# the mutation check said they had to be. 2.4.4 made two FIDELITY repairs whose effect
# on n is below any tolerance a physics assertion can justify: N-SF11's b1 moves n by
# 2e-7, and sapphire's three slipped digits by 3.3e-5. Reverting b1 passed all 79
# assertions; reverting sapphire's trio was caught only by its Abbe pin, and only just.
# These four pin the coefficients themselves, and are the only thing standing between
# those repairs and a silent revert. (2.4.4)
_assert_near(SellmeierCoefficients_b1(sellmeier_sf11()), _fd(173759695, 100000000), TOL8, "N-SF11 b1 literal");
_assert_near(
  SellmeierCoefficients_c1(sellmeier_sapphire()), _fd(5279925, 1000000000), TOL8, "sapphire c1 = 0.0726631^2");
_assert_near(
  SellmeierCoefficients_c2(sellmeier_sapphire()), _fd(1423826, 100000000), TOL8, "sapphire c2 = 0.1193242^2");
_assert_near(SellmeierCoefficients_b3(sellmeier_sapphire()), _fd(53414021, 10000000), TOL8, "sapphire b3 literal");

# resonance guard: at l^2 = c1, n stays finite and >= 1
var res_wl = f64_sqrt(SellmeierCoefficients_c1(sellmeier_bk7()));
var res_n = sellmeier_n_at(sellmeier_bk7(), res_wl);
assert_eq(_is_finite(res_n), 1, "resonance n finite");
assert(f64_ge(res_n, F64_ONE), "resonance n >= 1");

# ── Abbe ────────
test_group("abbe");

_assert_near(abbe_number(sellmeier_bk7()), _fd(6417, 100), TOL1, "BK7 Abbe ~ 64.17");
# ⚠ 25.68, not 25.76: these are N-SF11's coefficients (see the preset's comment), and
# N-SF11's catalogued Abbe number is 25.68 where the older SF11's is 25.76. The pin was
# 25.76 +/- 1.0 through 2.4.3 — loose enough that it never had to choose. (2.4.4)
_assert_near(abbe_number(sellmeier_sf11()), _fd(2568, 100), TOL_05, "N-SF11 Abbe = 25.68");
_assert_near(sellmeier_n_at(sellmeier_sf11(), fraunhofer_d()), _fd(178472, 100000), TOL4, "N-SF11 n_d = 1.78472");
# Sapphire had no value pin at all before 2.4.4 — only a "reasonable" range check.
_assert_near(sellmeier_n_at(sellmeier_sapphire(), fraunhofer_d()), _fd(176817, 100000), TOL4, "Sapphire n_d = 1.76817");
_assert_near(abbe_number(sellmeier_sapphire()), _fd(7231, 100), TOL_05, "Sapphire Abbe = 72.31");
# The most discriminating diamond pin there is: the pre-2.4.2 coefficients answered
# 64.21 here — a crown-glass dispersion for a stone whose published V_d is 55.3, and
# 8.9 outside this band. No value assertion in this file had ever asked it (2.4.2).
_assert_near(abbe_number(sellmeier_diamond()), _fd(553, 10), TOL1, "Diamond Abbe ~ 55.3");
# Same for water (2.4.3): the pre-2.4.3 coefficients answered 65.08 here, 9.4 outside
# this band, while their n_d sat only 0.0011 from published. Dropping a Sellmeier term
# shows up in the DISPERSION first — which is why every preset now carries an Abbe pin.
_assert_near(abbe_number(sellmeier_water()), _fd(557, 10), TOL1, "Water Abbe ~ 55.7");
var v_bk7 = abbe_number(sellmeier_bk7());
var v_sf11 = abbe_number(sellmeier_sf11());
assert(f64_gt(v_bk7, v_sf11), "crown Abbe > flint");
assert(f64_gt(v_bk7, f64_from(50)), "crown V > 50");
assert(f64_lt(v_sf11, f64_from(50)), "flint V < 50");

# ── cross-module refract/snell/trace ────────
test_group("refract_snell_trace");

var er = 0;
var refracted = ray_refract_3d(
  _n3(_fd(4, 10), _fd(3, 10), f64_neg(_fd(8, 10))),
  ray_vec3(Z, Z, F64_ONE), F64_ONE, N15, &er);
var rl = f64_sqrt(f64_add(f64_add(
      f64_mul(RayVec3_x(refracted), RayVec3_x(refracted)),
      f64_mul(RayVec3_y(refracted), RayVec3_y(refracted))),
    f64_mul(RayVec3_z(refracted), RayVec3_z(refracted))));
_assert_near(rl, F64_ONE, TOL_02, "refracted direction normalized");

var angle_i = ray_deg_to_rad(f64_from(30));
var es = 0;
var scalar_t = ray_snell(F64_ONE, N15, angle_i, &es);
var refl_x = 0;
var e3d = 0;
var refr3 = ray_snell_3d(
  ray_vec3(f64_sin(angle_i), Z, f64_neg(f64_cos(angle_i))),
  ray_vec3(Z, Z, F64_ONE), F64_ONE, N15, &refl_x, &e3d);
var angle_t_3d = ganita_f64_acos(f64_neg(RayVec3_z(refr3)));
_assert_near(angle_t_3d, scalar_t, TOL3, "snell_3d matches scalar snell");

var surfs = vec_new();
vec_push(surfs, surface_plane(f64_from(10), N15, f64_from(25)));
vec_push(surfs, surface_plane(f64_from(15), F64_ONE, f64_from(25)));
var et = 0;
var hits = trace_sequential(trace_ray_new(ray_vec3(Z, Z, Z), ray_vec3(Z, Z, F64_ONE), F64_ONE), surfs, &et);
var ih = 0;
while (ih < vec_len(hits)) {
    var refl = TraceHit_reflectance(vec_get(hits, ih));
    assert(_between(refl, Z, F64_ONE), "surface reflectance in [0,1]");
    ih = ih + 1;
}

# ── Prism ────────
test_group("prism");

var e_zero = 0;
var dev_zero = prism_deviation(Z, N15, &e_zero);
assert_eq(e_zero, 0, "zero apex ok");
_assert_near(dev_zero, Z, TOL6, "zero apex zero deviation");

var apex60 = ray_deg_to_rad(f64_from(60));
var e60 = 0;
var dev60 = prism_deviation(apex60, sellmeier_n_at(sellmeier_bk7(), fraunhofer_d()), &e60);
assert(_between(ray_rad_to_deg(dev60), f64_from(35), f64_from(50)), "60deg BK7 prism dev ~40deg");

var el = 0;
var eh = 0;
var dev_low = prism_deviation(apex60, _fd(14, 10), &el);
var dev_high = prism_deviation(apex60, _fd(17, 10), &eh);
assert(f64_gt(dev_high, dev_low), "deviation increases with n");

var e_tir = 0;
var _dtir = prism_deviation(ray_deg_to_rad(f64_from(120)), F64_TWO, &e_tir);
assert(prakash_is_err(e_tir), "prism TIR errors");

var edb = 0;
var edr = 0;
var dev_blue = prism_dispersion(apex60, sellmeier_bk7(), fraunhofer_f(), &edb);
var dev_red = prism_dispersion(apex60, sellmeier_bk7(), fraunhofer_c(), &edr);
assert(f64_gt(dev_blue, dev_red), "blue deviated more than red");

var esp = 0;
var spread = prism_angular_spread(apex60, sellmeier_bk7(), fraunhofer_f(), fraunhofer_c(), &esp);
assert_eq(esp, 0, "angular spread ok");
assert(f64_gt(PrismSpread_dev_short(spread), PrismSpread_dev_long(spread)), "dev_short > dev_long");
assert(f64_gt(PrismSpread_spread(spread), Z), "spread positive");
assert(f64_lt(ray_rad_to_deg(PrismSpread_spread(spread)), f64_from(5)), "BK7 spread modest");

var esc = 0;
var esf = 0;
var spread_crown = prism_angular_spread(apex60, sellmeier_bk7(), fraunhofer_f(), fraunhofer_c(), &esc);
var spread_flint = prism_angular_spread(apex60, sellmeier_sf11(), fraunhofer_f(), fraunhofer_c(), &esf);
assert(f64_gt(PrismSpread_spread(spread_flint), PrismSpread_spread(spread_crown)), "flint disperses more than crown");

# ── additional models ────────
test_group("additional_models");

# ⭐ TWO INDEPENDENT MODELS OF ONE GLASS — the sharpest instrument in this file, and
# it was set to TOL_002 (inherited from the Rust archive) while the defect it was
# there to catch measured 2.1e-5. At TOL5 the corrected pair agrees to 1.7e-6 across
# 400-700 nm; the pre-2.4.4 a3 misses at every wavelength below. (2.4.4)
var schb = schott_bk7();
var selb = sellmeier_bk7();
_assert_near(schott_n_at(schb, _fd(4, 10)), sellmeier_n_at(selb, _fd(4, 10)), TOL5, "Schott ~ Sellmeier at 0.40um");
_assert_near(schott_n_at(schb, fraunhofer_f()), sellmeier_n_at(selb, fraunhofer_f()), TOL5, "Schott ~ Sellmeier at F");
_assert_near(schott_n_at(schb, fraunhofer_d()), sellmeier_n_at(selb, fraunhofer_d()), TOL5, "Schott ~ Sellmeier at d");
_assert_near(schott_n_at(schb, fraunhofer_c()), sellmeier_n_at(selb, fraunhofer_c()), TOL5, "Schott ~ Sellmeier at C");
_assert_near(schott_n_at(schb, _fd(7, 10)), sellmeier_n_at(selb, _fd(7, 10)), TOL5, "Schott ~ Sellmeier at 0.70um");
_assert_near(schott_n_at(schb, fraunhofer_d()), _fd(151680, 100000), TOL4, "Schott BK7 n_d = 1.51680");
assert(_between(schott_n_at(schott_bk7(), _fd(4, 10)), _fd(14, 10), _fd(16, 10)), "Schott BK7 range 0.4");
assert(_between(schott_n_at(schott_bk7(), _fd(5, 10)), _fd(14, 10), _fd(16, 10)), "Schott BK7 range 0.5");
assert(_between(schott_n_at(schott_bk7(), _fd(6, 10)), _fd(14, 10), _fd(16, 10)), "Schott BK7 range 0.6");
assert(_between(schott_n_at(schott_bk7(), _fd(7, 10)), _fd(14, 10), _fd(16, 10)), "Schott BK7 range 0.7");

var conrady = _conrady_mk(_fd(151, 100), _fd(5, 1000), _fd(1, 10000));
assert(_between(conrady_n_at(conrady, _fd(5876, 10000)), N15, _fd(155, 100)), "Conrady n in (1.5,1.55)");

var herz = _herzberger_mk(_fd(151, 100), _fd(1, 1000), Z, f64_neg(_fd(1, 1000)), Z);
assert(_between(herzberger_n_at(herz, _fd(5876, 10000)), _fd(14, 10), _fd(16, 10)), "Herzberger n in (1.4,1.6)");

# ── chromatic aberration ────────
test_group("chromatic_aberration");

_assert_near(partial_dispersion(sellmeier_bk7()), _fd(53, 100), TOL_05, "BK7 partial dispersion ~ 0.53");
var v = abbe_number(sellmeier_bk7());
assert(_between(longitudinal_chromatic_aberration(f64_from(100), v), TOL1, F64_TWO), "LCA ~ 1.5mm");
assert(_between(lateral_chromatic_aberration(f64_from(10), v), Z, F64_ONE), "TCA in (0,1)");
_assert_near(secondary_spectrum(f64_from(100), Z, f64_from(64)), Z, TOL6, "zero dP -> zero secondary spectrum");
assert(f64_gt(secondary_spectrum(f64_from(100), _fd(1, 100), f64_from(64)), Z), "positive dP -> positive secondary");

# ── Sellmeier derivatives and group index (2.10.0) ────────
test_group("sellmeier_derivatives");

# Pinned against mpmath at 50 digits (numerical differentiation of the SAME
# Sellmeier formula, with the coefficients and wavelengths as the doubles the
# library holds) — an independent evaluation of the derivatives, not the analytic
# expression they are computed from.
fn _rel(a, b) { return f64_div(f64_abs(f64_sub(a, b)), f64_abs(b)); }
fn _assert_rel(a, b, rtol, msg) { assert(f64_le(_rel(a, b), rtol), msg); }
fn _isnan(x) { return f64_eq(x, x) == 0; }
var R13 = _fd(1, 10000000000000);   # 1e-13
var fsd = sellmeier_fused_silica();
var bkd = sellmeier_bk7();
var dia = sellmeier_diamond();
_assert_rel(sellmeier_dn_dlambda(fsd, _fd(5, 10)), 0xBFAC57AB86E57A01, R13, "silica dn/dl at 0.5 um");
_assert_rel(sellmeier_d2n_dlambda2(fsd, _fd(5, 10)), 0x3FD4AC33B3B86D4F, R13, "silica d2n/dl2 at 0.5 um");
_assert_rel(sellmeier_group_index(fsd, _fd(5, 10)), 0x3FF7D70F235BAA19, R13, "silica N_g at 0.5 um");
_assert_rel(sellmeier_dn_dlambda(fsd, F64_ONE), 0xBF89D954B4220D21, R13, "silica dn/dl at 1 um");
_assert_rel(sellmeier_d2n_dlambda2(fsd, F64_ONE), 0x3F88783D9BD2BDDD, R13, "silica d2n/dl2 at 1 um");
_assert_rel(sellmeier_dn_dlambda(fsd, _fd(155, 100)), 0xBF888A46D0BC8D5F, R13, "silica dn/dl at 1.55 um");
_assert_rel(sellmeier_d2n_dlambda2(fsd, _fd(155, 100)), 0xBF715BED7B11B3C3, R13,
  "silica d2n/dl2 at 1.55 um (negative: past the zero)");
_assert_rel(sellmeier_group_index(fsd, _fd(155, 100)), 0x3FF766CB92173C16, R13, "silica N_g at 1.55 um = 1.46243");
_assert_rel(sellmeier_d2n_dlambda2(fsd, _fd(131, 100)), 0xBF4ADC1C1237983F, _fd(1, 100000000000),
  "silica d2n/dl2 at 1.31 um (small)");
_assert_rel(sellmeier_dn_dlambda(bkd, _fd(58756, 100000)), 0xBFA566C8395E21A2, R13, "BK7 dn/dl at the d line");
_assert_rel(sellmeier_d2n_dlambda2(bkd, _fd(58756, 100000)), 0x3FC9144FE7C31B13, R13, "BK7 d2n/dl2 at the d line");
_assert_rel(sellmeier_group_index(bkd, _fd(58756, 100000)), 0x3FF8A96919013E94, R13, "BK7 N_g at the d line");
_assert_rel(sellmeier_group_index(bkd, _fd(155, 100)), 0x3FF85236ADBB61D2, R13, "BK7 N_g at 1.55 um");
_assert_rel(sellmeier_dn_dlambda(dia, _fd(58756, 100000)), 0xBFC0C4B322B28CCC, R13, "diamond dn/dl at the d line");
_assert_rel(sellmeier_d2n_dlambda2(dia, _fd(58756, 100000)), 0x3FE67B71450B4FC4, R13, "diamond d2n/dl2 at the d line");
# Diamond's third term is a placeholder (b3 = 0, c3 = 1): it contributes nothing
# and must not turn 1 um into a pole.
_assert_rel(sellmeier_dn_dlambda(dia, F64_ONE), 0xBF99EF1B0672B151, R13,
  "diamond dn/dl at 1 um: the (0, 1) term is not a pole");
_assert_rel(sellmeier_group_index(dia, F64_ONE), 0x40035880A9A0CFEA, R13, "diamond N_g at 1 um");

# The analytic derivative against the library's own index: central differences
# of sellmeier_n_at at h = 1e-4 um (truncation ~1e-9 relative, rounding ~1e-12).
var hl = _fd(1, 10000);
var l0 = _fd(8, 10);
var np8 = sellmeier_n_at(fsd, f64_add(l0, hl));
var nm8 = sellmeier_n_at(fsd, f64_sub(l0, hl));
var fdiff = f64_div(f64_sub(np8, nm8), f64_add(hl, hl));
_assert_rel(sellmeier_dn_dlambda(fsd, l0), fdiff, _fd(1, 10000000), "dn/dl agrees with a difference of sellmeier_n_at");
var fdiff2 = f64_div(f64_add(f64_sub(np8, f64_mul(F64_TWO, sellmeier_n_at(fsd, l0))), nm8), f64_mul(hl, hl));
_assert_rel(sellmeier_d2n_dlambda2(fsd, l0), fdiff2, _fd(1, 100000), "d2n/dl2 agrees with a second difference");
# N_g > n in normal dispersion.
assert(f64_gt(sellmeier_group_index(fsd, l0), sellmeier_n_at(fsd, l0)),
  "group index exceeds phase index (normal dispersion)");

# Refusals: NaN, never a number, on inputs with no derivative.
assert(_isnan(sellmeier_dn_dlambda(0, F64_ONE)), "null set -> NaN");
assert(_isnan(sellmeier_d2n_dlambda2(fsd, Z)), "zero wavelength -> NaN");
assert(_isnan(sellmeier_group_index(fsd, f64_neg(F64_ONE))), "negative wavelength -> NaN");
assert(_isnan(sellmeier_dn_dlambda(fsd, 0x7FF0000000000000)), "infinite wavelength -> NaN");
assert(_isnan(sellmeier_dn_dlambda(fsd, 0x7FF8000000000000)), "NaN wavelength -> NaN");
# Water's IR resonance puts n^2 < 1 near 3.1 um, where sellmeier_n_at clamps to 1.
var wat = sellmeier_water();
assert_eq(sellmeier_n_at(wat, _fd(31, 10)), F64_ONE, "water at 3.1 um is in the clamped region");
assert(_isnan(sellmeier_dn_dlambda(wat, _fd(31, 10))), "no derivative of a clamped index");
assert(_isnan(sellmeier_d2n_dlambda2(wat, _fd(31, 10))), "no second derivative of a clamped index");
# A real pole: lambda^2 = c exactly, for a term whose b is nonzero.
var pole = _sellmeier_mk(F64_ONE, _fd(1, 4), Z, F64_ONE, Z, F64_ONE);
assert(_isnan(sellmeier_dn_dlambda(pole, F64_HALF)), "on a resonance -> NaN");

# Round 1: the pole guard is a BAND (|l^2 - C| <= 1e-15), not a point — one ulp
# above l^2 = C an unguarded term returns 2e23. And the n^2 < 1 test is on chi = n^2 - 1
# itself: at 5e-10 um silica's first term is below half an ulp of 1.
assert(_isnan(sellmeier_dn_dlambda(pole, 0x3FE0000000000001)), "one ulp above a resonance -> NaN");
assert(_isnan(sellmeier_d2n_dlambda2(pole, 0x3FE0000000000001)), "one ulp above a resonance -> NaN (d2n)");
assert(_isnan(sellmeier_group_index(fsd, 0x3E012E0BE826D695)), "silica at 5e-10 um (n^2 < 1 by an ulp) -> NaN");
assert(_isnan(sellmeier_d2n_dlambda2(fsd, 0x3E012E0BE826D695)), "silica at 5e-10 um -> NaN (d2n)");

var r = assert_summary();
